@inject IJSRuntime JS
@inject I18nText I18nText

<div class="barcode-input-group">
    <div class="input-group">
        <input type="text"
               class="form-control @CssClass"
               placeholder="@Placeholder"
               @bind="Value"
               @bind:event="oninput"
               @bind:after="OnValueChanged" />
        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="ToggleScanner"
                title="@T.BarcodeInput_ScanTitle">
            <i class="bi bi-@(showScanner ? "x" : "camera")"></i>
        </button>
    </div>

    @if (showScanner)
    {
        <div class="mt-3 p-3 border rounded bg-light">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong><i class="bi bi-camera-video me-2"></i>@T.BarcodeInput_ScannerTitle</strong>
                <button type="button" class="btn-close" @onclick="CloseScanner" aria-label="Close"></button>
            </div>
            <SimpleZXingScanner OnScanned="HandleScan" />
        </div>
    }

    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <div class="text-danger small mt-1">
            @ValidationMessage
        </div>
    }
</div>


@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "";

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public string? ValidationMessage { get; set; }

    [Parameter]
    public bool AutoStopAfterScan { get; set; } = true;

    private bool showScanner = false;

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        if (string.IsNullOrEmpty(Placeholder))
            Placeholder = T.BarcodeInput_Placeholder;
    }

    private void ToggleScanner()
    {
        showScanner = !showScanner;
    }

    private void CloseScanner()
    {
        showScanner = false;
    }

    private async Task HandleScan(string barcode)
    {
        if (string.IsNullOrWhiteSpace(barcode)) return;

        Value = barcode;
        
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(barcode);
        }

        if (AutoStopAfterScan)
        {
            showScanner = false;
        }

        StateHasChanged();
    }

    private async Task OnValueChanged()
    {
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
    }
}
