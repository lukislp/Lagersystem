@* Multi-select component for storage locations with quantity input *@
@inject I18nText I18nText
<div class="storage-location-multiselect">
    <label class="form-label">@Label</label>
    
    @if (SelectedStorageLocations.Any())
    {
        <div class="selected-storage-locations mb-3">
            @foreach (var location in SelectedStorageLocations)
            {
                <div class="selected-storage-item">
                    <div class="storage-info">
                        <CategoryIcon IconClass="bi-geo-alt" />
                        <strong class="ms-2">@location.StorageLocation.Code</strong>
                        <span class="text-muted ms-2">@location.StorageLocation.Name</span>
                        @if (!string.IsNullOrEmpty(location.StorageLocation.Room))
                        {
                            <span class="badge bg-info ms-2">@location.StorageLocation.Room</span>
                        }
                    </div>
                    <div class="quantity-input">
                        <input type="number" class="form-control form-control-sm"
                               style="width: 80px;"
                               min="0"
                               @bind="location.Quantity"
                               @bind:event="oninput"
                               @bind:after="OnQuantityInput"
                               placeholder="@T.StorageMultiSelect_Qty" />
                        <button type="button" class="btn btn-sm btn-danger"
                                @onclick="() => RemoveStorageLocation(location)">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="add-storage-location">
        <div class="input-group">
            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>
            <input type="text"
                   class="form-control"
                   placeholder="@T.StorageMultiSelect_Search"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @bind:after="OnSearchChanged" />
            <button type="button" class="btn btn-secondary" @onclick="ToggleDropdown">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>

        @if (showDropdown && filteredLocations.Any())
        {
            <div class="dropdown-menu show" style="width: 100%; max-height: 300px; overflow-y: auto;">
                @foreach (var location in filteredLocations)
                {
                    <button type="button"
                            class="dropdown-item d-flex justify-content-between align-items-center"
                            @onclick="() => AddStorageLocation(location)">
                        <div class="d-flex align-items-center gap-2">
                            <CategoryIcon IconClass="bi-geo-alt" />
                            <div>
                                <strong>@location.Code</strong>
                                <br>
                                <small class="text-muted">@location.Name</small>
                                @if (!string.IsNullOrEmpty(location.Room))
                                {
                                    <span class="badge bg-info ms-2">@location.Room</span>
                                }
                            </div>
                        </div>
                        <i class="bi bi-plus-circle text-primary"></i>
                    </button>
                }
            </div>
        }
        else if (showDropdown && !string.IsNullOrEmpty(searchTerm))
        {
            <div class="dropdown-menu show" style="width: 100%;">
                <div class="dropdown-item text-muted">
                    <i class="bi bi-info-circle me-2"></i>
                    @T.StorageMultiSelect_NoResults
                </div>
            </div>
        }
    </div>

    <small class="text-muted">
        <i class="bi bi-info-circle me-1"></i>
        @T.StorageMultiSelect_Hint
    </small>
</div>


@code {
    [Parameter]
    public string Label { get; set; } = "";

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        if (string.IsNullOrEmpty(Label))
            Label = T.StorageMultiSelect_Label;
    }

    [Parameter]
    public List<ProductStorageLocationItem> SelectedStorageLocations { get; set; } = new();

    [Parameter]
    public EventCallback<List<ProductStorageLocationItem>> SelectedStorageLocationsChanged { get; set; }

    [Parameter]
    public List<StorageLocation> AvailableStorageLocations { get; set; } = new();

    // Event raised when a quantity changes
    [Parameter]
    public EventCallback OnQuantityChanged { get; set; }

    private string searchTerm = string.Empty;
    private bool showDropdown = false;
    private List<StorageLocation> filteredLocations = new();

    protected override void OnParametersSet()
    {
        FilterLocations();
    }

    private void OnSearchChanged()
    {
        FilterLocations();
        showDropdown = true;
    }

    private void FilterLocations()
    {
        var alreadySelected = SelectedStorageLocations.Select(s => s.StorageLocation.Id).ToList();

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredLocations = AvailableStorageLocations
                .Where(l => !alreadySelected.Contains(l.Id))
                .Take(10)
                    .ToList();
        }
        else
        {
            var term = searchTerm.ToLower();
            filteredLocations = AvailableStorageLocations
                    .Where(l => !alreadySelected.Contains(l.Id) &&
                (l.Code.ToLower().Contains(term) ||
                l.Name.ToLower().Contains(term) ||
                (l.Room?.ToLower().Contains(term) ?? false)))
                    .Take(10)
                            .ToList();
        }
    }

    private async Task AddStorageLocation(StorageLocation location)
    {
        if (!SelectedStorageLocations.Any(s => s.StorageLocation.Id == location.Id))
        {
            SelectedStorageLocations.Add(new ProductStorageLocationItem
            {
                StorageLocation = location,
                Quantity = 0 // User must enter the quantity
            });

            await SelectedStorageLocationsChanged.InvokeAsync(SelectedStorageLocations);
            await OnQuantityChanged.InvokeAsync(); // Trigger parent refresh
         
            searchTerm = string.Empty;
            showDropdown = false;
            FilterLocations();
        }
    }

    private async Task RemoveStorageLocation(ProductStorageLocationItem item)
    {
        SelectedStorageLocations.Remove(item);
        await SelectedStorageLocationsChanged.InvokeAsync(SelectedStorageLocations);
        await OnQuantityChanged.InvokeAsync(); // Trigger parent refresh
        FilterLocations();
    }

    // Trigger on quantity input change
    private async Task OnQuantityInput()
    {
        await OnQuantityChanged.InvokeAsync();
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
        if (showDropdown)
        {
            FilterLocations();
        }
    }

    // Helper class for component
    public class ProductStorageLocationItem
    {
        public StorageLocation StorageLocation { get; set; } = null!;
        public int Quantity { get; set; }
    }
}
