@page "/settings"
@inherits CancellableComponentBase
@using LagersystemLVHome.Application.Configuration
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject I18nText I18nText
@rendermode InteractiveServer

<PageTitle>@T.Settings_PageTitle</PageTitle>

<div class="page-header">
    <h1 class="page-title">@T.Settings_Title</h1>
    <p class="page-subtitle">@T.Settings_Subtitle</p>
</div>

<div class="row g-4">
    <!-- PWA Cache Card -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-app-indicator me-2"></i>
                    @T.Settings_PWA_Title
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>@T.Settings_PWA_CacheStatus</strong>
                    @if (cacheCleared)
                    {
                        <span class="text-success">✅ Cache wurde geleert</span>
                    }
                    else
                    {
                        <span>@T.Settings_PWA_CacheDescription</span>
                    }
                </div>
         
                <p class="text-muted small mb-3">
                    @T.Settings_PWA_HintMobile
                </p>

                <button class="btn btn-warning w-100" @onclick="ClearCache" disabled="@isClearing">
                    @if (isClearing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <text>@T.Settings_PWA_Clearing</text>
                    }
                    else
                    {
                        <i class="bi bi-trash me-2"></i>
                        <text>@T.Settings_PWA_ClearCache</text>
                    }
                </button>
                
                @if (cacheCleared)
                {
                    <div class="alert alert-success mt-3 mb-0">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>@T.Settings_PWA_Success_Title</strong> @T.Settings_PWA_Success_Desc
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-database me-2"></i>
                    @T.Settings_DB_Title
                </h3>
            </div>
            <div class="card-body">
                @if (databaseSettings != null)
                {
                    <div class="alert @GetDatabaseAlertClass()">
                        <i class="bi @GetDatabaseIcon() me-2"></i>
                        <strong>@T.Settings_DB_Provider</strong> @GetDatabaseDisplayName()
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>@T.Settings_DB_ConnectionDetails</strong><br>
                        <code>@GetSafeConnectionString(databaseSettings.ConnectionString)</code>
                    </div>

                    <p class="text-muted small">
                        @T.Settings_DB_Supports
                    </p>
                }
                else
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>@T.Settings_DB_ConfigError</strong>
                        <br><small>@T.Settings_DB_ConfigErrorHint</small>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-qr-code me-2"></i>
                    @T.Settings_Scanner_Title
                </h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">@T.Settings_Scanner_DefaultQty</label>
                    <select class="form-select">
                        <option value="1" selected>@T.Settings_Scanner_Option1</option>
                        <option value="5">@T.Settings_Scanner_Option5</option>
                        <option value="10">@T.Settings_Scanner_Option10</option>
                    </select>
                    <small class="text-muted">@T.Settings_Scanner_DefaultQtyHint</small>
                </div>
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="scanSound" checked />
                    <label class="form-check-label" for="scanSound">
                        @T.Settings_Scanner_Sound
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="autoFocus" checked />
                    <label class="form-check-label" for="autoFocus">
                        @T.Settings_Scanner_AutoFocus
                    </label>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-bell me-2"></i>
                    @T.Settings_Notifications_Title
                </h3>
            </div>
            <div class="card-body">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="lowStockAlert" checked />
                    <label class="form-check-label" for="lowStockAlert">
                        @T.Settings_Notify_LowStock
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="outOfStockAlert" checked />
                    <label class="form-check-label" for="outOfStockAlert">
                        @T.Settings_Notify_OutOfStock
                    </label>
                </div>
                <div class="form-group mt-3">
                    <label class="form-label">@T.Settings_Notify_Threshold</label>
                    <div class="input-group">
                        <input type="number" class="form-control" value="5" min="1" />
                        <span class="input-group-text">@T.Settings_Notify_ThresholdUnit</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                    <h3 class="card-title">
                    <i class="bi bi-info-circle me-2"></i>
                    @T.Settings_About_Title
                </h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@T.Settings_About_Version</dt>
                    <dd class="col-sm-8">1.0.0</dd>

                    <dt class="col-sm-4">@T.Settings_About_Framework</dt>
                    <dd class="col-sm-8">.NET 10 Blazor</dd>

                    <dt class="col-sm-4">@T.Settings_About_Database</dt>
                    <dd class="col-sm-8">@GetDatabaseDisplayName() (Entity Framework Core)</dd>

                    <dt class="col-sm-4">@T.Settings_About_UI</dt>
                    <dd class="col-sm-8">Bootstrap 5 + Custom CSS</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <button class="btn btn-primary" disabled>
        <i class="bi bi-check"></i> @T.Settings_SaveButton
    </button>
    <small class="text-muted ms-3">@T.Settings_SaveHint</small>
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private DatabaseSettings? databaseSettings;
    private bool isClearing = false;
    private bool cacheCleared = false;

    protected override void OnInitialized()
    {
        _ = InitI18n();
        try
        {
            databaseSettings = Configuration.GetSection("DatabaseSettings").Get<DatabaseSettings>();
    
            if (databaseSettings == null)
            {
                var section = Configuration.GetSection("DatabaseSettings");
                if (section.Exists())
                {
                    databaseSettings = new DatabaseSettings
                    {
                        Provider = Enum.Parse<DatabaseProvider>(section["Provider"] ?? "SQLite"),
                        ConnectionString = section["ConnectionString"] ?? "",
                        EnableRetryOnFailure = bool.Parse(section["EnableRetryOnFailure"] ?? "true"),
                        MaxRetryCount = int.Parse(section["MaxRetryCount"] ?? "3"),
                        CommandTimeout = int.Parse(section["CommandTimeout"] ?? "30")
                    };
                }
            }
        }
        catch
        {
            databaseSettings = null;
        }
    }

    // Clear cache
    private async Task ClearCache()
    {
        try
        {
            isClearing = true;
            StateHasChanged();

            // Wait 500ms for UI update
            await Task.Delay(500);

            // Invoke JavaScript helper
            await JS.InvokeVoidAsync("PWA.clearCache");

            cacheCleared = true;
            StateHasChanged();

            // Wait 3 seconds, then reload
            await Task.Delay(3000);
            await JS.InvokeVoidAsync("location.reload", true); // Hard Reload
        }
        catch
        {
            isClearing = false;
            StateHasChanged();
        }
    }

    private string GetDatabaseDisplayName()
    {
        if (databaseSettings == null)
            return T.Settings_DB_Unknown;

        return databaseSettings.Provider switch
        {
            DatabaseProvider.SQLite => "SQLite (Lokal)",
            DatabaseProvider.PostgreSQL => "PostgreSQL",
            DatabaseProvider.MySQL => "MySQL",
            _ => databaseSettings.Provider.ToString()
        };
    }

    private string GetDatabaseIcon()
    {
        if (databaseSettings == null)
            return "bi-question-circle";

        return databaseSettings.Provider switch
        {
            DatabaseProvider.SQLite => "bi-file-earmark-code",
            DatabaseProvider.PostgreSQL => "bi-server",
            DatabaseProvider.MySQL => "bi-database",
            _ => "bi-database"
        };
    }

    private string GetDatabaseAlertClass()
    {
        if (databaseSettings == null)
            return "alert-secondary";

        return databaseSettings.Provider switch
        {
            DatabaseProvider.SQLite => "alert-info",
            DatabaseProvider.PostgreSQL => "alert-success",
            DatabaseProvider.MySQL => "alert-primary",
            _ => "alert-secondary"
        };
    }

    private string GetSafeConnectionString(string? connectionString)
    {
        if (string.IsNullOrEmpty(connectionString))
            return "Nicht konfiguriert";

        // Strip password from connection string before displaying
        var parts = connectionString.Split(';');
        var safeParts = parts.Where(p => !p.TrimStart().StartsWith("Password", StringComparison.OrdinalIgnoreCase))
.ToList();

        if (parts.Length != safeParts.Count)
        {
            safeParts.Add("Password=***");
        }

          return string.Join("; ", safeParts);
            }

            private async Task InitI18n()
            {
                T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
                StateHasChanged();
            }
        }
