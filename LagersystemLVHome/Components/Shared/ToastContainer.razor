@using LagersystemLVHome.Application.Services
@inject IToastService ToastService
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in toasts)
    {
        <div class="toast toast-@toast.Type @(toast.IsVisible ? "show" : "") @toast.AdditionalClass"
             @key="toast.Id"
             @onclick="() => DismissToast(toast.Id)">
            <div class="toast-icon">
                <i class="bi @GetIcon(toast.Type)"></i>
            </div>
            <div class="toast-content">
                @if (!string.IsNullOrEmpty(toast.Title))
                {
                    <strong class="toast-title">@toast.Title</strong>
                }
                <p class="toast-message">@toast.Message</p>
            </div>
            <button class="toast-close" @onclick="() => DismissToast(toast.Id)" @onclick:stopPropagation="true">
                <i class="bi bi-x"></i>
            </button>
            <div class="toast-progress" style="animation-duration: @toast.Duration ms"></div>
        </div>
    }
</div>

@code {
    private List<ToastNotification> toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
    }

    private void ShowToast(string message, string type, string? title, int duration, string? additionalClass)
    {
        var toast = new ToastNotification
        {
            Id = Guid.NewGuid().ToString(),
            Message = message,
            Type = type,
            Title = title ?? GetDefaultTitle(type),
            Duration = duration,
            AdditionalClass = additionalClass ?? "",
            IsVisible = false
        };

        toasts.Add(toast);
        StateHasChanged();

        // Trigger show animation
        Task.Run(async () =>
    {
        await Task.Delay(10);
        await InvokeAsync(() =>
        {
            toast.IsVisible = true;
            StateHasChanged();
        });

        // Auto-dismiss
        await Task.Delay(duration);
        await InvokeAsync(() => DismissToast(toast.Id));
    });
    }

    private void DismissToast(string id)
    {
        var toast = toasts.FirstOrDefault(t => t.Id == id);
        if (toast != null)
        {
            toast.IsVisible = false;
            StateHasChanged();

            // Remove after animation
            Task.Run(async () =>
            {
                await Task.Delay(300);
                await InvokeAsync(() =>
    {
                toasts.Remove(toast);
                StateHasChanged();
            });
            });
        }
    }

    private string GetIcon(string type) => type switch
    {
        "success" => "bi-check-circle-fill",
        "error" => "bi-x-circle-fill",
        "warning" => "bi-exclamation-triangle-fill",
        "info" => "bi-info-circle-fill",
        _ => "bi-bell-fill"
    };

    private string GetDefaultTitle(string type) => type switch
    {
        "success" => "Erfolg",
        "error" => "Fehler",
        "warning" => "Warnung",
        "info" => "Information",
        _ => ""
    };

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
    }

    private class ToastNotification
    {
        public string Id { get; set; } = "";
        public string Message { get; set; } = "";
        public string Type { get; set; } = "info";
        public string Title { get; set; } = "";
        public int Duration { get; set; } = 3000;
        public string AdditionalClass { get; set; } = "";
        public bool IsVisible { get; set; }
    }
}
