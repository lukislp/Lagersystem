@page "/admin/warehouses"
@inherits CancellableComponentBase
@using System.ComponentModel.DataAnnotations
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using LagersystemLVHome.Application.Services
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IWarehouseService WarehouseService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject I18nText I18nText

<PageTitle>@T.AdminWarehouses_PageTitle</PageTitle>

<div class="page-header d-flex justify-content-between align-items-start">
    <div>
        <h1 class="page-title">@T.AdminWarehouses_Title</h1>
        @if (currentUser?.Role == UserRole.SuperAdmin)
        {
            <p class="page-subtitle">@T.AdminWarehouses_Subtitle_SuperAdmin</p>
        }
        else
        {
            <p class="page-subtitle">@T.AdminWarehouses_Subtitle_Admin</p>
        }
    </div>
    @if (currentUser?.Role == UserRole.SuperAdmin)
    {
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            <i class="bi bi-plus"></i> @T.AdminWarehouses_NewWarehouse
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible">
        <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
        @message
        <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
    </div>
}

<div class="row g-4">
    @if (warehouses.Any())
    {
        @foreach (var warehouse in warehouses)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 @(warehouse.IsActive ? "" : "opacity-75")">
                    <div class="card-header d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="mb-1">@warehouse.Name</h4>
                            <code class="text-muted">@warehouse.Code</code>
                        </div>
                        @if (currentUser?.Role >= UserRole.Admin)
                        {
                            <div class="dropdown">
                                <button class="btn btn-icon btn-secondary" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (currentUser?.Role == UserRole.SuperAdmin)
                                    {
                                        <li>
                                            <button class="dropdown-item" @onclick="() => OpenEditModal(warehouse)">
                                                <i class="bi bi-pencil me-2"></i> @T.AdminWarehouses_Edit
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" @onclick="() => ToggleActive(warehouse)">
                                                <i class="bi @(warehouse.IsActive ? "bi-eye-slash" : "bi-eye") me-2"></i>
                                                @(warehouse.IsActive ? T.AdminWarehouses_Deactivate : T.AdminWarehouses_Activate)
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button class="dropdown-item text-danger" @onclick="() => ConfirmDelete(warehouse)">
                                                <i class="bi bi-trash me-2"></i> Löschen
                                            </button>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <button class="dropdown-item" @onclick="() => ViewWarehouseDetails(warehouse)">
                                                <i class="bi bi-eye me-2"></i> @T.AdminWarehouses_ViewDetails
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(warehouse.Description))
                        {
                            <p class="text-muted mb-3">@warehouse.Description</p>
                        }
               
                        @if (!string.IsNullOrEmpty(warehouse.Address))
                        {
                            <div class="mb-3">
                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@warehouse.Address</small>
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-6">
                                <div class="stat-box">
                                    <div class="stat-icon text-primary">
                                        <i class="bi bi-people"></i>
                                    </div>
                                    <div>
                                        <div class="stat-value">@GetUserCount(warehouse.Id) / @warehouse.MaxUsers</div>
                                        <div class="stat-label">@T.AdminWarehouses_Users</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="stat-box">
                                    <div class="stat-icon text-success">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <div>
                                        <div class="stat-value">@GetProductCount(warehouse.Id)</div>
                                        <div class="stat-label">@T.AdminWarehouses_Products</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="stat-box">
                                    <div class="stat-icon text-info">
                                        <i class="bi bi-door-open"></i>
                                    </div>
                                    <div>
                                        <div class="stat-value">@GetRoomCount(warehouse.Id)</div>
                                        <div class="stat-label">@T.AdminWarehouses_Rooms</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="stat-box">
                                    <div class="stat-icon text-warning">
                                        <i class="bi bi-geo-alt"></i>
                                    </div>
                                    <div>
                                        <div class="stat-value">@GetStorageLocationCount(warehouse.Id)</div>
                                        <div class="stat-label">@T.AdminWarehouses_StorageFacilities</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-@(warehouse.IsActive ? "success" : "secondary")">
                                    <i class="bi @(warehouse.IsActive ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                    @(warehouse.IsActive ? T.AdminWarehouses_Active : T.AdminWarehouses_Inactive)
                                </span>
                                <small class="text-muted">
                                    Erstellt: @warehouse.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="bi bi-building fs-1 text-muted"></i></div>
                        @if (currentUser?.Role == UserRole.SuperAdmin)
                        {
                            <div class="empty-state-title">@T.AdminWarehouses_Empty_NoWarehouses</div>
                            <p>@T.AdminWarehouses_Empty_NoWarehouses_Desc</p>
                            <button class="btn btn-primary" @onclick="OpenCreateModal">
                                <i class="bi bi-plus"></i> @T.AdminWarehouses_Empty_Create
                            </button>
                        }
                        else
                        {
                            <div class="empty-state-title">@T.AdminWarehouses_Empty_NoAssignment</div>
                            <p>@T.AdminWarehouses_Empty_NoAssignment_Desc</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Create/Edit Modal -->
@if (showModal && editingWarehouse != null)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-content modal-content--narrow" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@(editingWarehouse.Id > 0 ? T.AdminWarehouses_Modal_Edit : T.AdminWarehouses_Modal_New)</h3>
                <button class="modal-close" @onclick="CloseModal">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <EditForm Model="editingWarehouse" OnValidSubmit="SaveWarehouse" FormName="WarehouseForm">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="form-label">@T.AdminWarehouses_Modal_Name</label>
                        <InputText class="form-control" @bind-Value="editingWarehouse.Name"
                                   placeholder="z.B. Hauptlager München" />
                        <ValidationMessage For="() => editingWarehouse.Name" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@T.AdminWarehouses_Modal_Code</label>
                        <InputText class="form-control" @bind-Value="editingWarehouse.Code"
                                   placeholder="z.B. MUC001" />
                        <ValidationMessage For="() => editingWarehouse.Code" />
                        @if (codeExists)
                        {
                            <div class="text-danger small mt-1">@T.AdminWarehouses_Modal_CodeExists</div>
                        }
                    </div>

                    <div class="form-group">
                        <label class="form-label">@T.AdminWarehouses_Modal_Desc</label>
                        <InputTextArea class="form-control" @bind-Value="editingWarehouse.Description"
                                       rows="3" placeholder="Optionale Beschreibung..." />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@T.AdminWarehouses_Modal_Address</label>
                        <InputTextArea class="form-control" @bind-Value="editingWarehouse.Address"
                                       rows="2" placeholder="Straße, PLZ Stadt" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">@T.AdminWarehouses_Modal_MaxUsers</label>
                        <InputNumber class="form-control" @bind-Value="editingWarehouse.MaxUsers" min="1" />
                        <small class="text-muted">Wie viele Benutzer dürfen sich in diesem Lager registrieren?</small>
                    </div>

                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="editingWarehouse.IsActive" id="isActive" />
                        <label class="form-check-label" for="isActive">
                            @T.AdminWarehouses_Modal_IsActive
                        </label>
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">@T.AdminWarehouses_Modal_Cancel</button>
                <button class="btn btn-primary" @onclick="SaveWarehouse" disabled="@(codeExists || isSaving)">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check"></i> @T.AdminWarehouses_Modal_Save
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && warehouseToDelete != null)
{
    <div class="modal-backdrop" @onclick="() => showDeleteModal = false">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@T.AdminWarehouses_Delete_Title</h3>
                <button class="modal-close" @onclick="() => showDeleteModal = false">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                @if (GetUserCount(warehouseToDelete.Id) > 0 || GetProductCount(warehouseToDelete.Id) > 0 || GetRoomCount(warehouseToDelete.Id) > 0 || GetStorageLocationCount(warehouseToDelete.Id) > 0)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>@T.AdminWarehouses_Delete_HasData</strong>
                        <br>
                        @T.AdminWarehouses_Delete_HasData_Desc
                        <ul class="mb-0 mt-2">
                            @if (GetUserCount(warehouseToDelete.Id) > 0)
                            {
                                <li>@GetUserCount(warehouseToDelete.Id) Benutzer</li>
                            }
                            @if (GetProductCount(warehouseToDelete.Id) > 0)
                            {
                                <li>@GetProductCount(warehouseToDelete.Id) Produkte</li>
                            }
                            @if (GetRoomCount(warehouseToDelete.Id) > 0)
                            {
                                <li>@GetRoomCount(warehouseToDelete.Id) Räume</li>
                            }
                            @if (GetStorageLocationCount(warehouseToDelete.Id) > 0)
                            {
                                <li>@GetStorageLocationCount(warehouseToDelete.Id) Lagerfächer</li>
                            }
                        </ul>
                        <br>
                        Bitte migrieren Sie diese Daten erst in ein anderes Lager.
                    </div>
                }
                else
                {
                    <p>@T.AdminWarehouses_Delete_Confirm <strong>@warehouseToDelete.Name</strong></p>
                    <p class="text-muted">@T.AdminWarehouses_Delete_Warning</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showDeleteModal = false">@T.AdminWarehouses_Delete_Cancel</button>
                @if (GetUserCount(warehouseToDelete.Id) == 0 && GetProductCount(warehouseToDelete.Id) == 0 && GetRoomCount(warehouseToDelete.Id) == 0 && GetStorageLocationCount(warehouseToDelete.Id) == 0)
                {
                    <button class="btn btn-danger" @onclick="DeleteWarehouse">
                        <i class="bi bi-trash"></i> @T.AdminWarehouses_Delete
                    </button>
                }
            </div>
        </div>
    </div>
}
@code {
    private LagersystemLVHome.I18nText.App T = new();
    private List<Warehouse> warehouses = new();
    private Dictionary<int, int> userCountByWarehouse = new();
    private Dictionary<int, int> productCountByWarehouse = new();
    private Dictionary<int, int> roomCountByWarehouse = new();
    private Dictionary<int, int> storageLocationCountByWarehouse = new();
    private User? currentUser;

    private bool showModal = false;
    private bool showDeleteModal = false;
    private bool codeExists = false;
    private bool isSaving = false;
    private Warehouse? editingWarehouse;
    private Warehouse? warehouseToDelete;

    private string message = string.Empty;
    private bool isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        currentUser = await AuthService.GetCurrentUserAsync();

        if (currentUser?.Role < UserRole.Admin)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        if (currentUser is null) return;

        var view = await WarehouseService.GetAdminViewAsync(currentUser);
        warehouses = view.Warehouses;
        userCountByWarehouse = view.UserCountByWarehouseId;
        productCountByWarehouse = view.ProductCountByWarehouseId;
        roomCountByWarehouse = view.ActiveRoomCountByWarehouseId;
        storageLocationCountByWarehouse = view.ActiveStorageLocationCountByWarehouseId;
    }

    private int GetUserCount(int warehouseId) => userCountByWarehouse.GetValueOrDefault(warehouseId, 0);

    private int GetProductCount(int warehouseId) => productCountByWarehouse.GetValueOrDefault(warehouseId, 0);

    // Count rooms
    private int GetRoomCount(int warehouseId) => roomCountByWarehouse.GetValueOrDefault(warehouseId, 0);

    // Count storage locations
    private int GetStorageLocationCount(int warehouseId) => storageLocationCountByWarehouse.GetValueOrDefault(warehouseId, 0);

    private void OpenCreateModal()
    {
        editingWarehouse = new Warehouse
        {
            IsActive = true,
            MaxUsers = 10,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        };
        codeExists = false;
        showModal = true;
    }

    private void OpenEditModal(Warehouse warehouse)
    {
        editingWarehouse = new Warehouse
        {
            Id = warehouse.Id,
            Name = warehouse.Name,
            Code = warehouse.Code,
            Description = warehouse.Description,
            Address = warehouse.Address,
            MaxUsers = warehouse.MaxUsers,
            IsActive = warehouse.IsActive,
            CreatedAt = warehouse.CreatedAt,
            UpdatedAt = DateTime.UtcNow
        };
        codeExists = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingWarehouse = null;
        codeExists = false;
    }

    private async Task SaveWarehouse()
    {
        if (editingWarehouse == null || string.IsNullOrWhiteSpace(editingWarehouse.Name)) return;

        isSaving = true;
        message = string.Empty;

        try
        {
            if (editingWarehouse.Id > 0)
            {
                var updateResult = await WarehouseService.UpdateWarehouseAsync(editingWarehouse);
                if (updateResult.IsFailure)
                {
                    codeExists = updateResult.ErrorCode == "warehouse.codeexists";
                    if (!codeExists)
                    {
                        message = $"Fehler beim Speichern: {updateResult.ErrorMessage}";
                        isSuccess = false;
                    }
                    isSaving = false;
                    return;
                }

                message = "Lager erfolgreich aktualisiert!";
                isSuccess = true;
            }
            else
            {
                var createResult = await WarehouseService.CreateWarehouseAsync(editingWarehouse);
                if (createResult.IsFailure)
                {
                    codeExists = createResult.ErrorCode == "warehouse.codeexists";
                    if (!codeExists)
                    {
                        message = $"Fehler beim Speichern: {createResult.ErrorMessage}";
                        isSuccess = false;
                    }
                    isSaving = false;
                    return;
                }

                message = "Lager erfolgreich erstellt!";
                isSuccess = true;
            }

            await LoadData();
            CloseModal();
        }
        catch (Exception ex)
        {
            message = $"Fehler beim Speichern: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleActive(Warehouse warehouse)
    {
        var result = await WarehouseService.SetWarehouseActiveAsync(warehouse.Id, !warehouse.IsActive);
        if (result.IsFailure)
        {
            message = $"Fehler: {result.ErrorMessage}";
            isSuccess = false;
            return;
        }
        message = $"Lager {warehouse.Name} wurde {(!warehouse.IsActive ? "aktiviert" : "deaktiviert")}.";
        isSuccess = true;
        await LoadData();
    }

    private void ConfirmDelete(Warehouse warehouse)
    {
        warehouseToDelete = warehouse;
        showDeleteModal = true;
    }

    private void ViewWarehouseDetails(Warehouse warehouse)
    {
        // Admins can only view details of their own warehouse
        message = $"Lager: {warehouse.Name} ({warehouse.Code})";
        isSuccess = true;
    }

    private async Task DeleteWarehouse()
    {
        if (warehouseToDelete != null)
        {
            var result = await WarehouseService.DeleteWarehouseAsync(warehouseToDelete.Id);
            if (result.IsSuccess)
            {
                message = $"Lager {warehouseToDelete.Name} wurde gelöscht.";
                isSuccess = true;
                await LoadData();
            }
            else
            {
                message = $"Fehler beim Löschen: {result.ErrorMessage}";
                isSuccess = false;
            }
        }
        showDeleteModal = false;
        warehouseToDelete = null;
    }
}
