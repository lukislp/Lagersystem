                                </div>
                                <button class="btn btn-sm btn-warning" @onclick="() => ShowRevokeFingerprintModal()">
                                    <i class="bi bi-shield-x me-1"></i>
                                    Widerrufen
                                </button>
                            }
                            else
                            {
                                <p class="text-danger small mb-1">
                                    Nicht erteilt
                                </p>
                                <div class="alert alert-warning small mb-0">
                                    Ohne Device Fingerprinting sind erweiterte Sicherheits-Features deaktiviert.
                                    Login nur möglich nach erneuter Zustimmung.
                                </div>
                            }
                        </div>
                    </div>

                    <hr>

                    <!-- DSGVO-Aktionen -->
                    <h6 class="mb-3">Ihre Datenrechte</h6>
                    <div class="row g-3">
                        <!-- Export data -->
                        <div class="col-md-6">
                            <div class="card bg-light h-100">
                                <div class="card-body">
                                    <h6><i class="bi bi-download me-2"></i>Daten exportieren</h6>
                                    <p class="small text-muted">
                                        Laden Sie alle Ihre Daten als JSON herunter
