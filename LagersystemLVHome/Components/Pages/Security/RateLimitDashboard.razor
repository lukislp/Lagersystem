@page "/admin/rate-limits"
@using LagersystemLVHome.Application.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject IRateLimitService RateLimitService
@inject ILogger<RateLimitDashboard> Logger
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject I18nText I18nText
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>@T.RateLimit_Title - LagerSystem</PageTitle>

<!-- INLINE CSS (Dashboard-spezifisch) -->

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-speedometer2 text-primary me-2"></i>
                @T.RateLimit_Title
            </h1>
            <p class="text-muted mb-0">
                @T.RateLimit_Subtitle
                <span class="badge bg-success ms-2" title="Auto-refresh alle 5 Sekunden">
                    <i class="bi bi-arrow-clockwise @(loading ? "spin" : "")"></i> @T.RateLimit_AutoRefresh
                </span>
            </p>
        </div>
        <button class="btn btn-primary" @onclick="RefreshData" disabled="@loading">
            <i class="bi bi-arrow-clockwise me-2 @(loading ? "spin" : "")"></i>
            @(loading ? T.RateLimit_Loading : T.RateLimit_Refresh)
        </button>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">@T.RateLimit_KPI_Active</h6>
                            <h3 class="mb-0">@stats.ActiveBuckets</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-activity text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">@T.RateLimit_KPI_Total</h6>
                            <h3 class="mb-0">@stats.TotalRequests.ToString("N0")</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-graph-up text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">@T.RateLimit_KPI_Blocked</h6>
                            <h3 class="mb-0 text-danger">@stats.BlockedRequests.ToString("N0")</h3>
                        </div>
                        <div class="bg-danger bg-opacity-10 p-3 rounded">
                            <i class="bi bi-shield-x text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">@T.RateLimit_KPI_Rate</h6>
                            <h3 class="mb-0">@((stats.TotalRequests > 0 ? (double)stats.BlockedRequests / stats.TotalRequests * 100 : 0).ToString("F1"))%</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-exclamation-triangle text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="nav-tabs-wrapper mb-4">
        <ul class="nav nav-tabs border-bottom-0" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "limits" ? "active" : "")" @onclick='() => SetActiveTab("limits")' type="button">
                    <i class="bi bi-speedometer2 me-2"></i>@T.RateLimit_Tab_Limits
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "violations" ? "active" : "")" @onclick='() => SetActiveTab("violations")' type="button">
                    <i class="bi bi-exclamation-circle me-2"></i>@T.RateLimit_Tab_Violations
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "traffic" ? "active" : "")" @onclick='() => SetActiveTab("traffic")' type="button">
                    <i class="bi bi-activity me-2"></i>@T.RateLimit_Tab_Traffic
                    <span class="badge bg-success ms-2">@recentRequests.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "config" ? "active" : "")" @onclick='() => SetActiveTab("config")' type="button">
                    <i class="bi bi-gear me-2"></i>@T.RateLimit_Tab_Config
                </button>
            </li>
        </ul>
    </div>

    <!-- Rate Limits Tab -->
    @if (activeTab == "limits")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent">
                <h5 class="mb-0">
                    <i class="bi bi-table text-primary me-2"></i>
                    @T.RateLimit_Limits_Title
                </h5>
            </div>
            <div class="card-body">
                @if (loading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (activeLimits.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>@T.RateLimit_Limits_Identifier</th>
                                    <th>@T.RateLimit_Limits_Endpoint</th>
                                    <th>@T.RateLimit_Limits_Remaining</th>
                                    <th>@T.RateLimit_Limits_Window</th>
                                    <th>@T.RateLimit_Limits_Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var limit in activeLimits)
                                {
                                    <tr>
                                        <td>
                                            <code class="text-primary">@GetDisplayIdentifier(limit.Identifier)</code>
                                        </td>
                                        <td><code>@limit.Endpoint</code></td>
                                        <td>
                                            <span class="badge @GetRemainingClass(limit.RemainingRequests)">
                                                @limit.RemainingRequests
                                            </span>
                                        </td>
                                        <td>
                                            <small class="text-muted">@FormatTimeSpan(limit.WindowResetsIn)</small>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => ResetLimit(limit.Identifier)">
                                                <i class="bi bi-arrow-clockwise"></i> @T.RateLimit_Limits_Reset
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        <p>@T.RateLimit_Limits_Empty</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Violations Tab -->
    @if (activeTab == "violations")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-circle text-danger me-2"></i>
                    @T.RateLimit_Violations_Title
                </h5>
            </div>
            <div class="card-body">
                @if (loading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (violations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>@T.RateLimit_Violations_Timestamp</th>
                                    <th>@T.RateLimit_Violations_IP</th>
                                    <th>@T.RateLimit_Violations_Endpoint</th>
                                    <th>@T.RateLimit_Violations_Requests</th>
                                    <th>@T.RateLimit_Violations_Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var violation in violations.Take(50))
                                {
                                    <tr>
                                        <td>
                                            <small class="text-muted">@violation.Timestamp?.ToString("dd.MM.yyyy HH:mm:ss")</small>
                                        </td>
                                        <td><code>@GetDisplayIdentifier(violation.IpAddress)</code></td>
                                        <td>
                                            <code>@violation.Endpoint</code>
                                        </td>
                                        <td>
                                            <span class="badge bg-danger">@violation.RequestCount</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-warning text-dark">@T.RateLimit_Violations_Blocked</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check-circle fs-1 d-block mb-3"></i>
                        <p>@T.RateLimit_Violations_Empty</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Live Traffic Tab -->
    @if (activeTab == "traffic")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-activity text-success me-2"></i>
                    @T.RateLimit_Traffic_Title
                </h5>
                <div>
                    <span class="badge bg-success">
                        <i class="bi bi-circle-fill blink me-1" style="font-size: 0.6rem;"></i>
                        Live
                    </span>
                    <span class="badge bg-secondary ms-2">
                        @T.RateLimit_Traffic_MaxRequests
                    </span>
                </div>
            </div>
            <div class="card-body">
                @if (loading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (recentRequests.Any())
                {
                    <!-- Filter Controls -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <label class="form-label small">@T.RateLimit_Traffic_StatusFilter</label>
                            <select class="form-select form-select-sm" @bind="trafficStatusFilter">
                                <option value="all">@T.RateLimit_Traffic_All</option>
                                <option value="success">@T.RateLimit_Traffic_OnlySuccess</option>
                                <option value="blocked">@T.RateLimit_Traffic_OnlyBlocked</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">@T.RateLimit_Traffic_EndpointFilter</label>
                            <select class="form-select form-select-sm" @bind="trafficEndpointFilter">
                                <option value="">@T.RateLimit_Traffic_AllEndpoints</option>
                                @foreach (var endpoint in GetUniqueEndpoints())
                                {
                                    <option value="@endpoint">@endpoint</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">@T.RateLimit_Traffic_IdentifierFilter</label>
                            <select class="form-select form-select-sm" @bind="trafficIdentifierFilter">
                                <option value="">@T.RateLimit_Traffic_AllIPs</option>
                                @foreach (var identifier in GetUniqueIdentifiers())
                                {
                                    <option value="@identifier">@GetDisplayIdentifier(identifier)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Traffic Statistics Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-lg-2 col-md-4">
                            <div class="stat-box bg-success bg-opacity-10">
                                <div class="stat-value text-success">@GetFilteredRequests().Count(r => r.IsSuccess)</div>
                                <div class="stat-label">@T.RateLimit_Traffic_Success</div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <div class="stat-box bg-danger bg-opacity-10">
                                <div class="stat-value text-danger">@GetFilteredRequests().Count(r => !r.IsSuccess)</div>
                                <div class="stat-label">@T.RateLimit_Traffic_Blocked</div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <div class="stat-box bg-primary bg-opacity-10">
                                <div class="stat-value text-primary">@GetFilteredRequests().Select(r => r.Identifier).Distinct().Count()</div>
                                <div class="stat-label">@T.RateLimit_Traffic_UniqueIPs</div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <div class="stat-box bg-warning bg-opacity-10">
                                <div class="stat-value text-warning">@GetFilteredRequests().Select(r => r.Endpoint).Distinct().Count()</div>
                                <div class="stat-label">@T.RateLimit_Traffic_Endpoints</div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <div class="stat-box bg-info bg-opacity-10">
                                <div class="stat-value text-info">@CalculateAverageRequestCount()</div>
                                <div class="stat-label">@T.RateLimit_Traffic_AvgRequests</div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <div class="stat-box bg-secondary bg-opacity-10">
                                <div class="stat-value text-secondary">@CalculateBlockRate()%</div>
                                <div class="stat-label">@T.RateLimit_Traffic_BlockRate</div>
                            </div>
                        </div>
                    </div>

                    <!-- Top IPs and Endpoints -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        <i class="bi bi-bar-chart text-primary me-2"></i>
                                        @T.RateLimit_Traffic_Top5IPs
                                    </h6>
                                </div>
                                <div class="card-body p-3">
                                    @foreach (var item in GetTopIdentifiers(5))
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <code class="small">@GetDisplayIdentifier(item.Identifier)</code>
                                                @* Geo-location display *@
                                                @if (TryGetGeoInfo(item.Identifier, out var country, out var city))
                                                {
                                                    <div class="text-muted small mt-1">
                                                        <i class="bi bi-geo-alt-fill"></i>
                                                        @if (!string.IsNullOrEmpty(city))
                                                        {
                                                            <text>@city, @country</text>
                                                        }
                                                        else
                                                        {
                                                            <text>@country</text>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div>
                                                <span class="badge bg-primary">@item.Count Requests</span>
                                                @if (item.BlockedCount > 0)
                                                {
                                                    <span class="badge bg-danger ms-1">@item.BlockedCount Blocked</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        <i class="bi bi-graph-up text-warning me-2"></i>
                                        @T.RateLimit_Traffic_Top5Endpoints
                                    </h6>
                                </div>
                                <div class="card-body p-3">
                                    @foreach (var item in GetTopEndpoints(5))
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <code class="small">@item.Endpoint</code>
                                            </div>
                                            <div>
                                                <span class="badge bg-warning">@item.Count Requests</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Geo-location cards -->
                    @if (GetTopCountries().Any() || GetTopCities().Any())
                    {
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0">
                                            <i class="bi bi-globe text-success me-2"></i>
                                                            @T.RateLimit_Traffic_Top5Countries
                                                        </h6>
                                                    </div>
                                                    <div class="card-body p-3">
                                                        @foreach (var item in GetTopCountries().Take(5))
                                                        {
                                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                                <div>
                                                                    <span class="me-2">@GetCountryFlag(item.CountryCode)</span>
                                                                    <strong>@item.Country</strong>
                                                                </div>
                                                                <div>
                                                                    <span class="badge bg-success">@item.Count Requests</span>
                                                                    @if (item.BlockedCount > 0)
                                                                    {
                                                                        <span class="badge bg-danger ms-1">@item.BlockedCount Blocked</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (!GetTopCountries().Any())
                                                        {
                                                            <p class="text-muted text-center mb-0 small">@T.RateLimit_Traffic_NoGeoData</p>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="card border-0 shadow-sm">
                                                    <div class="card-header bg-light">
                                                        <h6 class="mb-0">
                                                            <i class="bi bi-geo-fill text-info me-2"></i>
                                                            @T.RateLimit_Traffic_Top5Cities
                                                        </h6>
                                                    </div>
                                                    <div class="card-body p-3">
                                                        @foreach (var item in GetTopCities().Take(5))
                                                        {
                                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                                <div>
                                                                    <i class="bi bi-pin-map-fill text-muted me-1"></i>
                                                                    <strong>@item.City</strong>
                                                                    <small class="text-muted">(@item.Country)</small>
                                                                </div>
                                                                <div>
                                                                    <span class="badge bg-info">@item.Count Requests</span>
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (!GetTopCities().Any())
                                                        {
                                                            <p class="text-muted text-center mb-0 small">@T.RateLimit_Traffic_NoCityData</p>
                                                        }
                                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Traffic Table -->
                    <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th style="width: 120px;">
                                        <i class="bi bi-clock me-1"></i>@T.RateLimit_Traffic_Time
                                    </th>
                                    <th style="width: 200px;">
                                        <i class="bi bi-person me-1"></i>Identifier
                                    </th>
                                    <th style="width: 80px;" class="text-center">
                                        <i class="bi bi-globe me-1"></i>@T.RateLimit_Traffic_Land
                                    </th>
                                    <th>
                                        <i class="bi bi-link-45deg me-1"></i>Endpoint
                                    </th>
                                    <th style="width: 100px;">
                                        <i class="bi bi-check-circle me-1"></i>@T.RateLimit_Traffic_Status
                                    </th>
                                    <th style="width: 100px;">
                                        <i class="bi bi-bar-chart me-1"></i>@T.RateLimit_Traffic_Count
                                    </th>
                                    <th style="width: 120px;">
                                        <i class="bi bi-speedometer2 me-1"></i>@T.RateLimit_Traffic_Activity
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in GetFilteredRequests().Take(500))
                                {
                                    <tr class="@(request.IsSuccess ? "" : "table-danger")">
                                        <td>
                                            <small class="text-muted">
                                                @request.Timestamp.ToString("HH:mm:ss")
                                            </small>
                                            <br />
                                            <small class="text-muted" style="font-size: 0.7rem;">
                                                @GetTimeAgo(request.Timestamp)
                                            </small>
                                        </td>
                                        <td>
                                            <code class="small">@GetDisplayIdentifier(request.Identifier)</code>
                                        </td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(request.Country))
                                            {
                                                var tooltipText = request.Country;
                                                if (!string.IsNullOrEmpty(request.City))
                                                {
                                                    tooltipText += $" - {request.City}";
                                                }
                                                <span class="flag-emoji" title="@tooltipText">
                                                    @GetCountryFlag(request.CountryCode)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted" title="@T.RateLimit_NoGeoData">—</span>
                                            }
                                        </td>
                                        <td>
                                            <code class="small">@request.Endpoint</code>
                                        </td>
                                        <td>
                                            @if (request.IsSuccess)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> 200 OK
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle"></i> 429 Blocked
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @GetRequestCountBadgeClass(request.RequestCount)">
                                                @request.RequestCount
                                            </span>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar @GetActivityBarClass(request.RequestCount)"
                                                     role="progressbar"
                                                     style="width: @GetActivityPercentage(request.RequestCount)%"
                                                     aria-valuenow="@request.RequestCount"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                    @GetActivityPercentage(request.RequestCount)%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Export Button -->
                    <div class="mt-3 text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="ExportTrafficData">
                            <i class="bi bi-download me-1"></i>
                            @T.RateLimit_Traffic_Export
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-activity fs-1 d-block mb-3"></i>
                        <p>@T.RateLimit_Traffic_Waiting</p>
                        <small>@T.RateLimit_Traffic_WaitingHint</small>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Configuration Tab -->
    @if (activeTab == "config")
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent">
                <h5 class="mb-0">
                    <i class="bi bi-gear text-primary me-2"></i>
                    @T.RateLimit_Config_Title
                </h5>
            </div>
            <div class="card-body">
                <!-- Modern configuration display -->
                <div class="row g-4 mb-4">
                    <!-- Anonymous Users -->
                    <div class="col-lg-6">
                        <div class="config-card">
                            <div class="config-header">
                                <div class="config-icon bg-secondary bg-opacity-10">
                                    <i class="bi bi-person text-secondary fs-4"></i>
                                </div>
