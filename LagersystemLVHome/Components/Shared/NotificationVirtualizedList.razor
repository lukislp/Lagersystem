@using LagersystemLVHome.Domain.Models
@inject I18nText I18nText

<VirtualizedList TItem="Notification"
                 Items="@Notifications"
                 ItemSize="120"
                 Height="calc(100vh - 400px)"
                 OverscanCount="3">
    <ItemTemplate Context="notification">
        <div class="notification-card @(notification.IsRead ? "read" : "unread") @GetTypeClass(notification.Type)"
             @onclick="() => OnNotificationClick.InvokeAsync(notification)">
      
            <div class="notification-icon">
                <i class="bi @GetIcon(notification.Type)"></i>
            </div>
   
            <div class="notification-content">
                <div class="notification-header">
                    <h5 class="notification-title">@notification.Title</h5>
                    <small class="notification-time">@GetRelativeTime(notification.CreatedAt)</small>
                </div>
                <p class="notification-message">@notification.Message</p>
                @if (!string.IsNullOrEmpty(notification.ActionUrl))
                {
                    <a href="@notification.ActionUrl" class="btn btn-sm btn-primary mt-2" @onclick:stopPropagation="true">
                        <i class="bi bi-box-arrow-up-right"></i> @(T.NotificationVirtualizedList_Open ?? "Öffnen")
                    </a>
                }
            </div>
     
            <div class="notification-actions">
                @if (!notification.IsRead)
                {
                    <button class="btn btn-sm btn-icon btn-outline-secondary"
                            @onclick="() => OnMarkAsRead.InvokeAsync(notification.Id)"
                            @onclick:stopPropagation="true"
                            title="@(T.NotificationVirtualizedList_MarkRead ?? "Als gelesen markieren")">
                        <i class="bi bi-check"></i>
                    </button>
                }
                <button class="btn btn-sm btn-icon btn-outline-danger"
                        @onclick="() => OnDelete.InvokeAsync(notification.Id)"
                        @onclick:stopPropagation="true"
                        title="@(T.NotificationVirtualizedList_Delete ?? "Löschen")">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>
    </ItemTemplate>
    
    <PlaceholderTemplate>
        <div class="notification-card skeleton">
            <div class="skeleton-icon"></div>
            <div class="notification-content">
                <div class="skeleton-line"></div>
                <div class="skeleton-line short"></div>
            </div>
        </div>
    </PlaceholderTemplate>
    
    <EmptyTemplate>
        <EmptyState IconClass="bi bi-bell-slash"
                    Title="Keine Benachrichtigungen"
                    Description="Sie haben noch keine Benachrichtigungen erhalten"
                    AdditionalClass="compact" />
    </EmptyTemplate>
</VirtualizedList>

@code {
    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    [Parameter, EditorRequired]
    public List<Notification> Notifications { get; set; } = new();

    [Parameter]
    public EventCallback<Notification> OnNotificationClick { get; set; }

    [Parameter]
    public EventCallback<int> OnMarkAsRead { get; set; }

    [Parameter]
    public EventCallback<int> OnDelete { get; set; }

    private string GetTypeClass(NotificationType type) =>
            type.ToString().ToLower();

    private string GetIcon(NotificationType type) =>
    type switch
    {
        NotificationType.LowStock => "bi-box-seam",
        NotificationType.CriticalStock => "bi-exclamation-triangle-fill",
        NotificationType.NewUser => "bi-person-plus-fill",
        NotificationType.SecurityAlert => "bi-shield-exclamation",
        NotificationType.Success => "bi-check-circle-fill",
        NotificationType.Error => "bi-x-circle-fill",
        NotificationType.Warning => "bi-exclamation-triangle-fill",
        NotificationType.Info => "bi-info-circle-fill",
        NotificationType.SystemUpdate => "bi-arrow-repeat",
        _ => "bi-bell-fill"
    };

    private string GetRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;

        if (timeSpan.TotalMinutes < 1) return "Gerade eben";
        if (timeSpan.TotalMinutes < 60) return $"vor {(int)timeSpan.TotalMinutes} Min.";
        if (timeSpan.TotalHours < 24) return $"vor {(int)timeSpan.TotalHours} Std.";
        if (timeSpan.TotalDays < 7) return $"vor {(int)timeSpan.TotalDays} Tagen";

        return dateTime.ToString("dd.MM.yyyy HH:mm");
    }
}
