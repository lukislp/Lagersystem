@page "/storage/new"
@inherits CancellableComponentBase
@using LagersystemLVHome.Application.Services
@using LagersystemLVHome.Domain.Models
@using LagersystemLVHome.Data
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject StorageLocationService StorageLocationService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IQRCodeService QRCodeService
@inject ILocationQueryService LocationQueryService
@inject I18nText I18nText
@rendermode InteractiveServer

<PageTitle>@T.NewStorageLocation_PageTitle</PageTitle>

<div class="container-fluid">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laden...</span>
            </div>
            <p class="mt-3 text-muted">@T.NewStorageLocation_Loading</p>
        </div>
    }
    else if (newLocationData != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-geo-alt-fill"></i>
                            @T.NewStorageLocation_CardTitle
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle"></i>
                                @errorMessage
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success">
                                <i class="bi bi-check-circle"></i>
                                @successMessage
                            </div>
                        }

                        @if (!alreadyExists && string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-info mb-4">
                                <i class="bi bi-info-circle"></i>
                                <strong>@T.NewStorageLocation_QRScanned</strong>
                                <br />
                                @T.NewStorageLocation_QRScanned_Desc
                            </div>

                            <EditForm Model="newLocation" OnValidSubmit="CreateStorageLocation" FormName="NewLocationForm">
                                <DataAnnotationsValidator />

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">@T.NewStorageLocation_Code</label>
                                            <InputText class="form-control" @bind-Value="newLocation.Code" disabled />
                                            <ValidationMessage For="() => newLocation.Code" />
                                            <small class="form-text text-muted">@T.NewStorageLocation_Code_FromQR</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">@T.NewStorageLocation_Name</label>
                                    <InputText class="form-control" @bind-Value="newLocation.Name"
                                               placeholder="z.B. Gang 1, Regal 1, Fach 3" />
                                    <ValidationMessage For="() => newLocation.Name" />
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Gang</label>
                                            <InputText class="form-control" @bind-Value="newLocation.Aisle"
                                                       placeholder="z.B. Gang 1" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Raum</label>
                                            <InputSelect class="form-select" @bind-Value="newLocation.Room">
                                                <option value="">-- Optional --</option>
                                                @foreach (var room in rooms)
                                                {
                                                    <option value="@room.Name">@room.Name</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Beschreibung</label>
                                    <InputTextArea class="form-control" @bind-Value="newLocation.Description"
                                                   rows="3" placeholder="Optionale Beschreibung..." />
                                </div>

                                <div class="form-check mb-3">
                                    <InputCheckbox class="form-check-input" @bind-Value="newLocation.IsActive" id="isActive" />
                                    <label class="form-check-label" for="isActive">
                                        Lagerplatz ist aktiv
                                    </label>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                        @if (isSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="bi bi-check"></i>
                                        @T.NewStorageLocation_Create
                                    </button>
                                    <button type="button" class="btn btn-secondary" @onclick="Cancel">
                                        <i class="bi bi-x"></i>
                                        @T.NewStorageLocation_Cancel
                                    </button>
                                </div>
                            </EditForm>
                        }
                        else if (alreadyExists)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i>
                                <strong>Lagerplatz existiert bereits!</strong>
                                <br />
                                Ein Lagerplatz mit dem Code <strong>@newLocationData.Code</strong> existiert bereits.
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/storage/@existingLocationId" class="btn btn-primary">
                                    <i class="bi bi-eye"></i>
                                    Lagerplatz anzeigen
                                </a>
                                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                                    <i class="bi bi-arrow-left"></i>
                                    Zurück
                                </button>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="d-flex gap-2">
                                <a href="/storage/@createdLocationId" class="btn btn-primary">
                                    <i class="bi bi-eye"></i>
                                    Lagerplatz anzeigen
                                </a>
                                <a href="/storage" class="btn btn-secondary">
                                    <i class="bi bi-list"></i>
                                    Alle Lagerplätze
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- QR Code Preview -->
                @if (!string.IsNullOrEmpty(qrCodePreview) && string.IsNullOrEmpty(successMessage))
                {
                    <div class="card shadow-sm mt-4">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="bi bi-qr-code"></i>
                                Gescannter QR-Code
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            <img src="data:image/png;base64,@qrCodePreview"
                                 alt="QR Code"
                                 style="max-width: 300px; border: 1px solid #ddd; padding: 10px;" />
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>Fehler!</strong>
            <br />
            Keine gültigen QR-Code-Daten gefunden. Bitte scannen Sie einen gültigen QR-Code.
        </div>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">
            <i class="bi bi-arrow-left"></i>
            Zurück zum QR-Code Generator
        </button>
    }
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    [SupplyParameterFromQuery(Name = "data")]
    public string? EncodedData { get; set; }

    private NewLocationData? newLocationData;
    private StorageLocation newLocation = new();
    private List<Room> rooms = new();
    private User? currentUser;

    private bool isLoading = true;
    private bool isSaving = false;
    private bool alreadyExists = false;
    private int existingLocationId = 0;
    private int createdLocationId = 0;

    private string? errorMessage;
    private string? successMessage;
    private string? qrCodePreview;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadRooms();
        await ParseQRCodeData();
        isLoading = false;
    }

    private async Task LoadRooms()
    {
        var result = await LocationQueryService.GetActiveRoomsForWarehouseAsync(currentUser!.WarehouseId);
        rooms = result.ToList();
    }

    private async Task ParseQRCodeData()
    {
        if (string.IsNullOrWhiteSpace(EncodedData))
        {
            errorMessage = "Keine QR-Code-Daten vorhanden.";
            return;
        }

        try
        {
            // Decode Base64
            var jsonBytes = Convert.FromBase64String(EncodedData);
            var jsonString = System.Text.Encoding.UTF8.GetString(jsonBytes);

            // Parse JSON
            newLocationData = JsonSerializer.Deserialize<NewLocationData>(jsonString);

            if (newLocationData == null || string.IsNullOrWhiteSpace(newLocationData.Code))
            {
                errorMessage = T.NewStorage_InvalidQR ?? "Ungültige QR-Code-Daten.";
                return;
            }

            // Check if location already exists
            var existing = await StorageLocationService.GetByCodeAsync(newLocationData.Code);
            if (existing != null)
            {
                alreadyExists = true;
                existingLocationId = existing.Id;
                return;
            }

            // Initialize new location with data from QR code
            newLocation = new StorageLocation
            {
                Code = newLocationData.Code,
                Name = newLocationData.Name ?? string.Empty,
                Aisle = newLocationData.Aisle ?? string.Empty,
                IsActive = true,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow,
                WarehouseId = currentUser!.WarehouseId
            };

            // Set room if provided
            if (newLocationData.RoomId.HasValue && newLocationData.RoomId.Value > 0)
            {
                var room = rooms.FirstOrDefault(r => r.Id == newLocationData.RoomId.Value);
                if (room != null)
                {
                    newLocation.Room = room.Name;
                }
            }

            // Generate QR code preview
            var baseUrl = new Uri(NavigationManager.Uri);
            var qrContent = $"{baseUrl.Scheme}://{baseUrl.Authority}/storage/new?data={EncodedData}";
            qrCodePreview = QRCodeService.GenerateQRCode(qrContent, 300);
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Parsen der QR-Code-Daten: {ex.Message}";
        }
    }

    private async Task CreateStorageLocation()
    {
        if (newLocation == null) return;

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            // Validate required fields
            if (string.IsNullOrWhiteSpace(newLocation.Code) || string.IsNullOrWhiteSpace(newLocation.Name))
            {
                errorMessage = "Code und Name sind Pflichtfelder.";
                isSaving = false;
                return;
            }

            // Check again if code exists
            var exists = await StorageLocationService.CodeExistsAsync(newLocation.Code);
            if (exists)
            {
                errorMessage = "Ein Lagerplatz mit diesem Code existiert bereits.";
                isSaving = false;
                return;
            }

            // Create storage location
            var created = await StorageLocationService.CreateAsync(newLocation);
            createdLocationId = created.Id;

            successMessage = $"Lagerplatz '{created.Code}' wurde erfolgreich erstellt!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Erstellen: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/qr-generator");
    }

    private class NewLocationData
    {
        public string Code { get; set; } = string.Empty;
        public string? Name { get; set; }
        public string? Aisle { get; set; }
        public int? RoomId { get; set; }
    }
}
