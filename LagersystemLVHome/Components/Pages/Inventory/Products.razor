@page "/products"
@page "/products/new"
@inherits CancellableComponentBase
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject LagersystemLVHome.Application.Services.IInventoryService InventoryService
@inject LagersystemLVHome.Application.Services.ILocationQueryService LocationQueryService
@inject NavigationManager NavigationManager
@inject LagersystemLVHome.Application.Services.IImageService ImageService
@inject LagersystemLVHome.Application.Services.IExpiryService ExpiryService
@inject LagersystemLVHome.Application.Services.IPriceHistoryService PriceHistoryService
@inject ILogger<Products> Logger
@inject LagersystemLVHome.Application.Services.IAuthService AuthService
@inject I18nText I18nText

<PageTitle>@T.Products_PageTitle</PageTitle>

<div class="page-header d-flex justify-content-between align-items-start">
    <div>
        <h1 class="page-title">@T.Products_Title</h1>
        <p class="page-subtitle">@(T.Products_Subtitle != null ? string.Format(T.Products_Subtitle, filteredProducts.Count) : "")</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <i class="bi bi-plus"></i> @T.Products_NewProduct
    </button>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="form-group mb-0">
                    <label class="form-label">@T.Products_FilterLabel_Search</label>
                    <input type="text" class="form-control" placeholder="@T.Common_Placeholder_Barcode"
                           @bind="searchTerm" @bind:event="oninput" @bind:after="FilterProducts" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group mb-0">
                    <label class="form-label">@T.Products_FilterLabel_Category</label>
                    <select class="form-select" @bind="selectedCategoryId" @bind:after="FilterProducts">
                        <option value="0">@T.Products_Filter_AllCategories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Icon @cat.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group mb-0">
                    <label class="form-label">@T.Products_FilterLabel_Stock</label>
                    <select class="form-select" @bind="stockFilter" @bind:after="FilterProducts">
                        <option value="all">@T.Products_Filter_All</option>
                        <option value="low">@T.Products_Filter_LowStock</option>
                        <option value="out">@T.Products_Filter_OutOfStock</option>
                        <option value="ok">@T.Products_Filter_Sufficient</option>
                        <option value="expired">@T.Products_Filter_Expired</option>
                        <option value="expiring">@T.Products_Filter_ExpiringSoon</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-secondary w-100" @onclick="ClearFilters">
                    <i class="bi bi-x-circle"></i> @T.Common_ClearFilter
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (filteredProducts.Any())
        {
            <ProductVirtualizedList Products="@filteredProducts"
                                    PriceHistoryCounts="@priceHistoryCounts"
                                    OnCreateProduct="OpenCreateModal"
                                    OnEditProduct="OpenEditModal"
                                    OnDeleteProduct="ConfirmDelete"
                                    OnNavigateToPriceHistory="NavigateToPriceHistory" />
        }
        else
        {
            <div class="p-4">
                <EmptyState IconClass="bi bi-inbox"
                            Title="@T.Products_EmptyTitle"
                            Description="@T.Products_EmptyDesc"
                            ShowAction="true"
                            ActionText="@T.Products_CreateAction"
                            ActionIcon="bi bi-plus"
                            OnActionClick="OpenCreateModal" />
            </div>
        }
    </div>
</div>

<!-- Create/Edit Modal -->
@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-content modal-content--narrow" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@(editingProduct?.Id > 0 ? T.Products_ModalEdit : T.Products_ModalCreate)</h3>
                <button class="modal-close" @onclick="CloseModal">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <EditForm Model="editingProduct" OnValidSubmit="SaveProduct">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="form-label">@T.Products_Label_Name</label>
                        <InputText class="form-control" @bind-Value="editingProduct!.Name" placeholder="@T.Products_Placeholder_Name" />
                        <ValidationMessage For="() => editingProduct.Name" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            @T.Products_Label_Barcode
                            <span class="text-danger small">@T.Products_Label_Barcode_Hint</span>
                        </label>
                        <BarcodeInputField @bind-Value="editingProduct!.Barcode"
                                           Placeholder="EAN, QR-Code, etc. (erforderlich)"
                                           AutoStopAfterScan="true" />

                        @{
                            if (string.IsNullOrWhiteSpace(editingProduct.Barcode))
                            {
                                <div class="text-danger small mt-1">
                                    <i class="bi bi-exclamation-triangle"></i> @T.Products_Barcode_Required
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(editingProduct.Barcode) && !string.IsNullOrEmpty(editingProduct.Name))
                            {
                                var existingProduct = allProducts.FirstOrDefault(p =>
                                    p.Barcode.Equals(editingProduct.Barcode, StringComparison.OrdinalIgnoreCase) &&
                                    p.Name.Equals(editingProduct.Name, StringComparison.OrdinalIgnoreCase) &&
                                    p.Id != editingProduct.Id);

                                if (existingProduct != null)
                                {
                                    <div class="alert alert-danger mt-2 py-2">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        <strong>Kombination bereits vergeben!</strong><br />
                                        <small>Ein Produkt mit Barcode "@editingProduct.Barcode" und Name "@editingProduct.Name" existiert bereits.</small>
                                    </div>
                                }
                                else
                                {
                                    var sameBarcode = allProducts.FirstOrDefault(p =>
                                        p.Barcode.Equals(editingProduct.Barcode, StringComparison.OrdinalIgnoreCase) &&
                                        p.Id != editingProduct.Id);

                                    if (sameBarcode != null)
                                    {
                                        <div class="alert alert-warning mt-2 py-2">
                                            <i class="bi bi-info-circle me-2"></i>
                                            <strong>Hinweis:</strong> Dieser Barcode wird bereits für "@sameBarcode.Name" verwendet.<br />
                                            <small>Verschiedene Produktvarianten können den gleichen Barcode haben (z.B. unterschiedliche Größen).</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-success small mt-1">
                                            <i class="bi bi-check-circle"></i> @T.Products_Barcode_Available
                                        </div>
                                    }
                                }
                            }
                        }
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label class="form-label">
                                    @T.Products_Label_Category
                                    <CategorySuggestionButton ProductName="@editingProduct.Name"
                                                              SelectedCategoryId="@editingProduct.CategoryId"
                                                              OnCategorySelected="@HandleCategorySelected"
                                                              ButtonText="KI-Vorschläge"
                                                              ButtonClass="btn-outline-primary btn-sm ms-2" />
                                </label>
                                <InputSelect class="form-select" @bind-Value="editingProduct.CategoryId">
                                    <option value="0">-- Wählen --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </InputSelect>
                                @if (editingProduct.CategoryId > 0)
                                {
                                    var selectedCategory = categories.FirstOrDefault(c => c.Id == editingProduct.CategoryId);
                                    if (selectedCategory != null)
                                    {
                                        <div class="mt-2 d-flex align-items-center gap-2">
                                            <CategoryIcon IconClass="@selectedCategory.Icon" />
                                            <small class="text-muted">@selectedCategory.Name</small>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Storage location multi-select -->
                    <div class="form-group">
                        <StorageLocationMultiSelect Label="Lagerfächer zuweisen"
                                                    @bind-SelectedStorageLocations="selectedStorageLocations"
                                                    AvailableStorageLocations="@allStorageLocations"
                                                    OnQuantityChanged="@(() => StateHasChanged())" />
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <div class="form-group">
                                <label class="form-label">@T.Products_Label_TotalStock</label>
                                <input type="number" class="form-control" value="@GetTotalQuantity()" disabled />
                                <small class="text-muted">@T.Products_StorageTotal_Hint</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group">
                                <label class="form-label">@T.Products_Label_MinStock</label>
                                <InputNumber class="form-control" @bind-Value="editingProduct.MinQuantity" />
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group">
                                <label class="form-label">@T.Products_Label_Price</label>
                                <InputNumber class="form-control" @bind-Value="editingProduct.Price" step="0.01" />
                                <ValidationMessage For="() => editingProduct.Price" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">@T.Products_Label_Description</label>
                        <InputTextArea class="form-control" @bind-Value="editingProduct.Description" rows="3" placeholder="Optionale Beschreibung..." />
                    </div>

                    <!-- Product image upload -->
                    <div class="form-group">
                        <label class="form-label">@T.Products_Label_Image</label>

                        @if (!string.IsNullOrEmpty(editingProduct.ImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@editingProduct.ThumbnailUrl" alt="@editingProduct.Name" class="img-thumbnail product-thumbnail" />
                                <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="RemoveImage">
                                    <i class="bi bi-trash"></i> @T.Products_ImageRemove
                                </button>
                            </div>
                        }

                        <InputFile OnChange="HandleImageUpload" class="form-control" accept="image/*" />
                        <small class="text-muted">@T.Products_ImageHint</small>

                        @if (imageUploadError != null)
                        {
                            <div class="alert alert-danger mt-2 py-2">
                                <small>@imageUploadError</small>
                            </div>
                        }
                    </div>

                    <!-- Specification PDF upload (optional) -->
                    <div class="form-group">
                        <label class="form-label">
                            @T.Products_Label_Pdf
                            <i class="bi bi-info-circle" title="Technische Datenblätter, Bedienungsanleitungen, etc."></i>
                        </label>

                        @if (!string.IsNullOrEmpty(editingProduct.SpecificationPdfPath))
                        {
                            <div class="mb-2">
                                <div class="d-flex align-items-center gap-2 p-2 border rounded pdf-preview-card">
                                    <i class="bi bi-file-earmark-pdf text-danger fs-3"></i>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold pdf-filename">@GetPdfFileName(editingProduct.SpecificationPdfPath)</div>
                                        <small class="text-muted pdf-filesize">@GetPdfFileSize(editingProduct.SpecificationPdfPath)</small>
                                    </div>
                                    <a href="@editingProduct.SpecificationPdfPath" target="_blank" class="btn btn-sm btn-outline-primary" title="@T.Products_PdfOpen">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="RemovePdf">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }

                        <InputFile OnChange="HandlePdfUpload" class="form-control" accept=".pdf" />
                        <small class="text-muted">@T.Products_PdfHint</small>

                        @if (pdfUploadError != null)
                        {
                            <div class="alert alert-danger mt-2 py-2">
                                <small>@pdfUploadError</small>
                            </div>
                        }
                    </div>

                    <!-- Expiry date tracking (food products) -->
                    @if (ShouldShowExpiryDate())
                    {
                        <div class="alert alert-info mb-3">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>@T.Products_FoodCategory_Alert</strong>
                        </div>

                        <!-- Batch management -->
                        <div class="form-group">
                            <label class="form-label">
                                @T.Products_Label_Batches
                                <button type="button" class="btn btn-sm btn-primary ms-2" @onclick="AddNewBatch">
                                    <i class="bi bi-plus"></i> @T.Products_AddBatch
                                </button>
                            </label>

                            @if (productBatches.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>@T.Products_BatchCol_Number</th>
                                                <th>@T.Products_BatchCol_Quantity</th>
                                                <th>@T.Products_BatchCol_Expiry</th>
                                                <th>@T.Products_BatchCol_Status</th>
                                                <th>@T.Products_BatchCol_Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var batch in productBatches.OrderBy(b => b.ExpiryDate ?? DateTime.MaxValue))
                                            {
                                                <tr class="@(batch.IsExpired ? "table-danger" : batch.IsExpiringSoon ? "table-warning" : "")">
                                                    <td>
                                                        <input type="text" class="form-control form-control-sm" @bind="batch.BatchNumber" placeholder="z.B. LOT-2025-001" />
                                                    </td>
                                                    <td>
                                                        <input type="number" class="form-control form-control-sm" @bind="batch.Quantity" min="0" style="width: 80px;" />
                                                    </td>
                                                    <td>
                                                        <input type="date" class="form-control form-control-sm" @bind="batch.ExpiryDate" style="width: 150px;" />
                                                    </td>
                                                    <td>
                                                        @if (batch.ExpiryDate.HasValue)
                                                        {
                                                            var days = (batch.ExpiryDate.Value - DateTime.UtcNow).Days;
                                                            @if (days < 0)
                                                            {
                                                                <span class="badge bg-danger">Abgelaufen (@(-days)d)</span>
                                                            }
                                                            else if (days <= 7)
                                                            {
                                                                <span class="badge bg-warning">@days Tage</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-success">@days Tage</span>
                                                            }
                                                        }
                                                    </td>
                                                    <td>
                                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveBatch(batch)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <small>@T.Products_EmptyBatches</small>
                                </div>
                            }

                            <div class="alert alert-info mt-2">
                                <small>
                                    <i class="bi bi-info-circle me-1"></i>
                                    @T.Products_BatchTip
                                </small>
                            </div>
                        </div>

                        <!-- Legacy single expiry date input (for products without batches) -->
                        @if (!productBatches.Any())
                        {
                            <div class="form-group">
                                <label class="form-label">
                                    Mindesthaltbarkeitsdatum (MHD) - Einzelnes Produkt
                                    <i class="bi bi-question-circle" title="Oder verwenden Sie Chargen für mehrere MHDs"></i>
                                </label>
                                <InputDate class="form-control" @bind-Value="editingProduct.ExpiryDate" />

                                @if (editingProduct.ExpiryDate.HasValue)
                                {
                                    var daysUntilExpiry = (editingProduct.ExpiryDate.Value - DateTime.UtcNow).Days;

                                    @if (daysUntilExpiry < 0)
                                    {
                                        <div class="alert alert-danger mt-2 py-2">
                                            <i class="bi bi-exclamation-triangle me-2"></i>
                                            <strong>ABGELAUFEN!</strong> Seit @(-daysUntilExpiry) Tagen
                                        </div>
                                    }
                                    else if (daysUntilExpiry <= 7)
                                    {
                                        <div class="alert alert-warning mt-2 py-2">
                                            <i class="bi bi-clock me-2"></i>
                                            <strong>Läuft bald ab:</strong> Noch @daysUntilExpiry Tage
                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Noch @daysUntilExpiry Tage haltbar</small>
                                    }
                                }
                            </div>
                        }
                    }
                </EditForm>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">@T.Products_Cancel</button>
                <button class="btn btn-primary" @onclick="SaveProduct" disabled="@(!IsSaveEnabled())">
                    <i class="bi bi-check"></i> @T.Products_Save
                </button>
                @if (!IsSaveEnabled())
                {
                    <small class="text-danger d-block mt-2">
                        @if (editingProduct == null || string.IsNullOrWhiteSpace(editingProduct.Name))
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Name ist erforderlich</span>
                        }
                        else if (string.IsNullOrWhiteSpace(editingProduct?.Barcode))
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Barcode ist erforderlich (eindeutige Identifikation)</span>
                        }
                        else if (allProducts.Any(p =>
                            p.Barcode.Equals(editingProduct.Barcode, StringComparison.OrdinalIgnoreCase) &&
                            p.Name.Equals(editingProduct.Name, StringComparison.OrdinalIgnoreCase) &&
                            p.Id != editingProduct.Id))
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Kombination Barcode "@editingProduct.Barcode" + Name "@editingProduct.Name" ist bereits vergeben</span>
                        }
                        else if (editingProduct.CategoryId <= 0)
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Kategorie ist erforderlich</span>
                        }
                        else if (editingProduct.Price <= 0)
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Preis muss größer als 0 sein</span>
                        }
                        else if (!selectedStorageLocations.Any(sl => sl.Quantity > 0))
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Mindestens ein Lagerfach mit Menge > 0 erforderlich</span>
                        }
                        else if (GetTotalQuantity() == 0)
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Gesamtmenge muss > 0 sein (aktuell: 0)</span>
                        }
                        else if (ShouldShowExpiryDate() && !productBatches.Any(b => b.Quantity > 0))
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Lebensmittel benötigen mindestens eine Charge mit MHD</span>
                        }
                        else if (ShouldShowExpiryDate() && productBatches.Any(b => b.Quantity > 0 && string.IsNullOrWhiteSpace(b.BatchNumber)))
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Alle Chargen benötigen eine Chargen-Nummer</span>
                        }
                        else if (ShouldShowExpiryDate() && productBatches.Any(b => b.Quantity > 0 && !b.ExpiryDate.HasValue))
                        {
                            <span><i class="bi bi-exclamation-circle"></i> Alle Chargen benötigen ein MHD (Mindesthaltbarkeitsdatum)</span>
                        }
                        else if (ShouldShowExpiryDate() && productBatches.Where(b => b.Quantity > 0).Sum(b => b.Quantity) != GetTotalQuantity())
                        {
                            var batchTotal = productBatches.Where(b => b.Quantity > 0).Sum(b => b.Quantity);
                            var locationTotal = GetTotalQuantity();
                            <span><i class="bi bi-exclamation-circle"></i> Chargen-Summe (@batchTotal) muss mit Lagerfach-Verteilung (@locationTotal) übereinstimmen</span>
                        }
                        else if (editingProduct.Id > 0 && !HasChanges())
                        {
                            <span><i class="bi bi-info-circle"></i> Keine Änderungen vorgenommen</span>
                        }
                    </small>
                }
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="modal-backdrop" @onclick="() => showDeleteModal = false">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@T.Products_ConfirmDelete_Title</h3>
                <button class="modal-close" @onclick="() => showDeleteModal = false">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <p>@T.Products_ConfirmDelete_Desc <strong>@productToDelete?.Name</strong>?</p>
                <p class="text-muted">@T.Products_ConfirmDelete_Warning</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showDeleteModal = false">@T.Products_Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteProduct">
                    <i class="bi bi-trash"></i> @T.Products_Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private List<LagersystemLVHome.Domain.Models.Product> allProducts = new();
    private List<LagersystemLVHome.Domain.Models.Product> filteredProducts = new();
    private List<LagersystemLVHome.Domain.Models.Category> categories = new();
    private List<StorageLocation> allStorageLocations = new();

    private List<StorageLocationMultiSelect.ProductStorageLocationItem> selectedStorageLocations = new();

    private string searchTerm = string.Empty;
    private int selectedCategoryId = 0;
    private string stockFilter = "all";

    private bool showModal = false;
    private LagersystemLVHome.Domain.Models.Product? editingProduct;

    private bool showDeleteModal = false;
    private Product? productToDelete;
    private string? imageUploadError;
    private List<ProductBatch> productBatches = new();

    private string? pdfUploadError;

    private bool isDirty = false;
    private string originalProductJson = string.Empty;
    private string originalStorageLocationsJson = string.Empty;
    private string originalBatchesJson = string.Empty;

    private Dictionary<int, int> priceHistoryCounts = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadData();
        await LoadPriceHistoryCounts();

        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var search = query["search"];
        if (!string.IsNullOrEmpty(search))
        {
            searchTerm = search;
            FilterProducts();
        }

        if (NavigationManager.Uri.Contains("/products/new"))
        {
            OpenCreateModal();

            var barcode = query["barcode"];
            if (!string.IsNullOrEmpty(barcode) && editingProduct != null)
            {
                editingProduct.Barcode = barcode;
            }
        }
    }

    private bool IsSaveEnabled()
    {
        if (editingProduct == null) return false;

        if (string.IsNullOrWhiteSpace(editingProduct.Name))
            return false;

        if (string.IsNullOrWhiteSpace(editingProduct.Barcode))
            return false;

        var existingProduct = allProducts.FirstOrDefault(p =>
            p.Barcode.Equals(editingProduct.Barcode, StringComparison.OrdinalIgnoreCase) &&
            p.Name.Equals(editingProduct.Name, StringComparison.OrdinalIgnoreCase) &&
            p.Id != editingProduct.Id);

        if (existingProduct != null)
            return false;

        if (editingProduct.CategoryId <= 0)
            return false;

        if (editingProduct.Price <= 0)
            return false;

        var totalDistributed = GetTotalQuantity();
        var hasStorageLocations = selectedStorageLocations.Any(sl => sl.Quantity > 0);

        if (!hasStorageLocations || totalDistributed == 0)
            return false;

        if (ShouldShowExpiryDate())
        {
            if (!productBatches.Any(b => b.Quantity > 0))
                return false;

            foreach (var batch in productBatches.Where(b => b.Quantity > 0))
            {
                if (string.IsNullOrWhiteSpace(batch.BatchNumber))
                    return false;

                if (!batch.ExpiryDate.HasValue)
                    return false;

                if (batch.Quantity <= 0)
                    return false;
            }

            var totalBatchQuantity = productBatches.Where(b => b.Quantity > 0).Sum(b => b.Quantity);
            if (totalBatchQuantity != totalDistributed)
                return false;
        }

        if (editingProduct.Id > 0)
        {
            return HasChanges();
        }

        return true;
    }

    private bool HasChanges()
    {
        try
        {
            var currentProductJson = System.Text.Json.JsonSerializer.Serialize(new
            {
                editingProduct?.Name,
                editingProduct?.Barcode,
                editingProduct?.Description,
                editingProduct?.MinQuantity,
                editingProduct?.Price,
                editingProduct?.CategoryId,
                editingProduct?.ImageUrl,
                editingProduct?.ExpiryDate,
                editingProduct?.SpecificationPdfPath
            });

            var currentStorageLocationsJson = System.Text.Json.JsonSerializer.Serialize(
                selectedStorageLocations.OrderBy(sl => sl.StorageLocation.Id)
                    .Select(sl => new { sl.StorageLocation.Id, sl.Quantity })
            );

            var currentBatchesJson = System.Text.Json.JsonSerializer.Serialize(
                productBatches.OrderBy(b => b.BatchNumber)
                    .Select(b => new { b.BatchNumber, b.Quantity, b.ExpiryDate, b.ManufactureDate, b.Notes })
            );

            return currentProductJson != originalProductJson ||
                   currentStorageLocationsJson != originalStorageLocationsJson ||
                   currentBatchesJson != originalBatchesJson;
        }
        catch
        {
            return true;
        }
    }

    private async Task LoadData()
    {
        allProducts = (await InventoryService.GetAllProductsAsync()).ToList();
        categories = (await InventoryService.GetAllCategoriesAsync()).ToList();

        allStorageLocations = (await LocationQueryService.GetActiveStorageLocationsAsync()).ToList();

        FilterProducts();
    }

    private async Task LoadPriceHistoryCounts()
    {
        try
        {
            priceHistoryCounts.Clear();

            foreach (var product in allProducts)
            {
                var count = await PriceHistoryService.GetPriceChangeCountAsync(product.Id);
                if (count > 0)
                {
                    priceHistoryCounts[product.Id] = count;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading price history counts");
        }
    }

    private void NavigateToPriceHistory(int productId)
    {
        NavigationManager.NavigateTo($"/price-history/{productId}");
    }

    private void FilterProducts()
    {
        var query = allProducts.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.ToLower();
            query = query.Where(p =>
                p.Name.ToLower().Contains(term) ||
                p.Barcode.ToLower().Contains(term) ||
                p.Description.ToLower().Contains(term));
        }

        if (selectedCategoryId > 0)
        {
            query = query.Where(p => p.CategoryId == selectedCategoryId);
        }

        query = stockFilter switch
        {
            "low" => query.Where(p => p.Quantity <= p.MinQuantity && p.Quantity > 0),
            "out" => query.Where(p => p.Quantity == 0),
            "ok" => query.Where(p => p.Quantity > p.MinQuantity),
            "expired" => query.Where(p => p.ExpiryDate.HasValue && p.ExpiryDate.Value < DateTime.UtcNow),
            "expiring" => query.Where(p => p.ExpiryDate.HasValue && p.ExpiryDate.Value >= DateTime.UtcNow && p.ExpiryDate.Value <= DateTime.UtcNow.AddDays(7)),
            _ => query
        };

        filteredProducts = query.ToList();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedCategoryId = 0;
        stockFilter = "all";
        FilterProducts();
    }

