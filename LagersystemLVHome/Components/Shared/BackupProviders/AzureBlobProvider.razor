@using LagersystemLVHome.Application.Services
@inject I18nText I18nText

<div class="row g-3">
    <div class="col-12">
        <label class="form-label">
            <i class="bi bi-key me-1"></i>
            Connection String *
        </label>
        <input type="text" class="form-control" @bind="Config.ConnectionString"
               placeholder="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net" />
        <small class="text-muted">@(T.BackupProvider_Azure_ConnStrHint ?? "Azure Storage Account Connection String")</small>
    </div>

    <div class="col-12">
        <label class="form-label">
            <i class="bi bi-box me-1"></i>
            Container Name *
        </label>
        <input type="text" class="form-control" @bind="Config.ContainerName"
               placeholder="lagersystem-backups" />
        <small class="text-muted">@(T.BackupProvider_Azure_ContainerHint ?? "Name des Blob Containers (wird automatisch erstellt falls nicht vorhanden)")</small>
    </div>

    <!-- Max Backups -->
    <div class="col-md-6">
        <label class="form-label">
            <i class="bi bi-clock-history me-1"></i>
            Maximale Anzahl Backups
        </label>
        <InputNumber class="form-control" @bind-Value="Config.MaxBackups"
                     min="1" max="365" />
        <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            @(T.BackupProvider_Azure_MaxBackupsHint ?? "Älteste Backups werden automatisch gelöscht (Standard: 30)")
        </small>
    </div>

    <div class="col-12">
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-2"></i>
            <strong>@(T.BackupProvider_Azure_SetupTitle ?? "Azure Blob Storage Setup:")</strong>
            <ol class="mb-0 mt-2">
                <li>@(T.BackupProvider_Azure_Step1 ?? "Erstelle ein Storage Account im Azure Portal")</li>
                <li>@(T.BackupProvider_Azure_Step2 ?? "Navigiere zu Access Keys")</li>
                <li>@(T.BackupProvider_Azure_Step3 ?? "Kopiere den Connection String")</li>
                <li>@(T.BackupProvider_Azure_Step4 ?? "Trage ihn oben ein")</li>
                <li>@(T.BackupProvider_Azure_Step5 ?? "Der Container wird automatisch erstellt")</li>
            </ol>
        </div>
    </div>
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    [Parameter] public AzureBlobConfig Config { get; set; } = new();
    [Parameter] public EventCallback<AzureBlobConfig> ConfigChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }
}
