@page "/movements"
@inherits CancellableComponentBase
@rendermode InteractiveServer
@inject LagersystemLVHome.Application.Services.IInventoryService InventoryService
@inject I18nText I18nText

<PageTitle>@T.Movements_PageTitle</PageTitle>

<div class="page-header">
    <h1 class="page-title">@T.Movements_Title</h1>
    <p class="page-subtitle">@T.Movements_Subtitle</p>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@(T.Movements_LastMovements != null ? string.Format(T.Movements_LastMovements, allMovements.Count) : "")</h3>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm" style="width: auto;" @bind="filterType" @bind:after="FilterMovements">
                <option value="all">@T.Movements_Filter_All</option>
                <option value="in">@T.Movements_Filter_In</option>
                <option value="out">@T.Movements_Filter_Out</option>
            </select>
        </div>
    </div>
    <div class="card-body p-0">
        @if (filteredMovements.Any())
        {
            <StockMovementInfiniteList Movements="@filteredMovements.ToList()"
                                       OnLoadMore="@LoadMoreMovements"
                                       IsLoading="@isLoading"
                                       HasMore="@hasMore" />
        }
        else
        {
            <EmptyState IconClass="bi bi-arrow-left-right"
                        Title="@T.Movements_Empty_Title"
                        Description="@T.Movements_Empty_Desc"
                        AdditionalClass="compact" />
        }
    </div>
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private List<LagersystemLVHome.Domain.Models.StockMovement> allMovements = new();
    private IEnumerable<LagersystemLVHome.Domain.Models.StockMovement> filteredMovements = new List<LagersystemLVHome.Domain.Models.StockMovement>();
    private string filterType = "all";
    
    // Infinite scroll state
    private int currentPage = 1;
    private const int PageSize = 50;
    private bool isLoading = false;
    private bool hasMore = true;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadMoreMovements();
    }

    // Load more (paginated)
    private async Task LoadMoreMovements()
    {
        if (isLoading || !hasMore) return;
        
        isLoading = true;
        StateHasChanged();
        
        try
        {
            // Load more movements
            var newMovements = (await InventoryService.GetRecentMovementsAsync(currentPage * PageSize))
                    .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
                    .ToList();
            
            if (newMovements.Count < PageSize)
            {
                hasMore = false;
            }
  
            allMovements.AddRange(newMovements);
            currentPage++;
 
            FilterMovements();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterMovements()
    {
        filteredMovements = filterType switch
        {
            "in" => allMovements.Where(m => m.QuantityChange > 0),
            "out" => allMovements.Where(m => m.QuantityChange < 0),
            _ => allMovements
        };
    }
}
