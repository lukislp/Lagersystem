<!-- Create API key modal -->
@if (showCreateApiKeyModal)
{
    <div class="modal-backdrop" style="display: block;"></div>
    <div class="modal" style="display: block;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-key me-2"></i>
                        Neuen API-Key erstellen
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCreateApiKeyModal"></button>
                </div>
                <div class="modal-body">
                    @if (string.IsNullOrEmpty(newApiKeyClearText))
                    {
                        <!-- Schritt 1: Key-Details eingeben -->
                        <div class="mb-3">
                            <label class="form-label">Name des API-Keys *</label>
                            <input type="text" class="form-control"
                                   @bind="newApiKeyName"
                                   placeholder="z.B. Home Assistant Integration"
                                   maxlength="100" />
                            <small class="text-muted">Geben Sie einen beschreibenden Namen ein</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ablaufdatum (optional)</label>
                            <input type="date" class="form-control"
                                   @bind="newApiKeyExpiry"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <small class="text-muted">Leer lassen für unbegrenzten Key</small>
                        </div>

                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Wichtig:</strong> Der API-Key wird nur einmal angezeigt!
                        </div>
                    }
                    else
                    {
                        <!-- Schritt 2: Key anzeigen -->
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            API-Key erfolgreich erstellt!
                        </div>

                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Kopieren Sie diesen Key jetzt!</strong><br>
                            Er wird nur einmal angezeigt und kann nicht wiederhergestellt werden.
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ihr API-Key:</label>
                            <div class="input-group">
                                <input type="text" class="form-control font-monospace"
                                       value="@newApiKeyClearText"
                                       readonly
                                       style="font-size: 0.875rem;" />
                                <button class="btn btn-outline-primary" @onclick="CopyApiKeyToClipboard">
                                    <i class="bi bi-clipboard"></i> Kopieren
                                </button>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <strong>Verwendung:</strong>
                            <pre class="mb-0 mt-2" style="font-size: 0.875rem;">curl -H "X-API-Key: @newApiKeyClearText" \
                                @(NavigationManager.BaseUri)api/products</pre>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        @if (string.IsNullOrEmpty(newApiKeyClearText))
                        {
                            <button class="btn btn-secondary" @onclick="CloseCreateApiKeyModal">Abbrechen</button>
                            <button class="btn btn-primary" @onclick="CreateApiKey" disabled="@(string.IsNullOrWhiteSpace(newApiKeyName) || isCreatingApiKey)">
                                @if (isCreatingApiKey)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <i class="bi bi-plus-circle me-1"></i>
                                Key erstellen
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="CloseCreateApiKeyModal">
                                <i class="bi bi-check-circle me-1"></i>
                                Fertig
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Revoke API key modal -->
    @if (showRevokeApiKeyModal)
    {
        <div class="modal-backdrop" style="display: block;"></div>
        <div class="modal" style="display: block;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">
                            <i class="bi bi-trash me-2"></i>
                            API-Key widerrufen?
                        </h5>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Diese Aktion kann nicht rückgängig gemacht werden!
                        </div>
                        <p>
                            Möchten Sie den API-Key <strong>"@revokeApiKeyName"</strong> wirklich widerrufen?
                        </p>
                        <p class="text-muted small">
                            Alle Anwendungen, die diesen Key verwenden, verlieren sofort den Zugriff.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseRevokeApiKeyModal">
                            Abbrechen
                        </button>
                        <button class="btn btn-danger" @onclick="RevokeApiKey" disabled="@isRevokingApiKey">
                            @if (isRevokingApiKey)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-trash me-1"></i>
                            Key widerrufen
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

<!-- Revoke consent modal (component) -->
<RevokeConsentModal ShowModal="@showRevokeConsentModal"
