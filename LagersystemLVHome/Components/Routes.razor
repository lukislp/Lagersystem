<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="exception">
                <div class="alert alert-danger m-4" role="alert">
                    <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Something went wrong</h4>
                    <p>The current view could not be rendered. The error has been logged and the team has been notified.</p>
                    <hr />
                    <button class="btn btn-outline-danger btn-sm" type="button" onclick="location.reload()">
                        <i class="bi bi-arrow-clockwise"></i> Reload page
                    </button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
</Router>
