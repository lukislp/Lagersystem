@page "/ml/security-risk-dashboard"
@using LagersystemLVHome.Infrastructure.ML.Services
@using LagersystemLVHome.Infrastructure.ML.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@rendermode InteractiveServer
@inject ISecurityRiskService SecurityService
@inject IToastService ToastService

<PageTitle>Security Risk Dashboard - ML</PageTitle>

<div class="page-header mb-4">
    <div>
        <h1 class="page-title">
            <i class="bi bi-shield-fill-exclamation me-2"></i>
            Security Risk Scoring
        </h1>
        <p class="page-subtitle">KI-gest&#252;tzte Sicherheitsrisikobewertung</p>
    </div>
    <div>
        @if (!SecurityService.IsModelReady)
        {
            <button class="btn btn-warning" @onclick="TrainModel" disabled="@isTraining">
                <i class="bi bi-cpu @(isTraining ? "rotating" : "")"></i>
                Modell trainieren
            </button>
        }
        else
        {
            <button class="btn btn-primary" @onclick="RefreshData" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise @(isLoading ? "rotating" : "")"></i>
                Aktualisieren
            </button>
        }
    </div>
</div>

@if (isLoading)
{
    <div class="loading-container">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Analysiere...</span>
        </div>
        <p>Risikobewertung l&#228;uft...</p>
    </div>
}
else if (highRiskUsers != null)
{
    <!-- KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-danger h-100">
                <div class="card-body text-center">
                    <i class="bi bi-shield-x display-1"></i>
                    <h2 class="mt-3 mb-0">@criticalRiskCount</h2>
                    <p class="mb-0">Kritisches Risiko</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-warning h-100">
                <div class="card-body text-center">
                    <i class="bi bi-shield-exclamation display-1"></i>
                    <h2 class="mt-3 mb-0">@highRiskCount</h2>
                    <p class="mb-0">Hohes Risiko</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-info h-100">
                <div class="card-body text-center">
                    <i class="bi bi-shield-check display-1"></i>
                    <h2 class="mt-3 mb-0">@mediumRiskCount</h2>
                    <p class="mb-0">Mittleres Risiko</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-success h-100">
                <div class="card-body text-center">
                    <i class="bi bi-shield-fill-check display-1"></i>
                    <h2 class="mt-3 mb-0">@lowRiskCount</h2>
                    <p class="mb-0">Geringes Risiko</p>
                </div>
            </div>
        </div>
    </div>

    @if (highRiskUsers.Any())
    {
        <!-- High Risk Users -->
        <div class="card mb-4">
            <div class="card-header @(criticalRiskCount > 0 ? "bg-danger" : "bg-warning") text-white">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Hochrisiko-Benutzer
                </h5>
            </div>
            <div class="card-body">
                @foreach (var assessment in highRiskUsers.Take(10))
                {
                    <div class="card mb-3 border-@GetRiskBorderClass(assessment.RiskLevel)">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-3">
                                    <h5 class="mb-1">@assessment.Username</h5>
                                    <small class="text-muted">ID: @assessment.UserId</small>
                                    <br />
                                    <span class="badge @GetRiskBadgeClass(assessment.RiskLevel) mt-2">
                                        @assessment.RiskLevel
                                    </span>
                                </div>
                                <div class="col-md-3">
                                    <strong>Risk Score</strong>
                                    <div class="progress mt-2">
                                        <div class="progress-bar @GetRiskProgressClass(assessment.RiskLevel)"
                                            role="progressbar"
                                            style="width: @assessment.RiskScore%"
                                            aria-valuenow="@assessment.RiskScore"
                                            aria-valuemin="0"
                                            aria-valuemax="100">
                                            @assessment.RiskScore.ToString("F0")%
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <strong>Risikofaktoren</strong>
                                    <ul class="list-unstyled mb-0 mt-2">
                                        @foreach (var factor in assessment.RiskFactors.Take(2))
                                        {
                                            <li class="small">
                                                <i class="bi bi-exclamation-circle text-danger"></i>
                                                @factor.Factor
                                            </li>
                                        }
                                        @if (assessment.RiskFactors.Count > 2)
                                        {
                                            <li class="small text-muted">
                                                <i class="bi bi-plus"></i> @(assessment.RiskFactors.Count - 2) weitere
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div class="col-md-3">
                                    <strong>Empfehlungen</strong>
                                    <ul class="list-unstyled mb-0 mt-2">
                                        @foreach (var recommendation in assessment.Recommendations.Take(2))
                                        {
                                            <li class="small">@recommendation</li>
                                        }
                                    </ul>
                                </div>
                            </div>

                            @if (assessment.RequiresTwoFactor || assessment.RequiresPasswordChange || assessment.SuggestAccountReview)
                            {
                                <hr />
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (assessment.RequiresTwoFactor)
                                    {
                                        <span class="badge bg-warning">2FA erforderlich</span>
                                    }
                                    @if (assessment.RequiresPasswordChange)
                                    {
                                        <span class="badge bg-info">Passwort-&#196;nderung erforderlich</span>
                                    }
                                    @if (assessment.SuggestAccountReview)
                                    {
                                        <span class="badge bg-danger">Account-Review empfohlen</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            <i class="bi bi-shield-check me-2"></i>
            <strong>Keine Hochrisiko-Benutzer</strong>
            <p class="mb-0">Alle Benutzer haben ein akzeptables Sicherheitsrisiko.</p>
        </div>
    }

    <!-- Risk Distribution -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-pie-chart me-2"></i>
                        Risiko-Verteilung
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="riskDistributionChart"></canvas>
                    <div class="text-center">
                        <div class="mb-2">
                            <span class="badge bg-danger">Kritisch: @criticalRiskCount</span>
                        </div>
                        <div class="mb-2">
                            <span class="badge bg-warning">Hoch: @highRiskCount</span>
                        </div>
                        <div class="mb-2">
                            <span class="badge bg-info">Mittel: @mediumRiskCount</span>
                        </div>
                        <div>
                            <span class="badge bg-success">Niedrig: @lowRiskCount</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Bewertungskriterien
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> Fehlgeschlagene Login-Versuche
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> 2FA-Status
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> Sensible Aktionen
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> Account-Alter
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> Ungew&#246;hnliche Aktivit&#228;tszeiten
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> IP-Adressen-Variation
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> Daten-Exports
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> Passwort-&#196;nderungsh&#228;ufigkeit
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<SecurityRiskAssessment>? highRiskUsers;
    private bool isLoading = false;
    private bool isTraining = false;
    private int criticalRiskCount = 0;
    private int highRiskCount = 0;
    private int mediumRiskCount = 0;
    private int lowRiskCount = 0;

    protected override async Task OnInitializedAsync()
    {
        if (SecurityService.IsModelReady)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            highRiskUsers = await SecurityService.GetHighRiskUsersAsync();

            criticalRiskCount = highRiskUsers.Count(u => u.RiskLevel == RiskLevel.Critical);
            highRiskCount = highRiskUsers.Count(u => u.RiskLevel == RiskLevel.High);
            mediumRiskCount = highRiskUsers.Count(u => u.RiskLevel == RiskLevel.Medium);
            lowRiskCount = highRiskUsers.Count(u => u.RiskLevel == RiskLevel.Low);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        ToastService.ShowSuccess("Data refreshed");
    }

    private async Task TrainModel()
    {
        try
        {
            isTraining = true;
            ToastService.ShowInfo("Modell-Training gestartet...");

            var success = await SecurityService.TrainModelAsync();

            if (success)
            {
                ToastService.ShowSuccess("Model trained successfully!");
                await LoadData();
            }
            else
            {
                ToastService.ShowWarning("Training failed. Not enough data?");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error during training: {ex.Message}");
        }
        finally
        {
            isTraining = false;
        }
    }

    private string GetRiskBadgeClass(RiskLevel level)
    {
        return level switch
        {
            RiskLevel.Critical => "bg-danger",
            RiskLevel.High => "bg-warning",
            RiskLevel.Medium => "bg-info",
            RiskLevel.Low => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetRiskBorderClass(RiskLevel level)
    {
        return level switch
        {
            RiskLevel.Critical => "danger",
            RiskLevel.High => "warning",
            _ => "info"
        };
    }

    private string GetRiskProgressClass(RiskLevel level)
    {
        return level switch
        {
            RiskLevel.Critical => "bg-danger",
            RiskLevel.High => "bg-warning",
            RiskLevel.Medium => "bg-info",
            RiskLevel.Low => "bg-success",
            _ => "bg-secondary"
        };
    }
}
