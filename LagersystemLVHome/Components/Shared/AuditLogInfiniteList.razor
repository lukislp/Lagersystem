@using LagersystemLVHome.Domain.Models
@inject I18nText I18nText

<InfiniteScroll OnLoadMore="@OnLoadMore"
                IsLoading="@IsLoading"
                HasMore="@HasMore"
                Threshold="300">
    
    <div class="audit-logs-list">
        @foreach (var log in AuditLogs)
        {
            <div class="audit-log-entry @GetSeverityClass(log.Severity)" @key="log.Id">
                <div class="log-severity">
                    <span class="severity-badge @GetSeverityBadgeClass(log.Severity)">
                        @log.Severity
                    </span>
                </div>
            
                <div class="log-timestamp">
                    <div>@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy")</div>
                    <small>@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</small>
                </div>

                <div class="log-user">
                    <strong>@(log.Username ?? T.AuditLog_System)</strong>
                    <small class="text-muted">ID: @log.UserId</small>
                </div>
        
                <div class="log-action">
                    <span class="badge @GetActionBadgeClass(log.Action)">
                        @GetActionDisplayName(log.Action)
                    </span>
                </div>
     
                <div class="log-entity">
                    <div>@log.Entity</div>
                    @if (log.EntityId.HasValue)
                    {
                        <small class="text-muted">ID: @log.EntityId</small>
                    }
                </div>
    
                <div class="log-ip">
                    <small>@(log.IpAddress ?? "-")</small>
                </div>
     
                <div class="log-actions">
                    @if (!string.IsNullOrEmpty(log.Details))
                    {
                        <button class="btn btn-sm btn-icon btn-outline-primary"
                                @onclick="() => OnShowDetails.InvokeAsync(log)"
                                title="@T.AuditLog_DetailsTitle">
                            <i class="bi bi-eye"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</InfiniteScroll>

@code {
    [Parameter, EditorRequired]
    public List<AuditLog> AuditLogs { get; set; } = new();

    [Parameter]
    public EventCallback OnLoadMore { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool HasMore { get; set; } = true;

    [Parameter]
    public EventCallback<AuditLog> OnShowDetails { get; set; }

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    private string GetSeverityClass(AuditSeverity severity) =>
        severity switch
        {
            AuditSeverity.Warning => "log-warning",
            AuditSeverity.Error => "log-error",
            AuditSeverity.Critical => "log-critical",
            _ => "log-info"
        };

    private string GetSeverityBadgeClass(AuditSeverity severity) =>
severity switch
{
    AuditSeverity.Info => "bg-success",
    AuditSeverity.Warning => "bg-warning text-dark",
    AuditSeverity.Error => "bg-danger",
    AuditSeverity.Critical => "bg-dark",
    _ => "bg-secondary"
};

    private string GetActionBadgeClass(string action)
    {
        if (action.Contains("SUCCESS") || action.Contains("APPROVED"))
            return "bg-success";
        if (action.Contains("FAILED") || action.Contains("REJECTED") || action.Contains("DELETED"))
            return "bg-danger";
        if (action.Contains("CREATED") || action.Contains("UPDATED"))
            return "bg-primary";
   
        return "bg-secondary";
    }

    private string GetActionDisplayName(string action) =>
    action switch
    {
        "LOGIN_SUCCESS" => T.AuditAction_Login,
        "LOGIN_FAILED" => T.AuditAction_LoginFailed,
        "LOGOUT" => T.AuditAction_Logout,
        "REGISTER_SUCCESS" => T.AuditAction_Register,
        "USER_APPROVED" => T.AuditAction_UserApproved,
        "USER_REJECTED" => T.AuditAction_UserRejected,
        "PASSWORD_CHANGED" => T.AuditAction_PasswordChanged,
        "PRODUCT_CREATED" => T.AuditAction_ProductCreated,
        "PRODUCT_UPDATED" => T.AuditAction_ProductUpdated,
        "PRODUCT_DELETED" => T.AuditAction_ProductDeleted,
        _ => action
    };
}
