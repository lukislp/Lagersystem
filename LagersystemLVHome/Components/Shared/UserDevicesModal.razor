@* Modal for a user's device list *@
@inject I18nText I18nText
@if (ShowDevicesModal)
{
    <!-- Backdrop with reduced opacity and no onClick -->
    <div class="modal-backdrop fade show" style="background-color: rgba(0, 0, 0, 0.5); z-index: 1040;"></div>
    
    <!-- Modal with correct z-index and stopPropagation at the right place -->
    <div class="modal fade show d-block" style="z-index: 1050;" tabindex="-1" role="dialog" @onclick="HandleBackdropClick">
        <div class="modal-dialog modal-dialog-scrollable modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-devices me-2"></i>
                        @string.Format(T.UserDevicesModal_Title, SelectedUsername)
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDevicesModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (SelectedUserId.HasValue)
                    {
                        <UserDeviceList UserId="@SelectedUserId.Value"
                                        CurrentSessionId="@null"
                                        AllowTerminate="@AllowTerminate"
                                        ShowFingerprint="true"
                                        OnDeviceTerminated="HandleModalDeviceTerminated" />
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-info-circle text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3">@T.UserDevicesModal_NoUser</p>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDevicesModal">
                        @T.UserDevicesModal_Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool ShowDevicesModal { get; set; }

    [Parameter]
    public EventCallback<bool> ShowDevicesModalChanged { get; set; }

    [Parameter]
    public int? SelectedUserId { get; set; }

    [Parameter]
    public string? SelectedUsername { get; set; }

    [Parameter]
    public bool AllowTerminate { get; set; } = true;

    [Parameter]
    public EventCallback OnDevicesUpdated { get; set; }

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    // Handle backdrop clicks (only outside the dialog)
    private async Task HandleBackdropClick()
    {
        await CloseDevicesModal();
    }

    private async Task CloseDevicesModal()
    {
        ShowDevicesModal = false;
        await ShowDevicesModalChanged.InvokeAsync(false);
    }

    private async Task HandleModalDeviceTerminated()
    {
        // Notify parent component to refresh data
        await OnDevicesUpdated.InvokeAsync();
    }
}
