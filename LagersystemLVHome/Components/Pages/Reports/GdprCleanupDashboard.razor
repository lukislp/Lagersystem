@page "/admin/gdpr-cleanup"
@inherits CancellableComponentBase
@rendermode InteractiveServer
@using LagersystemLVHome.Application.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IGdprCleanupService CleanupService
@inject ILogger<GdprCleanupDashboard> Logger
@inject I18nText I18nText

<PageTitle>@T.Reports_GdprCleanup_PageTitle</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-shield-check text-primary me-2"></i>
                GDPR/DSGVO Cleanup
            </h1>
            <p class="text-muted mb-0">
                Automatische Bereinigung personenbezogener Daten
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" @onclick="LoadPreview" disabled="@loading">
                <i class="bi bi-eye"></i> Vorschau
            </button>
            <button class="btn btn-warning" @onclick="() => RunCleanup(dryRun: true)" disabled="@loading">
                <i class="bi bi-play-circle"></i> Dry Run
            </button>
            <button class="btn btn-danger" @onclick="() => RunCleanup(dryRun: false)" disabled="@loading">
                <i class="bi bi-trash"></i> Bereinigung starten
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">@loadingMessage</p>
        </div>
    }
    else
    {
        <!-- Last Cleanup Stats -->
        @if (lastCleanup != null)
        {
            <div class="alert @(lastCleanup.Success ? "alert-success" : "alert-danger") mb-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="alert-heading mb-2">
                            <i class="bi @(lastCleanup.Success ? "bi-check-circle-fill" : "bi-x-circle-fill") me-2"></i>
                            Letzte Bereinigung
                        </h5>
                        <p class="mb-1">
                            <strong>Datum:</strong> @lastCleanup.StartTime.ToString("dd.MM.yyyy HH:mm:ss") UTC
                        </p>
                        <p class="mb-1">
                            <strong>Dauer:</strong> @lastCleanup.Duration?.ToString(@"hh\:mm\:ss")
                        </p>
                        <p class="mb-1">
                            <strong>Gelöscht:</strong> @lastCleanup.TotalDeleted.ToString("N0") Datensätze
                        </p>
                        @if (lastCleanup.DryRun)
                        {
                            <span class="badge bg-warning">Dry Run</span>
                        }
                        @if (!string.IsNullOrEmpty(lastCleanup.ErrorMessage))
                        {
                            <p class="mb-0 mt-2 text-danger">
                                <strong>Fehler:</strong> @lastCleanup.ErrorMessage
                            </p>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Preview Stats -->
        @if (previewStats != null)
        {
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-eye me-2"></i>
                        Vorschau - Zu löschende Datensätze
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-value">@previewStats.PageViewsDeleted.ToString("N0")</div>
                                <div class="stat-label">PageViews</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-value">@previewStats.ApiRequestsDeleted.ToString("N0")</div>
                                <div class="stat-label">API Requests</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-value">@previewStats.SessionActivitiesDeleted.ToString("N0")</div>
                                <div class="stat-label">Session Activities</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-value">@previewStats.UserActivitiesDeleted.ToString("N0")</div>
                                <div class="stat-label">User Activities</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-value">@previewStats.AuditLogsDeleted.ToString("N0")</div>
                                <div class="stat-label">Audit Logs</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-value">@previewStats.SecurityEventsDeleted.ToString("N0")</div>
                                <div class="stat-label">Security Events</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-value">@previewStats.PerformanceMetricsDeleted.ToString("N0")</div>
                                <div class="stat-label">Performance Metrics</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-value">@previewStats.KeyBackupHistoryDeleted.ToString("N0")</div>
                                <div class="stat-label">Backup History</div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="text-center">
                        <h3 class="text-primary">@previewStats.TotalDeleted.ToString("N0")</h3>
                        <p class="text-muted">Datensätze gesamt</p>
                    </div>
                </div>
            </div>
        }

        <!-- Current Stats -->
        @if (currentStats != null)
        {
            <div class="card">
                <div class="card-header @(currentStats.Success ? "bg-success" : "bg-danger") text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-@(currentStats.Success ? "check-circle" : "x-circle") me-2"></i>
                        @(currentStats.DryRun ? "Dry Run" : "Cleanup") Ergebnis
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Start:</strong> @currentStats.StartTime.ToString("dd.MM.yyyy HH:mm:ss")
                        </div>
                        <div class="col-md-4">
                            <strong>Ende:</strong> @currentStats.EndTime?.ToString("dd.MM.yyyy HH:mm:ss")
                        </div>
                        <div class="col-md-4">
                            <strong>Dauer:</strong> @currentStats.Duration?.ToString(@"hh\:mm\:ss")
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(currentStats.ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            <strong>Fehler:</strong> @currentStats.ErrorMessage
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Datentyp</th>
                                    <th class="text-end">Gelöschte Datensätze</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>PageViews</td>
                                    <td class="text-end">@currentStats.PageViewsDeleted.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>API Requests</td>
                                    <td class="text-end">@currentStats.ApiRequestsDeleted.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>Session Activities</td>
                                    <td class="text-end">@currentStats.SessionActivitiesDeleted.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>User Activities</td>
                                    <td class="text-end">@currentStats.UserActivitiesDeleted.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>Audit Logs</td>
                                    <td class="text-end">@currentStats.AuditLogsDeleted.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>Security Events</td>
                                    <td class="text-end">@currentStats.SecurityEventsDeleted.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>Performance Metrics</td>
                                    <td class="text-end">@currentStats.PerformanceMetricsDeleted.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>Key Backup History</td>
                                    <td class="text-end">@currentStats.KeyBackupHistoryDeleted.ToString("N0")</td>
                                </tr>
                                <tr class="table-primary fw-bold">
                                    <td>GESAMT</td>
                                    <td class="text-end">@currentStats.TotalDeleted.ToString("N0")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>


@code {
    private LagersystemLVHome.I18nText.App T = new();
    private bool loading = false;
    private string loadingMessage = "";
    private GdprCleanupStats? lastCleanup;
    private GdprCleanupStats? previewStats;
    private GdprCleanupStats? currentStats;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadLastCleanup();
    }

    private async Task LoadLastCleanup()
    {
        try
        {
            loading = true;
            loadingMessage = "Lade letzte Bereinigung...";
            lastCleanup = await CleanupService.GetLastCleanupStatsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading last cleanup stats");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadPreview()
    {
        try
        {
            loading = true;
            loadingMessage = "Analysiere Daten...";
            previewStats = await CleanupService.GetCleanupPreviewAsync();
            currentStats = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading preview");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RunCleanup(bool dryRun)
    {
        try
        {
            loading = true;
            loadingMessage = dryRun ? "Führe Dry Run durch..." : "Bereinigung läuft...";
    
            currentStats = await CleanupService.CleanupPersonalDataAsync();
            previewStats = null;
            
            // Reload last cleanup
            await LoadLastCleanup();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error running cleanup");
            currentStats = new GdprCleanupStats
            {
                Success = false,
                ErrorMessage = ex.Message,
                DryRun = dryRun
            };
        }
        finally
        {
            loading = false;
        }
    }
}
