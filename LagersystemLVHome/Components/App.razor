@using Microsoft.AspNetCore.Components.Authorization

<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#667eea" />
    <meta name="description" content="Professionelles Lagerverwaltungssystem mit QR-Scanner und Multi-Tenancy" />
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json" />
    
    <title>LagerSystem LV Home</title>
    <base href="/" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- PWA Icons -->
    <link rel="apple-touch-icon" sizes="72x72" href="/icons/icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="96x96" href="/icons/icon-96x96.png" />
    <link rel="apple-touch-icon" sizes="128x128" href="/icons/icon-128x128.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/icons/icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/icons/icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="384x384" href="/icons/icon-384x384.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512x512.png" />
    
    <!-- Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/dashboard.css" />
    <link rel="stylesheet" href="css/skeleton.css" />
    <link rel="stylesheet" href="css/empty-state.css" />
    <link rel="stylesheet" href="css/micro-interactions.css" />
    <link rel="stylesheet" href="css/toast.css" />
    <link rel="stylesheet" href="css/notifications.css" />
    <link rel="stylesheet" href="css/session-blocking-overlay.css" />
    <link rel="stylesheet" href="LagersystemLVHome.styles.css" />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <!-- Session restoration for mobile reload scenarios -->
        <LagersystemLVHome.Components.Shared.SessionRestorer />

        <Routes />
        <LagersystemLVHome.Components.Shared.ToastContainer />
    </CascadingAuthenticationState>
    
    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Chart.js for Application Insights -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  
    <!-- ApexCharts for Dashboard -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <!-- html5-qrcode library for barcode/QR scanning -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    
    <!-- JSZip for batch QR code downloads -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <!-- Mobile Menu & Responsive Features -->
    <script src="js/mobile-menu.js"></script>
    
    <!-- Keyboard Shortcuts -->
    <script src="js/keyboard-shortcuts.js"></script>
    
    <!-- Camera Service -->
    <script src="js/camera-service.js"></script>
    
    <!-- QR Code Helper -->
    <script src="js/qr-code-helper.js"></script>
    
    <!-- Application Insights Charts -->
    <script src="js/insights-charts.js"></script>
    
    <!-- Session Management Charts -->
    <script src="js/sessionCharts.js"></script>
    
    <!-- Session Monitor -->
    <script src="js/sessionMonitor.js"></script>

    <!-- Session blocking overlay (JavaScript implementation) -->
    <script src="js/sessionBlockingOverlay.js"></script>

    <!-- PWA Helper (Service Worker Registration) -->
    <script src="js/pwa-helper.js"></script>
 
    <!-- PWA Install Prompt (Global Install Button) -->
    <script src="js/pwa-install-prompt.js"></script>
    
    <!-- Client info helper (login/session tracking) -->
    <script src="js/clientInfo.js"></script>

    <!-- Cookie helper (session id storage, mobile compatible) -->
    <script src="js/cookieHelper.js"></script>

    <!-- WebAuthn/Passkey helper (secure device identification) -->
    <script src="js/webAuthnHelper.js"></script>

    <!-- File Download Helper -->
    <script src="js/file-download.js"></script>
    <script src="js/appHelper.js"></script>

    <!-- Backup Folder Browser Script -->
    <script src="js/backup-folder-browser.js"></script>
    
    <!-- Setup File Upload Script -->
    <script src="js/setup-file-upload.js"></script>
</body>

</html>
