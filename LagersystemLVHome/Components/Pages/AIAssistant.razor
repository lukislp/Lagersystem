@page "/ai-assistant"
@inherits CancellableComponentBase
@using LagersystemLVHome.Application.Services
@using LagersystemLVHome.Domain.Models
@using Markdig
@inject IOllamaService OllamaService
@inject ILogger<AIAssistant> Logger
@inject IJSRuntime JSRuntime
@inject I18nText I18nText
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

<PageTitle>@T.AIAssistant_Title - LagerSystem</PageTitle>

<div class="ai-container">
    <div class="ai-header">
        <h2><i class="bi bi-robot"></i> @T.AIAssistant_Title</h2>
        <div class="status-badge @(ollamaAvailable ? "status-ok" : "status-error")">
            @if (ollamaAvailable)
            {
                <i class="bi bi-check-circle"></i> <text>Verbunden mit gpt-oss:120b-cloud</text>
            }
            else
            {
                <i class="bi bi-x-circle"></i> <text>@T.AIAssistant_OllamaError</text>
            }
        </div>
    </div>

    <div class="chat-box" @ref="chatBox">
        @if (isInitialLoading)
        {
            <div class="empty-state">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                <p style="margin-top: 1rem;"><strong>@T.AIAssistant_Loading</strong></p>
                <p style="font-size: 0.9rem;">@T.AIAssistant_LoadingHint</p>
            </div>
        }
        else if (!messages.Any() && !isThinking && !ollamaAvailable)
        {
            <div class="empty-state">
                <div><i class="bi bi-x-circle text-danger" style="font-size: 3rem;"></i></div>
                <p><strong>@T.AIAssistant_OllamaError</strong></p>
                <p>@T.AIAssistant_OllamaHint</p>
            </div>
        }
        else
        {
            @foreach (var msg in messages)
            {
                <div class="message @(msg.IsUser ? "message-user" : "message-ai")">
                    @if (msg.IsUser)
                    {
                        <div>@msg.Text</div>
                    }
                    else
                    {
                        <div class="markdown-content">
                            @((MarkupString)RenderMarkdown(msg.Text))
                        </div>
                    }
                    <div class="message-time">@msg.Timestamp.ToString("HH:mm")</div>
                </div>
            }

            @if (isThinking)
            {
                <div class="thinking">
                    <i class="bi bi-three-dots"></i> AI denkt nach...
                </div>
            }
        }
    </div>

    <div class="input-group-wrapper">
        <textarea rows="3"
                  placeholder="Z.B.: 'Welche Artikel laufen bald ab?', 'Wo liegt Edding?', 'Zeige abgelaufene Chargen', 'Welche Lebensmittel haben MHD in 7 Tagen?'"
                  @bind="userInput"
                  @bind:event="oninput"
                  @onkeydown="HandleKeyDown"
                  disabled="@(!ollamaAvailable || isThinking)"></textarea>

        <button class="btn-send" @onclick="SendMessage" disabled="@(!CanSendMessage())">
            @if (isThinking)
            {
                <div>
                    <div class="spinner-border spinner-border-sm"></div>
                    <div>@T.AIAssistant_Waiting</div>
                </div>
            }
            else
            {
                <div>
                    <i class="bi bi-send-fill" style="font-size: 1.2rem;"></i>
                    <div>@T.AIAssistant_Send</div>
                </div>
            }
        </button>
    </div>
</div>

@code {
    private const string MODEL_NAME = "gpt-oss:120b-cloud";

    private string userInput = "";
    private List<ChatMessage> messages = new();
    private bool isThinking = false;
    private bool ollamaAvailable = false;
    private ElementReference chatBox;
    private bool isInitialLoading = true;

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; } = DateTime.Now;
    }

    private string RenderMarkdown(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return "";

        try
        {
            markdown = markdown.Replace("??", "🔴");
            markdown = markdown.Replace("❓❓", "🔴");

            markdown = System.Text.RegularExpressions.Regex.Replace(
                markdown, @"\?\s+(OK|Gut|Stabil)", "$1",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);

            markdown = System.Text.RegularExpressions.Regex.Replace(
                markdown, @"\?\s+(Niedrig|Warnung|Achtung)", "$1",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);

            markdown = System.Text.RegularExpressions.Regex.Replace(
                markdown, @"\?\s+(KRITISCH|Dringend|Gefahr)", "🔴 $1",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);

            markdown = System.Text.RegularExpressions.Regex.Replace(
                markdown, @"\?\s+(Handlungsempfehlung|Empfehlung|Tipp|Info)", "💡 $1",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase);

            markdown = System.Text.RegularExpressions.Regex.Replace(
                markdown, @"(?<![?❓])\?(?![?❓])", "✅");

            var pipeline = new MarkdownPipelineBuilder()
                .UseAdvancedExtensions()
                .Build();

            var html = Markdown.ToHtml(markdown, pipeline);

            html = html.Replace(":red_circle:", "🔴")
                .Replace(":warning:", "⚠️")
                .Replace(":white_check_mark:", "✅")
                .Replace(":check_mark:", "✅")
                .Replace(":green_circle:", "✅")
                .Replace(":yellow_circle:", "⚠️")
                .Replace(":package:", "📦")
                .Replace(":moneybag:", "💰")
                .Replace(":chart_with_upwards_trend:", "📊")
                .Replace(":bar_chart:", "📊")
                .Replace(":bulb:", "💡")
                .Replace(":light_bulb:", "💡")
                .Replace(":rocket:", "🚀")
                .Replace(":fire:", "🔥")
                .Replace(":star:", "⭐")
                .Replace(":zap:", "⚡")
                .Replace(":exclamation:", "❗")
                .Replace(":arrow_right:", "➡️")
                .Replace(":arrow_up:", "⬆️")
                .Replace(":arrow_down:", "⬇️")
                .Replace(":x:", "❌")
                .Replace(":information_source:", "ℹ️");

            html = html.Replace("&#63;&#63;", "🔴")
                .Replace("&#63;", "✅")
                .Replace("&quest;&quest;", "🔴")
                .Replace("&quest;", "✅");

            html = System.Text.RegularExpressions.Regex.Replace(
                html, @"\?\s*(OK|Niedrig|KRITISCH|Gut|Stabil|Handlungsempfehlung)",
                m =>
                {
                    var status = m.Groups[1].Value;
                    var emoji = status.ToLower() switch
                    {
                        "ok" or "gut" or "stabil" => "✅",
                        "niedrig" => "⚠️",
                        "kritisch" => "🔴",
                        _ => "💡"
                    };
                    return $"{emoji} {status}";
                });

            return html;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rendering markdown");
            return $"<p>{System.Web.HttpUtility.HtmlEncode(markdown)}</p>";
        }
    }

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await CheckOllamaStatus();

        if (ollamaAvailable)
        {
            await SendInitialGreeting();
        }
        else
        {
            isInitialLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && messages.Any())
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("appHelper.scrollToBottom", ".chat-box");
            }
            catch { }
        }
    }

    private async Task CheckOllamaStatus()
    {
        try
        {
            Logger.LogInformation("Checking Ollama status...");
            ollamaAvailable = await OllamaService.IsOllamaRunningAsync();

            if (ollamaAvailable)
            {
                Logger.LogInformation("Ollama is running - using model: {Model}", MODEL_NAME);
            }
            else
            {
                Logger.LogWarning("Ollama is not running");
            }
        }
        catch (Exception ex)
        {
            ollamaAvailable = false;
            Logger.LogError(ex, "Error checking Ollama status");
        }

        StateHasChanged();
    }

    private async Task SendInitialGreeting()
    {
        try
        {
            Logger.LogInformation("Sending initial greeting...");
            var response = await OllamaService.AskInventoryQuestionAsync("Hi");

            messages.Add(new ChatMessage
            {
                Text = response,
                IsUser = false,
                Timestamp = DateTime.Now
            });

            Logger.LogInformation("Initial greeting received");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending initial greeting");

            messages.Add(new ChatMessage
            {
                Text = "Willkommen! Leider konnte ich die Begrüßung nicht laden. Stelle mir trotzdem gerne eine Frage!",
                IsUser = false,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isInitialLoading = false;
            StateHasChanged();
        }
    }

    private bool CanSendMessage() => ollamaAvailable && !isThinking && !string.IsNullOrWhiteSpace(userInput);

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && CanSendMessage())
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (!CanSendMessage())
            return;

        var userMessage = userInput.Trim();

        messages.Add(new ChatMessage
        {
            Text = userMessage,
            IsUser = true,
            Timestamp = DateTime.Now
        });

        userInput = "";
        StateHasChanged();

        isThinking = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Sending message to Ollama with model {Model}: {Message}", MODEL_NAME, userMessage);
            var response = await OllamaService.AskInventoryQuestionAsync(userMessage);

            messages.Add(new ChatMessage
            {
                Text = response,
                IsUser = false,
                Timestamp = DateTime.Now
            });

            Logger.LogInformation("Received response from Ollama");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending message to Ollama");

            messages.Add(new ChatMessage
            {
                Text = $"Fehler: {ex.Message}",
                IsUser = false,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isThinking = false;
            StateHasChanged();
        }
    }
}
