<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Generate XML documentation for OpenAPI -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Explicit build paths -->
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(TargetFramework)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>

    <!-- Prevent files from being copied to the project directory -->
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <UseCommonOutputDirectory>false</UseCommonOutputDirectory>

    <!-- Build output optimization: German localization only -->
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>

    <!-- Static web assets handling for publish -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

    <!-- Force copying static web assets on publish -->
    <PublishStaticWebAssetsContent>true</PublishStaticWebAssetsContent>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Web/host packages and Blazor UI packages used directly by this project.
      All other runtime dependencies (EF Core providers, ML, auth crypto,
      cloud SDKs, image/QR processing, etc.) are owned by the layered
      sub-projects (LagersystemLVHome.Application / .Infrastructure / .Data)
      and flow into this project transitively via ProjectReference.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Pinned above the transitive 2.0.0 to patch GHSA-v5pm-xwqc-g5wc (circular schema references terminate parsing) -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.13.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />

    <!-- Blazor UI components used inside Razor pages owned by this project -->
    <PackageReference Include="Blazor-ApexCharts" Version="7.0.0" />
    <PackageReference Include="Blazor.Extensions.Canvas" Version="1.1.1" />
    <PackageReference Include="Toolbelt.Blazor.I18nText" Version="14.1.1" />
  </ItemGroup>

  <!-- Include ML models in publish output -->
  <ItemGroup>
    <!-- ML model assets are owned by LagersystemLVHome.Infrastructure now and copied via that project's Content items. -->
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="AR\**" />
    <Content Remove="AR\**" />
    <EmbeddedResource Remove="AR\**" />
    <None Remove="AR\**" />
  </ItemGroup>

  <!-- Include GeoIP2 database in output, if present. MaxMind's license doesn't permit
       redistributing it, so it's gitignored and won't exist on a fresh checkout (CI, or
       anyone else cloning this repo) - GeoLocationService already treats it as optional
       at runtime, so the build shouldn't hard-require it either. -->
  <ItemGroup>
    <Content Include="GeoData\GeoLite2-City.mmdb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('GeoData\GeoLite2-City.mmdb')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LagersystemLVHome.Domain\LagersystemLVHome.Domain.csproj" />
    <ProjectReference Include="..\LagersystemLVHome.Data\LagersystemLVHome.Data.csproj" />
    <ProjectReference Include="..\LagersystemLVHome.Application\LagersystemLVHome.Application.csproj" />
    <ProjectReference Include="..\LagersystemLVHome.Infrastructure\LagersystemLVHome.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Post-build: remove unnecessary localization folders and tools -->
  <Target Name="CleanupBuildOutput" AfterTargets="Build">
    <ItemGroup>
      <!-- Remove unnecessary localization folders (keep 'de') -->
      <LocaleDirectoriesToRemove Include="$(OutputPath)cs" />
      <LocaleDirectoriesToRemove Include="$(OutputPath)es" />
  <LocaleDirectoriesToRemove Include="$(OutputPath)fr" />
      <LocaleDirectoriesToRemove Include="$(OutputPath)it" />
      <LocaleDirectoriesToRemove Include="$(OutputPath)ja" />
      <LocaleDirectoriesToRemove Include="$(OutputPath)ko" />
  <LocaleDirectoriesToRemove Include="$(OutputPath)pl" />
      <LocaleDirectoriesToRemove Include="$(OutputPath)pt-BR" />
      <LocaleDirectoriesToRemove Include="$(OutputPath)ru" />
      <LocaleDirectoriesToRemove Include="$(OutputPath)tr" />
  <LocaleDirectoriesToRemove Include="$(OutputPath)zh-Hans" />
      <LocaleDirectoriesToRemove Include="$(OutputPath)zh-Hant" />
      
      <!-- Remove obsolete tools directory (pg_dump/mysqldump no longer needed) -->
      <LocaleDirectoriesToRemove Include="$(OutputPath)Tools" />
    </ItemGroup>
    
    <RemoveDir Directories="@(LocaleDirectoriesToRemove)" />
    
    <Message Text="Removed unnecessary localization folders and Tools directory" Importance="high" />
  </Target>

</Project>
