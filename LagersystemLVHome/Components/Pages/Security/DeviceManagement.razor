@page "/admin/device-management"
@rendermode InteractiveServer
@using LagersystemLVHome.Application.Services
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using LagersystemLVHome.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject ISessionManagementService SessionService
@inject IAuthService AuthService
@inject IDeviceFingerprintService DeviceFingerprintService
@inject IAdminQueryService AdminQueryService
@inject ILogger<DeviceManagement> Logger
@implements IDisposable
@inject I18nText I18nText

<PageTitle>@T.DeviceMgmt_Title - LagerSystem</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-hdd-stack text-primary me-2"></i>
                @T.DeviceMgmt_Title
            </h1>
            <p class="text-muted mb-0">
                @T.DeviceMgmt_Subtitle
                <!-- Auto-refresh indicator -->
                <span class="ms-2 badge bg-success">
                    <i class="bi bi-arrow-repeat"></i> @T.DeviceMgmt_AutoRefresh
                </span>
            </p>
        </div>
        
        <div class="d-flex gap-2">
            <!-- Toggle auto-refresh -->
            <button class="btn @(autoRefreshEnabled ? "btn-success" : "btn-outline-secondary")"
                    @onclick="ToggleAutoRefresh">
                <i class="bi @(autoRefreshEnabled ? "bi-pause-circle" : "bi-play-circle")"></i>
                @(autoRefreshEnabled ? T.DeviceMgmt_AutoRefresh_Pause : T.DeviceMgmt_AutoRefresh_Start)
            </button>
          
            <button class="btn btn-primary" @onclick="LoadData" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise @(isLoading ? "rotating" : "")"></i>
                @T.DeviceMgmt_Refresh
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@T.DeviceMgmt_Loading</span>
            </div>
        </div>
    }
    else
    {
        <!-- Filter & Search -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@T.DeviceMgmt_SearchUser</label>
                        <input type="text" class="form-control"
                               placeholder="@T.DeviceMgmt_SearchPlaceholder"
                               @bind="searchQuery"
                               @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@T.DeviceMgmt_Role</label>
                        <select class="form-select" @bind="filterRole" @bind:event="onchange">
                            <option value="">@T.DeviceMgmt_AllRoles</option>
                            <option value="User">@T.DeviceMgmt_RoleUser</option>
                            <option value="Manager">@T.DeviceMgmt_RoleManager</option>
                            <option value="Admin">@T.DeviceMgmt_RoleAdmin</option>
                            <option value="SuperAdmin">@T.DeviceMgmt_RoleSuperAdmin</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@T.DeviceMgmt_Status</label>
                        <select class="form-select" @bind="filterActiveOnly" @bind:event="onchange">
                            <option value="false">@T.DeviceMgmt_AllSessions</option>
                            <option value="true">@T.DeviceMgmt_ActiveOnly</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">@T.DeviceMgmt_KPI_Users</h6>
                                <h3 class="mb-0">@filteredUsers.Count()</h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 p-3 rounded">
                                <i class="bi bi-people-fill text-primary fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">@T.DeviceMgmt_KPI_Devices</h6>
                                <h3 class="mb-0">@totalDevices</h3>
                            </div>
                            <div class="bg-info bg-opacity-10 p-3 rounded">
                                <i class="bi bi-devices text-info fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">@T.DeviceMgmt_KPI_Sessions</h6>
                                <h3 class="mb-0 text-success">@activeSessions</h3>
                            </div>
                            <div class="bg-success bg-opacity-10 p-3 rounded">
                                <i class="bi bi-circle-fill text-success fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">@T.DeviceMgmt_KPI_VPN</h6>
                                <h3 class="mb-0 @(vpnConnections > 0 ? "text-warning" : "")">@vpnConnections</h3>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded">
                                <i class="bi bi-shield-exclamation text-warning fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- User List with Devices -->
        @if (filteredUsers.Any())
        {
            <div class="row g-3">
                @foreach (var user in filteredUsers)
                {
                    var userSessions = allSessions
                .Where(s => s.UserId == user.Id && !string.IsNullOrEmpty(s.DeviceFingerprint))
                .GroupBy(s => ResolvePrimary(s.DeviceFingerprint!))
                .ToList();
  
                    var activeUserSessions = userSessions.Count(g => g.Any(s => s.IsActive));

                    <div class="col-12">
                        <div class="card @(activeUserSessions > 0 ? "border-success" : "")">
                            <div class="card-header bg-light">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (activeUserSessions > 0)
                                            {
                                                <span class="badge bg-success pulse">
                                                    <i class="bi bi-circle-fill" style="font-size: 6px;"></i>
                                                </span>
                                            }
                                            <div>
                                                <h5 class="mb-0">
                                                    @user.DisplayName
                                                    <small class="text-muted">@@@user.Username</small>
                                                </h5>
                                                <small class="text-muted">
                                                    <i class="bi bi-envelope me-1"></i>@user.Email
                                                    @if (user.Warehouse != null)
                                                    {
                                                        <span class="ms-2">
                                                            <i class="bi bi-building me-1"></i>@user.Warehouse.Name
                                                        </span>
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <span class="badge bg-@GetRoleBadgeClass(user.Role) me-2">
                                            @GetRoleDisplayName(user.Role)
                                        </span>
                                        @if (userSessions.Any())
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-devices"></i>
                                                @userSessions.Count @(userSessions.Count == 1 ? T.DeviceMgmt_DeviceCount_Single : T.DeviceMgmt_DeviceCount_Multi)
                                            </span>
                                        }
                                        @if (activeUserSessions > 0)
                                        {
                                            <span class="badge bg-success ms-1">
                                                    @string.Format(T.DeviceMgmt_DevicesActive ?? "{0} aktiv", activeUserSessions)
                                                </span>
                                        }
                                    </div>
                                </div>
                            </div>
      
                            @if (userSessions.Any())
                            {
                                <div class="card-body">
                                    <UserDeviceList UserId="@user.Id"
                                                    CurrentSessionId="@null"
                                                    AllowTerminate="true"
                                                    ShowFingerprint="true"
                                                    OnDeviceTerminated="LoadData" />
                                </div>
                            }
                            else
                            {
                                <div class="card-body text-center text-muted py-4">
                                    <i class="bi bi-info-circle me-2"></i>
                                    @T.DeviceMgmt_NoDevices
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-search" style="font-size: 3rem; opacity: 0.3;"></i>
                    <p class="text-muted mt-3 mb-0">@T.DeviceMgmt_NoUsers</p>
                </div>
            </div>
        }
    }
</div>


@code {
    private List<User> allUsers = new();
    private List<Domain.Models.UserSession> allSessions = new();
    // Cache: linkedFingerprint -> primaryFingerprint
    private Dictionary<string, string> _fpLinks = new();
    
    private string searchQuery = "";
    private string filterRole = "";
    private bool filterActiveOnly = false;
    
    private bool isLoading = false; // Only true on the initial load
    private bool isInitialLoad = true; // Flag for the first load
    
    // Auto-Refresh Timer
    private System.Threading.Timer? _refreshTimer;
    private bool autoRefreshEnabled = true;
    private const int RefreshIntervalSeconds = 5;
    
    // Previous values for change detection
    private int _previousTotalDevices = 0;
    private int _previousActiveSessions = 0;
    private int _previousVpnConnections = 0;
    private int _previousUserCount = 0;

    private IEnumerable<User> filteredUsers
    {
        get
        {
            var query = allUsers.AsEnumerable();

            // Suche
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(u =>
                u.Username.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
        u.DisplayName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
        (u.Email?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            // Rolle
            if (!string.IsNullOrWhiteSpace(filterRole))
            {
                if (Enum.TryParse<UserRole>(filterRole, out var role))
                {
                    query = query.Where(u => u.Role == role);
                }
            }

            // Only with active sessions
            if (filterActiveOnly)
            {
                var usersWithActiveSessions = allSessions
            .Where(s => s.IsActive)
        .Select(s => s.UserId)
                        .Distinct()
        .ToHashSet();
     
                query = query.Where(u => usersWithActiveSessions.Contains(u.Id));
            }

            return query.OrderBy(u => u.DisplayName);
        }
    }

    private int totalDevices => allSessions
    .Where(s => !string.IsNullOrEmpty(s.DeviceFingerprint))
        .Select(s => ResolvePrimary(s.DeviceFingerprint!))
        .Distinct()
        .Count();

    private string ResolvePrimary(string fp)
    {
        if (_fpLinks.TryGetValue(fp, out var primary))
            return primary;
        return fp;
    }

    private int activeSessions => allSessions.Count(s => s.IsActive);

    private int vpnConnections => allSessions.Count(s => s.IsActive && s.IsVpn);

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadData();
 
        // Start the auto-refresh timer
        StartAutoRefresh();
    }

    // Auto-refresh methods
    private void StartAutoRefresh()
    {
        if (_refreshTimer != null)
        {
            _refreshTimer.Dispose();
        }

        _refreshTimer = new System.Threading.Timer(async _ =>
                {
                    if (autoRefreshEnabled && !isLoading)
                    {
                        await InvokeAsync(async () =>
                    {
                        await LoadDataSilent(); // Use the silent-load path
                    });
                    }
                }, null, TimeSpan.FromSeconds(RefreshIntervalSeconds), TimeSpan.FromSeconds(RefreshIntervalSeconds));

        Logger.LogInformation("Auto-refresh timer started (interval: {Interval}s)", RefreshIntervalSeconds);
    }

    private void ToggleAutoRefresh()
    {
        autoRefreshEnabled = !autoRefreshEnabled;
        Logger.LogInformation("Auto-refresh {Status}", autoRefreshEnabled ? "enabled" : "disabled");
        StateHasChanged();
    }

    // Silent load without spinner
    private async Task LoadDataSilent()
    {
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            var warehouseId = currentUser?.Role == UserRole.SuperAdmin ? null : (int?)currentUser?.WarehouseId;

            // Load fresh data
            var newUsersResult = await AdminQueryService.GetActiveUsersWithWarehouseAsync(warehouseId);
            var newUsers = newUsersResult.ToList();

            var newSessions = await SessionService.GetActiveSessionsAsync(warehouseId, false);

            // Refresh fingerprint links
            await LoadFingerprintLinksAsync();

            // CHANGE DETECTION: only update when something actually changed
            bool hasChanges = false;
    
            // Check whether KPIs have changed
            var newTotalDevices = newSessions
            .Where(s => !string.IsNullOrEmpty(s.DeviceFingerprint))
            .Select(s => ResolvePrimary(s.DeviceFingerprint!))
                .Distinct()
                .Count();
            var newActiveSessions = newSessions.Count(s => s.IsActive);
            var newVpnConnections = newSessions.Count(s => s.IsActive && s.IsVpn);
            var newUserCount = newUsers.Count;

            if (newTotalDevices != _previousTotalDevices ||
                            newActiveSessions != _previousActiveSessions ||
                    newVpnConnections != _previousVpnConnections ||
                newUserCount != _previousUserCount ||
                    !SessionsEqual(allSessions, newSessions))
            {
                hasChanges = true;
        
                // Update data
                allUsers = newUsers;
                allSessions = newSessions;
     
                // Update previous values
                _previousTotalDevices = newTotalDevices;
                _previousActiveSessions = newActiveSessions;
                _previousVpnConnections = newVpnConnections;
                _previousUserCount = newUserCount;

                Logger.LogInformation("Changes detected - updating UI (Users: {UserCount}, Sessions: {SessionCount})",
                allUsers.Count, allSessions.Count);
             
                // IMPORTANT: StateHasChanged() WITHOUT scroll reset
                StateHasChanged();
            }
            else
            {
                Logger.LogDebug("No changes detected - skipping UI update");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading device management data (silent)");
        }
    }

    // Vergleicht Session-Listen
    private bool SessionsEqual(List<Domain.Models.UserSession> list1, List<Domain.Models.UserSession> list2)
    {
        if (list1.Count != list2.Count)
            return false;

        // Fast check: count active sessions per user
        var active1 = list1.Where(s => s.IsActive).GroupBy(s => s.UserId).ToDictionary(g => g.Key, g => g.Count());
        var active2 = list2.Where(s => s.IsActive).GroupBy(s => s.UserId).ToDictionary(g => g.Key, g => g.Count());

        if (active1.Count != active2.Count)
            return false;

        foreach (var kvp in active1)
        {
            if (!active2.TryGetValue(kvp.Key, out var count) || count != kvp.Value)
                return false;
        }

        return true;
    }

    // Manual refresh (with spinner)
    private async Task LoadData()
    {
        try
        {
            // Only show the spinner on the first load or an explicit manual refresh
            if (isInitialLoad)
            {
                isLoading = true;
                StateHasChanged();
            }

            var currentUser = await AuthService.GetCurrentUserAsync();
            var warehouseId = currentUser?.Role == UserRole.SuperAdmin ? null : (int?)currentUser?.WarehouseId;

            // Load all users
            var users = await AdminQueryService.GetActiveUsersWithWarehouseAsync(warehouseId);
            allUsers = users.ToList();

            // Load all sessions (including ended ones)
            allSessions = await SessionService.GetActiveSessionsAsync(warehouseId, false);

            // Load fingerprint links for accurate device counting
            await LoadFingerprintLinksAsync();

            // Initialize previous values
            _previousTotalDevices = totalDevices;
            _previousActiveSessions = activeSessions;
            _previousVpnConnections = vpnConnections;
            _previousUserCount = allUsers.Count;

            Logger.LogInformation("Loaded {UserCount} users with {SessionCount} sessions",
    allUsers.Count, allSessions.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading device management data");
        }
        finally
        {
            isLoading = false;
            isInitialLoad = false;
            StateHasChanged();
        }
    }

    private string GetRoleBadgeClass(UserRole role)
    {
        return role switch
        {
            UserRole.SuperAdmin => "danger",
            UserRole.Admin => "warning",
            UserRole.Manager => "info",
            _ => "secondary"
        };
    }

    private string GetRoleDisplayName(UserRole role)
    {
        return role switch
        {
            UserRole.SuperAdmin => "Super Admin",
            UserRole.Admin => "Administrator",
            UserRole.Manager => "Manager",
            _ => "Benutzer"
        };
    }
    
    private async Task LoadFingerprintLinksAsync()
    {
        try
        {
            // Load links for all users that appear in allSessions
            var userIds = allSessions.Select(s => s.UserId).Distinct().ToList();
            _fpLinks.Clear();
            foreach (var userId in userIds)
            {
                var links = await DeviceFingerprintService.GetLinkedFingerprintsAsync(userId);
                foreach (var link in links)
                {
                    _fpLinks[link.LinkedFingerprint] = link.PrimaryFingerprint;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading fingerprint links");
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        Logger.LogInformation("Device management auto-refresh timer disposed");
    }
}
