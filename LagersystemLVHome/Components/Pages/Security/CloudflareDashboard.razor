@page "/admin/cloudflare"
@inherits CancellableComponentBase
@using LagersystemLVHome.Application.Services
@using LagersystemLVHome.Application.Configuration
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Authorization
@inject ICloudflareService CloudflareService
@inject IOptions<CloudflareSettings> Settings
@inject IToastService ToastService
@inject ILogger<CloudflareDashboard> Logger
@inject I18nText I18nText
@attribute [Authorize(Roles = "SuperAdmin,Admin")]

<PageTitle>@T.Cloudflare_Title - LagerSystem</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="bi bi-cloud-fill"></i> @T.Cloudflare_Title</h2>
                    <p class="text-muted">@T.Cloudflare_Subtitle</p>
                </div>
                <div>
                    <a href="/docs/cloudflare" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-book"></i> Dokumentation
                    </a>
                    @if (isCloudflareEnabled)
                    {
                        <span class="badge bg-success fs-6">
                            <i class="bi bi-check-circle"></i> Cloudflare Aktiv
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6">
                            <i class="bi bi-x-circle"></i> Cloudflare Deaktiviert
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!isCloudflareEnabled)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            <strong>@T.Cloudflare_Disabled</strong>
            <p class="mb-0">
                Aktiviere Cloudflare in <code>appsettings.json</code> um alle Features zu nutzen.
                Siehe <a href="/docs/cloudflare" class="alert-link">@T.Cloudflare_SetupGuide</a>.
            </p>
        </div>
    }
    else if (!hasApiToken)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>@T.Cloudflare_TokenMissing</strong>
            <p class="mb-0">
                Einige Features benötigen einen Cloudflare API-Token.
                Siehe <a href="/docs/cloudflare#api-token" class="alert-link">@T.Cloudflare_Guide</a>.
            </p>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Lade Daten...</span>
            </div>
            <p class="mt-3 text-muted">@T.Cloudflare_Loading</p>
        </div>
    }
    else if (dashboardData != null)
    {
        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <!-- Total Requests -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">@T.Cloudflare_KPI_Requests</h6>
                                <h3 class="mb-0">@FormatNumber(dashboardData.Analytics?.Requests.All ?? 0)</h3>
                            </div>
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                <i class="bi bi-graph-up text-primary fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cache Hit Rate -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">@T.Cloudflare_KPI_CacheHit</h6>
                                <h3 class="mb-0">@(dashboardData.CacheStats?.CacheHitRate.ToString("F1") ?? "0")%</h3>
                            </div>
                            <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                <i class="bi bi-lightning-charge text-success fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Threats Blocked -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">@T.Cloudflare_KPI_ThreatsBlocked</h6>
                                <h3 class="mb-0">@FormatNumber(dashboardData.Analytics?.Threats.All ?? 0)</h3>
                            </div>
                            <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                                <i class="bi bi-shield-fill-exclamation text-danger fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bandwidth Saved -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">@T.Cloudflare_KPI_BandwidthSaved</h6>
                                <h3 class="mb-0">@FormatBytes(dashboardData.Analytics?.Bandwidth.Cached ?? 0)</h3>
                            </div>
                            <div class="rounded-circle bg-info bg-opacity-10 p-3">
                                <i class="bi bi-cloud-arrow-down text-info fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Security & Performance -->
        <div class="row g-3 mb-4">
            <!-- Security Status -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0">
                        <h5 class="mb-0"><i class="bi bi-shield-check"></i> @T.Cloudflare_Security_Title</h5>
                    </div>
                    <div class="card-body">
                        @if (dashboardData.SecurityLevel != null)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">@T.Cloudflare_SecurityLevel</label>
                                <select class="form-select" @bind="selectedSecurityLevel" @bind:after="UpdateSecurityLevel">
                                    <option value="@CloudflareSecurityLevel.Off">Off</option>
                                    <option value="@CloudflareSecurityLevel.EssentiallyOff">Essentially Off</option>
                                    <option value="@CloudflareSecurityLevel.Low">Low</option>
                                    <option value="@CloudflareSecurityLevel.Medium">Medium (Empfohlen)</option>
                                    <option value="@CloudflareSecurityLevel.High">High</option>
                                    <option value="@CloudflareSecurityLevel.UnderAttack">Under Attack 🚨</option>
                                </select>
                            </div>
                        }

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold">@T.Cloudflare_AutoEscalation</span>
                                <span class="badge @(Settings.Value.AutoEscalation.Enabled ? "bg-success" : "bg-secondary")">
                                    @(Settings.Value.AutoEscalation.Enabled ? "Aktiv" : "Inaktiv")
                                </span>
                            </div>
                            @if (Settings.Value.AutoEscalation.Enabled && dashboardData.EscalationStatus.IsEscalated)
                            {
                                <div class="alert alert-warning mt-2 mb-0">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <strong>@T.Cloudflare_AutoEscalationDesc</strong>
                                    <br />
                                    <small>
                                        Eskaliert seit: @dashboardData.EscalationStatus.EscalatedAt?.ToString("HH:mm:ss")
                                        @if (dashboardData.EscalationStatus.AutoDeEscalateIn.HasValue)
                                        {
                                            <text><br />De-Eskalation in: @FormatTimeSpan(dashboardData.EscalationStatus.AutoDeEscalateIn.Value)</text>
                                        }
                                    </small>
                                </div>
                            }
                        </div>

                        @if (dashboardData.SslInfo != null)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">@T.Cloudflare_SSL</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                    <input type="text" class="form-control" value="@dashboardData.SslInfo.Value" readonly />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Performance & Cache -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-speedometer2"></i> @T.Cloudflare_Perf_Title</h5>
                        <button class="btn btn-sm btn-outline-primary" @onclick="PurgeCacheAsync" disabled="@isPurging">
                            @if (isPurging)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-arrow-clockwise"></i> Purge Cache
                        </button>
                    </div>
                    <div class="card-body">
                        @if (dashboardData.CacheStats != null)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Cache Hit Rate</span>
                                    <span class="fw-bold">@dashboardData.CacheStats.CacheHitRate.ToString("F1")%</span>
                                </div>
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar bg-success"
                                         role="progressbar"
                                         style="width: @(dashboardData.CacheStats.CacheHitRate)%"
                                         aria-valuenow="@dashboardData.CacheStats.CacheHitRate"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @dashboardData.CacheStats.CacheHitRate.ToString("F1")%
                                    </div>
                                </div>
                            </div>

                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="text-center p-3 bg-light rounded">
                                        <div class="text-muted small">@T.Cloudflare_Cached</div>
                                        <div class="fs-5 fw-bold">@FormatNumber(dashboardData.CacheStats.CachedRequests)</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="text-center p-3 bg-light rounded">
                                        <div class="text-muted small">@T.Cloudflare_Uncached</div>
                                        <div class="fs-5 fw-bold">@FormatNumber(dashboardData.CacheStats.UncachedRequests)</div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="mt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       id="devMode"
                                       @bind="isDevelopmentMode"
                                       @bind:after="ToggleDevelopmentMode">
                                    <label class="form-check-label" for="devMode">
                                        Development Mode (Bypass Cache)
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Zone Info & Analytics -->
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0">
                            <h5 class="mb-0"><i class="bi bi-bar-chart-fill"></i> @T.Cloudflare_Analytics_Title</h5>
                        </div>
                        <div class="card-body">
                            @if (dashboardData.Analytics != null)
                            {
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <h6 class="text-muted">@T.Cloudflare_HTTP_StatusCodes</h6>
                                        <div class="list-group list-group-flush">
                                            @foreach (var status in dashboardData.Analytics.Requests.HttpStatus.OrderByDescending(x => x.Value).Take(5))
                                            {
                                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                    <span>@status.Key</span>
                                                    <span class="badge bg-primary rounded-pill">@FormatNumber(status.Value)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <h6 class="text-muted">@T.Cloudflare_SSL_Versions</h6>
                                        <div class="list-group list-group-flush">
                                            @foreach (var ssl in dashboardData.Analytics.Requests.Ssl.OrderByDescending(x => x.Value))
                                            {
                                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                    <span>@ssl.Key</span>
                                                    <span class="badge bg-success rounded-pill">@FormatNumber(ssl.Value)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <h6 class="text-muted">@T.Cloudflare_ThreatTypes</h6>
                                        <div class="list-group list-group-flush">
                                            @foreach (var threat in dashboardData.Analytics.Threats.Type.OrderByDescending(x => x.Value).Take(5))
                                            {
                                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                    <span>@threat.Key</span>
                                                    <span class="badge bg-danger rounded-pill">@FormatNumber(threat.Value)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Zone Info -->
            @if (dashboardData.ZoneInfo != null)
            {
                <div class="row g-3">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white border-0">
                                <h5 class="mb-0"><i class="bi bi-info-circle"></i> @T.Cloudflare_Zone_Title</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <div class="mb-2">
                                            <strong>@T.Cloudflare_Domain</strong> @dashboardData.ZoneInfo.Name
                                            </div>
                                            <div class="mb-2">
                                                <strong>@T.Cloudflare_Status</strong>
                                            <span class="badge @(dashboardData.ZoneInfo.Status == "active" ? "bg-success" : "bg-warning")">
                                                @dashboardData.ZoneInfo.Status
                                            </span>
                                        </div>
                                        <div class="mb-2">
                                            <strong>@T.Cloudflare_Plan</strong> @dashboardData.ZoneInfo.Plan.Name
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <strong>@T.Cloudflare_Nameservers</strong>
                                        <ul class="list-unstyled mb-0 mt-2">
                                            @foreach (var ns in dashboardData.ZoneInfo.NameServers)
                                            {
                                                <li><code>@ns</code></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="text-center text-muted mt-3">
                <small>
                    <i class="bi bi-clock"></i> Letzte Aktualisierung: @dashboardData.LastUpdated.ToString("HH:mm:ss")
                    <button class="btn btn-link btn-sm" @onclick="LoadDataAsync">
                        <i class="bi bi-arrow-clockwise"></i> Aktualisieren
                    </button>
                </small>
            </div>
        }
    </div>

@code {
    private CloudflareDashboardData? dashboardData;
    private bool isLoading = true;
    private bool isCloudflareEnabled;
    private bool hasApiToken;
    private bool isPurging = false;
    private bool isDevelopmentMode = false;
    private CloudflareSecurityLevel selectedSecurityLevel = CloudflareSecurityLevel.Medium;

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        isCloudflareEnabled = Settings.Value.Enabled;
        hasApiToken = !string.IsNullOrEmpty(Settings.Value.ApiToken);

        if (isCloudflareEnabled && hasApiToken)
        {
            await LoadDataAsync();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            dashboardData = await CloudflareService.GetDashboardDataAsync();
   
            if (dashboardData?.SecurityLevel != null)
            {
                selectedSecurityLevel = ParseSecurityLevel(dashboardData.SecurityLevel.Value);
            }

            isDevelopmentMode = Settings.Value.Performance.DevelopmentMode;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Cloudflare data");
            ToastService.ShowError("Error loading Cloudflare data");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task UpdateSecurityLevel()
    {
        try
        {
            var success = await CloudflareService.UpdateSecurityLevelAsync(selectedSecurityLevel);
     
            if (success)
            {
                ToastService.ShowSuccess($"Security level changed to '{selectedSecurityLevel}'");
                await LoadDataAsync();
            }
            else
            {
                ToastService.ShowError("Error changing the security level");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing the security level");
            ToastService.ShowError("Error changing the security level");
        }
    }

    private async Task PurgeCacheAsync()
    {
        isPurging = true;
        StateHasChanged();

        try
        {
            var success = await CloudflareService.PurgeCacheAsync();
      
            if (success)
            {
                ToastService.ShowSuccess("Cache cleared successfully");
            }
            else
            {
                ToastService.ShowError("Error clearing the cache");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing the cache");
            ToastService.ShowError("Error clearing the cache");
        }
        finally
        {
            isPurging = false;
            StateHasChanged();
        }
    }

    private async Task ToggleDevelopmentMode()
    {
        try
        {
            var success = await CloudflareService.SetDevelopmentModeAsync(isDevelopmentMode);
            
            if (success)
            {
                ToastService.ShowSuccess($"Development mode {(isDevelopmentMode ? "enabled" : "disabled")}");
            }
            else
            {
                ToastService.ShowError("Error toggling development mode");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling development mode");
            ToastService.ShowError("Error toggling development mode");
        }
    }

    private CloudflareSecurityLevel ParseSecurityLevel(string value)
    {
        return value switch
        {
            "off" => CloudflareSecurityLevel.Off,
            "essentially_off" => CloudflareSecurityLevel.EssentiallyOff,
            "low" => CloudflareSecurityLevel.Low,
            "medium" => CloudflareSecurityLevel.Medium,
            "high" => CloudflareSecurityLevel.High,
            "under_attack" => CloudflareSecurityLevel.UnderAttack,
            _ => CloudflareSecurityLevel.Medium
        };
    }

    private string FormatNumber(long number)
    {
        if (number >= 1_000_000)
            return $"{number / 1_000_000.0:F1}M";
        if (number >= 1_000)
            return $"{number / 1_000.0:F1}K";
        return number.ToString();
    }

    private string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) // GB
            return $"{bytes / 1_073_741_824.0:F1} GB";
        if (bytes >= 1_048_576) // MB
            return $"{bytes / 1_048_576.0:F1} MB";
        if (bytes >= 1_024) // KB
            return $"{bytes / 1_024.0:F1} KB";
        return $"{bytes} B";
    }

    private string FormatTimeSpan(TimeSpan timeSpan)
    {
        if (timeSpan.TotalMinutes < 1)
            return $"{timeSpan.Seconds}s";
        if (timeSpan.TotalHours < 1)
            return $"{timeSpan.Minutes}m {timeSpan.Seconds}s";
        return $"{timeSpan.Hours}h {timeSpan.Minutes}m";
    }
}
