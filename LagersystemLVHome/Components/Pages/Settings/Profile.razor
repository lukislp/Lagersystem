@code {
    private LagersystemLVHome.I18nText.App T = new();
    private LagersystemLVHome.Domain.Models.User? currentUser;
    private int warehouseUserCount = 0;
    private string? currentSessionId;
    
    private PasswordChangeModel passwordModel = new();
    private string passwordMessage = string.Empty;
    private bool passwordSuccess = false;
    private bool isChangingPassword = false;
  
    // DSGVO
    private bool showDeleteConfirmation = false;
    private bool isExporting = false;
    private bool isDeleting = false;

    // 2FA
    private bool show2FASetup = false;
    private bool show2FADisable = false;
    private bool showRecoveryCodesModal = false;
    private bool isProcessing2FA = false;
    private string qrCodeUrl = "";
    private string twoFactorSecret = "";
    private string verification2FACode = "";
    private string disable2FAPassword = "";
    private string twoFactorErrorMessage = "";
    private List<string>? recoveryCodes;

    // Email OTP
    private bool showEmailOtpDisable = false;
    private string disableEmailOtpPassword = "";

    // API keys
    private List<ApiKey>? apiKeys;
    private bool showCreateApiKeyModal = false;
    private bool showRevokeApiKeyModal = false;
    private string newApiKeyName = "";
    private DateTime? newApiKeyExpiry;
