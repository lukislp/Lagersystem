@* Ollama Model Selection Component *@

<div class="model-selector">
    @if (isLoading)
    {
        <div class="model-selector-loading">
            <div class="spinner-border spinner-border-sm text-primary me-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span>@T.ModelSelector_Loading</span>
        </div>
    }
    else if (hasError)
    {
        <div class="model-selector-error">
            <i class="bi bi-exclamation-triangle text-warning me-2"></i>
            <span>@errorMessage</span>
            <button class="btn btn-sm btn-outline-primary ms-2" @onclick="LoadModelsAsync">
                <i class="bi bi-arrow-clockwise"></i> @T.ModelSelector_RetryButton
            </button>
        </div>
    }
    else if (availableModels == null || !availableModels.Any())
    {
        <div class="model-selector-empty">
            <i class="bi bi-inbox text-muted me-2"></i>
            <span>@T.ModelSelector_NoModels</span>
        </div>
    }
    else
    {
        <div class="model-selector-dropdown">
            <label for="model-select" class="form-label">
                <i class="bi bi-robot me-1"></i> @T.ModelSelector_Label
            </label>
            <select id="model-select"
                    class="form-select"
                    @bind="selectedModelValue"
                    @bind:after="OnModelChanged">
                <option value="">@T.ModelSelector_Select</option>
                @foreach (var model in availableModels)
                {
                    <option value="@model">@model</option>
                }
            </select>
  
            @if (!string.IsNullOrEmpty(selectedModelValue))
            {
                <div class="model-info mt-2">
                    <small class="text-muted">
                        <i class="bi bi-check-circle text-success me-1"></i>
                        @T.ModelSelector_SelectedModel <strong>@selectedModelValue</strong>
                    </small>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject] private IOllamaService OllamaService { get; set; } = default!;
    [Inject] private ILogger<ModelSelector> Logger { get; set; } = default!;
    [Inject] private Toolbelt.Blazor.I18nText.I18nText I18nText { get; set; } = default!;

    [Parameter] public string? SelectedModel { get; set; }
    [Parameter] public EventCallback<string> SelectedModelChanged { get; set; }

    private List<string>? availableModels;
    private string? selectedModelValue;
    private bool isLoading = true;
    private bool hasError;
    private string errorMessage = "";

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        selectedModelValue = SelectedModel;
        await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        isLoading = true;
        hasError = false;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Loading available Ollama models...");
        
            var models = await OllamaService.GetAvailableModelsAsync();
     
            if (models != null && models.Any())
            {
                // Extract model names and sort them
                availableModels = models
                    .Select(m => m.Name)
                        .OrderBy(name => name)
                            .ToList();
     
                Logger.LogInformation("Successfully loaded {Count} models: {Models}",
            availableModels.Count,
                string.Join(", ", availableModels));

                // Auto-select first model if none selected
                if (string.IsNullOrEmpty(selectedModelValue) && availableModels.Any())
                {
                    // Prefer models without namespace (e.g., "llama3.2" over "fixt/home-3b-v3:latest")
                    selectedModelValue = availableModels
                            .FirstOrDefault(m => !m.Contains('/') && !m.Contains(':'))
                    ?? availableModels.First();
        
                    Logger.LogInformation("Auto-selected model: {Model}", selectedModelValue);
                    await OnModelChanged();
                }
            }
            else
            {
                Logger.LogWarning("No models returned from Ollama service");
                availableModels = new List<string>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Ollama models");
            hasError = true;
            errorMessage = $"{T.ModelSelector_LoadError} {ex.Message}";
            availableModels = new List<string>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnModelChanged()
    {
        if (!string.IsNullOrEmpty(selectedModelValue))
        {
            Logger.LogInformation("Model selected: {Model}", selectedModelValue);
            
            // Force state update BEFORE invoking callback
            await InvokeAsync(StateHasChanged);
       
            // Invoke callback to parent
            await SelectedModelChanged.InvokeAsync(selectedModelValue);
 
            // Force state update AFTER callback
            await InvokeAsync(StateHasChanged);
        }
    }
}
