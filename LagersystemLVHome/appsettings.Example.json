{
    "AllowedHosts": "*",

    "DatabaseSettings": {
        "Provider": "SQLite",
        "ConnectionString": "Data Source=inventory.db",
        "EnableRetryOnFailure": true,
        "MaxRetryCount": 3,
        "CommandTimeout": 30

        // Provider options:
        //
        // SQLite (default, no installation required):
        //   "Provider": "SQLite",
        //   "ConnectionString": "Data Source=inventory.db"
        //
        // PostgreSQL:
        //   "Provider": "PostgreSQL",
        //   "ConnectionString": "Host=localhost;Database=Lagersystem;Username=postgres;Password=PLACEHOLDER;"
        //
        // MySQL:
        //   "Provider": "MySQL",
        //   "ConnectionString": "Server=localhost;Database=Lagersystem;User=root;Password=PLACEHOLDER;"
        //
        // For encrypted passwords run: .\setup-database-password.ps1
        // The encrypted password is loaded from Pass/db.password.enc at startup.
        // Password=PLACEHOLDER is replaced automatically.
    },

    "CacheSettings": {
        "EnableDistributedCache": false,
        "EnableMemoryCache": true,
        "DefaultExpirationMinutes": 10,
        "SlidingExpirationMinutes": 5,
        "RedisConnection": "localhost:6379"
    },

    "DashboardSettings": {
        "EnableRealTimeUpdates": true,
        "MaxTopMovers": 10,
        "DefaultPeriodDays": 30,
        "RefreshInterval": 30,
        "ShowCharts": true,
        "ShowRecentMovements": true,
        "RecentMovementsCount": 5
    },

    "EmailSettings": {
        "EnableEmail": false,
        "SmtpHost": "smtp.example.com",
        "SmtpPort": 587,
        "UseSsl": true,
        "SenderEmail": "noreply@example.com",
        "SenderName": "LagerSystem",
        "SmtpUsername": "your-smtp-username",
        "SmtpPassword": "",
        "ApplicationUrl": "https://localhost:7239",
        "TemplatesPath": "EmailTemplates"
    },

    "TeamsSettings": {
        "EnableTeams": false,
        "WebhookUrl": "",
        "EnableForLowStock": true,
        "EnableForExpiry": true,
        "EnableForAnomalies": true,
        "EnableForSecurityRisks": true,
        "EnableForSystemAlerts": true,
        "MentionUsers": [],
        "ThemeColor": "0078D4",
        "IncludeActionButtons": true,
        "MaxRetries": 3,
        "TimeoutSeconds": 30
    },

    "NotificationChannels": {
        "LowStockAlerts": {
            "Email": true,
            "Teams": true,
            "InApp": true
        },
        "ExpiryAlerts": {
            "Email": true,
            "Teams": true,
            "InApp": true
        },
        "SecurityAlerts": {
            "Email": true,
            "Teams": true,
            "InApp": true
        },
        "SystemAlerts": {
            "Email": false,
            "Teams": true,
            "InApp": true
        },
        "WeeklyReports": {
            "Email": true,
            "Teams": false,
            "InApp": false
        },
        "PasswordReset": {
            "Email": true,
            "Teams": false,
            "InApp": false
        }
    },

    "GdprSettings": {
        "EnableAutoCleanup": true,
        "CleanupSchedule": "03:00",
        "BatchSize": 1000,
        "PageViewsRetentionDays": 30,
        "ApiRequestsRetentionDays": 30,
        "SessionActivitiesRetentionDays": 30,
        "UserActivitiesRetentionDays": 30,
        "AuditLogsRetentionDays": 90,
        "SecurityEventsRetentionDays": 90,
        "PerformanceMetricsRetentionDays": 7,
        "NotificationLogRetentionDays": 30,
        "KeyBackupHistoryRetentionDays": 90,
        "DryRun": false
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    },

    "PerformanceSettings": {
        "EnableResponseCompression": true,
        "EnableOutputCaching": true,
        "MaxPageSize": 100,
        "DefaultPageSize": 25
    },

    "UISettings": {
        "EnableDragDrop": true,
        "EnableKeyboardShortcuts": true,
        "EnableTouchGestures": true,
        "ToastDurationMs": 5000,
        "EnableHapticFeedback": true
    },

    "ApiSettings": {
        "EnableSwagger": true,
        "RequireApiKey": true,
        "TokenExpirationMinutes": 60
    },

    "RateLimitSettings": {
        "Enabled": true,

        "Anonymous": {
            "PermitLimit": 30,
            "Window": "00:01:00",
            "QueueLimit": 2
        },

        "Authenticated": {
            "PermitLimit": 120,
            "Window": "00:01:00",
            "QueueLimit": 10
        },

        "Admin": {
            "PermitLimit": 300,
            "Window": "00:01:00",
            "QueueLimit": 20
        },

        "SuperAdmin": {
            "PermitLimit": 600,
            "Window": "00:01:00",
            "QueueLimit": 30
        },

        "EndpointOverrides": {
            "/api/auth/login": {
                "PermitLimit": 5,
                "Window": "00:05:00",
                "QueueLimit": 0
            },
            "/api/auth/register": {
                "PermitLimit": 3,
                "Window": "00:10:00",
                "QueueLimit": 0
            },
            "/api/sensors/*": {
                "PermitLimit": 60,
                "Window": "00:01:00",
                "QueueLimit": 5
            }
        },

        "WhitelistedIPs": [],
        "BlacklistedIPs": [],

        "StatusCode": 429,
        "RetryAfterSeconds": 60,
        "LogViolations": true
    },

    "OllamaSettings": {
        "BaseUrl": "http://localhost:11434",
        "DefaultModel": "llama3",
        "MaxTokens": 2048,
        "Temperature": 0.7,
        "Timeout": 300
    },

    "GeoIP": {
        "DatabasePath": "GeoData/GeoLite2-City.mmdb",
        "EnableGeolocation": true,
        "Comment": "Download GeoLite2-City.mmdb from https://dev.maxmind.com/geoip/geolite2-free-geolocation-data"
    },

    "SecurityAlerts": {
        "Enabled": true,

        "BurstAttack": {
            "EmailEnabled": true,
            "Threshold": 50,
            "TimeWindowSeconds": 5
        },
        "BruteForce": {
            "EmailEnabled": true,
            "Threshold": 10,
            "TimeWindowMinutes": 15
        },
        "DDoS": {
            "EmailEnabled": true,
            "MinUniqueIPs": 20,
            "MinTotalRequests": 1000,
            "TimeWindowMinutes": 5
        },
        "SlowRate": {
            "EmailEnabled": false,
            "MinActiveHours": 12,
            "MinOffenders": 5
        }
    },

    "VpnDetection": {
        "VpnSubnets": [
            "10.0.5.*"
        ],
        "SubnetMatchConfidence": 95
    },

    "CloudflareSettings": {
        "Enabled": false,
        "ApiToken": "",
        "ZoneId": "",
        "AccountId": "",

        "BotProtection": {
            "Enabled": true,
            "RequireBotScoreHeader": false,
            "MinimumBotScore": 30,
            "SuspiciousBotScoreThreshold": 50,
            "BlockKnownBadBots": true,
            "BlockScrapers": false,
            "AllowedBots": [
                "Googlebot",
                "Bingbot",
                "facebookexternalhit"
            ]
        },

        "DDoSProtection": {
            "Enabled": true,
            "BlockHighThreatScore": true,
            "ThreatScoreThreshold": 10,
            "EnhanceRateLimitingOnAttack": true
        },

        "GeoLocation": {
            "Enabled": true,
            "UseCloudflareGeoIP": true,
            "BlockedCountries": [],
            "AllowedCountries": [],
            "LogUnusualCountries": true
        },

        "RateLimiting": {
            "Enabled": false,
            "UseCloudflareHeaders": false,
            "LogViolations": true
        },

        "SecurityLevel": {
            "Level": "Medium",
            "AutoEscalateOnAttack": false
        },

        "Challenge": {
            "Enabled": true,
            "Type": "Managed",
            "ValidateChallengePassage": true
        },

        "Performance": {
            "Enabled": true,
            "AutoMinify": {
                "Html": true,
                "Css": true,
                "Js": true
            },
            "EnableBrotli": true,
            "BrowserCacheTtl": 14400,
            "CacheLevel": "standard",
            "AlwaysOnline": true,
            "DevelopmentMode": false
        },

        "Analytics": {
            "Enabled": true,
            "UpdateIntervalMinutes": 15,
            "HistoricalDataDays": 30,
            "ShowThreats": true,
            "ShowCacheMetrics": true,
            "ShowBandwidth": true
        },

        "AutoEscalation": {
            "Enabled": false,
            "EnableUnderAttackMode": true,
            "ThreatScoreThreshold": 50,
            "ThreatsCountThreshold": 100,
            "TimeWindowMinutes": 5,
            "AutoDeEscalateAfterMinutes": 60,
            "NotifyOnEscalation": true
        },

        "PageRules": {
            "Enabled": false,
            "Rules": []
        },

        "SslTls": {
            "Enabled": true,
            "Mode": "full",
            "AlwaysUseHttps": true,
            "MinTlsVersion": "1.2",
            "AutomaticHttpsRewrites": true
        },

        "Firewall": {
            "Enabled": true,
            "EnableManagedRules": true,
            "CustomRules": []
        }
    },

    "PrivacyPolicySettings": {
        "Version": "2.0",
        "ShowLegalDisclaimer": true,
        "CustomFooterText": null,

        "Company": {
            "Name": "[Your Company Name]",
            "Address": "[Your Address]",
            "Email": "[Your Email]",
            "Phone": "[Your Phone]",
            "Website": null
        },

        "DPO": {
            "Name": "[Data Protection Officer]",
            "Email": "datenschutz@example.com",
            "Phone": null
        },

        "Retention": {
            "UserData": "Bis zur Konto-L\u00f6schung durch den Benutzer",
            "SessionsAndFingerprints": 30,
            "LoginLogs": 90,
            "AuditLogs": 90,
            "AnalyticsData": 90,
            "DeletedAccounts": 90,
            "DailyBackups": 30,
            "WeeklyBackups": 90,
            "MonthlyBackups": 365
        },

        "Cookies": {
            "Name": ".AspNetCore.Cookies",
            "ExpirationHours": 8,
            "HttpOnly": true,
            "Secure": true,
            "SameSite": "Lax"
        },

        "External": {
            "UseCloudflare": false,
            "Cloudflare": {
                "Name": "Cloudflare Inc.",
                "Address": "101 Townsend St, San Francisco, CA 94107, USA",
                "PrivacyPolicyUrl": "https://www.cloudflare.com/de-de/privacypolicy/",
                "DpaUrl": "https://www.cloudflare.com/de-de/cloudflare-customer-dpa/"
            }
        }
    },

    "WebAuthn": {
        "RpId": "localhost",
        "RpName": "LagerSystem",
        "Origin": "https://localhost:7239",
        "Comment": "Production: RpId = your domain (e.g. 'lagersystem.de'), Origin = 'https://lagersystem.de'"
    }
}
