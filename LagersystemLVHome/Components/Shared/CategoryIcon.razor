@* Renders a category icon - supports both emoji and Bootstrap Icons *@
@if (IsBootstrapIcon(IconClass))
{
    <i class="@IconClass @CssClass"></i>
}
else
{
    <span class="@CssClass">@IconClass</span>
}

@code {
    [Parameter]
    public string IconClass { get; set; } = "bi-box";
    
    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    private bool IsBootstrapIcon(string icon)
    {
        return icon.StartsWith("bi-");
    }
}
