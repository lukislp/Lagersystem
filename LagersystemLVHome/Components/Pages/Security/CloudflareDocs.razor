@page "/docs/cloudflare"
@inherits CancellableComponentBase
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Cloudflare Integration - Dokumentation</PageTitle>

<div class="docs-container">
    <!-- Header -->
    <div class="docs-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1><i class="bi bi-cloud-fill text-white"></i> Cloudflare Integration</h1>
                    <p class="text-white mb-0 opacity-75">Vollständige Setup & Konfigurations-Dokumentation</p>
                </div>
                <button class="btn btn-light" @onclick='() => Navigation.NavigateTo("/admin/cloudflare")'>
                    <i class="bi bi-speedometer2"></i> Zum Dashboard
                </button>
            </div>
        </div>
    </div>

    <!-- Single Column Content -->
    <div class="docs-single-layout">
        <main class="docs-content">
            <!-- Overview Section -->
            <section id="overview" class="docs-section">
                <h2><i class="bi bi-info-circle text-primary"></i> übersicht</h2>
                <div class="alert alert-info">
                    <h5 class="alert-heading"><i class="bi bi-lightbulb"></i> Was ist Cloudflare?</h5>
                    <p>
                        Cloudflare ist ein <strong>Content Delivery Network (CDN)</strong> und <strong>Web Application Firewall (WAF)</strong>,
                        das Ihre Anwendung vor DDoS-Angriffen, Bots und anderen Bedrohungen schßtzt.
                    </p>
                </div>

                <div class="feature-grid">
                    <div class="feature-card">
                        <div class="feature-icon bg-primary">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h5>Bot Protection</h5>
                        <p>Automatische Bot-Erkennung via Cloudflare-Headers</p>
                        <span class="badge bg-success">Free Plan</span>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon bg-danger">
                            <i class="bi bi-shield-fill-exclamation"></i>
                        </div>
                        <h5>DDoS Protection</h5>
                        <p>Threat-Score-basiertes Blocking von Angreifern</p>
                        <span class="badge bg-success">Free Plan</span>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon bg-info">
                            <i class="bi bi-globe"></i>
                        </div>
                        <h5>Geo-Blocking</h5>
                        <p>Länderspezifische Zugriffskontrolle</p>
                        <span class="badge bg-success">Free Plan</span>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon bg-success">
                            <i class="bi bi-lock-fill"></i>
                        </div>
                        <h5>SSL/TLS</h5>
                        <p>Kostenlose Let's Encrypt Zertifikate</p>
                        <span class="badge bg-success">Free Plan</span>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon bg-warning">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                        <h5>CDN & Caching</h5>
                        <p>300+ Server weltweit für schnellere Ladezeiten</p>
                        <span class="badge bg-success">Free Plan</span>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon bg-purple">
                            <i class="bi bi-graph-up"></i>
                        </div>
                        <h5>Analytics</h5>
                        <p>Echtzeit-Metriken & Statistiken</p>
                        <span class="badge bg-warning">API-Token</span>
                    </div>
                </div>
            </section>

            <!-- Prerequisites Section -->
            <section id="prerequisites" class="docs-section">
                <h2><i class="bi bi-check-circle text-success"></i> Voraussetzungen</h2>
    
                <div class="checklist">
                    <div class="checklist-item">
                        <input type="checkbox" id="req1" />
                        <label for="req1"><strong>Domain:</strong> Eigene Domain (z.B. meinelager.de)</label>
                    </div>
                    <div class="checklist-item">
                        <input type="checkbox" id="req2" />
                        <label for="req2"><strong>Domain-Zugriff:</strong> Möglichkeit Nameserver zu ändern</label>
                    </div>
                    <div class="checklist-item">
                        <input type="checkbox" id="req3" />
                        <label for="req3"><strong>Cloudflare-Konto:</strong> Kostenloses Konto bei <a href="https://dash.cloudflare.com/sign-up" target="_blank">cloudflare.com</a></label>
                    </div>
                    <div class="checklist-item">
                        <input type="checkbox" id="req4" />
                        <label for="req4"><strong>Server-IP:</strong> öffentliche IP-Adresse Ihres Servers</label>
                    </div>
                </div>

                <div class="alert alert-warning mt-3">
                    <strong><i class="bi bi-exclamation-triangle"></i> Optional (für erweiterte Features):</strong>
                    <ul class="mb-0">
                        <li>Cloudflare API-Token</li>
                        <li>Zone-ID aus Cloudflare Dashboard</li>
                    </ul>
                </div>
            </section>

            <!-- Variants Section -->
            <section id="variants" class="docs-section">
                <h2><i class="bi bi-layers text-primary"></i> Setup-Varianten</h2>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="variant-card">
                            <div class="variant-header bg-primary">
                                <h4><i class="bi bi-speedometer"></i> Variante A: Basis</h4>
                                <span class="badge bg-light text-dark">~30 Minuten</span>
                            </div>
                            <div class="variant-body">
                                <div class="variant-features">
                                    <h6>Funktionen:</h6>
                                    <ul>
                                        <li>✅ Bot/DDoS Protection</li>
                                        <li>✅ Geo-Blocking</li>
                                        <li>✅ SSL/TLS</li>
                                        <li>✅ CDN</li>
                                        <li>✅ Admin-Dashboard</li>
                                        <li>✅ Analytics</li>
                                        <li>✅ Auto-Escalation</li>
                                    </ul>
                                </div>
                                <div class="variant-badge">
                                    <span class="badge bg-success">Kein API-Token nötig</span>
                                </div>
                                <p class="text-muted mt-3"><strong>Geeignet für:</strong> Schneller Einstieg, automatischer Schutz ohne Konfiguration</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="variant-card">
                            <div class="variant-header bg-success">
                                <h4><i class="bi bi-gear-fill"></i> Variante B: Vollständig</h4>
                                <span class="badge bg-light text-dark">~60 Minuten</span>
                            </div>
                            <div class="variant-body">
                                <div class="variant-features">
                                    <h6>Funktionen:</h6>
                                    <ul>
                                        <li>✅ Alle aus Variante A</li>
                                        <li>✅ Admin-Dashboard</li>
                                        <li>✅ Echtzeit-Analytics</li>
                                        <li>✅ Auto-Escalation</li>
                                        <li>✅ Cache-Management</li>
                                        <li>✅ Security Level Control</li>
                                    </ul>
                                </div>
                                <div class="variant-badge">
                                    <span class="badge bg-warning">API-Token erforderlich</span>
                                </div>
                                <p class="text-muted mt-3"><strong>Geeignet für:</strong> Produktionsumgebungen, vollständige Kontrolle & Monitoring</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Variante A Steps -->
            <section id="variant-a" class="docs-section">
                <h2 class="section-header"><i class="bi bi-1-circle-fill text-primary"></i> Variante A: Basis-Setup</h2>

                <!-- Step 1 -->
                <div id="variant-a-step1" class="step-card">
                    <div class="step-header">
                        <span class="step-number">1</span>
                        <h3>Cloudflare-Konto erstellen</h3>
                    </div>
                    <div class="step-body">
                        <ol>
                            <li>Gehe zu <a href="https://dash.cloudflare.com/sign-up" target="_blank">dash.cloudflare.com/sign-up</a></li>
                            <li>Registriere dich mit E-Mail & Passwort</li>
                            <li>Bestätige E-Mail-Adresse</li>
                        </ol>
                        <div class="alert alert-info">
                            <i class="bi bi-clock"></i> <strong>Erwartete Dauer:</strong> 2 Minuten
                        </div>
                    </div>
                </div>

                <!-- Step 2 -->
                <div id="variant-a-step2" class="step-card">
                    <div class="step-header">
                        <span class="step-number">2</span>
                        <h3>Domain zu Cloudflare hinzufügen</h3>
                    </div>
                    <div class="step-body">
                        <ol>
                            <li>Im Cloudflare Dashboard: Klicke <strong>"Add a Site"</strong></li>
                            <li>Gib deine Domain ein: <code>meinelager.de</code></li>
                            <li>Wähle <strong>"Free"</strong> Plan</li>
                            <li>Klicke <strong>"Add Site"</strong></li>
                            <li>Warte bis DNS-Scan abgeschlossen (ca. 60 Sekunden)</li>
                            <li>Klicke <strong>"Continue"</strong></li>
                        </ol>
                        <div class="alert alert-info">
                            <i class="bi bi-clock"></i> <strong>Erwartete Dauer:</strong> 3 Minuten
                        </div>
                    </div>
                </div>

                <!-- Step 3 -->
                <div id="variant-a-step3" class="step-card">
                    <div class="step-header">
                        <span class="step-number">3</span>
                        <h3>Nameserver ändern</h3>
                    </div>
                    <div class="step-body">
                        <div class="alert alert-warning">
                            <strong><i class="bi bi-exclamation-triangle"></i> Wichtig:</strong> Cloudflare zeigt dir jetzt 2 Nameserver an, z.B.:
                            <pre class="mt-2">clark.ns.cloudflare.com
                                roxy.ns.cloudflare.com</pre>
                            </div>

                            <p><strong>Diese Nameserver mössen bei deinem Domain-Provider eingetragen werden:</strong></p>

                            <div class="provider-tabs">
                                <ul class="nav nav-tabs" role="tablist">
                                    <li class="nav-item">
                                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#ionos">IONOS</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#strato">Strato</button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#godaddy">GoDaddy</button>
                                    </li>
                                </ul>
                                <div class="tab-content p-3 border border-top-0">
                                    <div class="tab-pane fade show active" id="ionos">
                                        <ol>
                                            <li>Login bei <a href="https://www.ionos.de/" target="_blank">ionos.de</a></li>
                                            <li>Domains → Deine Domain auswählen</li>
                                            <li>DNS → Nameserver</li>
                                            <li><strong>"Eigene Nameserver verwenden"</strong></li>
                                            <li>Trage ein: Cloudflare-Nameserver</li>
                                            <li>Speichern</li>
                                        </ol>
                                    </div>
                                    <div class="tab-pane fade" id="strato">
                                        <ol>
                                            <li>Login bei <a href="https://www.strato.de/" target="_blank">strato.de</a></li>
                                            <li>Verträge → Domain → Domain-Verwaltung</li>
                                            <li><strong>"Nameserver ändern"</strong></li>
                                            <li>Trage ein: Cloudflare-Nameserver</li>
                                            <li>Speichern</li>
                                        </ol>
                                    </div>
                                    <div class="tab-pane fade" id="godaddy">
                                        <ol>
                                            <li>Login bei <a href="https://www.godaddy.com/" target="_blank">godaddy.com</a></li>
                                            <li>My Products → Domains → DNS</li>
                                            <li><strong>"Change Nameservers"</strong></li>
                                            <li>Wähle <strong>"Custom"</strong></li>
                                            <li>Trage ein: Cloudflare-Nameserver</li>
                                            <li>Save</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-warning mt-3">
                                <strong><i class="bi bi-clock"></i> Wartezeit:</strong> 5 Minuten - 24 Stunden (meist 15-30 Minuten)
                            </div>

                            <h5>Prüfen ob Nameserver aktiv:</h5>
                            <pre class="bg-dark text-light p-3"><code>nslookup meinelager.de</code></pre>
                            <p><strong>Erwartete Ausgabe (nach Aktivierung):</strong></p>
                            <pre class="bg-light p-3"><code>Addresses:  104.26.x.x
                                172.67.x.x</code></pre>
                            </div>
                        </div>

                        <!-- Step 4 -->
                        <div id="variant-a-step4" class="step-card">
                            <div class="step-header">
                                <span class="step-number">4</span>
                                <h3>DNS konfigurieren</h3>
                            </div>
                            <div class="step-body">
                                <p><strong>Im Cloudflare Dashboard → DNS:</strong></p>
                                <ol>
                                    <li>Füge A-Record hinzu (falls nicht vorhanden):</li>
                                </ol>
                                <div class="dns-config-card">
                                    <div class="row">
                                        <div class="col-md-3"><strong>Type:</strong> A</div>
                                        <div class="col-md-3"><strong>Name:</strong> @@ (oder www)</div>
                                        <div class="col-md-3"><strong>IPv4:</strong> 203.0.113.10</div>
                                        <div class="col-md-3"><strong>Proxy:</strong> <span class="badge bg-warning">☁️ Proxied</span></div>
                                    </div>
                                </div>
                                <div class="alert alert-danger mt-3">
                                    <strong><i class="bi bi-exclamation-triangle-fill"></i> KRITISCH:</strong> Die <strong>Orange Cloud</strong> muss aktiv sein (Proxied)!
                                </div>
                            </div>
                        </div>

                        <!-- Step 5 -->
                        <div id="variant-a-step5" class="step-card">
                            <div class="step-header">
                                <span class="step-number">5</span>
                                <h3>SSL/TLS konfigurieren</h3>
                            </div>
                            <div class="step-body">
                                <p><strong>Cloudflare Dashboard → SSL/TLS:</strong></p>
                                <div class="ssl-modes">
                                    <div class="ssl-mode-card recommended">
                                        <h5><i class="bi bi-check-circle text-success"></i> Full (strict)</h5>
                                        <p>Beste Sicherheit - Wenn du ein gültiges SSL-Zertifikat hast</p>
                                        <span class="badge bg-success">Empfohlen</span>
                                    </div>
                                    <div class="ssl-mode-card">
                                        <h5>Full</h5>
                                        <p>Wenn du ein Self-Signed Zertifikat hast</p>
                                    </div>
                                    <div class="ssl-mode-card">
                                        <h5><i class="bi bi-exclamation-triangle text-warning"></i> Flexible</h5>
                                        <p>Nur als letzter Ausweg (nicht empfohlen)</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 6 -->
                        <div id="variant-a-step6" class="step-card">
                            <div class="step-header">
                                <span class="step-number">6</span>
                                <h3>Firewall aktivieren</h3>
                            </div>
                            <div class="step-body">
                                <p><strong>Cloudflare Dashboard → Security → WAF:</strong></p>
                                <div class="checklist">
                                    <div class="checklist-item">
                                        <input type="checkbox" id="waf1" />
                                        <label for="waf1">🛡️ OWASP Core Ruleset aktivieren</label>
                                    </div>
                                    <div class="checklist-item">
                                        <input type="checkbox" id="waf2" />
                                        <label for="waf2">🛡️ Cloudflare Managed Ruleset aktivieren</label>
                                    </div>
                                    <div class="checklist-item">
                                        <input type="checkbox" id="waf3" />
                                        <label for="waf3">🛡️ Bot Fight Mode aktivieren</label>
                                    </div>
                                    <div class="checklist-item">
                                        <input type="checkbox" id="waf4" />
                                        <label for="waf4">🛡️ Super Bot Fight Mode aktivieren</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 7 -->
                        <div id="variant-a-step7" class="step-card">
                            <div class="step-header">
                                <span class="step-number">7</span>
                                <h3>App-Konfiguration</h3>
                            </div>
                            <div class="step-body">
                                <p><strong>öffne <code>appsettings.json</code>:</strong></p>
                                <pre class="code-block"><code>{
                                    "CloudflareSettings": {
                                    "Enabled": true,  // Cloudflare aktivieren
    
                                    "ApiToken": "",  // Leave empty for header-only mode
                                    "ZoneId": "",
    
                                    "BotProtection": {
                                    "Enabled": true,
                                    "MinimumBotScore": 30
                                    },
    
                                    "DDoSProtection": {
                                    "Enabled": true,
                                    "ThreatScoreThreshold": 10
                                    },
    
                                    "GeoLocation": {
                                    "Enabled": true,
                                    "BlockedCountries": []
                                    }
                                    }
                                    }</code></pre>
                                    <div class="alert alert-success mt-3">
                                        <strong><i class="bi bi-check-circle"></i> App neu starten:</strong>
                                        <pre class="mb-0 mt-2"><code>dotnet run</code></pre>
                                    </div>
                                </div>
                            </div>

                            <!-- Step 8 -->
                            <div id="variant-a-step8" class="step-card">
                                <div class="step-header">
                                    <span class="step-number">8</span>
                                    <h3>Testing</h3>
                                </div>
                                <div class="step-body">
                                    <h5>Test 1: Cloudflare ist aktiv</h5>
                                    <pre class="code-block"><code>curl -I https://meinelager.de</code></pre>
                                    <p><strong>✅ Erwartete Header:</strong></p>
                                    <pre class="bg-light p-3"><code>cf-ray: 8abc123...
                                        server: cloudflare
                                        cf-cache-status: DYNAMIC</code></pre>

                                        <h5 class="mt-4">Test 2: Bot Protection</h5>
                                        <pre class="code-block"><code>curl -A "BadBot/1.0" https://meinelager.de</code></pre>
                                        <p><strong>Erwartung:</strong> <code>403 Forbidden</code> oder Challenge</p>
                                    </div>
                                </div>
                            </section>

                            <!-- Variante B Section -->
                            <section id="variant-b" class="docs-section">
                                <h2 class="section-header"><i class="bi bi-2-circle-fill text-success"></i> Variante B: Vollständige Integration</h2>
        
                                <div class="alert alert-info">
                                    <strong><i class="bi bi-info-circle"></i> Hinweis:</strong> Diese Variante baut auf Variante A auf.
                                    Führe zuerst alle Schritte von Variante A aus!
                                </div>

                                <!-- Step 1: API Token -->
                                <div id="variant-b-step1" class="step-card">
                                    <div class="step-header">
                                        <span class="step-number">1</span>
                                        <h3>API-Token erstellen</h3>
                                    </div>
                                    <div class="step-body">
                                        <ol>
                                            <li>Cloudflare Dashboard → <strong>My Profile → API Tokens</strong></li>
                                            <li>Klicke <strong>"Create Token"</strong></li>
                                            <li>Wähle Template: <strong>"Edit zone settings"</strong></li>
                                            <li>
                                                Permissions konfigurieren:
                                                <ul>
                                                    <li>✅ Zone > Zone Settings > <strong>Edit</strong></li>
                                                    <li>✅ Zone > Analytics > <strong>Read</strong></li>
                                                    <li>✅ Zone > Zone > <strong>Read</strong></li>
                                                </ul>
                                            </li>
                                            <li>Zone Resources: Include > <strong>Specific zone > [Deine Domain]</strong></li>
                                            <li>Klicke <strong>"Create Token"</strong></li>
                                            <li>⚠️ <strong>WICHTIG:</strong> Token SOFORT kopieren (wird nur einmal angezeigt!)</li>
                                        </ol>

                                        <h5 class="mt-4">Token validieren:</h5>
                                        <pre class="code-block"><code>curl -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
                                            -H "Authorization: Bearer DEIN_TOKEN"</code></pre>
  
                                            <p><strong>✅ Erwartete Response:</strong></p>
                                            <pre class="bg-light p-3"><code>{
                                                "success": true,
                                                "result": {
                                                "id": "...",
                                                "status": "active"
                                                }
                                                }</code></pre>
                                            </div>
                                        </div>

                                        <!-- Step 2: Zone ID -->
                                        <div id="variant-b-step2" class="step-card">
                                            <div class="step-header">
                                                <span class="step-number">2</span>
                                                <h3>Zone-ID finden</h3>
                                            </div>
                                            <div class="step-body">
                                                <ol>
                                                    <li>Cloudflare Dashboard → <strong>Deine Domain → Overview</strong></li>
                                                    <li>Rechte Sidebar → <strong>"Zone ID"</strong></li>
                                                    <li>Kopiere die ID (z.B. <code>1234567890abcdef1234567890abcdef</code>)</li>
                                                </ol>
                                            </div>
                                        </div>

                                        <!-- Step 3: App Config -->
                                        <div id="variant-b-step3" class="step-card">
                                            <div class="step-header">
                                                <span class="step-number">3</span>
                                                <h3>App-Konfiguration erweitern</h3>
                                            </div>
                                            <div class="step-body">
                                                <p><strong>öffne <code>appsettings.json</code>:</strong></p>
                                                <pre class="code-block"><code>{
                                                    "CloudflareSettings": {
                                                    "Enabled": true,
    
                                                    // API-Credentials eintragen
                                                    "ApiToken": "abc123def456...",
                                                    "ZoneId": "1234567890abcdef...",
    
                                                    // ... alle Settings von Variante A ...
    
                                                    // Analytics aktivieren
                                                    "Analytics": {
                                                    "Enabled": true,
                                                    "UpdateIntervalMinutes": 15
                                                    },
    
                                                    // Auto-Escalation (optional)
                                                    "AutoEscalation": {
                                                    "Enabled": false  // Erst nach Tests aktivieren!
                                                    }
                                                    }
                                                    }</code></pre>

                                                    <div class="alert alert-danger mt-3">
                                                        <strong><i class="bi bi-exclamation-triangle-fill"></i> WICHTIG:</strong>
                                                        <ul class="mb-0">
                                                            <li>API-Token <strong>NIE</strong> in Git committen!</li>
                                                            <li>Verwende Umgebungsvariablen in Produktion</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Step 4: Dashboard -->
                                            <div id="variant-b-step4" class="step-card">
                                                <div class="step-header">
                                                    <span class="step-number">4</span>
                                                    <h3>Dashboard aufrufen</h3>
                                                </div>
                                                <div class="step-body">
                                                    <ol>
                                                        <li>App neu starten: <code>dotnet run</code></li>
                                                        <li>Login als <strong>SuperAdmin</strong></li>
                                                        <li>Navigiere zu: <code>/admin/cloudflare</code></li>
                                                    </ol>

                                                    <div class="dashboard-preview">
                                                        <h5><i class="bi bi-check-circle text-success"></i> Dashboard sollte anzeigen:</h5>
                                                        <ul>
                                                            <li>✅ Requests (24h)</li>
                                                            <li>✅ Cache Hit Rate</li>
                                                            <li>✅ Threats Blocked</li>
                                                            <li>✅ Bandwidth Saved</li>
                                                            <li>✅ Security Level Control</li>
                                                            <li>✅ Zone Information</li>
                                                        </ul>
                                                    </div>

                                                    <div class="text-center mt-4">
                                                        <a href="/admin/cloudflare" class="btn btn-primary btn-lg">
                                                            <i class="bi bi-box-arrow-up-right"></i> Dashboard öffnen
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Step 5: Auto-Escalation -->
                                            <div id="variant-b-step5" class="step-card">
                                                <div class="step-header">
                                                    <span class="step-number">5</span>
                                                    <h3>Auto-Escalation (Optional)</h3>
                                                </div>
                                                <div class="step-body">
                                                    <div class="alert alert-warning">
