                                <p class="text-success small mb-1">
                                    ✓ Erteilt am @currentUser.DeviceFingerprintConsentDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </p>
                                <div class="alert alert-info small mb-2">
                                    <i class="bi bi-info-circle me-1"></i>
