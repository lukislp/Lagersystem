@page "/profile"
@inherits CancellableComponentBase
@using System.ComponentModel.DataAnnotations
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject IUserProfileService UserProfileService
@inject IPasswordResetService PasswordResetService
@inject ITwoFactorManagementService TwoFactorManagementService
@inject IGdprService GdprService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ITwoFactorService TwoFactorService
@inject IApiKeyService ApiKeyService
@inject IPwnedPasswordService PwnedPasswordService
@inject I18nText I18nText

<PageTitle>@T.Profile_PageTitle</PageTitle>

<div class="page-header">
    <h1 class="page-title">@T.Profile_Title</h1>
    <p class="page-subtitle">@T.Profile_Subtitle</p>
</div>

@if (currentUser == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @T.Profile_UserNotFound
    </div>
}
else
{
    <div class="row g-4">
        <!-- Profil-Informationen -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@T.Profile_Section_Info</h3>
                </div>
                <div class="card-body">
                    <!-- Profile picture upload -->
                    <ProfileImageUpload CurrentImagePath="@currentUser.ProfileImagePath"
                                        OnImageUploaded="HandleImageUploaded"
                                        OnImageDeleted="HandleImageDeleted" />

                    <h4 class="mt-3">@currentUser.DisplayName</h4>
                    <p class="text-muted">@@@currentUser.Username</p>
                    <span class="badge bg-@GetRoleBadgeClass(currentUser.Role)">
                        @GetRoleDisplayName(currentUser.Role)
                    </span>

                    <div class="info-grid mt-4">
                        <div class="info-item">
                            <span class="info-label">@T.Profile_Label_Email</span>
                            <span class="info-value">@currentUser.Email</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@T.Profile_Label_Warehouse</span>
                            <span class="info-value">@currentUser.Warehouse?.Name</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@T.Profile_Label_WarehouseCode</span>
                            <span class="info-value"><code>@currentUser.Warehouse?.Code</code></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@T.Profile_Label_MemberSince</span>
                            <span class="info-value">@currentUser.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@T.Profile_Label_LastLogin</span>
                            <span class="info-value">@currentUser.LastLoginAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Change password -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@T.Profile_ChangePassword_Title</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(passwordMessage))
                    {
                        <div class="alert @(passwordSuccess ? "alert-success" : "alert-danger")">
                            <i class="bi @(passwordSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
                            @passwordMessage
                        </div>
                    }

                    <EditForm Model="passwordModel" OnValidSubmit="HandlePasswordChange" FormName="PasswordChangeForm">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label class="form-label">@T.Profile_Label_CurrentPassword</label>
                                    <InputText type="password" class="form-control" @bind-Value="passwordModel.OldPassword"
                                               placeholder="••••••••" />
                                    <ValidationMessage For="() => passwordModel.OldPassword" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">@T.Profile_Label_NewPassword</label>
                                    <InputText type="password" class="form-control" @bind-Value="passwordModel.NewPassword"
                                               placeholder="••••••••" />
                                    <ValidationMessage For="() => passwordModel.NewPassword" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">@T.Profile_Label_ConfirmPassword</label>
                                    <InputText type="password" class="form-control" @bind-Value="passwordModel.ConfirmPassword"
                                               placeholder="••••••••" />
                                    <ValidationMessage For="() => passwordModel.ConfirmPassword" />
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary" disabled="@isChangingPassword">
                            @if (isChangingPassword)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-key me-2"></i>
                            @T.Profile_ChangePassword_Submit
                        </button>
                    </EditForm>
                </div>
            </div>

            <!-- Warehouse-Informationen -->
            <div class="card mt-4">
                <div class="card-header">
                    <h3 class="card-title">@T.Profile_Warehouse_Title</h3>
                </div>
                <div class="card-body">
                    @if (currentUser.Warehouse != null)
                    {
                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">Name:</span>
                                <span class="info-value">@currentUser.Warehouse.Name</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Code:</span>
                                <span class="info-value"><code>@currentUser.Warehouse.Code</code></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Adresse:</span>
                                <span class="info-value">@currentUser.Warehouse.Address</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Max. Benutzer:</span>
                                <span class="info-value">@currentUser.Warehouse.MaxUsers</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Aktuelle Benutzer:</span>
                                <span class="info-value">@warehouseUserCount</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- 2FA (Zwei-Faktor-Authentifizierung) -->
@if (currentUser != null)
{
    <div class="row g-4 mt-0">
        <div class="col-12">
            <!-- Passwordless login settings -->
            <PasswordlessLoginSettings User="@currentUser"
                                       OnSettingsChanged="StateHasChanged" />
        
            <!-- IP access rules settings -->
            <IpAccessRulesSettings User="@currentUser"
                                   OnSettingsChanged="StateHasChanged" />
  
            <!-- Passkey manager (WebAuthn) -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-fingerprint me-2"></i>
                        Meine Passkeys (WebAuthn)
                    </h3>
                </div>
                <div class="card-body">
                    <PasskeyManager UserId="@currentUser.Id" />
                </div>
            </div>
 
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-shield-lock me-2"></i>
                        Zwei-Faktor-Authentifizierung (2FA)
                    </h3>
                </div>
                <div class="card-body">
                    @if (!currentUser.TwoFactorEnabled && !currentUser.EmailOtpEnabled)
                    {
                        <!-- No 2FA enabled -->
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            2FA ist aktuell <strong>nicht aktiviert</strong>.
                            Erhoehen Sie die Sicherheit Ihres Accounts.
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-primary" @onclick="StartEnable2FA">
                                <i class="bi bi-phone me-2"></i>
                                Authenticator-App einrichten
                            </button>
                            <button class="btn btn-outline-primary" @onclick="EnableEmailOtp">
                                <i class="bi bi-envelope me-2"></i>
                                E-Mail-Code aktivieren
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- At least one 2FA method enabled -->
                        <div class="alert alert-success mb-3">
                            <i class="bi bi-check-circle me-2"></i>
                            2FA ist <strong>aktiviert</strong>. Ihr Account ist durch zusaetzliche Sicherheitsebenen geschuetzt.
                        </div>

                        <!-- Active methods -->
                        <div class="row g-3 mb-3">
                            <!-- Authenticator-App -->
                            <div class="col-md-6">
                                <div class="card h-100 @(currentUser.TwoFactorEnabled ? "border-success" : "border-secondary")">
                                    <div class="card-body">
                                        <h6>
                                            <i class="bi bi-phone me-1"></i>Authenticator-App
                                            @if (currentUser.TwoFactorEnabled)
                                            {
                                                <span class="badge bg-success ms-1">Aktiv</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary ms-1">Inaktiv</span>
                                            }
                                        </h6>
                                        @if (currentUser.TwoFactorEnabled)
                                        {
                                            <button class="btn btn-danger btn-sm mt-2" @onclick="StartDisable2FA">
                                                <i class="bi bi-shield-x me-1"></i>Deaktivieren
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary btn-sm mt-2" @onclick="StartEnable2FA">
                                                <i class="bi bi-shield-check me-1"></i>Einrichten
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- E-Mail-OTP -->
                            <div class="col-md-6">
                                <div class="card h-100 @(currentUser.EmailOtpEnabled ? "border-success" : "border-secondary")">
                                    <div class="card-body">
                                        <h6>
                                            <i class="bi bi-envelope me-1"></i>E-Mail-Code
                                            @if (currentUser.EmailOtpEnabled)
                                            {
                                                <span class="badge bg-success ms-1">Aktiv</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary ms-1">Inaktiv</span>
                                            }
                                        </h6>
                                        <p class="small text-muted mb-2">Code wird an @MaskEmailProfile(currentUser.Email) gesendet</p>
                                        @if (currentUser.EmailOtpEnabled)
                                        {
                                            <button class="btn btn-danger btn-sm" @onclick="StartDisableEmailOtp">
                                                <i class="bi bi-shield-x me-1"></i>Deaktivieren
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary btn-sm" @onclick="EnableEmailOtp">
                                                <i class="bi bi-shield-check me-1"></i>Aktivieren
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Recovery codes (only with Authenticator) -->
                        @if (currentUser.TwoFactorEnabled)
                        {
                            <div class="mt-2">
                                <h6>Recovery-Codes</h6>
                                <p class="small text-muted">
                                    Falls Sie Ihr Geraet verlieren, koennen Sie diese Codes verwenden.
                                </p>
                                <button class="btn btn-outline-primary btn-sm" @onclick="ShowRecoveryCodes">
                                    <i class="bi bi-key me-1"></i>
                                    Recovery-Codes anzeigen
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- 2FA Setup Modal -->
@if (show2FASetup)
{
    <div class="modal-backdrop" style="display: block;"></div>
    <div class="modal" style="display: block;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">2FA einrichten</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cancel2FASetup"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <h6>Schritt 1: QR-Code scannen</h6>
                        <p class="small text-muted">
                            Öffnen Sie Google Authenticator und scannen Sie diesen Code
                        </p>
                        <img src="@qrCodeUrl" alt="QR-Code" class="img-fluid" style="max-width: 300px;" />
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Wichtig:</strong> Bewahren Sie diesen QR-Code NICHT auf.
                        Er wird nur einmal angezeigt.
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Schritt 2: Code eingeben</label>
                        <input type="text" class="form-control form-control-lg text-center"
                               @bind="verification2FACode"
                               placeholder="000 000"
                               maxlength="7"
                               style="letter-spacing: 0.5em; font-size: 1.5rem;"
                               @oninput="Format2FACode" />
                        <small class="text-muted">Geben Sie den 6-stellten Code aus der App ein</small>
                    </div>

                    @if (!string.IsNullOrEmpty(twoFactorErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @twoFactorErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancel2FASetup">
                        Abbrechen
                    </button>
                    <button class="btn btn-primary" @onclick="ConfirmEnable2FA" disabled="@isProcessing2FA">
                        @if (isProcessing2FA)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-circle me-1"></i>
                        2FA aktivieren
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 2FA Disable Modal -->
@if (show2FADisable)
{
    <div class="modal-backdrop" style="display: block;"></div>
    <div class="modal" style="display: block;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">2FA deaktivieren?</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => show2FADisable = false"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Ihr Account wird weniger sicher ohne 2FA!
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Bestätigen Sie mit Ihrem Passwort</label>
                        <input type="password" class="form-control"
                               @bind="disable2FAPassword"
                               placeholder="••••••••" />
                    </div>

                    @if (!string.IsNullOrEmpty(twoFactorErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @twoFactorErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => show2FADisable = false">
                        Abbrechen
                    </button>
                    <button class="btn btn-danger" @onclick="ConfirmDisable2FA" disabled="@isProcessing2FA">
                        @if (isProcessing2FA)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        2FA deaktivieren
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- E-Mail-OTP Disable Modal -->
@if (showEmailOtpDisable)
{
    <div class="modal-backdrop" style="display: block;"></div>
    <div class="modal" style="display: block;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">E-Mail-Code deaktivieren?</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showEmailOtpDisable = false"></button>
                </div>
                <div class="modal-body">
                    @if (!currentUser!.TwoFactorEnabled)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Achtung:</strong> Ohne andere aktive 2FA-Methode wird Ihr Account weniger sicher!
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Bestaetigen Sie mit Ihrem Passwort</label>
                        <input type="password" class="form-control"
                               @bind="disableEmailOtpPassword"
                               placeholder="••••••••" />
                    </div>

                    @if (!string.IsNullOrEmpty(twoFactorErrorMessage))
                    {
                        <div class="alert alert-danger">@twoFactorErrorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showEmailOtpDisable = false">Abbrechen</button>
                    <button class="btn btn-danger" @onclick="ConfirmDisableEmailOtp" disabled="@isProcessing2FA">
                        @if (isProcessing2FA)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Deaktivieren
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Recovery Codes Modal -->
@if (showRecoveryCodesModal)
{
    <div class="modal-backdrop" style="display: block;"></div>
    <div class="modal" style="display: block;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">Recovery-Codes</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showRecoveryCodesModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Wichtig:</strong> Bewahren Sie diese Codes sicher auf!
                        Jeder Code kann nur einmal verwendet werden.
                    </div>

                    @if (recoveryCodes != null && recoveryCodes.Any())
                    {
                        <div class="row g-2">
                            @foreach (var recoveryCode in recoveryCodes)
                            {
                                <div class="col-6">
                                    <div class="p-2 bg-light border rounded text-center">
                                        <code style="font-size: 1.2rem; letter-spacing: 0.2em;">@recoveryCode</code>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-outline-primary btn-sm" @onclick="CopyRecoveryCodesToClipboard">
                                <i class="bi bi-clipboard me-1"></i>
                                Alle kopieren
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- DSGVO & Datenschutz -->
@if (currentUser != null)
{
    <div class="row g-4 mt-0">
        <div class="col-12">
            <!-- API keys management -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-key me-2"></i>
                        API-Keys
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>API-Keys für externe Integrationen</strong><br>
                        Erstellen Sie API-Keys für Home Assistant, Automationen oder eigene Anwendungen.
                        <br><small class="text-muted">API-Endpunkt: @(NavigationManager.BaseUri)api/</small>
                    </div>

                    @if (apiKeys != null && apiKeys.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Key-Prefix</th>
                                        <th>Erstellt</th>
                                        <th>Zuletzt verwendet</th>
                                        <th>Status</th>
                                        <th>Aktionen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var key in apiKeys)
                                    {
                                        <tr>
                                            <td>
                                                <i class="bi bi-key me-1"></i>
                                                <strong>@key.Name</strong>
                                                @if (key.ExpiresAt.HasValue)
                                                {
                                                    <br>
    
                                                    <small class="text-muted">Läuft ab: @key.ExpiresAt.Value.ToLocalTime().ToString("dd.MM.yyyy")</small>
                                                }
                                            </td>
                                            <td><code>@key.KeyPrefix...</code></td>
                                            <td>@key.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                @if (key.LastUsedAt.HasValue)
                                                {
                                                    @key.LastUsedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Nie</span>
                                                }
                                            </td>
                                            <td>
                                                @if (key.IsActive && (!key.ExpiresAt.HasValue || key.ExpiresAt.Value > DateTime.UtcNow))
                                                {
                                                    <span class="badge bg-success">Aktiv</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inaktiv</span>
                                                }
                                            </td>
                                            <td>
                                                @if (key.IsActive)
                                                {
                                                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmRevokeApiKey(key.Id, key.Name)">
                                                        <i class="bi bi-trash"></i> Widerrufen
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-key" style="font-size: 3rem; opacity: 0.3;"></i>
                            <p class="text-muted mt-2">Noch keine API-Keys erstellt</p>
                        </div>
                    }

                    <button class="btn btn-primary mt-3" @onclick="ShowCreateApiKeyModal">
                        <i class="bi bi-plus-circle me-1"></i>
                        Neuen API-Key erstellen
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-info text-white">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-shield-check me-2"></i>
                        Datenschutz & Privatsphäre (DSGVO)
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Einwilligungsstatus -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6><i class="bi bi-check-circle-fill text-success me-2"></i>Datenschutzerklärung</h6>
                            <p class="text-muted small mb-1">
                                Akzeptiert am: @currentUser.GdprConsentDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")<br>
                                Version: @currentUser.GdprConsentVersion
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="bi bi-envelope me-2"></i>Marketing-Einwilligung</h6>
                            @if (currentUser.MarketingConsent)
                            {
                                <p class="text-success small mb-1">
                                    Akzeptiert am: @currentUser.MarketingConsentDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </p>
                                <button class="btn btn-sm btn-warning" @onclick="RevokeMarketingConsent">
                                    <i class="bi bi-envelope-slash me-1"></i>
                                    Widerrufen
                                </button>
                            }
                            else
                            {
                                <p class="text-muted small mb-1">Nicht erteilt</p>
                            }
                        </div>
                    </div>

                    <!-- Granular consents -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6><i class="bi bi-graph-up me-2"></i>Analytics & Performance</h6>
                            @if (currentUser.AnalyticsConsent)
                            {
                                <p class="text-success small mb-1">
                                    ✓ Erteilt am @currentUser.AnalyticsConsentDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </p>
                                <div class="alert alert-info small mb-2">
                                    <i class="bi bi-info-circle me-1"></i>
                                    <strong>Erforderlich:</strong> Tracking von Seitenaufrufen, Ladezeiten und Fehleranalyse für App-Qualität
