@page "/admin/rooms"
@inherits CancellableComponentBase
@using System.ComponentModel.DataAnnotations
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@rendermode InteractiveServer
@inject IRoomService RoomService
@inject IAuthService AuthService
@inject IAuditService AuditService
@inject NavigationManager NavigationManager
@inject I18nText I18nText

<PageTitle>@T.AdminRooms_PageTitle</PageTitle>

<div class="page-header d-flex justify-content-between align-items-start">
    <div>
        <h1 class="page-title">@T.AdminRooms_Title</h1>
        <p class="page-subtitle">@T.AdminRooms_Subtitle</p>
    </div>
    @if (currentUser?.Role >= UserRole.Admin)
    {
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            <i class="bi bi-plus"></i> @T.AdminRooms_NewRoom
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible">
        <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
        @message
        <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
    </div>
}

<!-- Filter -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-group mb-0">
                    <label class="form-label">@T.AdminRooms_Search_Label</label>
                    <input type="text" class="form-control" placeholder="@T.AdminRooms_Search_Placeholder"
                           @bind="searchTerm" @bind:event="oninput" @bind:after="FilterRooms" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group mb-0">
                    <label class="form-label">@T.AdminRooms_Filter_Type</label>
                    <select class="form-select" @bind="selectedType" @bind:after="FilterRooms">
                        <option value="">@T.AdminRooms_Filter_AllTypes</option>
                        @foreach (var type in Enum.GetValues<RoomType>())
                        {
                            <option value="@type">@GetRoomTypeDisplayName(type)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-secondary w-100" @onclick="ClearFilters">
                    <i class="bi bi-x-circle"></i> @T.AdminRooms_Filter_Clear
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Rooms Grid -->
<div class="row g-4">
    @if (filteredRooms.Any())
    {
        @foreach (var room in filteredRooms)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 @(room.IsActive ? "" : "opacity-75")">
                    <div class="card-header d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="mb-1">@room.Name</h4>
                            <code class="text-muted">@room.Code</code>
                        </div>
                        @if (currentUser?.Role >= UserRole.Admin)
                        {
                            <div class="dropdown">
                                <button class="btn btn-icon btn-secondary" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button class="dropdown-item" @onclick="() => OpenEditModal(room)">
                                            <i class="bi bi-pencil me-2"></i> @T.AdminRooms_Edit
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item" @onclick="() => ToggleActive(room)">
                                            <i class="bi @(room.IsActive ? "bi-eye-slash" : "bi-eye") me-2"></i>
                                            @(room.IsActive ? T.AdminRooms_Deactivate : T.AdminRooms_Activate)
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button class="dropdown-item text-danger" @onclick="() => ConfirmDelete(room)">
                                            <i class="bi bi-trash me-2"></i> @T.AdminRooms_Delete
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <span class="badge bg-info">@GetRoomTypeDisplayName(room.Type)</span>
                            @if (room.Floor.HasValue)
                            {
                                <span class="badge bg-secondary ms-1">Etage @room.Floor</span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(room.Description))
                        {
                            <p class="text-muted small mb-3">@room.Description</p>
                        }

                        <div class="row g-2">
                            <div class="col-6">
                                <div class="stat-box-sm">
                                    <i class="bi bi-geo-alt text-primary"></i>
                                    <div>
                                        <div class="stat-value-sm">@GetStorageLocationCount(room.Id)</div>
                                        <div class="stat-label-sm">@T.AdminRooms_StorageLocations</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="stat-box-sm">
                                    <i class="bi bi-box text-success"></i>
                                    <div>
                                        <div class="stat-value-sm">@GetProductCount(room.Id)</div>
                                        <div class="stat-label-sm">@T.AdminRooms_Products</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (room.Capacity.HasValue || room.Area.HasValue)
                        {
                            <div class="mt-3 pt-3 border-top">
                                @if (room.Area.HasValue)
                                {
                                    <small class="text-muted d-block">
                                        <i class="bi bi-rulers me-1"></i>Fläche: @room.Area m²
                                    </small>
                                }
                                @if (room.Capacity.HasValue)
                                {
                                    <small class="text-muted d-block">
                                        <i class="bi bi-stack me-1"></i>Kapazität: @room.Capacity Stück
                                    </small>
                                }
                            </div>
                        }

                        <div class="mt-3 pt-3 border-top">
                            <span class="badge bg-@(room.IsActive ? "success" : "secondary")">
                                <i class="bi @(room.IsActive ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                @(room.IsActive ? T.AdminRooms_Active : T.AdminRooms_Inactive)
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <EmptyState IconClass="bi bi-door-open"
                                Title="@T.AdminRooms_Empty_Title"
                                Description="@T.AdminRooms_Empty_Desc"
                                ShowAction="@(currentUser?.Role >= UserRole.Admin)"
                                ActionText="@T.AdminRooms_Empty_Action"
                                ActionIcon="bi bi-plus"
                                OnActionClick="OpenCreateModal" />
                </div>
            </div>
        </div>
    }
</div>

<!-- Create/Edit Modal -->
@if (showModal && editingRoom != null)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-content modal-content--narrow" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@(editingRoom.Id > 0 ? T.AdminRooms_Modal_Edit : T.AdminRooms_Modal_New)</h3>
                <button class="modal-close" @onclick="CloseModal">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <EditForm Model="editingRoom" OnValidSubmit="SaveRoom" FormName="RoomForm">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label class="form-label">@T.AdminRooms_Modal_Name</label>
                                <InputText class="form-control" @bind-Value="editingRoom.Name"
                                           placeholder="z.B. Lager Halle A" />
                                <ValidationMessage For="() => editingRoom.Name" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">@T.AdminRooms_Modal_Code</label>
                                <InputText class="form-control" @bind-Value="editingRoom.Code"
                                           placeholder="z.B. H-A" />
                                <ValidationMessage For="() => editingRoom.Code" />
                                @if (codeExists)
                                {
                                    <div class="text-danger small mt-1">@T.AdminRooms_Modal_CodeExists</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label class="form-label">@T.AdminRooms_Modal_Type</label>
                                <InputSelect class="form-select" @bind-Value="editingRoom.Type">
                                    @foreach (var type in Enum.GetValues<RoomType>())
                                    {
                                        <option value="@type">@GetRoomTypeDisplayName(type)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">@T.AdminRooms_Modal_Floor</label>
                                <InputNumber class="form-control" @bind-Value="editingRoom.Floor"
                                             placeholder="Optional" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">@T.AdminRooms_Modal_Desc</label>
                        <InputTextArea class="form-control" @bind-Value="editingRoom.Description"
                                       rows="3" placeholder="Optionale Beschreibung..." />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">@T.AdminRooms_Modal_Area</label>
                                <InputNumber class="form-control" @bind-Value="editingRoom.Area"
                                             placeholder="Optional" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">@T.AdminRooms_Modal_Capacity</label>
                                <InputNumber class="form-control" @bind-Value="editingRoom.Capacity"
                                             placeholder="Optional" />
                            </div>
                        </div>
                    </div>

                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="editingRoom.IsActive" id="isActive" />
                        <label class="form-check-label" for="isActive">
                            @T.AdminRooms_Modal_IsActive
                        </label>
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">@T.AdminRooms_Modal_Cancel</button>
                <button class="btn btn-primary" @onclick="SaveRoom" disabled="@(codeExists || isSaving)">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check"></i> @T.AdminRooms_Modal_Save
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && roomToDelete != null)
{
    <div class="modal-backdrop" @onclick="() => showDeleteModal = false">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@T.AdminRooms_Delete_Title</h3>
                <button class="modal-close" @onclick="() => showDeleteModal = false">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                @if (GetStorageLocationCount(roomToDelete.Id) > 0)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>@T.AdminRooms_Delete_HasLocations</strong>
                        <br>
                        @(T.AdminRooms_Delete_HasLocations_Desc != null ? string.Format(T.AdminRooms_Delete_HasLocations_Desc, GetStorageLocationCount(roomToDelete.Id)) : "")
                    </div>
                }
                else
                {
                    <p>@T.AdminRooms_Delete_Confirm <strong>@roomToDelete.Name</strong></p>
                    <p class="text-muted">@T.AdminRooms_Delete_Warning</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showDeleteModal = false">@T.AdminRooms_Delete_Cancel</button>
                @if (GetStorageLocationCount(roomToDelete.Id) == 0)
                {
                    <button class="btn btn-danger" @onclick="DeleteRoom">
                        <i class="bi bi-trash"></i> @T.AdminRooms_Delete
                    </button>
                }
            </div>
        </div>
    </div>
}
@code {
    private LagersystemLVHome.I18nText.App T = new();
    private List<Room> rooms = new();
    private IEnumerable<Room> filteredRooms = new List<Room>();
    private List<StorageLocation> allStorageLocations = new();
    private User? currentUser;

    private string searchTerm = string.Empty;
    private string selectedType = string.Empty;

    private bool showModal = false;
    private bool showDeleteModal = false;
    private bool codeExists = false;
    private bool isSaving = false;
    private Room? editingRoom;
    private Room? roomToDelete;

    private string message = string.Empty;
    private bool isSuccess = false;
    private Dictionary<int, int> productCountByRoom = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        currentUser = await AuthService.GetCurrentUserAsync();

        if (currentUser?.Role < UserRole.Admin)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        var view = await RoomService.GetAdminViewAsync(currentUser!.WarehouseId);
        rooms = view.Rooms;
        allStorageLocations = view.StorageLocations;
        productCountByRoom = view.ProductCountByRoomId;

        FilterRooms();
    }

    private void FilterRooms()
    {
        filteredRooms = rooms;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.ToLower();
            filteredRooms = filteredRooms.Where(r =>
                      r.Name.ToLower().Contains(term) ||
              r.Code.ToLower().Contains(term));
        }

        if (!string.IsNullOrEmpty(selectedType) && Enum.TryParse<RoomType>(selectedType, out var type))
        {
            filteredRooms = filteredRooms.Where(r => r.Type == type);
        }
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedType = string.Empty;
        FilterRooms();
    }

    private int GetStorageLocationCount(int roomId)
    {
        var room = rooms.FirstOrDefault(r => r.Id == roomId);
        if (room == null) return 0;
        return allStorageLocations.Count(s => s.Room == room.Name);
    }

    private int GetProductCount(int roomId)
    {
        return productCountByRoom.GetValueOrDefault(roomId, 0);
    }

    private void OpenCreateModal()
    {
        editingRoom = new Room
        {
            WarehouseId = currentUser!.WarehouseId,
            IsActive = true,
            Type = RoomType.StorageRoom,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        };
        codeExists = false;
        showModal = true;
    }

    private void OpenEditModal(Room room)
    {
        editingRoom = new Room
        {
            Id = room.Id,
            Name = room.Name,
            Code = room.Code,
            Description = room.Description,
            Type = room.Type,
            Floor = room.Floor,
            Area = room.Area,
            Capacity = room.Capacity,
            WarehouseId = room.WarehouseId,
            IsActive = room.IsActive,
            CreatedAt = room.CreatedAt,
            UpdatedAt = DateTime.UtcNow
        };
        codeExists = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingRoom = null;
        codeExists = false;
    }

    private async Task SaveRoom()
    {
        if (editingRoom == null || string.IsNullOrWhiteSpace(editingRoom.Name)) return;

        isSaving = true;
        message = string.Empty;

        try
        {
            if (editingRoom.Id > 0)
            {
                var updateResult = await RoomService.UpdateRoomAsync(editingRoom);
                if (updateResult.IsFailure)
                {
                    codeExists = updateResult.ErrorCode == "room.codeexists";
                    if (!codeExists)
                    {
                        message = $"Fehler beim Speichern: {updateResult.ErrorMessage}";
                        isSuccess = false;
                    }
                    isSaving = false;
                    return;
                }

                message = "Raum erfolgreich aktualisiert!";
                await AuditService.LogAsync("ROOM_UPDATED", "Room", editingRoom.Id, new { editingRoom.Name, editingRoom.Code });
                isSuccess = true;
            }
            else
            {
                var createResult = await RoomService.CreateRoomAsync(editingRoom);
                if (createResult.IsFailure)
                {
                    codeExists = createResult.ErrorCode == "room.codeexists";
                    if (!codeExists)
                    {
                        message = $"Fehler beim Speichern: {createResult.ErrorMessage}";
                        isSuccess = false;
                    }
                    isSaving = false;
                    return;
                }

                await AuditService.LogAsync("ROOM_CREATED", "Room", createResult.Value!.Id, new { createResult.Value.Name, createResult.Value.Code });
                message = "Raum erfolgreich erstellt!";
                isSuccess = true;
            }

            await LoadData();
            CloseModal();
        }
        catch (Exception ex)
        {
            message = $"Fehler beim Speichern: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleActive(Room room)
    {
        var result = await RoomService.SetRoomActiveAsync(room.Id, !room.IsActive);
        if (result.IsFailure)
        {
            message = $"Fehler: {result.ErrorMessage}";
            isSuccess = false;
            return;
        }
        message = $"Raum {room.Name} wurde {(!room.IsActive ? "aktiviert" : "deaktiviert")}.";
        isSuccess = true;
        await LoadData();
    }

    private void ConfirmDelete(Room room)
    {
        roomToDelete = room;
        showDeleteModal = true;
    }

    private async Task DeleteRoom()
    {
        if (roomToDelete != null)
        {
            var result = await RoomService.DeleteRoomAsync(roomToDelete.Id);
            if (result.IsSuccess)
            {
                message = string.Format(T.AdminRooms_Deleted ?? "Raum {0} wurde gelöscht.", roomToDelete.Name);
                await AuditService.LogAsync("ROOM_DELETED", "Room", roomToDelete.Id, new { roomToDelete.Name, roomToDelete.Code }, AuditSeverity.Warning);
                isSuccess = true;
                await LoadData();
            }
            else
            {
                message = string.Format(T.AdminRooms_DeleteFail ?? "Fehler beim Löschen: {0}", result.ErrorMessage);
                isSuccess = false;
            }
        }
        showDeleteModal = false;
        roomToDelete = null;
    }

    private string GetRoomTypeDisplayName(RoomType type)
    {
        return type switch
        {
            RoomType.StorageRoom => "Lagerraum",
            RoomType.Warehouse => "Warehouse",
            RoomType.Workshop => "Werkstatt",
            RoomType.Office => "Büro",
            RoomType.ColdStorage => "Kühlhaus",
            RoomType.Archive => "Archiv",
            RoomType.LoadingBay => "Verladezone",
            _ => type.ToString()
        };
    }
}
