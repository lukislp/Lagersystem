@inject IImageService ImageService
@inject IJSRuntime JSRuntime
@inject I18nText I18nText

<div class="profile-image-upload">
    <div class="profile-image-container">
        @if (!string.IsNullOrEmpty(CurrentImagePath))
        {
            <img src="@CurrentImagePath" alt="Profilbild" class="profile-image" />
        }
        else
        {
            <div class="profile-image-placeholder">
                <i class="bi bi-person-circle"></i>
            </div>
        }
        
        <div class="profile-image-overlay">
            <label for="profileImageInput" class="upload-button">
                <i class="bi bi-camera-fill"></i>
                <span>@(T.ProfileImageUpload_ChangeImage ?? "Bild ändern")</span>
            </label>
        </div>
    </div>
    
    <InputFile id="profileImageInput"
               OnChange="HandleImageUpload"
               accept="image/jpeg,image/png,image/webp"
               class="d-none" />
  
    <!-- Delete button (only if an image is present) -->
    @if (!string.IsNullOrEmpty(CurrentImagePath))
    {
        <button class="btn btn-sm btn-danger mt-2" @onclick="HandleImageDelete" disabled="@isDeleting">
            @if (isDeleting)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="bi bi-trash me-1"></i>
            @(T.ProfileImageUpload_DeleteImage ?? "Profilbild löschen")
        </button>
    }
    
    @if (isUploading)
    {
        <div class="upload-progress mt-2">
            <div class="spinner-border spinner-border-sm me-2"></div>
            <span>Wird hochgeladen...</span>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @errorMessage
        </div>
    }
    
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-2">
            <i class="bi bi-check-circle me-2"></i>
            @successMessage
        </div>
    }
    
    <div class="upload-info mt-2">
        <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            Max. 50 MB · JPG, PNG, WebP
        </small>
    </div>
</div>


@code {
    [Parameter]
    public string? CurrentImagePath { get; set; }
    
    [Parameter]
    public EventCallback<string> OnImageUploaded { get; set; }
    
    [Parameter]
    public EventCallback OnImageDeleted { get; set; } // Event for deletion
    
    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    private bool isUploading = false;
    private bool isDeleting = false; // NEU
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    
    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        errorMessage = string.Empty;
        successMessage = string.Empty;
     
        // DSGVO: Datensparsamkeit - Validierung
        
        // 1. Validate file size (max 50MB)
        if (file.Size > 50 * 1024 * 1024)
        {
            errorMessage = T.ProfileImageUpload_TooLarge ?? "Datei zu groß! Maximal 50 MB erlaubt.";
            return;
        }
        
        // 2. Validate file type
        var allowedTypes = new[] { "image/jpeg", "image/jpg", "image/png", "image/webp" };
        if (!allowedTypes.Contains(file.ContentType.ToLower()))
        {
            errorMessage = T.ProfileImageUpload_WrongType ?? "Ungültiger Dateityp! Nur JPG, PNG oder WebP erlaubt.";
            return;
        }
   
        isUploading = true;
    
        try
        {
            // Upload via ImageService
            var imagePath = await ImageService.UploadProfileImageAsync(file);
        
            // GDPR: remove the old file (data minimization)
            if (!string.IsNullOrEmpty(CurrentImagePath))
            {
                await ImageService.DeleteProfileImageAsync(CurrentImagePath);
            }
 
            // Raise event
            await OnImageUploaded.InvokeAsync(imagePath);
   
            successMessage = "Profilbild erfolgreich hochgeladen!";

            // Hide success message after 3 seconds
            await Task.Delay(3000);
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Hochladen: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    // Delete profile picture
    private async Task HandleImageDelete()
    {
        if (string.IsNullOrEmpty(CurrentImagePath)) return;

        errorMessage = string.Empty;
        successMessage = string.Empty;
        isDeleting = true;

        try
        {
            // Delete the file on the server
            await ImageService.DeleteProfileImageAsync(CurrentImagePath);

            // Raise event (so Profile.razor refreshes the user model)
            await OnImageDeleted.InvokeAsync();

            successMessage = T.ProfileImageUpload_Deleted ?? "Profilbild erfolgreich gelöscht!";

            // Hide success message after 3 seconds
            await Task.Delay(3000);
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = string.Format(T.ProfileImageUpload_DeleteError ?? "Fehler beim Löschen: {0}", ex.Message);
        }
        finally
        {
            isDeleting = false;
        }
    }
}
