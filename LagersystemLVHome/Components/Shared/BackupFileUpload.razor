@inject ILogger<BackupFileUpload> Logger
@inject IDatabaseProviderService DatabaseProviderService
@inject IToastService ToastService
@inject NavigationManager NavigationManager
@inject I18nText I18nText

<div class="backup-file-upload">
    @if (isProcessing)
    {
        <div class="upload-progress-container">
            <div class="text-center mb-3">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                <p class="mt-2"><strong>@processingMessage</strong></p>
            </div>
            @if (uploadProgressPercent > 0)
            {
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         style="width: @uploadProgressPercent%">
                        @uploadProgressPercent%
                    </div>
                </div>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(SelectedFileName))
    {
        <div class="file-selected">
            <i class="bi bi-check-circle text-success display-4 mb-3"></i>
            <p class="mb-1"><strong>@SelectedFileName</strong></p>
            <p class="text-muted small">@FormatFileSize(SelectedFileSize)</p>
         
            @if (needsPassword)
            {
                <div class="alert alert-warning mt-3">
                    <i class="bi bi-lock me-2"></i>
                    <strong>@T.BackupFileUpload_Encrypted</strong>
                </div>
   
                <div class="input-group mt-3">
                    <input type="password" class="form-control"
                           placeholder="@T.BackupFileUpload_DecryptionPassword"
                           @bind="decryptionPassword"
                           @onkeyup="@(e => { if (e.Key == "Enter") HandlePasswordSubmit(); })" />
                    <button class="btn btn-primary" @onclick="HandlePasswordSubmit">
                        <i class="bi bi-unlock me-1"></i>
                        @(T.BackupFileUpload_Restore ?? "Restore")
                    </button>
                </div>
            }
            else
            {
                <button class="btn btn-outline-danger btn-sm mt-3" @onclick="ClearSelection">
                    <i class="bi bi-x-circle me-1"></i>
                    @(T.BackupFileUpload_Remove ?? "Entfernen")
                </button>
            }
        </div>
    }
    else
    {
        <div class="backup-file-selector">
            <div class="text-center py-4">
                <i class="bi bi-cloud-upload display-4 text-primary mb-3"></i>
                <p class="mb-2"><strong>@T.BackupFileUpload_Title</strong></p>
                <p class="text-muted small mb-3">@T.BackupFileUpload_Hint</p>
  
                <label for="backupFileInput" class="btn btn-primary btn-lg">
                    <i class="bi bi-folder2-open me-2"></i>
                    @(T.BackupFileUpload_SelectFile ?? "Datei auswählen")
                </label>
            </div>
        </div>
    }
    
    <InputFile id="backupFileInput"
               OnChange="HandleFileUpload"
               accept=".db,.zip,.enc"
               class="d-none" />
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @errorMessage
        </div>
    }
</div>


@code {
    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    [Parameter] public EventCallback OnRestoreComplete { get; set; }
    
    private bool isProcessing = false;
    private string errorMessage = string.Empty;
    private string? SelectedFileName { get; set; }
    private long SelectedFileSize { get; set; }
    private int uploadProgressPercent = 0;
    private bool needsPassword = false;
    private string? decryptionPassword = null;
    private string? uploadedFilePath = null;
    private bool isEncrypted = false;
    private long uploadedBytes = 0;
    private long totalBytes = 0;
    private string processingMessage = "Lädt...";
    
    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        
        isProcessing = true;
        errorMessage = string.Empty;
        SelectedFileName = file.Name;
        SelectedFileSize = file.Size;
        totalBytes = file.Size;
        processingMessage = "Datei wird hochgeladen...";
        
        try
        {
            var tempPath = Path.Combine(Path.GetTempPath(), $"restore_{DateTime.Now:yyyyMMddHHmmss}_{file.Name}");
            Logger.LogInformation("Uploading to: {Path}", tempPath);
   
            await using var stream = file.OpenReadStream(500 * 1024 * 1024);
            await using var fileStream = File.Create(tempPath);
            
            var buffer = new byte[81920];
            int bytesRead;
            while ((bytesRead = await stream.ReadAsync(buffer)) > 0)
            {
                await fileStream.WriteAsync(buffer.AsMemory(0, bytesRead));
                uploadedBytes += bytesRead;
                uploadProgressPercent = (int)((double)uploadedBytes / totalBytes * 100);
                if (uploadProgressPercent % 10 == 0) StateHasChanged();
            }
            
            uploadedFilePath = tempPath;
            CheckIfEncrypted();
       
            if (isEncrypted)
            {
                needsPassword = true;
                Logger.LogInformation("File is encrypted, waiting for password");
            }
            else
            {
                await RestoreBackupAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Upload fehlgeschlagen: {ex.Message}";
            Logger.LogError(ex, "Upload failed");
            ClearSelection();
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
    
    private void CheckIfEncrypted()
    {
        if (string.IsNullOrEmpty(uploadedFilePath)) return;
        isEncrypted = uploadedFilePath.EndsWith(".enc", StringComparison.OrdinalIgnoreCase);
        
        if (!isEncrypted && File.Exists(uploadedFilePath))
        {
            try
            {
                using var fs = File.OpenRead(uploadedFilePath);
                var buffer = new byte[4];
                fs.Read(buffer, 0, 4);
                var header = System.Text.Encoding.ASCII.GetString(buffer);
                isEncrypted = !header.StartsWith("SQLi");
            }
            catch { }
        }
  
        Logger.LogInformation("Encryption check: {IsEncrypted}", isEncrypted);
    }
    
    private async Task HandlePasswordSubmit()
    {
        if (string.IsNullOrWhiteSpace(decryptionPassword))
        {
            errorMessage = "Bitte Passwort eingeben";
            return;
        }
  
        needsPassword = false;
        await RestoreBackupAsync();
    }
    
    private async Task RestoreBackupAsync()
    {
        if (string.IsNullOrEmpty(uploadedFilePath)) return;
    
        isProcessing = true;
        errorMessage = string.Empty;
        string? tempDecryptedPath = null;
        string? tempUnzippedPath = null;
        
        try
        {
            processingMessage = "Starte Wiederherstellung...";
            ToastService.ShowInfo(processingMessage);
            var processedPath = uploadedFilePath;
            
            // STEP 1: Decrypt
            if (isEncrypted && !string.IsNullOrEmpty(decryptionPassword))
            {
                processingMessage = "Entschlüssele Backup...";
                StateHasChanged();
                tempDecryptedPath = await DecryptBackupAsync(processedPath, decryptionPassword);
                processedPath = tempDecryptedPath;
                ToastService.ShowSuccess("Decryption successful");
            }
            
            // SCHRITT 2: Entpacken
            if (processedPath.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
            {
                processingMessage = "Entpacke Backup...";
                StateHasChanged();
                tempUnzippedPath = await UnzipBackupAsync(processedPath);
                processedPath = tempUnzippedPath;
                ToastService.ShowSuccess("Extraction successful");
            }
  
            // SCHRITT 3: Sicherheits-Backup
            processingMessage = "Erstelle Sicherheits-Backup...";
            StateHasChanged();
            var safetyBackup = $"pre_restore_{DateTime.Now:yyyyMMdd_HHmmss}.db";
            await DatabaseProviderService.BackupDatabaseAsync(safetyBackup);
         
            // SCHRITT 4: Restore
            processingMessage = "Stelle Datenbank wieder her...";
            StateHasChanged();
            await DatabaseProviderService.RestoreDatabaseAsync(processedPath);
    
            // Success!
            ToastService.ShowSuccess("Backup restored successfully!");
            Logger.LogInformation("Restore complete");
   
            await OnRestoreComplete.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Wiederherstellung fehlgeschlagen: {ex.Message}";
            ToastService.ShowError(errorMessage);
            Logger.LogError(ex, "Restore failed");
        }
        finally
        {
            if (tempDecryptedPath != null && File.Exists(tempDecryptedPath))
                try { File.Delete(tempDecryptedPath); } catch { }
          
            if (tempUnzippedPath != null && File.Exists(tempUnzippedPath))
                try { File.Delete(tempUnzippedPath); } catch { }

            isProcessing = false;
            StateHasChanged();
        }
    }
    
    private async Task<string> DecryptBackupAsync(string encryptedPath, string password)
    {
        var decryptedPath = Path.Combine(Path.GetTempPath(), $"decrypted_{DateTime.Now:yyyyMMddHHmmss}.db");
        
        using var aes = System.Security.Cryptography.Aes.Create();
        aes.Key = DeriveKeyFromPassword(password);
  
        await using var inputStream = File.OpenRead(encryptedPath);
        var iv = new byte[16];
        await inputStream.ReadAsync(iv, 0, 16);
        aes.IV = iv;
   
        await using var outputStream = File.Create(decryptedPath);
        await using var cryptoStream = new System.Security.Cryptography.CryptoStream(
inputStream, aes.CreateDecryptor(), System.Security.Cryptography.CryptoStreamMode.Read);
        
        await cryptoStream.CopyToAsync(outputStream);
        return decryptedPath;
    }
    
    private byte[] DeriveKeyFromPassword(string password)
    {
        using var sha256 = System.Security.Cryptography.SHA256.Create();
        return sha256.ComputeHash(System.Text.Encoding.UTF8.GetBytes(password));
    }
    
    private async Task<string> UnzipBackupAsync(string zipPath)
    {
        var tempFolder = Path.Combine(Path.GetTempPath(), $"backup_unzip_{DateTime.Now:yyyyMMddHHmmss}");
        Directory.CreateDirectory(tempFolder);
      
        try
        {
            System.IO.Compression.ZipFile.ExtractToDirectory(zipPath, tempFolder);
            var dbFiles = Directory.GetFiles(tempFolder, "*.db", SearchOption.AllDirectories);
            
            if (dbFiles.Length == 0)
                throw new Exception("Keine .db Datei im Backup gefunden");
 
            var tempDbPath = Path.Combine(Path.GetTempPath(), $"restored_{DateTime.Now:yyyyMMddHHmmss}.db");
            File.Copy(dbFiles[0], tempDbPath, overwrite: true);
            
            try { Directory.Delete(tempFolder, recursive: true); } catch { }
            
            return tempDbPath;
        }
        catch
        {
            try { Directory.Delete(tempFolder, recursive: true); } catch { }
            throw;
        }
    }
    
    private void ClearSelection()
    {
        SelectedFileName = null;
        SelectedFileSize = 0;
        uploadedBytes = 0;
        totalBytes = 0;
        uploadProgressPercent = 0;
        uploadedFilePath = null;
        isEncrypted = false;
        needsPassword = false;
        decryptionPassword = null;
        errorMessage = string.Empty;
        StateHasChanged();
    }
    
    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
