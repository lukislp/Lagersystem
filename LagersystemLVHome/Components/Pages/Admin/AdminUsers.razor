@page "/admin/users"
@inherits CancellableComponentBase
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject IUserRegistrationService UserRegistrationService
@inject IAdminQueryService AdminQueryService
@inject I18nText I18nText

<PageTitle>@T.AdminUsers_PageTitle</PageTitle>

<div class="page-header">
    <h1 class="page-title">@T.AdminUsers_Title</h1>
    <p class="page-subtitle">@T.AdminUsers_Subtitle</p>
</div>

@if (currentUser?.Role < UserRole.Admin)
{
    <div class="alert alert-danger">
   <i class="bi bi-exclamation-triangle me-2"></i>
        @T.AdminUsers_NoPermission
 </div>
}
else
{
<!-- Pending Users -->
    <div class="card mb-4">
  <div class="card-header card-header-pending">
        <h3 class="card-title">
  <i class="bi bi-clock-history me-2"></i>
     @(T.AdminUsers_Pending_Title != null ? string.Format(T.AdminUsers_Pending_Title, pendingUsers.Count) : "")
    </h3>
        </div>
     <div class="card-body">
   @if (pendingUsers.Any())
{
 <div class="table-container">
     <table class="data-table">
   <thead>
        <tr>
  <th>@T.AdminUsers_Col_Username</th>
   <th>@T.AdminUsers_Col_Name</th>
         <th>@T.Common_Email</th>
   <th>@T.AdminUsers_Col_RegisteredAt</th>
      <th>@T.Common_Actions</th>
  </tr>
  </thead>
    <tbody>
      @foreach (var user in pendingUsers)
    {
  <tr>
     <td>
    <div class="d-flex align-items-center gap-2">
            @if (!string.IsNullOrEmpty(user.ProfileImagePath))
  {
 <img src="@user.ProfileImagePath" 
     alt="@user.DisplayName" 
        class="profile-avatar-small" />
    }
     else
    {
       <i class="bi bi-person-circle fs-4 text-warning"></i>
       }
        <div>
   <div class="fw-bold">@user.Username</div>
      <small class="text-muted">ID: @user.Id</small>
   </div>
    </div>
 </td>
   <td>@user.DisplayName</td>
     <td>@user.Email</td>
    <td>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
     <td>
 <div class="d-flex gap-2">
         <button class="btn btn-success btn-sm" @onclick="() => OpenApproveModal(user)">
         <i class="bi bi-check-circle"></i> @T.AdminUsers_Approve
          </button>
       <button class="btn btn-danger btn-sm" @onclick="() => OpenRejectModal(user)">
       <i class="bi bi-x-circle"></i> @T.AdminUsers_Reject
         </button>
   </div>
 </td>
   </tr>
     }
    </tbody>
   </table>
     </div>
  }
        else
   {
      <EmptyState 
IconClass="bi bi-clock-history"
Title="Keine wartenden Benutzer"
 Description="Alle Registrierungen sind bearbeitet."
     AdditionalClass="compact" />
        }
        </div>
    </div>

    <!-- Approved Users -->
    <div class="card mb-4">
   <div class="card-header">
   <h3 class="card-title">
    <i class="bi bi-people me-2"></i>
Genehmigte Benutzer (@approvedUsers.Count)
    </h3>
 </div>
 <div class="card-body">
    @if (approvedUsers.Any())
   {
    <div class="table-container">
   <table class="data-table">
 <thead>
       <tr>
      <th>Benutzername</th>
   <th>Name</th>
        <th>E-Mail</th>
        <th>Rolle</th>
  <th>Genehmigt am</th>
    <th>Genehmigt von</th>
    <th>Letzter Login</th>
          <th>Aktionen</th>
      </tr>
   </thead>
  <tbody>
     @foreach (var user in approvedUsers)
{
     <tr>
    <td>
   <div class="d-flex align-items-center gap-2">
         @if (!string.IsNullOrEmpty(user.ProfileImagePath))
    {
        <img src="@user.ProfileImagePath" 
    alt="@user.DisplayName" 
  class="profile-avatar-small" />
   }
 else
      {
  <i class="bi bi-person-check-fill fs-4 text-success"></i>
      }
    <div>
    <div class="fw-bold">@user.Username</div>
     <small class="text-muted">ID: @user.Id</small>
     </div>
   </div>
     </td>
        <td>@user.DisplayName</td>
       <td>@user.Email</td>
 <td>
         <span class="badge bg-@GetRoleBadgeClass(user.Role)">
    @GetRoleDisplayName(user.Role)
     </span>
  </td>
        <td>@user.ApprovedAt?.ToLocalTime().ToString("dd.MM.yyyy")</td>
   <td>
      @if (user.ApprovedByUserId.HasValue)
      {
     var approver = approvedUsers.FirstOrDefault(u => u.Id == user.ApprovedByUserId);
      <span>@(approver?.Username ?? "System")</span>
    }
  else
    {
 <span class="text-muted">-</span>
     }
    </td>
      <td>@user.LastLoginAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
       <td>
      @if (CanChangeRole(user))
            {
<button class="btn btn-sm btn-outline-primary" @onclick="() => OpenRoleChangeModal(user)">
  <i class="bi bi-shield me-1"></i> @T.AdminUsers_ChangeRole
  </button>
           }
        else
          {
     <span class="text-muted">-</span>
        }
        </td>
     </tr>
    }
    </tbody>
  </table>
        </div>
   }
  </div>
    </div>

  <!-- Rejected Users -->
    @if (rejectedUsers.Any())
    {
        <div class="card">
      <div class="card-header card-header-rejected">
         <h3 class="card-title">
     <i class="bi bi-x-octagon me-2"></i>
      Abgelehnte Benutzer (@rejectedUsers.Count)
    </h3>
        </div>
       <div class="card-body">
       <div class="table-container">
      <table class="data-table">
   <thead>
     <tr>
 <th>Benutzername</th>
      <th>E-Mail</th>
   <th>Abgelehnt am</th>
    <th>Abgelehnt von</th>
          <th>Grund</th>
     </tr>
       </thead>
       <tbody>
  @foreach (var user in rejectedUsers)
  {
       <tr>
       <td>@user.Username</td>
     <td>@user.Email</td>
    <td>@user.ApprovedAt?.ToLocalTime().ToString("dd.MM.yyyy")</td>
<td>
      @if (user.ApprovedByUserId.HasValue)
         {
      var rejecter = approvedUsers.FirstOrDefault(u => u.Id == user.ApprovedByUserId);
   <span>@(rejecter?.Username ?? "System")</span>
    }
    </td>
       <td>@(user.ApprovalNotes ?? "-")</td>
    </tr>
    }
 </tbody>
   </table>
   </div>
   </div>
  </div>
    }
}

<!-- Approve Modal -->
@if (showApproveModal && selectedUser != null)
{
    <div class="modal-backdrop" @onclick="CloseModals">
  <div class="modal-content" @onclick:stopPropagation="true">
     <div class="modal-header">
   <h3 class="modal-title">Benutzer genehmigen</h3>
  <button class="modal-close" @onclick="CloseModals">
 <i class="bi bi-x"></i>
      </button>
   </div>
     <div class="modal-body">
       <p>Möchten Sie den Benutzer <strong>@selectedUser.Username</strong> (@selectedUser.Email) genehmigen?</p>
         
    <div class="form-group">
    <label class="form-label">Notizen (optional)</label>
    <textarea class="form-control" @bind="approvalNotes" rows="3" 
        placeholder="z.B. Nach Rücksprache mit Team genehmigt"></textarea>
    </div>
      </div>
    <div class="modal-footer">
   <button class="btn btn-secondary" @onclick="CloseModals">Abbrechen</button>
   <button class="btn btn-success" @onclick="ApproveUser" disabled="@isProcessing">
          @if (isProcessing)
   {
  <span class="spinner-border spinner-border-sm me-2"></span>
      }
     <i class="bi bi-check-circle me-2"></i>
        Genehmigen
      </button>
        </div>
 </div>
    </div>
}

<!-- Reject Modal -->
@if (showRejectModal && selectedUser != null)
{
 <div class="modal-backdrop" @onclick="CloseModals">
      <div class="modal-content" @onclick:stopPropagation="true">
  <div class="modal-header">
  <h3 class="modal-title">Benutzer ablehnen</h3>
 <button class="modal-close" @onclick="CloseModals">
   <i class="bi bi-x"></i>
   </button>
 </div>
     <div class="modal-body">
     <p>Möchten Sie den Benutzer <strong>@selectedUser.Username</strong> (@selectedUser.Email) ablehnen?</p>
  
  <div class="alert alert-warning">
     <i class="bi bi-exclamation-triangle me-2"></i>
Der Benutzer wird deaktiviert und kann sich nicht mehr anmelden.
  </div>

<div class="form-group">
    <label class="form-label">Grund (empfohlen)</label>
  <textarea class="form-control" @bind="approvalNotes" rows="3" 
  placeholder="z.B. Kein Bezug zum Unternehmen erkennbar"></textarea>
  </div>
   </div>
  <div class="modal-footer">
        <button class="btn btn-secondary" @onclick="CloseModals">Abbrechen</button>
   <button class="btn btn-danger" @onclick="RejectUser" disabled="@isProcessing">
@if (isProcessing)
     {
      <span class="spinner-border spinner-border-sm me-2"></span>
      }
     <i class="bi bi-x-circle me-2"></i>
    Ablehnen
   </button>
   </div>
   </div>
  </div>
}

<!-- Role Change Modal -->
@if (showRoleChangeModal && selectedUser != null)
{
  <div class="modal-backdrop" @onclick="CloseModals">
 <div class="modal-content" @onclick:stopPropagation="true">
          <div class="modal-header">
      <h3 class="modal-title">Rolle ändern</h3>
             <button class="modal-close" @onclick="CloseModals">
          <i class="bi bi-x"></i>
       </button>
      </div>
  <div class="modal-body">
  <p>Rolle für Benutzer <strong>@selectedUser.Username</strong> ändern:</p>
           
            <div class="alert alert-info">
  <i class="bi bi-info-circle me-2"></i>
               Aktuelle Rolle: <strong>@GetRoleDisplayName(selectedUser.Role)</strong>
       </div>

            <div class="form-group">
       <label class="form-label">Neue Rolle</label>
                 <select class="form-select" @bind="selectedNewRole">
         @foreach (UserRole role in GetAvailableRoles())
             {
     <option value="@role">@GetRoleDisplayName(role)</option>
}
           </select>
   </div>

          <div class="mt-3">
      <h6>Rollenbeschreibungen:</h6>
     <ul class="small">
     <li><strong>Benutzer:</strong> Kann scannen und Produkte verwalten</li>
   <li><strong>Manager:</strong> Wie Benutzer, plus Berichte ansehen</li>
  @if (currentUser?.Role == UserRole.SuperAdmin)
         {
       <li><strong>Administrator:</strong> Volle Kontrolle über das Lager, kann Benutzer verwalten</li>
     }
    <li class="text-muted"><strong>Super Admin:</strong> Kann nicht vergeben werden - es gibt nur einen Super Admin im System</li>
       </ul>
     </div>
            </div>
            <div class="modal-footer">
    <button class="btn btn-secondary" @onclick="CloseModals">Abbrechen</button>
 <button class="btn btn-primary" @onclick="ChangeUserRole" disabled="@isProcessing">
   @if (isProcessing)
       {
         <span class="spinner-border spinner-border-sm me-2"></span>
   }
        <i class="bi bi-shield-check me-2"></i>
          Rolle ändern
      </button>
     </div>
     </div>
    </div>
}

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private User? currentUser;
    private List<User> pendingUsers = new();
private List<User> approvedUsers = new();
    private List<User> rejectedUsers = new();
    
    private bool showApproveModal = false;
    private bool showRejectModal = false;
    private bool showRoleChangeModal = false;
 private User? selectedUser;
    private string approvalNotes = string.Empty;
    private UserRole selectedNewRole = UserRole.User;
    private bool isProcessing = false;

  protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        currentUser = await AuthService.GetCurrentUserAsync();
        
    if (currentUser?.Role >= UserRole.Admin)
        {
 await LoadUsers();
      }
    }

    private async Task LoadUsers()
    {
      var warehouseId = AuthService.GetCurrentWarehouseId();
      var grouped = await AdminQueryService.GetUsersByApprovalStatusAsync(warehouseId);

      pendingUsers = grouped.Pending.ToList();
      approvedUsers = grouped.Approved.ToList();
      rejectedUsers = grouped.Rejected.ToList();
    }

    private void OpenApproveModal(User user)
    {
        selectedUser = user;
 approvalNotes = string.Empty;
showApproveModal = true;
    }

    private void OpenRejectModal(User user)
    {
        selectedUser = user;
 approvalNotes = string.Empty;
        showRejectModal = true;
 }

    private void OpenRoleChangeModal(User user)
    {
   selectedUser = user;
        selectedNewRole = user.Role;
    showRoleChangeModal = true;
    }

    private void CloseModals()
    {
   showApproveModal = false;
  showRejectModal = false;
        showRoleChangeModal = false;
        selectedUser = null;
approvalNotes = string.Empty;
    }

    private async Task ApproveUser()
    {
        if (selectedUser == null || currentUser == null) return;
      
        isProcessing = true;
      try
        {
     var success = await UserRegistrationService.ApproveUserAsync(selectedUser.Id, currentUser.Id, approvalNotes);
     if (success)
            {
      await LoadUsers();
   CloseModals();
    }
        }
        finally
      {
isProcessing = false;
}
    }

  private async Task RejectUser()
    {
   if (selectedUser == null || currentUser == null) return;
  
        isProcessing = true;
 try
        {
          var success = await UserRegistrationService.RejectUserAsync(selectedUser.Id, currentUser.Id, approvalNotes);
       if (success)
   {
    await LoadUsers();
              CloseModals();
      }
        }
        finally
        {
 isProcessing = false;
     }
    }

    private async Task ChangeUserRole()
    {
        if (selectedUser == null || currentUser == null) return;
        
  isProcessing = true;
     try
   {
     var success = await UserRegistrationService.ChangeUserRoleAsync(selectedUser.Id, selectedNewRole, currentUser.Id);
  if (success)
{
        await LoadUsers();
   CloseModals();
     }
 }
  finally
   {
      isProcessing = false;
  }
    }

  private bool CanChangeRole(User user)
  {
   if (currentUser == null) return false;
   
        // Own role cannot be changed
        if (user.Id == currentUser.Id) return false;
        
  // SuperAdmin role cannot be changed - only one SuperAdmin exists
  if (user.Role == UserRole.SuperAdmin) return false;
        
        // SuperAdmin can change all roles (except SuperAdmin)
if (currentUser.Role == UserRole.SuperAdmin) return true;
    
 // Admin can only change User and Manager roles
  if (currentUser.Role == UserRole.Admin)
        {
      return user.Role < UserRole.Admin;
        }
        
        return false;
    }

    private IEnumerable<UserRole> GetAvailableRoles()
    {
        // The SuperAdmin role can never be assigned - only one SuperAdmin exists in the system
        if (currentUser?.Role == UserRole.SuperAdmin)
   {
 // SuperAdmin may assign Admin, Manager and User (but not SuperAdmin)
    return new[] { UserRole.Admin, UserRole.Manager, UserRole.User };
   }

   // Admin may only assign User and Manager
        return new[] { UserRole.User, UserRole.Manager };
    }

    private string GetRoleBadgeClass(UserRole role)
  {
        return role switch
   {
      UserRole.SuperAdmin => "danger",
            UserRole.Admin => "warning",
          UserRole.Manager => "info",
    _ => "secondary"
        };
    }

    private string GetRoleDisplayName(UserRole role)
    {
 return role switch
   {
   UserRole.SuperAdmin => "Super Admin",
    UserRole.Admin => "Administrator",
         UserRole.Manager => "Manager",
    _ => "Benutzer"
  };
 }
}
