        passwordMessage = "Sessions erfolgreich beendet!";
        passwordSuccess = true;
        await Task.Delay(3000);
        passwordMessage = string.Empty;
        StateHasChanged();
    }

    // Profile image upload handler (GDPR-compliant)
    private async Task HandleImageUploaded(string imagePath)
    {
        if (currentUser == null) return;

        try
        {
            // Delete old image (data minimization)
            // (already handled inside the component)

            // Update via service
            await UserProfileService.UpdateProfileImageAsync(currentUser.Id, imagePath);

            // Update user model
            currentUser.ProfileImagePath = imagePath;
            currentUser.ProfileImageUploadedAt = DateTime.UtcNow;

            passwordMessage = "Profilbild erfolgreich hochgeladen!";
            passwordSuccess = true;
   
            // Refresh UI
            StateHasChanged();

            // Hide success message after 3 seconds
            await Task.Delay(3000);
            passwordMessage = string.Empty;
        }
        catch (Exception ex)
        {
            passwordMessage = $"Fehler beim Speichern: {ex.Message}";
            passwordSuccess = false;
        }
    }

    // Profile image delete handler
    private async Task HandleImageDeleted()
    {
        if (currentUser == null) return;

        try
        {
            // Update via service
            await UserProfileService.UpdateProfileImageAsync(currentUser.Id, null);

            // Update user model
            currentUser.ProfileImagePath = null;
            currentUser.ProfileImageUploadedAt = null;

            passwordMessage = T.Profile_Image_Deleted;
            passwordSuccess = true;

            // Refresh UI
            StateHasChanged();

            // Hide success message after 3 seconds
            await Task.Delay(3000);
            passwordMessage = string.Empty;
        }
        catch (Exception ex)
        {
            passwordMessage = $"Fehler beim Löschen: {ex.Message}";
            passwordSuccess = false;
        }
    }

    private void CloseCreateApiKeyModal()
    {
        showCreateApiKeyModal = false;
        newApiKeyName = "";
        newApiKeyExpiry = null;
        newApiKeyClearText = "";
    }

    private async Task CreateApiKey()
    {
        if (currentUser == null || string.IsNullOrWhiteSpace(newApiKeyName)) return;

        isCreatingApiKey = true;
  
        try
        {
            var (clearKey, apiKey) = await ApiKeyService.GenerateApiKeyAsync(
                    currentUser.Id,
            newApiKeyName,
                    permissions: null,
            expiresAt: newApiKeyExpiry?.ToUniversalTime()
            );

            newApiKeyClearText = clearKey;
         
            // Reload keys
            apiKeys = await ApiKeyService.GetUserApiKeysAsync(currentUser.Id);

            passwordMessage = "API-Key erfolgreich erstellt!";
            passwordSuccess = true;
        }
        catch (Exception ex)
        {
            passwordMessage = $"Fehler beim Erstellen des API-Keys: {ex.Message}";
            passwordSuccess = false;
            CloseCreateApiKeyModal();
        }
        finally
        {
            isCreatingApiKey = false;
        }
    }

    private void ConfirmRevokeApiKey(int keyId, string keyName)
    {
        revokeApiKeyId = keyId;
        revokeApiKeyName = keyName;
        showRevokeApiKeyModal = true;
    }

    private void CloseRevokeApiKeyModal()
    {
        showRevokeApiKeyModal = false;
        revokeApiKeyId = 0;
        revokeApiKeyName = "";
    }

    private async Task RevokeApiKey()
    {
        if (currentUser == null || revokeApiKeyId == 0) return;

        isRevokingApiKey = true;

        try
        {
            var success = await ApiKeyService.RevokeApiKeyAsync(revokeApiKeyId, currentUser.Id);

            if (success)
            {
                // Reload keys
                apiKeys = await ApiKeyService.GetUserApiKeysAsync(currentUser.Id);

                passwordMessage = $"API-Key '{revokeApiKeyName}' wurde widerrufen.";
                passwordSuccess = true;
                CloseRevokeApiKeyModal();
            }
            else
            {
                passwordMessage = "Fehler beim Widerrufen des API-Keys.";
                passwordSuccess = false;
            }
        }
        catch (Exception ex)
        {
            passwordMessage = $"Fehler: {ex.Message}";
            passwordSuccess = false;
        }
        finally
        {
            isRevokingApiKey = false;
        }
    }

    private async Task CopyApiKeyToClipboard()
    {
        if (string.IsNullOrEmpty(newApiKeyClearText)) return;

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", newApiKeyClearText);
        passwordMessage = "API-Key in Zwischenablage kopiert!";
        passwordSuccess = true;
        StateHasChanged();
    }

    // Revoke consent methods
    private void ShowRevokeAnalyticsModal()
    {
        revokeConsentType = "Analytics & Performance";
        showRevokeConsentModal = true;
    }

    private void ShowRevokeFingerprintModal()
    {
        revokeConsentType = "Device Fingerprinting";
        showRevokeConsentModal = true;
    }

    private void CancelRevokeConsent()
    {
        showRevokeConsentModal = false;
        revokeConsentType = "";
    }

    private async Task HandleRevokeConsent()
    {
        if (currentUser == null) return;

        try
        {
            var success = await UserProfileService.RevokeConsentAsync(currentUser.Id, revokeConsentType);

            if (success)
            {
                if (revokeConsentType == "Analytics & Performance")
                {
                    currentUser.AnalyticsConsent = false;
                    currentUser.AnalyticsConsentDate = null;
                }
                else if (revokeConsentType == "Device Fingerprinting")
                {
                    currentUser.DeviceFingerprintConsent = false;
                    currentUser.DeviceFingerprintConsentDate = null;
                }

                passwordMessage = $"{revokeConsentType} wurde widerrufen. Sie werden beim nächsten Login erneut um Zustimmung gebeten.";
                passwordSuccess = true;
            }
            else
            {
                passwordMessage = "Fehler beim Widerrufen.";
                passwordSuccess = false;
            }

            showRevokeConsentModal = false;
            revokeConsentType = "";

            StateHasChanged();
        }
        catch (Exception ex)
        {
            passwordMessage = $"Fehler beim Widerrufen: {ex.Message}";
            passwordSuccess = false;
        }
    }

    public class PasswordChangeModel
    {
        [Required(ErrorMessage = "Aktuelles Passwort ist erforderlich")]
        public string OldPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Neues Passwort ist erforderlich")]
        [MinLength(6, ErrorMessage = "Passwort muss mindestens 6 Zeichen lang sein")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Passwortbestätigung ist erforderlich")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
