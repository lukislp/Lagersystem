@page "/expiry-monitoring"
@inherits CancellableComponentBase
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IExpiryService ExpiryService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject I18nText I18nText

<PageTitle>@T.ExpiryMonitoring_PageTitle</PageTitle>

<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-calendar-x me-2"></i>
        @T.ExpiryMonitoring_Title
    </h1>
    <p class="page-subtitle">@T.ExpiryMonitoring_Subtitle</p>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@T.Common_VisuallyHiddenLoading</span>
        </div>
    </div>
}
else
{
    <!-- Statistics -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle fs-1 me-3"></i>
                        <div>
                            <h3 class="mb-0">@expiredBatches.Count</h3>
                            <small>@T.ExpiryMonitoring_Expired</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-clock-history fs-1 me-3"></i>
                        <div>
                            <h3 class="mb-0">@expiringBatches.Count</h3>
                            <small>@T.ExpiryMonitoring_ExpiringSoon</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle fs-1 me-3"></i>
                        <div>
                            <h3 class="mb-0">@okBatches.Count</h3>
                            <small>@T.ExpiryMonitoring_Ok</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-box-seam fs-1 me-3"></i>
                        <div>
                            <h3 class="mb-0">@totalQuantity</h3>
                            <small>@T.ExpiryMonitoring_TotalPieces</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@T.ExpiryMonitoring_Filter_Label</label>
                    <select class="form-select" @bind="selectedFilter" @bind:after="FilterBatches">
                        <option value="all">@T.ExpiryMonitoring_Filter_All</option>
                        <option value="expired">@T.ExpiryMonitoring_Filter_Expired</option>
                        <option value="expiring">@T.ExpiryMonitoring_Filter_ExpiringSoon</option>
                        <option value="ok">@T.ExpiryMonitoring_Filter_Ok</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">@T.ExpiryMonitoring_Search_Label</label>
                    <input type="text" class="form-control"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           @bind:after="FilterBatches"
                           placeholder="@T.ExpiryMonitoring_Search_Placeholder" />
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-secondary w-100" @onclick="ClearFilters">
                        <i class="bi bi-x-circle me-2"></i>
                        @T.ExpiryMonitoring_ResetFilters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Expired batches -->
    @if (filteredBatches.Any(b => b.IsExpired))
    {
        <div class="card mb-4 border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @(T.ExpiryMonitoring_Expired_Section != null ? string.Format(T.ExpiryMonitoring_Expired_Section, filteredBatches.Count(b => b.IsExpired)) : "")
                </h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@T.ExpiryMonitoring_Col_Product</th>
                                <th>@T.ExpiryMonitoring_Col_BatchNumber</th>
                                <th>@T.ExpiryMonitoring_Col_ExpiryDate</th>
                                <th>@T.ExpiryMonitoring_Col_ExpiredSince</th>
                                <th>@T.ExpiryMonitoring_Col_Quantity</th>
                                <th>@T.ExpiryMonitoring_Col_Notes</th>
                                <th>@T.ExpiryMonitoring_Col_Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var batch in filteredBatches.Where(b => b.IsExpired).OrderBy(b => b.ExpiryDate))
                            {
                                <tr class="table-danger">
                                    <td>
                                        <strong>@batch.Product?.Name</strong><br />
                                        <small class="text-muted">@batch.Product?.Barcode</small>
                                    </td>
                                    <td><code>@batch.BatchNumber</code></td>
                                    <td>@batch.ExpiryDate?.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <span class="badge bg-danger">
                                            @(-batch.DaysUntilExpiry) Tage
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@batch.Quantity Stk.</span>
                                    </td>
                                    <td>
                                        <small>@(batch.Notes ?? "-")</small>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-danger" @onclick="() => MarkForDisposal(batch)">
                                            <i class="bi bi-trash"></i> @T.ExpiryMonitoring_Dispose
                                        </button>
                                        <button class="btn btn-sm btn-info" @onclick="() => ViewProduct(batch.ProductId)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Expiring soon batches -->
    @if (filteredBatches.Any(b => b.IsExpiringSoon))
    {
        <div class="card mb-4 border-warning">
            <div class="card-header bg-warning">
                <h3 class="card-title mb-0">
                    <i class="bi bi-clock-history me-2"></i>
                    @(T.ExpiryMonitoring_ExpiringSoon_Section != null ? string.Format(T.ExpiryMonitoring_ExpiringSoon_Section, filteredBatches.Count(b => b.IsExpiringSoon)) : "")
                </h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@T.ExpiryMonitoring_Col_Product</th>
                                <th>@T.ExpiryMonitoring_Col_BatchNumber</th>
                                <th>@T.ExpiryMonitoring_Col_ExpiryDate</th>
                                <th>@T.ExpiryMonitoring_Col_DaysUntilExpiry</th>
                                <th>@T.ExpiryMonitoring_Col_Quantity</th>
                                <th>@T.ExpiryMonitoring_Col_Manufacture</th>
                                <th>@T.ExpiryMonitoring_Col_Notes</th>
                                <th>@T.ExpiryMonitoring_Col_Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var batch in filteredBatches.Where(b => b.IsExpiringSoon).OrderBy(b => b.ExpiryDate))
                            {
                                <tr class="table-warning">
                                    <td>
                                        <strong>@batch.Product?.Name</strong><br />
                                        <small class="text-muted">@batch.Product?.Category?.Name</small>
                                    </td>
                                    <td><code>@batch.BatchNumber</code></td>
                                    <td>@batch.ExpiryDate?.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-clock"></i> @batch.DaysUntilExpiry Tage
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@batch.Quantity Stk.</span>
                                    </td>
                                    <td>
                                        <small>@(batch.ManufactureDate?.ToString("dd.MM.yyyy") ?? "-")</small>
                                    </td>
                                    <td>
                                        <small>@(batch.Notes ?? "-")</small>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-info" @onclick="() => ViewProduct(batch.ProductId)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- OK batches -->
    @if (filteredBatches.Any(b => !b.IsExpired && !b.IsExpiringSoon))
    {
        <div class="card border-success">
            <div class="card-header bg-success text-white">
                <h3 class="card-title mb-0">
                    <i class="bi bi-check-circle me-2"></i>
                    @(T.ExpiryMonitoring_Ok_Section != null ? string.Format(T.ExpiryMonitoring_Ok_Section, filteredBatches.Count(b => !b.IsExpired && !b.IsExpiringSoon)) : "")
                </h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@T.ExpiryMonitoring_Col_Product</th>
                                <th>@T.ExpiryMonitoring_Col_BatchNumber</th>
                                <th>@T.ExpiryMonitoring_Col_ExpiryDate</th>
                                <th>@T.ExpiryMonitoring_Col_DaysUntilExpiry</th>
                                <th>@T.ExpiryMonitoring_Col_Quantity</th>
                                <th>@T.ExpiryMonitoring_Col_Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var batch in filteredBatches.Where(b => !b.IsExpired && !b.IsExpiringSoon).OrderBy(b => b.ExpiryDate).Take(20))
                            {
                                <tr>
                                    <td>
                                        <strong>@batch.Product?.Name</strong>
                                    </td>
                                    <td><code>@batch.BatchNumber</code></td>
                                    <td>@batch.ExpiryDate?.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <span class="badge bg-success">
                                            @batch.DaysUntilExpiry Tage
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@batch.Quantity Stk.</span>
                                    </td>
                                    <td>
                                        <small>@(batch.Notes ?? "-")</small>
                                    </td>
                                </tr>
                            }
                            @if (filteredBatches.Count(b => !b.IsExpired && !b.IsExpiringSoon) > 20)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        <em>...und @(filteredBatches.Count(b => !b.IsExpired && !b.IsExpiringSoon) - 20) weitere</em>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (!filteredBatches.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h3 class="mt-3">Keine Chargen gefunden</h3>
                <p class="text-muted">Es wurden keine Chargen mit MHD-Tracking gefunden.</p>
            </div>
        </div>
    }
}

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private bool isLoading = true;
    private List<ProductBatch> allBatches = new();
    private List<ProductBatch> filteredBatches = new();
    private List<ProductBatch> expiredBatches = new();
    private List<ProductBatch> expiringBatches = new();
    private List<ProductBatch> okBatches = new();
    private int totalQuantity = 0;

    private string selectedFilter = "all";
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadBatches();
    }

    private async Task LoadBatches()
    {
        isLoading = true;
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) return;

            // Load all batches with expiry date
            var batches = await ExpiryService.GetAllNonEmptyBatchesWithExpiryAsync(currentUser.WarehouseId);
            allBatches = batches.ToList();

            // Categorize batches
            expiredBatches = allBatches.Where(b => b.IsExpired).ToList();
            expiringBatches = allBatches.Where(b => b.IsExpiringSoon).ToList();
            okBatches = allBatches.Where(b => !b.IsExpired && !b.IsExpiringSoon).ToList();
            totalQuantity = allBatches.Sum(b => b.Quantity);

            FilterBatches();
        }
        catch
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterBatches()
    {
        filteredBatches = allBatches;

        // Status filter
        filteredBatches = selectedFilter switch
        {
            "expired" => filteredBatches.Where(b => b.IsExpired).ToList(),
            "expiring" => filteredBatches.Where(b => b.IsExpiringSoon).ToList(),
            "ok" => filteredBatches.Where(b => !b.IsExpired && !b.IsExpiringSoon).ToList(),
            _ => filteredBatches
        };

        // Text search
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.ToLower();
            filteredBatches = filteredBatches.Where(b =>
                b.Product?.Name.ToLower().Contains(term) == true ||
            b.BatchNumber.ToLower().Contains(term)
            ).ToList();
        }
    }

    private void ClearFilters()
    {
        selectedFilter = "all";
        searchTerm = string.Empty;
        FilterBatches();
    }

    private async Task MarkForDisposal(ProductBatch batch)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm",
$"Charge '{batch.BatchNumber}' wirklich als entsorgt markieren?\n\n" +
        $"Produkt: {batch.Product?.Name}\n" +
        $"Menge: {batch.Quantity} Stück\n" +
        $"MHD: {batch.ExpiryDate:dd.MM.yyyy}"))
        {
            try
            {
                var result = await ExpiryService.MarkBatchAsDisposedAsync(
                    batch.Id,
                    notes: $"Entsorgt: Charge {batch.BatchNumber} abgelaufen seit {-batch.DaysUntilExpiry} Tagen");

                if (result.IsFailure)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"Fehler: {result.ErrorMessage ?? "Unbekannter Fehler"}");
                    return;
                }

                await LoadBatches();
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Fehler: {ex.Message}");
            }
        }
    }

    private void ViewProduct(int productId)
    {
        NavigationManager.NavigateTo($"/products?search={productId}");
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}
