@page "/admin/database-health"
@inherits CancellableComponentBase
@using LagersystemLVHome.Application.Services
@using LagersystemLVHome.Application.Configuration
@using Microsoft.AspNetCore.Authorization
@inject IDatabaseHealthService DatabaseHealthService
@inject IAuthService AuthService
@inject IToastService ToastService
@inject NavigationManager NavigationManager
@inject DatabaseSettings DatabaseSettings
@inject I18nText I18nText
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode InteractiveServer

<PageTitle>@T.DbHealth_Title - LagerSystem</PageTitle>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h2 class="mb-1"><i class="bi bi-database-fill-gear text-primary"></i> @T.DbHealth_Title</h2>
                    <p class="text-muted mb-0">@T.DbHealth_Subtitle</p>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-secondary fs-6">
                        <i class="bi bi-server me-1"></i>@DatabaseSettings.Provider
                    </span>
                    <button class="btn btn-outline-primary" @onclick="RefreshDataAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-arrow-clockwise"></i> Aktualisieren
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!hasAccess)
    {
        <div class="alert alert-danger">
            <i class="bi bi-shield-exclamation me-2"></i>
            <strong>@T.DbHealth_AccessDenied</strong>
        </div>
    }
    else if (isLoading && report == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary health-spinner" role="status"></div>
            <p class="mt-3 text-muted">@T.DbHealth_Loading</p>
        </div>
    }
    else if (report != null)
    {
        <!-- Quick Stats Row -->
        <div class="row g-3 mb-4">
            <!-- Health Score -->
            <div class="col-6 col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-3">
                        <div class="health-ring @GetHealthRingClass(report.HealthScore)">
                            <span class="health-value">@report.HealthScore</span>
                        </div>
                        <div class="mt-2">
                            <span class="badge @GetHealthBadgeClass(report.HealthStatus)">@report.HealthStatus</span>
                        </div>
                        <small class="text-muted">@T.DbHealth_HealthScore</small>
                    </div>
                </div>
            </div>

            <!-- Connection Status -->
            <div class="col-6 col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-3">
                        @if (report.IsConnected)
                        {
                            <div class="stat-icon text-success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div class="stat-value text-success">@T.DbHealth_Online</div>
                        }
                        else
                        {
                            <div class="stat-icon text-danger">
                                <i class="bi bi-x-circle-fill"></i>
                            </div>
                            <div class="stat-value text-danger">@T.DbHealth_Offline</div>
                        }
                        <small class="text-muted">@T.DbHealth_Connection</small>
                    </div>
                </div>
            </div>

            <!-- Latency -->
            <div class="col-6 col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-3">
                        <div class="stat-icon @GetLatencyClass(report.ConnectionLatency.TotalMilliseconds)">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                        <div class="stat-value">@report.ConnectionLatency.TotalMilliseconds.ToString("F0") ms</div>
                        <small class="text-muted">@T.DbHealth_Latency</small>
                    </div>
                </div>
            </div>

            <!-- Database Size -->
            <div class="col-6 col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-3">
                        <div class="stat-icon text-info">
                            <i class="bi bi-hdd-fill"></i>
                        </div>
                        <div class="stat-value">@report.DatabaseSizeFormatted</div>
                        <small class="text-muted">@T.DbHealth_DbSize</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Stats Grid -->
        <div class="row g-3 mb-4">
            <!-- Database Info Card -->
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="mb-0"><i class="bi bi-info-circle text-primary me-2"></i>@T.DbHealth_DbInfo</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="info-box">
                                    <div class="info-label">@T.DbHealth_Provider</div>
                                    <div class="info-value">
                                        <span class="badge bg-primary">@report.DatabaseProvider</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-box">
                                    <div class="info-label">@T.DbHealth_Version</div>
                                    <div class="info-value text-truncate" title="@report.DatabaseVersion">
                                        @TruncateVersion(report.DatabaseVersion, 25)
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-box">
                                    <div class="info-label">@T.DbHealth_Tables</div>
                                    <div class="info-value fw-bold">@report.TotalTables</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-box">
                                    <div class="info-label">@T.DbHealth_TotalRows</div>
                                    <div class="info-value fw-bold">@report.TotalRows.ToString("N0")</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-box">
                                    <div class="info-label">@T.DbHealth_ActiveConnections</div>
                                    <div class="info-value">
                                        @if (report.ActiveConnections > 0)
                                        {
                                            <span class="fw-bold">@report.ActiveConnections</span>
                                            @if (report.MaxConnections > 0)
                                            {
                                                <span class="text-muted"> / @report.MaxConnections</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-box">
                                    <div class="info-label">@T.DbHealth_AvgQueryTime</div>
                                    <div class="info-value">
                                        @if (report.AverageQueryTimeMs > 0)
                                        {
                                            <span class="@GetQueryTimeClass(report.AverageQueryTimeMs)">@report.AverageQueryTimeMs.ToString("F1") ms</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Performance Metrics -->
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="mb-0"><i class="bi bi-graph-up text-success me-2"></i>@T.DbHealth_PerfMetrics</h5>
                    </div>
                    <div class="card-body">
                        <!-- Connection Latency Bar -->
                        <div class="metric-item mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="metric-label">@T.DbHealth_ConnectionLatency</span>
                                <span class="metric-value @GetLatencyClass(report.ConnectionLatency.TotalMilliseconds)">
                                    @report.ConnectionLatency.TotalMilliseconds.ToString("F1") ms
                                </span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @GetLatencyBarClass(report.ConnectionLatency.TotalMilliseconds)"
                                     style="width: @GetLatencyPercentage(report.ConnectionLatency.TotalMilliseconds)%"></div>
                            </div>
                            <small class="text-muted">@T.DbHealth_LatencyHint</small>
                        </div>

                        <!-- Database Size Bar -->
                        <div class="metric-item mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="metric-label">@T.DbHealth_StorageUsage</span>
                                <span class="metric-value">@report.DatabaseSizeFormatted</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @GetSizeBarClass(report.DatabaseSizeBytes)"
                                     style="width: @GetSizePercentage(report.DatabaseSizeBytes)%"></div>
                            </div>
                            <small class="text-muted">@T.DbHealth_StorageHint</small>
                        </div>

                        <!-- Row Density -->
                        <div class="metric-item mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="metric-label">@T.DbHealth_DataDensity</span>
                                <span class="metric-value">@GetRowDensity() Zeilen/Tabelle</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-info" style="width: @GetRowDensityPercentage()%"></div>
                            </div>
                        </div>

                        <!-- Health Components -->
                        <div class="mt-3 pt-3 border-top">
                            <small class="text-muted d-block mb-2">@T.DbHealth_HealthComponents</small>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge @(report.IsConnected ? "bg-success" : "bg-danger")">
                                    <i class="bi bi-plug me-1"></i>Verbindung
                                </span>
                                <span class="badge @(report.ConnectionLatency.TotalMilliseconds < 200 ? "bg-success" : report.ConnectionLatency.TotalMilliseconds < 500 ? "bg-warning" : "bg-danger")">
                                    <i class="bi bi-speedometer me-1"></i>Latenz
                                </span>
                                <span class="badge @(report.DatabaseSizeBytes < 5L * 1024 * 1024 * 1024 ? "bg-success" : "bg-warning")">
                                    <i class="bi bi-hdd me-1"></i>Speicher
                                </span>
                                <span class="badge @(report.TotalTables > 0 ? "bg-success" : "bg-secondary")">
                                    <i class="bi bi-table me-1"></i>Tabellen
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Warnings & Recommendations -->
        @if (report.Warnings.Any() || report.Recommendations.Any())
        {
            <div class="row g-3 mb-4">
                @if (report.Warnings.Any())
                {
                    <div class="col-md-6">
                        <div class="card border-warning shadow-sm h-100">
                            <div class="card-header bg-warning bg-opacity-10 border-warning">
                                <h5 class="mb-0 text-warning">
                                    <i class="bi bi-exclamation-triangle me-2"></i>Warnungen (@report.Warnings.Count)
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <ul class="list-group list-group-flush">
                                    @foreach (var warning in report.Warnings)
                                    {
                                        <li class="list-group-item d-flex align-items-start">
                                            <i class="bi bi-exclamation-circle text-warning me-2 mt-1"></i>
                                            <span>@warning</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
                @if (report.Recommendations.Any())
                {
                    <div class="col-md-6">
                        <div class="card border-info shadow-sm h-100">
                            <div class="card-header bg-info bg-opacity-10 border-info">
                                <h5 class="mb-0 text-info">
                                    <i class="bi bi-lightbulb me-2"></i>Empfehlungen (@report.Recommendations.Count)
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <ul class="list-group list-group-flush">
                                    @foreach (var rec in report.Recommendations)
                                    {
                                        <li class="list-group-item d-flex align-items-start">
                                            <i class="bi bi-arrow-right-circle text-info me-2 mt-1"></i>
                                            <span>@rec</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Table Statistics -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-table text-primary me-2"></i>@T.DbHealth_TableStats</h5>
                        <div class="d-flex gap-2 align-items-center">
                            <small class="text-muted">@tableStats.Count Tabellen</small>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleTableDetails">
                                <i class="bi @(showAllTables ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                @(showAllTables ? "Weniger" : "Alle anzeigen")
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@T.DbHealth_ColTable</th>
                                        <th class="text-end">@T.DbHealth_ColRows</th>
                                        <th class="text-end">@T.DbHealth_ColSize</th>
                                        <th class="text-end">@T.DbHealth_ColIndex</th>
                                        <th class="table-col-share">@T.DbHealth_ColShare</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var table in GetVisibleTables())
                                    {
                                        <tr>
                                            <td>
                                                <code class="text-primary">@table.TableName</code>
                                                @if (table.RowCount > 100000)
                                                {
                                                    <span class="badge bg-warning ms-1" title="Grosse Tabelle">
                                                        <i class="bi bi-exclamation-triangle"></i>
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end font-monospace">@table.RowCount.ToString("N0")</td>
                                            <td class="text-end font-monospace">@table.SizeFormatted</td>
                                            <td class="text-end font-monospace">@FormatSize(table.IndexSizeBytes)</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 6px;">
                                                        <div class="progress-bar @GetTableProgressBarColor(table.PercentageOfTotal)"
                                                             style="width: @table.PercentageOfTotal.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%">
                                                        </div>
                                                    </div>
                                                    <small class="text-muted table-share-label">@table.PercentageOfTotal.ToString("F1")%</small>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Index Statistics -->
        @if (indexStats.Any())
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0">
                            <h5 class="mb-0"><i class="bi bi-diagram-3 text-success me-2"></i>@T.DbHealth_IndexStats</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@T.DbHealth_ColIndex</th>
                                            <th>@T.DbHealth_ColTable</th>
                                            <th class="text-end">@T.DbHealth_ColSize</th>
                                            <th class="text-end">@T.DbHealth_ColScans</th>
                                            <th>@T.DbHealth_ColEfficiency</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var index in indexStats.Take(15))
                                        {
                                            <tr>
                                                <td><code class="text-success">@index.IndexName</code></td>
                                                <td>@index.TableName</td>
                                                <td class="text-end font-monospace">@FormatSize(index.SizeBytes)</td>
                                                <td class="text-end font-monospace">@(index.ScanCount?.ToString("N0") ?? "-")</td>
                                                <td>
                                                    @if (index.ScanCount.HasValue)
                                                    {
                                                        var efficiency = GetIndexEfficiency(index);
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="progress flex-grow-1" style="height: 6px; max-width: 80px;">
                                                                <div class="progress-bar @GetEfficiencyBarClass(efficiency)" style="width: @efficiency%"></div>
                                                            </div>
                                                            <small class="@GetEfficiencyTextClass(efficiency)">@efficiency%</small>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Connection Test & Actions -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="mb-0"><i class="bi bi-plug text-primary me-2"></i>@T.DbHealth_ConnectionTest</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">
                            Testen Sie die Datenbankverbindung und messen Sie die aktuelle Latenz.
                        </p>
                        <button class="btn btn-primary" @onclick="RunConnectionTestAsync" disabled="@isTestingConnection">
                            @if (isTestingConnection)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-play-circle me-1"></i> Verbindung testen
                        </button>

                        @if (connectionTestResult != null)
                        {
                            <div class="mt-3 p-3 rounded @(connectionTestResult.Success ? "bg-success bg-opacity-10 border border-success" : "bg-danger bg-opacity-10 border border-danger")">
                                @if (connectionTestResult.Success)
                                {
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-check-circle-fill text-success fs-4 me-2"></i>
                                        <div>
                                            <strong class="text-success">@T.DbHealth_Connection @T.DbHealth_Online</strong><br>
                                            <small class="text-muted">Latenz: @connectionTestResult.Latency.TotalMilliseconds.ToString("F2") ms</small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-x-circle-fill text-danger fs-4 me-2"></i>
                                        <div>
                                            <strong class="text-danger">@T.DbHealth_Connection @T.DbHealth_Offline</strong><br>
                                            <small class="text-danger">@connectionTestResult.ErrorMessage</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="mb-0"><i class="bi bi-gear text-secondary me-2"></i>Schnellaktionen</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-column gap-2">
                            <a href="/admin/backup" class="btn btn-outline-secondary text-start">
                                <i class="bi bi-cloud-arrow-up me-2"></i>Backup Management
                            </a>
                            <a href="/admin/gdpr-cleanup" class="btn btn-outline-secondary text-start">
                                <i class="bi bi-trash me-2"></i>GDPR Cleanup
                            </a>
                            <a href="/admin/sessions" class="btn btn-outline-secondary text-start">
                                <i class="bi bi-people me-2"></i>Session Management
                            </a>
                            <a href="/admin/audit" class="btn btn-outline-secondary text-start">
                                <i class="bi bi-journal-text me-2"></i>Audit Logs
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@code {
    private DatabaseHealthReport? report;
    private List<TableStatistics> tableStats = new();
    private List<IndexStatistics> indexStats = new();
    private ConnectionTestResult? connectionTestResult;
    
    private bool isLoading = true;
    private bool isTestingConnection = false;
    private bool showAllTables = false;
    private bool hasAccess = false;

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        var currentUser = await AuthService.GetCurrentUserAsync();
        hasAccess = currentUser?.Role == LagersystemLVHome.Domain.Models.UserRole.SuperAdmin;
        
        if (hasAccess)
        {
            await RefreshDataAsync();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task RefreshDataAsync()
    {
        isLoading = true;
        try
        {
            report = await DatabaseHealthService.GetHealthReportAsync();
            tableStats = await DatabaseHealthService.GetTableStatisticsAsync();
            indexStats = await DatabaseHealthService.GetIndexStatisticsAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunConnectionTestAsync()
    {
        isTestingConnection = true;
        try
        {
            connectionTestResult = await DatabaseHealthService.TestConnectionAsync();
            if (connectionTestResult.Success)
                ToastService.ShowSuccess($"Verbindung OK ({connectionTestResult.Latency.TotalMilliseconds:F2} ms)");
            else
                ToastService.ShowError($"Error: {connectionTestResult.ErrorMessage}");
        }
        finally
        {
            isTestingConnection = false;
        }
    }

    private void ToggleTableDetails() => showAllTables = !showAllTables;

    private List<TableStatistics> GetVisibleTables() => showAllTables ? tableStats : tableStats.Take(10).ToList();

    // Health Score Helpers
    private string GetHealthRingClass(int score)
    {
        if (score >= 90) return "health-excellent";
        if (score >= 70) return "health-good";
        if (score >= 50) return "health-fair";
        if (score >= 30) return "health-poor";
        return "health-critical";
    }

    private string GetHealthBadgeClass(string status)
    {
        return status switch
        {
            "Excellent" => "bg-success",
            "Good" => "bg-primary",
            "Fair" => "bg-warning text-dark",
            "Poor" => "bg-orange text-white",
            _ => "bg-danger"
        };
    }

    // Latency Helpers
    private string GetLatencyClass(double ms)
    {
        if (ms < 50) return "text-success";
        if (ms < 200) return "text-primary";
        if (ms < 500) return "text-warning";
        return "text-danger";
    }

    private string GetLatencyBarClass(double ms)
    {
        if (ms < 50) return "bg-success";
        if (ms < 200) return "bg-primary";
        if (ms < 500) return "bg-warning";
        return "bg-danger";
    }

    private double GetLatencyPercentage(double ms) => Math.Min(100, ms / 10);

    // Size Helpers
    private string GetSizeBarClass(long bytes)
    {
        var gb = bytes / (1024.0 * 1024.0 * 1024.0);
        if (gb < 1) return "bg-success";
        if (gb < 5) return "bg-warning";
        return "bg-danger";
    }

    private double GetSizePercentage(long bytes)
    {
        var gb = bytes / (1024.0 * 1024.0 * 1024.0);
        return Math.Min(100, gb * 10);
    }

    // Query Time Helper
    private string GetQueryTimeClass(double ms)
    {
        if (ms < 10) return "text-success fw-bold";
        if (ms < 50) return "text-primary";
        if (ms < 200) return "text-warning";
        return "text-danger";
    }

    // Row Density Helpers
    private string GetRowDensity()
    {
        if (report == null || report.TotalTables == 0) return "0";
        return (report.TotalRows / report.TotalTables).ToString("N0");
    }

    private double GetRowDensityPercentage()
    {
        if (report == null || report.TotalTables == 0) return 0;
        var density = report.TotalRows / report.TotalTables;
        return Math.Min(100, density / 1000.0);
    }

    // Table Helpers
    private string GetTableProgressBarColor(double percentage)
    {
        if (percentage >= 40) return "bg-danger";
        if (percentage >= 20) return "bg-warning";
        if (percentage >= 10) return "bg-info";
        return "bg-success";
    }

    // Index Helpers
    private int GetIndexEfficiency(IndexStatistics index)
    {
        if (!index.ScanCount.HasValue || index.ScanCount == 0) return 0;
        return (int)Math.Min(100, index.ScanCount.Value / 100.0);
    }

    private string GetEfficiencyBarClass(int efficiency)
    {
        if (efficiency >= 70) return "bg-success";
        if (efficiency >= 40) return "bg-warning";
        return "bg-danger";
    }

    private string GetEfficiencyTextClass(int efficiency)
    {
        if (efficiency >= 70) return "text-success";
        if (efficiency >= 40) return "text-warning";
        return "text-danger";
    }

    // Format Helpers
    private string TruncateVersion(string version, int maxLength)
    {
        if (string.IsNullOrEmpty(version)) return "Unknown";
        return version.Length > maxLength ? version[..maxLength] + "..." : version;
    }

    private string FormatSize(long bytes)
    {
        if (bytes == 0) return "0 B";
        string[] sizes = { "B", "KB", "MB", "GB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }
}
