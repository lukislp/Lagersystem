@page "/rooms/{RoomId:int}/products"
@inherits CancellableComponentBase
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject ILocationQueryService LocationQueryService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject I18nText I18nText

<PageTitle>@T.RoomProducts_PageTitle</PageTitle>

@if (room != null)
{
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-3">
            <a href="/rooms-overview" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> @T.RoomProducts_Back
            </a>
            <div>
                <h1 class="page-title mb-1">@room.Name</h1>
                <p class="page-subtitle mb-0">
                    <code>@room.Code</code>
                    @if (!string.IsNullOrEmpty(room.Description))
                    {
                        <span class="text-muted ms-3">@room.Description</span>
                    }
                </p>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-primary">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">@T.RoomProducts_Stats_Storage</p>
                        <h3 class="stat-value">@storageLocations.Count</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon text-success">
                        <i class="bi bi-box"></i>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">@T.RoomProducts_Stats_Products</p>
                        <h3 class="stat-value">@uniqueProducts.Count</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="stat-card">
                    <div class="stat-icon text-info">
                        <i class="bi bi-stack"></i>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">@T.RoomProducts_Stats_TotalQty</p>
                        <h3 class="stat-value">@totalQuantity</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="stat-card">
                    <div class="stat-icon text-warning">
                        <i class="bi bi-currency-euro"></i>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">@T.RoomProducts_Stats_TotalValue</p>
                        <h3 class="stat-value">@totalValue.ToString("C")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="stat-card">
                    <div class="stat-icon text-secondary">
                        <i class="bi bi-rulers"></i>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">@T.RoomProducts_Stats_Area</p>
                        <h3 class="stat-value">@(room.Area?.ToString("N0") ?? "-") mö</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <input type="text" class="form-control" placeholder="@T.RoomProducts_Search"
                           @bind="searchTerm" @bind:event="oninput" @bind:after="FilterProducts" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="selectedStorageId" @bind:after="FilterProducts">
                        <option value="0">@T.StorageOverview_Filter_All</option>
                        @foreach (var loc in storageLocations)
                        {
                            <option value="@loc.Id">@loc.Code - @loc.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-secondary w-100" @onclick="ClearFilters">
                        <i class="bi bi-x-circle"></i> Filter löschen
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Table -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Produkt</th>
                            <th>Kategorie</th>
                            <th>Lagerfach</th>
                            <th>Menge</th>
                            <th>Preis (Stk.)</th>
                            <th>Gesamtwert</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (filteredProducts.Any())
                        {
                            @foreach (var item in filteredProducts)
                            {
                                var totalItemValue = item.Product.Price * item.Quantity;
     
                                <tr>
                                    <td>
                                        <div class="product-info">
                                            <div class="product-icon">
                                                <CategoryIcon IconClass="@(item.Product.Category?.Icon ?? "bi-box")" />
                                            </div>
                                            <div>
                                                <div class="product-name">@item.Product.Name</div>
                                                @if (!string.IsNullOrEmpty(item.Product.Barcode))
                                                {
                                                    <div class="product-barcode">@item.Product.Barcode</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.Product.Category?.Name</td>
                                    <td>
                                        <code>@item.StorageLocation.Code</code>
                                        <br>
                                        <small class="text-muted">@item.StorageLocation.Name</small>
                                    </td>
                                    <td>
                                        <span class="badge @(item.Quantity < item.Product.MinQuantity ? "bg-danger" : "bg-success")">
                                            @item.Quantity Stk.
                                        </span>
                                    </td>
                                    <td>@item.Product.Price.ToString("C")</td>
                                    <td>
                                        <strong>@totalItemValue.ToString("C")</strong>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-primary"
                                                @onclick="() => NavigateToProduct(item.Product)">
                                            <i class="bi bi-eye"></i> Ansehen
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">
                                    <EmptyState IconClass="bi-inbox"
                                                Title="Keine Produkte gefunden"
                                                Description="In diesem Raum sind keine Produkte gelagert." />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (loading)
{
    <div class="text-center p-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Laden...</span>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Raum nicht gefunden.
    </div>
}

@code {
    private LagersystemLVHome.I18nText.App T = new();
    [Parameter]
    public int RoomId { get; set; }

    private Room? room;
    private List<StorageLocation> storageLocations = new();
    private List<ProductStorageLocation> allProductLocations = new();
    private List<ProductStorageLocation> filteredProducts = new();
    private List<Product> uniqueProducts = new();
    private int totalQuantity = 0;
    private decimal totalValue = 0m;

    private string searchTerm = string.Empty;
    private int selectedStorageId = 0;
    private bool loading = true;
    private User? currentUser;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;

        var contents = await LocationQueryService.GetRoomContentsAsync(RoomId, currentUser!.WarehouseId);

        if (contents is null)
        {
            room = null;
            loading = false;
            return;
        }

        room = contents.Room;
        storageLocations = contents.StorageLocations.ToList();
        allProductLocations = contents.ProductPlacements.ToList();

        uniqueProducts = allProductLocations
            .Select(psl => psl.Product)
            .DistinctBy(p => p.Id)
            .ToList();

        totalQuantity = allProductLocations.Sum(psl => psl.Quantity);
        totalValue = allProductLocations.Sum(psl => psl.Quantity * psl.Product.Price);

        FilterProducts();
        loading = false;
    }

    private void FilterProducts()
    {
        filteredProducts = allProductLocations;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.ToLower();
            filteredProducts = filteredProducts
                .Where(psl => psl.Product.Name.ToLower().Contains(term) ||
                psl.Product.Barcode.ToLower().Contains(term))
                    .ToList();
        }

        if (selectedStorageId > 0)
        {
            filteredProducts = filteredProducts
        .Where(psl => psl.StorageLocationId == selectedStorageId)
            .ToList();
        }
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedStorageId = 0;
        FilterProducts();
    }

    private void NavigateToProduct(Product product)
    {
        // Navigate to product detail page
        NavigationManager.NavigateTo($"/products/{product.Id}");
    }
}
