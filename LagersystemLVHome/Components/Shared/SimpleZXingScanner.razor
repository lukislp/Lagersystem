@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="zxing-scanner-container">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        </div>
    }

    @if (!isScanning)
    {
        <div class="text-center mb-3">
            <button class="btn btn-primary btn-lg" @onclick="StartScanning">
                <i class="bi bi-camera-video me-2"></i>Scanner starten
            </button>
        </div>
    }

    @if (isScanning)
    {
        <div class="scanner-active mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-success">
                    <i class="bi bi-record-circle-fill blink me-2"></i>Scanner aktiv
                </span>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleFullscreen" title="Vollbild">
                        <i class="bi bi-arrows-fullscreen me-1"></i>Vollbild
                    </button>
                    <button class="btn btn-danger btn-sm" @onclick="StopScanning">
                        <i class="bi bi-stop-circle me-1"></i>Stop
                    </button>
                </div>
            </div>

            <div class="scanner-viewport">
                <div id="@videoElementId" class="scanner-container-inner"></div>
          
                <div class="scan-zone">
                    <div class="scan-line"></div>
                    <div class="corner top-left"></div>
                    <div class="corner top-right"></div>
                    <div class="corner bottom-left"></div>
                    <div class="corner bottom-right"></div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(lastBarcode))
            {
                <div class="alert alert-success mt-3 scan-result">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>Letzter Scan:</strong>
                    <div class="mt-1">
                        <code class="fs-5">@lastBarcode</code>
                        <span class="ms-2 text-muted">(@lastScanTime.ToString("HH:mm:ss"))</span>
                    </div>
                </div>
            }
        </div>
    }
</div>


@code {
    [Parameter]
    public EventCallback<string> OnScanned { get; set; }

    private IJSObjectReference? module;
    private DotNetObjectReference<SimpleZXingScanner>? dotNetRef;
    private bool isScanning = false;
    private string? errorMessage;
    private string lastBarcode = string.Empty;
    private DateTime lastScanTime = DateTime.Now;
    private string videoElementId = $"scanner-target-{Guid.NewGuid():N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/barcode-scanner.js");
                dotNetRef = DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("init", dotNetRef);
            }
            catch (Exception ex)
            {
                errorMessage = $"Scanner konnte nicht initialisiert werden: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private async Task StartScanning()
    {
        if (module == null) return;

        errorMessage = null;
        isScanning = true;
        StateHasChanged();

        await Task.Delay(200);

        try
        {
            await module.InvokeVoidAsync("startScanner", videoElementId, "");
        }
        catch (Exception ex)
        {
            errorMessage = $"Scanner konnte nicht gestartet werden: {ex.Message}";
            isScanning = false;
            StateHasChanged();
        }
    }

    private async Task StopScanning()
    {
        if (module != null)
        {
            await module.InvokeVoidAsync("stopScanner");
        }
        isScanning = false;
        StateHasChanged();
    }

    private async Task ToggleFullscreen()
    {
        if (module == null) return;
        try
        {
            await module.InvokeAsync<bool>("toggleFullscreen", videoElementId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Vollbild fehlgeschlagen: {ex.Message}";
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnBarcodeDetected(string barcode)
    {
        if (string.IsNullOrWhiteSpace(barcode))
            return;

        lastBarcode = barcode;
        lastScanTime = DateTime.Now;

        if (OnScanned.HasDelegate)
        {
            await OnScanned.InvokeAsync(barcode);
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnError(string error)
    {
        errorMessage = error;
        isScanning = false;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module != null)
            {
                await module.InvokeVoidAsync("stopScanner");
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
        }
        catch
        {
            // Ignore disposal errors
        }

        dotNetRef?.Dispose();
    }
}
