@page "/admin/insights"
@rendermode InteractiveServer
@using LagersystemLVHome.Application.Services
@using LagersystemLVHome.Domain.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject IApplicationInsightsService InsightsService
@inject IApplicationUptimeService UptimeService
@inject NavigationManager Navigation
@inject ILogger<ApplicationInsights> _logger
@inject IJSRuntime JSRuntime
@inject I18nText I18nText
@attribute [Authorize(Roles = "SuperAdmin")]
@implements IDisposable

<PageTitle>Application Insights - LagerSystem</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-graph-up-arrow text-primary me-2"></i>
                Application Insights
            </h1>
            <p class="text-muted mb-0">
                System Analytics & Performance Monitoring
                <span class="badge bg-success ms-2" title="Auto-refresh every 30 seconds">
                    <i class="bi bi-arrow-clockwise"></i> Auto-Refresh
                </span>
            </p>
        </div>
     
        <TimePeriodFilter SelectedPeriod="@selectedPeriod"
                          IsLoading="@loading"
                          OnPeriodChanged="@ChangePeriodFromComponent" />
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading insights...</p>
        </div>
    }
    else if (stats == null)
    {
        <!-- Error State -->
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Failed to load insights
            </h4>
            <p>There was an error loading Application Insights data. Please check the logs.</p>
            <hr>
            <button class="btn btn-sm btn-danger" @onclick="LoadDataAsync">
                <i class="bi bi-arrow-clockwise me-1"></i>
                Retry
            </button>
        </div>
    }
    else if (stats.TotalPageViews == 0 && stats.TotalApiRequests == 0)
    {
        <!-- Empty State - No Data Yet -->
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-graph-up text-muted" style="font-size: 4rem;"></i>
                </div>
                <h3 class="mb-3">No Data Available Yet</h3>
                <p class="text-muted mb-4">
                    Application Insights will start collecting data once you navigate through the application.
                    <br>
                    Page views, API requests, and user activity will be tracked automatically.
                </p>
        
                <div class="alert alert-info text-start d-inline-block" style="max-width: 600px;">
                    <h5 class="alert-heading">
                        <i class="bi bi-info-circle me-2"></i>
                        How to generate data:
                    </h5>
                    <ol class="mb-0">
                        <li>Navigate to different pages (Products, Categories, Dashboard)</li>
                        <li>Use the Scanner feature</li>
                        <li>Make API requests</li>
                        <li>Perform actions (Create, Edit, Delete)</li>
                    </ol>
                </div>
        
                <hr class="my-4">
     
                <button class="btn btn-primary me-2" @onclick='() => Navigation.NavigateTo("/")'>
                    <i class="bi bi-house-fill me-1"></i>
                    Go to Dashboard
                </button>
                <button class="btn btn-outline-primary" @onclick="LoadDataAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Refresh
                </button>
            </div>
        </div>
    }
    else if (stats != null)
    {
        <!-- Existing KPI Cards and Charts -->
        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Page Views</h6>
                                <h3 class="mb-0">@stats.TotalPageViews.ToString("N0")</h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 p-3 rounded">
                                <i class="bi bi-eye-fill text-primary fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">API Requests</h6>
                                <h3 class="mb-0">@stats.TotalApiRequests.ToString("N0")</h3>
                            </div>
                            <div class="bg-success bg-opacity-10 p-3 rounded">
                                <i class="bi bi-cpu-fill text-success fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Active Users</h6>
                                <h3 class="mb-0">@stats.ActiveUsers</h3>
                                <small class="text-muted">of @stats.TotalUsers total</small>
                            </div>
                            <div class="bg-info bg-opacity-10 p-3 rounded">
                                <i class="bi bi-people-fill text-info fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Avg Response</h6>
                                <h3 class="mb-0">@stats.AvgApiResponseTimeMs.ToString("F0")ms</h3>
                                <small class="text-muted">API Success: @stats.ApiSuccessRate.ToString("F1")%</small>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded">
                                <i class="bi bi-speedometer text-warning fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- User engagement KPIs -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Unique Visitors</h6>
                                <h3 class="mb-0">@stats.UniqueVisitors.ToString("N0")</h3>
                                <small class="text-muted">Distinct IPs</small>
                            </div>
                            <div class="bg-purple bg-opacity-10 p-3 rounded">
                                <i class="bi bi-people text-purple fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Avg Session</h6>
                                <h3 class="mb-0">@stats.AvgSessionDuration.ToString("F1")m</h3>
                                <small class="text-muted">Duration</small>
                            </div>
                            <div class="bg-cyan bg-opacity-10 p-3 rounded">
                                <i class="bi bi-clock-history text-cyan fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Bounce Rate</h6>
                                <h3 class="mb-0">@stats.BounceRate.ToString("F1")%</h3>
                                <small class="text-muted">@(stats.BounceRate < 30 ? "✓ Good" : "⚠ High")</small>
                            </div>
                            <div class="@(stats.BounceRate < 30 ? "bg-success" : "bg-warning") bg-opacity-10 p-3 rounded">
                                <i class="bi bi-arrow-return-left @(stats.BounceRate < 30 ? "text-success" : "text-warning") fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Error Rate</h6>
                                <h3 class="mb-0">@stats.ErrorRate.ToString("F1")%</h3>
                                <small class="text-muted">@(stats.ErrorRate < 1 ? "✓ Healthy" : "⚠ Check")</small>
                            </div>
                            <div class="@(stats.ErrorRate < 1 ? "bg-success" : "bg-danger") bg-opacity-10 p-3 rounded">
                                <i class="bi bi-exclamation-triangle @(stats.ErrorRate < 1 ? "text-success" : "text-danger") fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- System performance metrics -->
        @if (currentPerformance != null)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="text-muted mb-2">CPU Usage</h6>
                                    <h3 class="mb-0">@currentPerformance.CpuUsagePercent.ToString("F1")%</h3>
                                    <small class="text-muted">@(currentPerformance.CpuUsagePercent < 50 ? "✓ Normal" : currentPerformance.CpuUsagePercent < 80 ? "⚠ High" : "🔴 Critical")</small>
                                </div>
                                <div class="@(currentPerformance.CpuUsagePercent < 50 ? "bg-success" : currentPerformance.CpuUsagePercent < 80 ? "bg-warning" : "bg-danger") bg-opacity-10 p-3 rounded">
                                    <i class="bi bi-cpu @(currentPerformance.CpuUsagePercent < 50 ? "text-success" : currentPerformance.CpuUsagePercent < 80 ? "text-warning" : "text-danger") fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="text-muted mb-2">Memory Used</h6>
                                    <h3 class="mb-0">@currentPerformance.MemoryUsedMB.ToString("N0") MB</h3>
                                </div>
                                <div class="bg-info bg-opacity-10 p-3 rounded">
                                    <i class="bi bi-memory text-info fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="text-muted mb-2">Uptime</h6>
                                    <h3 class="mb-0">@FormatUptime()</h3>
                                    <small class="text-muted">
                                        @if (UptimeService.RecycleCount > 0)
                                        {
                                            <text>@UptimeService.RecycleCount IIS Recycles</text>
                                        }
                                        else
                                        {
                                            <text>Since start</text>
                                        }
                                    </small>
                                </div>
                                <div class="bg-primary bg-opacity-10 p-3 rounded">
                                    <i class="bi bi-clock text-primary fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="text-muted mb-2">Request Rate</h6>
                                    <h3 class="mb-0">@currentPerformance.TotalRequests</h3>
                                    <small class="text-muted">Last hour</small>
                                </div>
                                <div class="bg-success bg-opacity-10 p-3 rounded">
                                    <i class="bi bi-bar-chart text-success fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Charts Row -->
        <div class="row g-3 mb-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">Page Views & API Requests Over Time</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="trafficChart" style="height: 300px;"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">Device Types</h5>
                    </div>
                    <div class="card-body">
                        <canvas id="deviceChart" style="height: 300px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Pages & Users -->
        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">
                            <i class="bi bi-star-fill text-warning me-2"></i>
                            Top Pages
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Page</th>
                                        <th class="text-end">Views</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pageItem in stats.TopPages)
                                    {
                                        <tr>
                                            <td data-label="Page">
                                                <i class="bi bi-file-earmark text-muted me-2"></i>
                                                <code class="text-primary">@pageItem.Key</code>
                                            </td>
                                            <td class="text-end" data-label="Views">
                                                <span class="badge bg-primary">@pageItem.Value</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">
                            <i class="bi bi-person-fill text-info me-2"></i>
                            Most Active Users
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th class="text-end">Activity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in stats.TopUsers)
                                    {
                                        <tr>
                                            <td data-label="User">
                                                <i class="bi bi-person-circle text-muted me-2"></i>
                                                @user.Key
                                            </td>
                                            <td class="text-end" data-label="Activity">
                                                <span class="badge bg-info">@user.Value</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Sessions -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent">
                <h5 class="mb-0">
                    <i class="bi bi-activity text-success me-2"></i>
                    Active Sessions (Last 5 minutes)
                </h5>
            </div>
            <div class="card-body">
                @if (activeSessions != null && activeSessions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Current Page</th>
                                    <th>Device</th>
                                    <th>Duration</th>
                                    <th>Page Views</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in activeSessions)
                                {
                                    var sessionDuration = session.LastActivity - session.StartTime;
                                    var timeSinceLastActivity = DateTime.UtcNow - session.LastActivity;
          
                                    <tr>
                                        <td data-label="User">
                                            <span class="badge bg-success me-2">
                                                <i class="bi bi-circle-fill"></i>
                                            </span>
                                            @session.Username
                                        </td>
                                        <td data-label="Current Page">
                                            <code class="text-primary">@session.CurrentPage</code>
                                        </td>
                                        <td data-label="Device">
                                            <i class="bi bi-@(GetDeviceIcon(session.DeviceType)) me-1"></i>
                                            @session.DeviceType
                                        </td>
                                        <td data-label="Duration">
                                            @if (sessionDuration.TotalSeconds < 1)
                                            {
                                                <span class="text-muted">@FormatDuration(timeSinceLastActivity) ago</span>
                                            }
                                            else
                                            {
                                                @FormatDuration(sessionDuration)
                                            }
                                        </td>
                                        <td data-label="Page Views">
                                            <span class="badge bg-secondary">@session.PageViews</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3">No active sessions</p>
                }
            </div>
        </div>

        <!-- Top API Endpoints -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent">
                <h5 class="mb-0">
                    <i class="bi bi-code-slash text-success me-2"></i>
                    Top API Endpoints
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Endpoint</th>
                                <th class="text-end">Requests</th>
                                <th class="text-end">% of Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var endpoint in stats.TopApiEndpoints)
                            {
                                var percentage = (double)endpoint.Value / stats.TotalApiRequests * 100;
                                <tr>
                                    <td data-label="Endpoint">
                                        <code class="text-success">@endpoint.Key</code>
                                    </td>
                                    <td class="text-end" data-label="Requests">
                                        <span class="badge bg-success">@endpoint.Value</span>
                                    </td>
                                    <td class="text-end" data-label="% of Total">
                                        <span class="text-muted">@percentage.ToString("F1")%</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Performance & features analysis -->
        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">
                            <i class="bi bi-speedometer2 text-danger me-2"></i>
                            Slowest Pages
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (stats.SlowPages.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-sm">
                                    <thead>
                                        <tr>
                                            <th>Page</th>
                                            <th class="text-end">Avg Load Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var slowPage in stats.SlowPages.Take(5))
                                        {
                                            <tr>
                                                <td data-label="Page"><code class="text-danger">@slowPage.Key</code></td>
                                                <td class="text-end" data-label="Avg Load Time">
                                                    <span class="badge @(slowPage.Value > 3000 ? "bg-danger" : "bg-warning")">@slowPage.Value.ToString("F0")ms</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center mb-0">No load time data available</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">
                            <i class="bi bi-lightning-charge text-success me-2"></i>
                            Most Used Features
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (stats.MostUsedFeatures.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-sm">
                                    <thead>
                                        <tr>
                                            <th>Feature</th>
                                            <th class="text-end">Usage</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var feature in stats.MostUsedFeatures.Take(8))
                                        {
                                            <tr>
                                                <td data-label="Feature">@feature.Key</td>
                                                <td class="text-end" data-label="Usage">
                                                    <span class="badge bg-primary">@feature.Value</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center mb-0">No feature usage data</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Traffic sources & geography -->
        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">
                            <i class="bi bi-link-45deg text-info me-2"></i>
                            Top Referrers
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (stats.TopReferrers.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-sm">
                                    <thead>
                                        <tr>
                                            <th>Source</th>
                                            <th class="text-end">Visits</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var referrer in stats.TopReferrers.Take(10))
                                        {
                                            <tr>
                                                <td data-label="Source">
                                                    <i class="bi bi-globe me-1"></i>
                                                    <small>@referrer.Key</small>
                                                </td>
                                                <td class="text-end" data-label="Visits">
                                                    <span class="badge bg-info">@referrer.Value</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center mb-0">No referrer data available</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">
                            <i class="bi bi-geo-alt text-success me-2"></i>
                            Top Countries
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (stats.TopCountries.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-sm">
                                    <thead>
                                        <tr>
                                            <th>Country</th>
                                            <th class="text-end">Visitors</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var country in stats.TopCountries.Take(10))
                                        {
                                            <tr>
                                                <td data-label="Country">@country.Key</td>
                                                <td class="text-end" data-label="Visitors">
                                                    <span class="badge bg-success">@country.Value</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center mb-0">No country data available</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Top cities -->
        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">
                            <i class="bi bi-building text-primary me-2"></i>
                            Top Cities
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (stats.TopCities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-sm">
                                    <thead>
                                        <tr>
                                            <th>City</th>
                                            <th class="text-end">Visitors</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var city in stats.TopCities.Take(10))
                                        {
                                            <tr>
                                                <td data-label="City">
                                                    <i class="bi bi-geo-alt-fill text-muted me-1"></i>
                                                    @city.Key
                                                </td>
                                                <td class="text-end" data-label="Visitors">
                                                    <span class="badge bg-primary">@city.Value</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center mb-0">No city data available</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <!-- Placeholder for another metric or keep empty -->
            </div>
        </div>

        <!-- End of Role Activity section -->
    }
</div>


@code {
    private LagersystemLVHome.I18nText.App T = new();
    private ApplicationInsightsStats? stats;
    private List<UserSessionInfo>? activeSessions;
    private PerformanceMetric? currentPerformance;
    private bool loading = false; // only true on initial load
    private bool isInitialLoad = true;
    private string selectedPeriod = "24h";
    private int hoursToShow = 24;
    private CancellationTokenSource? _cancellationTokenSource;
    private Task? _refreshTask;
    private bool _disposed = false;
    
    // Previous values for change detection
    private int _previousPageViews = 0;
    private int _previousApiRequests = 0;
    private int _previousActiveUsers = 0;
    private int _previousActiveSessions = 0;
    // Hash for active sessions content detection
    private string _previousActiveSessionsHash = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        _logger.LogInformation("ApplicationInsights page loading...");
        await LoadDataAsync();
        await LoadSystemMetricsAsync();
        
        // Start auto-refresh background task
        StartAutoRefreshTask();
    }

    private void StartAutoRefreshTask()
    {
        if (_disposed || _cancellationTokenSource != null) return;
        
        _cancellationTokenSource = new CancellationTokenSource();
        _logger.LogInformation("Starting Auto-Refresh Background Task (30s interval)");
        
        _refreshTask = Task.Run(async () =>
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
       
        while (!_cancellationTokenSource.Token.IsCancellationRequested)
        {
            try
            {
                // Wait 30 seconds
                await timer.WaitForNextTickAsync(_cancellationTokenSource.Token);
       
                if (_disposed)
                {
                    _logger.LogInformation("Refresh skipped: Component disposed");
                    break;
                }
     
                _logger.LogInformation("Auto-refresh triggered (30s interval)");
         
                // Use silent load (also loads system metrics)
                await InvokeAsync(async () =>
                    {
                if (_disposed) return;
    
                await LoadDataSilent();
            });
            }
            catch (OperationCanceledException)
            {
                _logger.LogInformation("Auto-refresh task cancelled");
                break;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error during auto-refresh");
            }
        }
            
        _logger.LogInformation("Auto-refresh background task ended");
    }, _cancellationTokenSource.Token);
    }
    
    // Silent load without spinner
    private async Task LoadDataSilent()
    {
        try
        {
            var from = DateTime.UtcNow.AddHours(-hoursToShow);
            var to = DateTime.UtcNow;
      
            // Load new data
            var newStats = await InsightsService.GetDashboardStatsAsync(from, to);
            var newSessions = await InsightsService.GetActiveSessionsAsync();

            // Load system metrics as well
            var newPerformance = await InsightsService.GetCurrentPerformanceAsync();

            // Compute hash for active sessions content
            var newSessionsHash = ComputeSessionsHash(newSessions);

            // CHANGE DETECTION
            bool hasChanges = false;

            // 1. Check count changes
            if (newStats.TotalPageViews != _previousPageViews ||
            newStats.TotalApiRequests != _previousApiRequests ||
    newStats.ActiveUsers != _previousActiveUsers ||
    (newSessions?.Count ?? 0) != _previousActiveSessions)
            {
                hasChanges = true;
                _logger.LogInformation("Count changes detected");
            }

            // 2. Check active sessions content changes (LastActivity, CurrentPage)
            if (!hasChanges && newSessionsHash != _previousActiveSessionsHash)
            {
                hasChanges = true;
                _logger.LogInformation("Active sessions content changed");
            }
            
            if (hasChanges)
            {
                // Update data
                stats = newStats;
                activeSessions = newSessions;

                // Update previous values
                _previousPageViews = newStats.TotalPageViews;
                _previousApiRequests = newStats.TotalApiRequests;
                _previousActiveUsers = newStats.ActiveUsers;
                _previousActiveSessions = newSessions?.Count ?? 0;
                _previousActiveSessionsHash = newSessionsHash;
     
                _logger.LogInformation("Changes detected - updating UI (PageViews: {PageViews}, ApiRequests: {ApiRequests})",
                        newStats.TotalPageViews, newStats.TotalApiRequests);
    
                // Re-render charts
                await RenderChartsAsync();
            }
            else
            {
                _logger.LogDebug("No changes detected - skipping UI update");
            }
   
            // Always update system performance (CPU, memory, request rate)
            currentPerformance = newPerformance;
     
            // Always update UI for uptime and performance metrics
            // Ensures CPU, memory, uptime are refreshed every 30s
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading insights data (silent)");
        }
    }
    
    // Compute hash for active sessions (LastActivity + CurrentPage)
    private string ComputeSessionsHash(List<UserSessionInfo>? sessions)
    {
        if (sessions == null || !sessions.Any())
            return string.Empty;
   
        try
        {
            // Create hash from session ID, last activity, and current page
            var sessionData = sessions
        .OrderBy(s => s.SessionId)
        .Select(s => $"{s.SessionId}|{s.LastActivity:O}|{s.CurrentPage ?? ""}|{s.PageViews}")
    .ToList();
  
            return string.Join(";", sessionData);
        }
        catch
        {
            return string.Empty;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && stats != null)
        {
            await RenderChartsAsync();
        }

        // Render charts also after first load
        if (stats != null && !_disposed)
        {
            await Task.Delay(100);
            await RenderChartsAsync();
        }
    }

    public void Dispose()
    {
        if (_disposed) return;
        
        _disposed = true;
        _logger.LogInformation("Dispose() called - stopping Auto-Refresh");

        // Cancel background task
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = null;

        // Wait for task to complete (with timeout)
        if (_refreshTask != null)
        {
            try
            {
                _refreshTask.Wait(TimeSpan.FromSeconds(2));
            }
            catch { }
            finally
            {
                _refreshTask = null;
            }
        }

        // Destroy charts
        try
        {
            JSRuntime.InvokeVoidAsync("InsightsCharts.destroyCharts");
        }
        catch { }

        _logger.LogInformation("Auto-refresh successfully stopped");
    }

    // Manual load (with spinner)
    private async Task LoadDataAsync()
    {
        if (isInitialLoad)
        {
            loading = true;
            StateHasChanged();
        }

        try
        {
            var from = DateTime.UtcNow.AddHours(-hoursToShow);
            var to = DateTime.UtcNow;
            
            _logger.LogInformation("Loading insights data for the last {Hours} hours", hoursToShow);
      
            stats = await InsightsService.GetDashboardStatsAsync(from, to);
            activeSessions = await InsightsService.GetActiveSessionsAsync();
            
            // Initialize previous values
            _previousPageViews = stats.TotalPageViews;
            _previousApiRequests = stats.TotalApiRequests;
            _previousActiveUsers = stats.ActiveUsers;
            _previousActiveSessions = activeSessions?.Count ?? 0;
            // Initialize hash
            _previousActiveSessionsHash = ComputeSessionsHash(activeSessions);

            _logger.LogInformation("Stats loaded: PageViews={PageViews}, ApiRequests={ApiRequests}",
                stats.TotalPageViews, stats.TotalApiRequests);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading insights data");
        }
        finally
        {
            loading = false;
            isInitialLoad = false;
            StateHasChanged();
        }
    }

    private async Task LoadSystemMetricsAsync()
    {
        try
        {
            currentPerformance = await InsightsService.GetCurrentPerformanceAsync();
            _logger.LogInformation("Performance loaded: CPU={Cpu}%", currentPerformance.CpuUsagePercent);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading system metrics");
        }
    }

    private async Task ChangePeriodFromComponent(int hours)
    {
        try
        {
            _logger.LogInformation("Changing period to {Hours} hours", hours);

            hoursToShow = hours;
            selectedPeriod = hours switch
            {
                24 => "24h",
                168 => "7d",
                720 => "30d",
                _ => "24h"
            };
      
            await InvokeAsync(StateHasChanged);
            await LoadDataAsync();
   
            if (stats != null)
            {
                await RenderChartsAsync();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error changing the period");
        }
    }

    private async Task RenderChartsAsync()
    {
        if (stats == null)
        {
            _logger.LogWarning("Charts cannot be rendered: stats is null");
            return;
        }

        try
        {
            // Prepare Traffic Chart Data
            var trafficLabels = stats.HourlyPageViews.Select(h => h.Hour.ToString("HH:mm")).ToArray();
            var pageViewsData = stats.HourlyPageViews.Select(h => h.Count).ToArray();
            var apiRequestsData = stats.HourlyApiRequests.Select(h => h.Count).ToArray();

            // Prepare Device Chart Data
            var deviceLabels = stats.DeviceTypes.Keys.ToArray();
            var deviceData = stats.DeviceTypes.Values.ToArray();

            // Call JavaScript to render charts
            await JSRuntime.InvokeVoidAsync("InsightsCharts.renderTrafficChart",
                        trafficLabels, pageViewsData, apiRequestsData);
  
            await JSRuntime.InvokeVoidAsync("InsightsCharts.renderDeviceChart",
        deviceLabels, deviceData);

            _logger.LogInformation("Charts rendered successfully");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error rendering charts");
        }
    }

    private string GetDeviceIcon(string deviceType)
    {
        return deviceType?.ToLower() switch
        {
            "mobile" => "phone",
            "tablet" => "tablet",
            "desktop" => "laptop",
            _ => "device-ssd"
        };
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMinutes < 1)
            return $"{(int)duration.TotalSeconds}s";
        if (duration.TotalHours < 1)
            return $"{(int)duration.TotalMinutes}m";
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }

    private string FormatUptime()
    {
        // Use real application uptime (persists across IIS recycles)
        var appUptime = UptimeService.ApplicationUptime;
    
        // Show application-level uptime (since first start)
        if (appUptime.TotalHours < 1)
            return $"{(int)appUptime.TotalMinutes}m";
        if (appUptime.TotalDays < 1)
            return $"{(int)appUptime.TotalHours}h {appUptime.Minutes}m";
        return $"{(int)appUptime.TotalDays}d {appUptime.Hours}h";
    }
}
