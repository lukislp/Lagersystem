@page "/low-stock"
@inherits CancellableComponentBase
@rendermode InteractiveServer
@inject LagersystemLVHome.Application.Services.IInventoryService InventoryService
@inject NavigationManager NavigationManager
@inject I18nText I18nText

<PageTitle>@T.LowStock_PageTitle</PageTitle>

<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-exclamation-triangle text-warning me-2"></i>
        @T.LowStock_Title
    </h1>
    <p class="page-subtitle">@T.LowStock_Subtitle</p>
</div>

@if (lowStockProducts.Any())
{
    <div class="alert alert-warning d-flex align-items-center mb-4">
        <i class="bi bi-exclamation-triangle-fill me-3" style="font-size: 1.5rem;"></i>
        <div>
            <strong>@(T.LowStock_Alert != null ? string.Format(T.LowStock_Alert, lowStockProducts.Count()) : "")</strong>
            <br>@T.LowStock_AlertDescription
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@T.LowStock_Col_Product</th>
                            <th>@T.LowStock_Col_Category</th>
                            <th>@T.LowStock_Col_StorageLocation</th>
                            <th>@T.LowStock_Col_CurrentStock</th>
                            <th>@T.LowStock_Col_MinStock</th>
                            <th>@T.LowStock_Col_Difference</th>
                            <th>@T.LowStock_Col_Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in lowStockProducts.OrderBy(p => p.Quantity))
                        {
                            var difference = product.MinQuantity - product.Quantity;
                            <tr class="@(product.Quantity == 0 ? "table-danger" : "")">
                                <td>
                                    <div class="product-info">
                                        <div class="product-icon">
                                            <CategoryIcon IconClass="@(product.Category?.Icon ?? "bi-box")" />
                                        </div>
                                        <div>
                                            <div class="product-name">@product.Name</div>
                                            <div class="product-barcode">@product.Barcode</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@product.Category?.Name</td>
                                <td>
                                    @{
                                        var storageCount = storageCounts.GetValueOrDefault(product.Id, 0);
                                    }
                                    @if (storageCount > 0)
                                    {
                                        <span class="badge bg-info">@(T.LowStock_StorageLocations != null ? string.Format(T.LowStock_StorageLocations, storageCount) : "")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@T.LowStock_NoStorage</span>
                                    }
                                </td>
                                <td>
                                    <span class="stock-badge @(product.Quantity == 0 ? "critical" : "low")">
                                        @(T.LowStock_Pieces != null ? string.Format(T.LowStock_Pieces, product.Quantity) : "")
                                    </span>
                                </td>
                                <td>@(T.LowStock_MinPieces != null ? string.Format(T.LowStock_MinPieces, product.MinQuantity) : "")</td>
                                <td>
                                    <span class="text-danger fw-bold">-@difference</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="/scanner" class="btn btn-primary btn-sm" title="@T.LowStock_Scanner">
                                            <i class="bi bi-upc-scan"></i> @T.LowStock_Scanner
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <EmptyState IconClass="bi bi-check-circle"
                        Title="@T.LowStock_Empty_Title"
                        Description="@T.LowStock_Empty_Description"
                        ShowAction="true"
                        ActionText="@T.Nav_Products"
                        ActionIcon="bi bi-box"
                        OnActionClick="NavigateToProducts" />
        </div>
    </div>
}

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private List<LagersystemLVHome.Domain.Models.Product> lowStockProducts = new();
    private Dictionary<int, int> storageCounts = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadData();
    }

    private async Task LoadData()
    {
        lowStockProducts = (await InventoryService.GetLowStockProductsAsync()).ToList();
        storageCounts = await InventoryService.GetStorageLocationCountsForProductsAsync(lowStockProducts.Select(p => p.Id));
    }

    private void NavigateToProducts()
    {
        NavigationManager.NavigateTo("/products");
    }
}
