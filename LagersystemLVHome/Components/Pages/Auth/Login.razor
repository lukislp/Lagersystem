    private async Task SendMagicLink()
{
        if (string.IsNullOrWhiteSpace(magicLinkEmail)) return;

        isLoading = true;
errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var user = await UserProfileService.GetActiveUserByEmailAsync(magicLinkEmail);

    if (user != null && !user.PasswordlessEnabled && user.DefaultLoginMethod == "Password")
        {
        errorMessage = T.Login_PasswordlessOff ?? "Passwordless Login ist für diesen Account nicht aktiviert.";
        return;
            }

        var success = await PasswordlessService.SendMagicLinkAsync(magicLinkEmail);

            if (success)
            {
        successMessage = T.Login_MagicLinkSent ?? "Ein Magic Link wurde an Ihre E-Mail-Adresse gesendet. Der Link ist 15 Minuten gültig.";
        magicLinkEmail = string.Empty;
            }
            else
            {
        errorMessage = "Fehler beim Senden des Magic Links.";
            }
}
        catch (Exception ex)
        {
_logger.LogError(ex, "Error sending magic link");
    errorMessage = "Ein Fehler ist aufgetreten.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleLogin()
    {
    isLoading = true;
errorMessage = string.Empty;

        try
        {
        // Check IP restrictions
            var userCheck = await UserProfileService.GetActiveUserByUsernameAsync(loginModel.Username);
          
            if (userCheck != null)
        {
        var clientIp = GetClientIp();
        if (!string.IsNullOrEmpty(clientIp))
        {
            var ipResult = await IpAccessService.CheckAccessAsync(userCheck.Id, clientIp);
    if (!ipResult.IsAllowed)
        {
errorMessage = $"Zugriff verweigert: Ihre IP-Adresse ({clientIp}) ist nicht freigegeben.";
                return;
        }
    }
            }

            var loginResult = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);

            if (loginResult.IsSuccess)
            {
                var user = loginResult.Value!;
                await Task.Delay(100);
                StateHasChanged();
                
    // Set session cookie
                try
{
        var sessionId = await AuthService.GetCurrentSessionIdAsync();
if (!string.IsNullOrEmpty(sessionId))
        {
    await JSRuntime.InvokeVoidAsync("cookieHelper.setCookie", "LagerSystem.SessionId", sessionId, 7);
        }
            }
            catch (Exception ex)
    {
    _logger.LogWarning(ex, "Failed to set session cookie");
        }
       
    // Check 2FA requirement
        if (user.TwoFactorEnabled || user.EmailOtpEnabled)
    {
            // Trusted device check: use thumbmarkjs fingerprint
            // (captured locally on login page or from cookie on repeat request)
            var isTrusted = false;
            try
            {
                if (string.IsNullOrEmpty(currentDeviceFingerprint))
                {
                    currentDeviceFingerprint = HttpContextAccessor?.HttpContext?.Request.Cookies["DeviceFingerprint"];
                }
                if (!string.IsNullOrEmpty(currentDeviceFingerprint))
                {
                    isTrusted = await TrustedDeviceService.IsDeviceTrustedAsync(user.Id, currentDeviceFingerprint);
                }
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Error checking trusted device for user {UserId}", user.Id);
            }

            if (isTrusted)
            {
                _logger.LogInformation("Trusted device detected for user {UserId} - skipping 2FA", user.Id);
                // 2FA skipped - proceed to passkey prompt or redirect
            }
            else
            {
                pendingUser = user;
                require2FA = true;
                trustThisDevice = false;

                // Determine available 2FA methods
                available2FAMethods.Clear();
                if (user.TwoFactorEnabled) available2FAMethods.Add(TwoFactorMethods.Authenticator);
                if (user.EmailOtpEnabled) available2FAMethods.Add(TwoFactorMethods.EmailOtp);

                // Auto-select when only one method is available
                if (available2FAMethods.Count == 1)
                {
                    selected2FAMethod = available2FAMethods[0];
                    methodSelected = true;

                    if (selected2FAMethod == TwoFactorMethods.EmailOtp)
                    {
                        await SendEmailOtpCode();
                    }
                }
                else
                {
                    selected2FAMethod = "";
                    methodSelected = false;
                }

                return;
            }
    }

    // Check if user has passkeys - if not, show prompt
    if (webAuthnSupported)
{
    var hasPasskeys = await WebAuthnService.HasPasskeysAsync(user.Id);
        if (!hasPasskeys)
{
                pendingUser = user;
        showPasskeyPrompt = true;
        return;
        }
        }

        NavigationManager.NavigateTo("/", false);
            }
            else
            {
                // Authoritative error mapping driven by AuthService.LoginAsync result.
                // No duplicated DB lookups / consent checks here – everything below
                // is purely UI presentation.
                switch (loginResult.ErrorCode)
                {
                    case LoginFailures.GranularConsentRequired:
                    case LoginFailures.GdprConsentRequired:
                        // Consent missing – open the GDPR modal so the user can give it.
                        pendingUser = await UserProfileService.GetActiveUserByUsernameAsync(loginModel.Username);
                        if (pendingUser is not null)
                        {
                            showGdprModal = true;
                            return;
                        }
                        errorMessage = "Einwilligung erforderlich.";
                        break;

                    case LoginFailures.AccountLocked:
                        errorMessage = $"Account gesperrt. Versuchen Sie es in {loginResult.ErrorMessage} Minuten erneut.";
                        break;

                    case LoginFailures.PendingApproval:
                        errorMessage = "Ihr Account wartet noch auf Genehmigung.";
                        break;

                    case LoginFailures.Rejected:
                        errorMessage = "Ihr Account wurde abgelehnt.";
                        break;

                    case LoginFailures.IpDenied:
                        errorMessage = "Zugriff verweigert: Ihre IP-Adresse ist nicht freigegeben.";
                        break;

                    case LoginFailures.Inactive:
                        errorMessage = "Account ist deaktiviert.";
                        break;

                    default:
                        errorMessage = "Benutzername oder Passwort ist falsch.";
                        break;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{T.Login_Error_LoginFailed} {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string? GetClientIp()
    {
        var context = HttpContextAccessor?.HttpContext;
    if (context == null) return null;

        var forwardedFor = context.Request.Headers["X-Forwarded-For"].FirstOrDefault();
        if (!string.IsNullOrEmpty(forwardedFor))
        {
    return forwardedFor.Split(',')[0].Trim();
        }

        return context.Connection.RemoteIpAddress?.ToString();
    }

    private async Task AcceptGdprConsent()
    {
        if (pendingUser != null && gdprConsentLogin && analyticsConsentLogin && fingerprintConsentLogin)
{
    try
    {
        await GdprService.GiveConsentAsync(pendingUser.Id, marketingConsentLogin);

        await UserProfileService.UpdateConsentPreferencesAsync(pendingUser.Id, analyticsConsentLogin, fingerprintConsentLogin);

        var loginResult = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);

        if (loginResult.IsSuccess)
                {
                var user = loginResult.Value!;
                showGdprModal = false;
            
                    try
        {
        var sessionId = await AuthService.GetCurrentSessionIdAsync();
    if (!string.IsNullOrEmpty(sessionId))
        {
await JSRuntime.InvokeVoidAsync("cookieHelper.setCookie", "LagerSystem.SessionId", sessionId, 7);
                }
        }
            catch { }

        // Show passkey prompt after GDPR consent
            if (webAuthnSupported)
    {
    var hasPasskeys = await WebAuthnService.HasPasskeysAsync(user.Id);
if (!hasPasskeys)
        {
    pendingUser = user;
            showPasskeyPrompt = true;
return;
        }
        }
           
        NavigationManager.NavigateTo("/", false);
        }
        else
        {
            errorMessage = T.Login_Error_GdprLoginFailed;
        showGdprModal = false;
            }
    }
    catch (Exception ex)
            {
        errorMessage = $"Fehler: {ex.Message}";
    showGdprModal = false;
        }
    }
    }

    private void CancelGdprConsent()
    {
        showGdprModal = false;
        pendingUser = null;
gdprConsentLogin = false;
    marketingConsentLogin = false;
        analyticsConsentLogin = false;
        fingerprintConsentLogin = false;
    }

    private async Task Verify2FA()
    {
        if (pendingUser == null) return;

    isLoading = true;
    errorMessage = string.Empty;

        try
        {
            bool isValid;

            if (useRecoveryCode)
            {
                isValid = await AuthService.Verify2FARecoveryCodeAsync(pendingUser.Id, twoFactorCode);
            }
            else if (selected2FAMethod == TwoFactorMethods.EmailOtp)
            {
                isValid = await AuthService.VerifyEmailOtpAsync(pendingUser.Id, twoFactorCode);
            }
            else
            {
                isValid = await AuthService.Verify2FACodeAsync(pendingUser.Id, twoFactorCode);
            }

    if (isValid)
            {
                // Save trusted device if requested
                if (trustThisDevice && !string.IsNullOrEmpty(currentDeviceFingerprint) && pendingUser != null)
                {
                    try
                    {
                        var clientIp = GetClientIp();
                        var userAgent = HttpContextAccessor?.HttpContext?.Request.Headers["User-Agent"].ToString() ?? "Unknown";
                        var deviceName = ParseDeviceNameFromUserAgent(userAgent);
                        await TrustedDeviceService.TrustDeviceAsync(
                            pendingUser.Id, currentDeviceFingerprint, deviceName, clientIp, 30);
                        _logger.LogInformation("Device trusted after 2FA for user {UserId}", pendingUser.Id);
                    }
                    catch (Exception ex)
                    {
                        _logger.LogWarning(ex, "Failed to trust device for user {UserId}", pendingUser.Id);
                    }
                }

    try
    {
            var sessionId = await AuthService.GetCurrentSessionIdAsync();
        if (!string.IsNullOrEmpty(sessionId))
            {
        await JSRuntime.InvokeVoidAsync("cookieHelper.setCookie", "LagerSystem.SessionId", sessionId, 7);
        }
}
        catch { }

        require2FA = false;

    // Show passkey prompt after 2FA
        if (webAuthnSupported)
        {
    var hasPasskeys = await WebAuthnService.HasPasskeysAsync(pendingUser.Id);
        if (!hasPasskeys)
        {
showPasskeyPrompt = true;
            return;
}
}

    NavigationManager.NavigateTo("/", forceLoad: true);
    }
else
            {
                if (useRecoveryCode)
                    errorMessage = T.Login_Error_InvalidRecoveryCode;
                else if (selected2FAMethod == TwoFactorMethods.EmailOtp)
                    errorMessage = T.Login_Error_InvalidEmailOtp;
                else
                    errorMessage = T.Login_Error_Invalid2FA;
    }
        }
        catch (Exception ex)
        {
errorMessage = $"Fehler: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Select2FAMethod(string method)
    {
        selected2FAMethod = method;
        methodSelected = true;
        twoFactorCode = "";
        errorMessage = string.Empty;

        // Send OTP code immediately for email method
        if (method == TwoFactorMethods.EmailOtp && pendingUser != null)
        {
            await SendEmailOtpCode();
        }
    }

    private Task SelectAuthenticatorMethod() => Select2FAMethod(TwoFactorMethods.Authenticator);
    private Task SelectEmailOtpMethod() => Select2FAMethod(TwoFactorMethods.EmailOtp);

    private async Task SendEmailOtpCode()
    {
        if (pendingUser == null) return;

        try
        {
            var sent = await TwoFactorManagementService.SendEmailOtpAsync(pendingUser.Id);
            if (!sent)
            {
                errorMessage = T.Login_Error_EmailOtpSendFailed;
            }
            else
            {
                StartEmailOtpCooldown();
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error sending email OTP");
            errorMessage = T.Login_Error_EmailOtpSendError;
        }
    }

    private async Task ResendEmailOtp()
    {
        if (emailOtpCooldown) return;
        errorMessage = string.Empty;
        await SendEmailOtpCode();
    }

    private void StartEmailOtpCooldown()
    {
        emailOtpCooldown = true;
        emailOtpCooldownSeconds = 30;
        emailOtpCooldownTimer?.Dispose();
        emailOtpCooldownTimer = new System.Threading.Timer(_ =>
        {
            emailOtpCooldownSeconds--;
            if (emailOtpCooldownSeconds <= 0)
            {
                emailOtpCooldown = false;
                emailOtpCooldownTimer?.Dispose();
            }
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private static string MaskEmail(string email)
    {
        if (string.IsNullOrEmpty(email) || !email.Contains('@'))
            return "***";

        var parts = email.Split('@');
        var local = parts[0];
        var domain = parts[1];

        if (local.Length <= 2)
            return $"{local[0]}***@{domain}";

        return $"{local[0]}{local[1]}***@{domain}";
    }

    private static string ParseDeviceNameFromUserAgent(string userAgent)
    {
        if (string.IsNullOrEmpty(userAgent)) return "Unbekanntes Gerät";

        var ua = userAgent.ToLower();
        var browser = "Browser";
        if (ua.Contains("edg/")) browser = "Edge";
        else if (ua.Contains("opr/") || ua.Contains("opera")) browser = "Opera";
        else if (ua.Contains("chrome") && !ua.Contains("edg")) browser = "Chrome";
        else if (ua.Contains("firefox")) browser = "Firefox";
        else if (ua.Contains("safari") && !ua.Contains("chrome")) browser = "Safari";

        var os = "Unbekannt";
        if (ua.Contains("windows")) os = "Windows";
        else if (ua.Contains("mac os")) os = "macOS";
        else if (ua.Contains("iphone")) os = "iPhone";
        else if (ua.Contains("ipad")) os = "iPad";
        else if (ua.Contains("android")) os = "Android";
        else if (ua.Contains("linux")) os = "Linux";

        return $"{browser} auf {os}";
    }

    private void Cancel2FA()
    {
        require2FA = false;
        pendingUser = null;
        twoFactorCode = "";
        useRecoveryCode = false;
        errorMessage = string.Empty;
        selected2FAMethod = "";
        methodSelected = false;
        available2FAMethods.Clear();
        emailOtpCooldown = false;
        emailOtpCooldownTimer?.Dispose();
        trustThisDevice = false;
}

