@inject ITeamPresenceService PresenceService
@inject IAuthService AuthService
@inject I18nText I18nText
@rendermode InteractiveServer
@implements IDisposable

<div class="team-presence-container">
    <div class="team-presence-button" @onclick="ToggleDropdown" title="Team anzeigen">
        <i class="bi bi-people-fill"></i>
        @if (onlineCount > 0)
        {
            <span class="badge">@onlineCount</span>
        }
    </div>

    @if (showDropdown)
    {
        <div class="team-presence-dropdown" @onclick:stopPropagation="true">
            <div class="presence-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="bi bi-people me-2"></i>
                        Team Online
                    </h6>
                    <button class="presence-close-btn" @onclick="CloseDropdown" title="@T.TeamPresenceButton_Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <small class="text-muted">@warehouseName</small>
            </div>

            <div class="presence-list">
                @if (onlineUsers == null || !onlineUsers.Any())
                {
                    <div class="empty-presence">
                        <i class="bi bi-person-x"></i>
                        <p>Niemand online</p>
                    </div>
                }
                else
                {
                    @foreach (var user in onlineUsers)
                    {
                        // Check if this is the current user
                        bool isCurrentUser = user.UserId == _currentUserId;
      
                        <div class="presence-item @(isCurrentUser ? "current-user" : "")">
                            <div class="presence-avatar">
                                @if (!string.IsNullOrEmpty(user.ProfileImagePath))
                                {
                                    <img src="@user.ProfileImagePath" alt="@user.FullName" class="avatar-image" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle"></i>
                                }
                                <span class="status-indicator status-@user.StatusBadgeColor"></span>
                            </div>
                            <div class="presence-info">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@user.FullName</strong>
                                        @if (isCurrentUser)
                                        {
                                            <span class="badge badge-sm bg-success ms-1">
                                                <i class="bi bi-person-check-fill me-1"></i>Du
                                            </span>
                                        }
                                        <span class="badge badge-sm bg-@GetRoleBadgeColor(user.Role) ms-1">
                                            @user.Role
                                        </span>
                                    </div>
                                    <small class="text-muted">@FormatLastSeen(user.LastSeen)</small>
                                </div>
    
                                @if (!string.IsNullOrEmpty(user.CustomStatus))
                                {
                                    <div class="custom-status">
                                        <i class="bi bi-chat-left-quote-fill me-1"></i>
                                        <em>@user.CustomStatus</em>
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted device-info">
                                        <i class="bi bi-@GetDeviceIcon(user.DeviceType) me-1"></i>
                                        @GetPageDisplay(user.CurrentPage)
                                    </small>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @if (onlineUsers != null && onlineUsers.Any())
            {
                <div class="presence-footer">
                    <small class="text-muted">
                        <i class="bi bi-clock me-1"></i>
                        Aktualisiert alle 5 Sekunden
                    </small>
                </div>
            }
        </div>
    }
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private List<UserPresence>? onlineUsers;
    private int onlineCount;
    private bool showDropdown;
    private System.Threading.Timer? _timer;
    private string warehouseName = "Lager";
    private int _currentUserId = 0; // Track current user ID
    
    private int _previousOnlineCount = 0;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadPresenceData();
   
        // Auto-refresh every 5 seconds, loads directly from database
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
    {
        await LoadPresenceDataSilent();
    });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadPresenceDataSilent()
    {
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) return;

            // User has WarehouseId, not Warehouses collection
            if (currentUser.WarehouseId == 0) return;

            // Update current user ID for UI highlighting
            _currentUserId = currentUser.Id;

            var newUsers = await PresenceService.GetOnlineUsersInWarehouseAsync(currentUser.WarehouseId);
     
            // Count excludes current user, but list includes them
            var newCount = newUsers.Count(u => u.UserId != currentUser.Id);

            // Always update, not just on count change
            // Reason: LastPageUrl may change without count changing
            bool hasChanges = false;
        
            if (newCount != _previousOnlineCount)
            {
                hasChanges = true;
                _previousOnlineCount = newCount;
            }
   
            // Check if LastPageUrl or status changed
            if (onlineUsers != null && newUsers.Any())
            {
                foreach (var newUser in newUsers)
                {
                    var existingUser = onlineUsers.FirstOrDefault(u => u.UserId == newUser.UserId);
                    if (existingUser == null ||
                        existingUser.CurrentPage != newUser.CurrentPage ||
                    existingUser.Status != newUser.Status ||
                        existingUser.LastSeen != newUser.LastSeen)
                    {
                        hasChanges = true;
                        break;
                    }
                }
            }
            else if (newUsers.Any())
            {
                hasChanges = true; // Initial data loaded
            }

            if (hasChanges)
            {
                onlineUsers = newUsers;
                onlineCount = newCount;
                warehouseName = currentUser.Warehouse?.Name ?? "Lager";

                StateHasChanged();
            }
        }
        catch
        {
        }
    }

    private async Task LoadPresenceData()
    {
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) return;

            if (currentUser.WarehouseId == 0) return;

            // Save current user ID
            _currentUserId = currentUser.Id;

            onlineUsers = await PresenceService.GetOnlineUsersInWarehouseAsync(currentUser.WarehouseId);
     
            // Count excludes current user, but list includes them
            onlineCount = onlineUsers.Count(u => u.UserId != currentUser.Id);
            _previousOnlineCount = onlineCount;
            warehouseName = currentUser.Warehouse?.Name ?? "Lager";
        }
        catch
        {
        }
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown()
    {
        showDropdown = false;
    }

    private string GetRoleBadgeColor(string role)
    {
        return role switch
        {
            "SuperAdmin" => "danger",
            "Admin" => "primary",
            "Manager" => "info",
            "User" => "secondary",
            _ => "secondary"
        };
    }

    private string GetDeviceIcon(string deviceType)
    {
        return deviceType?.ToLower() switch
        {
            "mobile" => "phone",
            "tablet" => "tablet",
            "desktop" => "laptop",
            _ => "device-ssd"
        };
    }

    private string GetPageDisplay(string page)
    {
        if (string.IsNullOrEmpty(page) || page == "/") return "Dashboard";

        // Filter out Logout page
        if (page.Contains("/logout", StringComparison.OrdinalIgnoreCase))
            return "Dashboard";
        
        return page switch
        {
            "/products" => "Produkte",
            "/scanner" => "Scanner",
            "/movements" => "Bewegungen",
            "/categories" => "Kategorien",
            "/settings" => "Einstellungen",
            "/admin/insights" => "Insights",
            "/admin/users" => "Benutzerverwaltung",
            _ => page.TrimStart('/').Replace("-", " ")
        };
    }

    private string FormatLastSeen(DateTime lastSeen)
    {
        var timeSpan = DateTime.UtcNow - lastSeen;

        if (timeSpan.TotalSeconds < 30)
            return "Jetzt";

        if (timeSpan.TotalMinutes < 1)
            return $"{(int)timeSpan.TotalSeconds}s";

        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m";

        return $"{(int)timeSpan.TotalHours}h";
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
