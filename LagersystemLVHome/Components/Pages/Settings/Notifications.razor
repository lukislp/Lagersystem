@page "/notifications"
@inherits CancellableComponentBase
@rendermode InteractiveServer
@inject LagersystemLVHome.Application.Services.INotificationService NotificationService
@inject LagersystemLVHome.Application.Services.IAuthService AuthService
@inject NavigationManager NavigationManager
@inject I18nText I18nText
@using LagersystemLVHome.Domain.Models

<PageTitle>@T.Notifications_PageTitle</PageTitle>

<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-bell me-2"></i>
        @T.Notifications_Title
    </h1>
    <p class="page-subtitle">@(T.Notifications_Count != null ? string.Format(T.Notifications_Count, notifications.Count) : "")</p>
</div>

<!-- Filter Tabs -->
<div class="card mb-4">
    <div class="card-body p-0">
        <div class="btn-group w-100" role="group">
            <button class="btn @(filter == "all" ? "btn-primary" : "btn-light") rounded-0 rounded-start"
                    @onclick='@(() => SetFilter("all"))'>
                @T.Notifications_All (@notifications.Count)
            </button>
            <button class="btn @(filter == "unread" ? "btn-primary" : "btn-light") rounded-0"
                    @onclick='@(() => SetFilter("unread"))'>
                @T.Notifications_Unread (@notifications.Count(n => !n.IsRead))
            </button>
            <button class="btn @(filter == "read" ? "btn-primary" : "btn-light") rounded-0 rounded-end"
                    @onclick='@(() => SetFilter("read"))'>
                @T.Notifications_Read (@notifications.Count(n => n.IsRead))
            </button>
        </div>
    </div>
</div>

<!-- Actions -->
@if (filteredNotifications.Any())
{
    <div class="d-flex justify-content-between mb-3">
        <button class="btn btn-secondary" @onclick="MarkAllAsRead" disabled="@(!filteredNotifications.Any(n => !n.IsRead))">
            <i class="bi bi-check-all"></i> @T.Notifications_MarkAllRead
        </button>
        <button class="btn btn-danger" @onclick="DeleteAll">
            <i class="bi bi-trash"></i> @T.Notifications_DeleteAll
        </button>
    </div>
}

<!-- Virtualized notifications list -->
<div class="card">
    <div class="card-body p-2">
        @if (filteredNotifications.Any())
        {
            <NotificationVirtualizedList Notifications="@filteredNotifications.OrderByDescending(n => n.CreatedAt).ToList()"
                                         OnNotificationClick="@HandleNotificationClick"
                                         OnMarkAsRead="@MarkAsRead"
                                         OnDelete="@Delete" />
        }
        else
        {
            <EmptyState IconClass="bi bi-bell-slash"
                        Title="@T.Notifications_Empty_Title"
                        Description="@GetEmptyStateDescription()"
                        ShowAction="true"
                        ActionText="@T.Notifications_GoHome"
                        ActionIcon="bi bi-house"
                        OnActionClick="NavigateToHome" />
        }
    </div>
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private List<Notification> notifications = new();
    private IEnumerable<Notification> filteredNotifications = new List<Notification>();
    private string filter = "all";

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            notifications = (await NotificationService.GetUserNotificationsAsync(currentUser.Id)).ToList();
            ApplyFilter();
        }
    }

    private void SetFilter(string newFilter)
    {
        filter = newFilter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredNotifications = filter switch
        {
            "unread" => notifications.Where(n => !n.IsRead),
            "read" => notifications.Where(n => n.IsRead),
            _ => notifications
        };
    }

    // Handle click on notification
    private async Task HandleNotificationClick(Notification notification)
    {
        // Mark as read if unread
        if (!notification.IsRead)
        {
            await MarkAsRead(notification.Id);
        }
        
        // Navigate if action URL exists
        if (!string.IsNullOrEmpty(notification.ActionUrl))
        {
            NavigationManager.NavigateTo(notification.ActionUrl);
        }
    }

    private async Task MarkAsRead(int notificationId)
    {
        await NotificationService.MarkAsReadAsync(notificationId);
        await LoadNotifications();
    }

    private async Task MarkAllAsRead()
    {
        foreach (var notification in filteredNotifications.Where(n => !n.IsRead))
        {
            await NotificationService.MarkAsReadAsync(notification.Id);
        }
        await LoadNotifications();
    }

    private async Task Delete(int notificationId)
    {
        await NotificationService.DeleteNotificationAsync(notificationId);
        await LoadNotifications();
    }

    private async Task DeleteAll()
    {
        foreach (var notification in filteredNotifications)
        {
            await NotificationService.DeleteNotificationAsync(notification.Id);
        }
        await LoadNotifications();
    }

    private string GetEmptyStateDescription()
    {
        return filter == "unread"
    ? "Alle Benachrichtigungen wurden gelesen"
            : "Sie haben noch keine Benachrichtigungen erhalten";
    }

    private void NavigateToHome()
    {
        NavigationManager.NavigateTo("/");
    }
}
