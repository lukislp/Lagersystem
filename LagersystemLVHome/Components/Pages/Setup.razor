@page "/setup"
@inherits CancellableComponentBase
@using System.ComponentModel.DataAnnotations
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using LagersystemLVHome.Application.Services
@using Microsoft.EntityFrameworkCore
@layout EmptyLayout
@rendermode InteractiveServer
@inject ISetupService SetupService
@inject NavigationManager NavigationManager
@inject I18nText I18nText

<PageTitle>@T.Setup_PageTitle</PageTitle>

<div class="login-container">
    <div class="login-card" style="max-width: 600px;">
        <div class="login-header">
            <i class="bi bi-shield-check login-logo" style="color: #dc3545;"></i>
            <h1>@T.Setup_Title</h1>
            <p>@T.Setup_Subtitle</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @errorMessage
            </div>
        }

        @if (setupComplete)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-2"></i>
                <strong>@T.Setup_Complete</strong>
                <br>@T.Setup_CompleteRedirect
            </div>
        }
        else if (alreadySetup)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                @T.Setup_AlreadySetup
            </div>
        }
        else
        {
            <EditForm Model="setupModel" OnValidSubmit="HandleSetup" FormName="SetupForm">
                <DataAnnotationsValidator />

                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Wichtig:</strong> Dies ist ein einmaliger Vorgang. Der SuperAdmin hat vollständige Kontrolle über das System.
                </div>

                <h5 class="mb-3">@T.Setup_WarehouseSection</h5>

                <div class="form-group">
                    <label class="form-label">@T.Setup_WarehouseName *</label>
                    <InputText class="form-control" @bind-Value="setupModel.WarehouseName"
                               placeholder="z.B. Hauptlager Mönchen" />
                    <ValidationMessage For="() => setupModel.WarehouseName" />
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">@T.Setup_WarehouseCode *</label>
                            <InputText class="form-control" @bind-Value="setupModel.WarehouseCode"
                                       placeholder="z.B. WH001" />
                            <ValidationMessage For="() => setupModel.WarehouseCode" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Max. Benutzer</label>
                            <InputNumber class="form-control" @bind-Value="setupModel.MaxUsers" />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Adresse (optional)</label>
                    <InputTextArea class="form-control" @bind-Value="setupModel.WarehouseAddress"
                                   rows="2" placeholder="Straße, PLZ Stadt" />
                </div>

                <hr class="my-4" />

                <h5 class="mb-3">SuperAdmin-Benutzer</h5>

                <div class="form-group">
                    <label class="form-label">@T.Setup_Username *</label>
                    <InputText class="form-control" @bind-Value="setupModel.Username"
                               placeholder="admin" autocomplete="username" />
                    <ValidationMessage For="() => setupModel.Username" />
                </div>

                <div class="form-group">
                    <label class="form-label">@T.Setup_DisplayName *</label>
                    <InputText class="form-control" @bind-Value="setupModel.DisplayName"
                               placeholder="z.B. Max Mustermann" />
                    <ValidationMessage For="() => setupModel.DisplayName" />
                </div>

                <div class="form-group">
                    <label class="form-label">@T.Setup_Email *</label>
                    <InputText type="email" class="form-control" @bind-Value="setupModel.Email"
                               placeholder="admin@example.com" autocomplete="email" />
                    <ValidationMessage For="() => setupModel.Email" />
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">@T.Setup_Password *</label>
                            <InputText type="password" class="form-control" @bind-Value="setupModel.Password"
                                       placeholder="••••••••" autocomplete="new-password" />
                            <ValidationMessage For="() => setupModel.Password" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">@T.Setup_ConfirmPassword *</label>
                            <InputText type="password" class="form-control" @bind-Value="setupModel.ConfirmPassword"
                                       placeholder="••••••••" autocomplete="new-password" />
                            <ValidationMessage For="() => setupModel.ConfirmPassword" />
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-danger btn-lg w-100" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-shield-check me-2"></i>
                    @T.Setup_Submit
                </button>
            </EditForm>
        }
    </div>
</div>


@code {
    [SupplyParameterFromForm]
    private SetupModel setupModel { get; set; } = new();
    
    private string errorMessage = string.Empty;
    private bool isProcessing = false;
    private bool setupComplete = false;
    private bool alreadySetup = false;
    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        // Check whether setup has already been completed
        if (await SetupService.IsInitialSetupCompletedAsync())
        {
            alreadySetup = true;
            await Task.Delay(2000);
            NavigationManager.NavigateTo("/login");
        }
    }

    private async Task HandleSetup()
    {
        if (setupModel.Password != setupModel.ConfirmPassword)
        {
            errorMessage = T.Setup_PasswordMismatch ?? "Die Passwörter stimmen nicht überein.";
            return;
        }

        isProcessing = true;
        errorMessage = string.Empty;

        try
        {
            var request = new InitialSetupRequest(
                WarehouseName: setupModel.WarehouseName,
                WarehouseCode: setupModel.WarehouseCode,
                WarehouseAddress: setupModel.WarehouseAddress,
                MaxUsers: setupModel.MaxUsers,
                Username: setupModel.Username,
                Email: setupModel.Email,
                DisplayName: setupModel.DisplayName,
                Password: setupModel.Password);

            var result = await SetupService.CompleteInitialSetupAsync(request);

            if (result.IsFailure)
            {
                if (result.ErrorCode == "setup.alreadycomplete")
                {
                    errorMessage = "Das System wurde bereits eingerichtet.";
                    alreadySetup = true;
                    await Task.Delay(2000);
                    NavigationManager.NavigateTo("/login");
                    return;
                }

                errorMessage = $"Fehler bei der Einrichtung: {result.ErrorMessage ?? "Unbekannter Fehler"}";
                return;
            }

            setupComplete = true;

            // Redirect to login
            await Task.Delay(3000);
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler bei der Einrichtung: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    public class SetupModel
    {
        [Required(ErrorMessage = "Warehouse-Name ist erforderlich")]
        [MinLength(3, ErrorMessage = "Mindestens 3 Zeichen")]
        public string WarehouseName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Warehouse-Code ist erforderlich")]
        [MinLength(2, ErrorMessage = "Mindestens 2 Zeichen")]
        [MaxLength(50, ErrorMessage = "Maximal 50 Zeichen")]
        public string WarehouseCode { get; set; } = string.Empty;

        public string? WarehouseAddress { get; set; }

        public int MaxUsers { get; set; } = 50;

        [Required(ErrorMessage = "Benutzername ist erforderlich")]
        [MinLength(3, ErrorMessage = "Mindestens 3 Zeichen")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Anzeigename ist erforderlich")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "E-Mail ist erforderlich")]
        [EmailAddress(ErrorMessage = "Ungültige E-Mail-Adresse")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Passwort ist erforderlich")]
        [MinLength(6, ErrorMessage = "Passwort muss mindestens 6 Zeichen lang sein")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Passwortbestätigung ist erforderlich")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
