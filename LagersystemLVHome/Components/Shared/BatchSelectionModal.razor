@using LagersystemLVHome.Domain.Models
@inject I18nText I18nText

<div class="batch-selection-modal @(IsVisible ? "show" : "")" @onclick="HandleBackdropClick">
    <div class="batch-modal-content" @onclick:stopPropagation="true">
        <div class="batch-modal-header">
            <h3 class="batch-modal-title">
                <i class="bi bi-list-check me-2"></i>@T.BatchSelection_Title
            </h3>
            <button type="button" class="batch-modal-close" @onclick="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="batch-modal-body">
            @{
                var availableBatches = (Batches ?? new List<ProductBatch>())
                    .Where(b => b.Quantity > 0)
                .OrderBy(b => b.ExpiryDate)
        .ToList();
            }

            @if (!availableBatches.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">@T.BatchSelection_Empty</p>
                    <small>@T.BatchSelection_Empty_Desc</small>
                </div>
            }
            else
            {
                <div class="batch-list">
                    @foreach (var batch in availableBatches)
                    {
                        var isExpired = batch.IsExpired;
                        var isExpiringSoon = batch.IsExpiringSoon;
                        var isSelected = SelectedBatchId == batch.Id;

                        <div class="batch-item @(isSelected ? "selected" : "") @(isExpired ? "expired" : isExpiringSoon ? "expiring" : "")"
                             @onclick="() => SelectBatch(batch.Id)">
                            <div class="batch-item-header">
                                <div class="batch-item-number">
                                    <i class="bi bi-upc-scan me-2"></i>
                                    <strong>@batch.BatchNumber</strong>
                                </div>
                                @if (isSelected)
                                {
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                }
                            </div>

                            <div class="batch-item-details">
                                <div class="batch-detail-row">
                                    <span class="batch-label">@T.BatchSelection_Qty</span>
                                    <span class="batch-value">@batch.Quantity @T.StorageDistribution_Assigned</span>
                                </div>

                                @if (batch.ExpiryDate.HasValue)
                                {
                                    <div class="batch-detail-row">
                                        <span class="batch-label">@T.BatchSelection_Expiry</span>
                                        <span class="batch-value">
                                            @batch.ExpiryDate.Value.ToString("dd.MM.yyyy")
                                            @if (isExpired)
                                            {
                                                <span class="badge bg-danger ms-2">@T.BatchSelection_Expired</span>
                                            }
                                            else if (isExpiringSoon)
                                            {
                                                <span class="badge bg-warning ms-2">@batch.DaysUntilExpiry Tage</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success ms-2">@batch.DaysUntilExpiry Tage</span>
                                            }
                                        </span>
                                    </div>
                                }

                                @if (batch.ManufactureDate.HasValue)
                                {
                                    <div class="batch-detail-row">
                                        <span class="batch-label">@T.BatchSelection_Manufacture</span>
                                        <span class="batch-value">@batch.ManufactureDate.Value.ToString("dd.MM.yyyy")</span>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(batch.Notes))
                                {
                                    <div class="batch-detail-row">
                                        <span class="batch-label">@T.BatchSelection_Notes</span>
                                        <span class="batch-value text-muted small">@batch.Notes</span>
                                    </div>
                                }

                                <div class="batch-detail-row">
                                    <span class="batch-label">@T.BatchSelection_Created</span>
                                    <span class="batch-value text-muted small">@batch.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="batch-modal-footer">
            <button type="button" class="btn btn-secondary" @onclick="Close">
                <i class="bi bi-x-circle me-1"></i>@T.BatchSelection_Cancel
            </button>
            <button type="button" class="btn btn-primary" @onclick="Confirm" disabled="@(!SelectedBatchId.HasValue)">
                <i class="bi bi-check-circle me-1"></i>@T.BatchSelection_Select
            </button>
        </div>
    </div>
</div>


@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public List<ProductBatch> Batches { get; set; } = new();
    [Parameter] public int? SelectedBatchId { get; set; }
    [Parameter] public EventCallback<int?> OnBatchSelected { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    private async Task SelectBatch(int batchId)
    {
        SelectedBatchId = batchId;
        StateHasChanged();
    }

    private async Task Confirm()
    {
        if (SelectedBatchId.HasValue)
        {
            await OnBatchSelected.InvokeAsync(SelectedBatchId);
            await Close();
        }
    }

    private async Task Close()
    {
        await OnClosed.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }
}
