@using LagersystemLVHome.Application.Services
@using LagersystemLVHome.Domain.Models
@inject IWebAuthnService WebAuthnService
@inject IJSRuntime JSRuntime
@inject ILogger<PasskeyManager> Logger
@inject I18nText I18nText

<div class="passkey-manager">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">
            <i class="bi bi-fingerprint me-2"></i>
            @T.PasskeyManager_Title
        </h5>
        <button class="btn btn-primary btn-sm" @onclick="RegisterNewPasskey" disabled="@(!isSupported || isLoading)">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            else
            {
                <i class="bi bi-plus-lg me-1"></i>
            }
            @T.PasskeyManager_AddNew
        </button>
    </div>

    @if (!isSupported)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>WebAuthn nicht verfügbar:</strong> @T.PasskeyManager_NotSupported
        </div>
    }
    else if (hasPlatformAuthenticator)
    {
        <div class="alert alert-info alert-sm py-2 mb-3">
            <i class="bi bi-shield-check me-2"></i>
            <small>
                <strong>@(T.PasskeyManager_PlatformAuthenticatorLabel ?? "Plattform-Authenticator verfügbar:")</strong>
                @T.PasskeyManager_PlatformAvailable
            </small>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle me-2"></i>
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (passkeys == null)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@T.PasskeyManager_Loading</span>
            </div>
        </div>
    }
    else if (passkeys.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded">
            <i class="bi bi-fingerprint display-4 text-muted mb-3 d-block"></i>
            <h6 class="text-muted">@T.PasskeyManager_Empty_Title</h6>
            <p class="text-muted small mb-3">
                @T.PasskeyManager_Empty_Desc
            </p>
            <button class="btn btn-outline-primary" @onclick="RegisterNewPasskey" disabled="@(!isSupported || isLoading)">
                <i class="bi bi-plus-lg me-1"></i>
                @T.PasskeyManager_CreateFirst
            </button>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var passkey in passkeys)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center mb-1">
                                <i class="bi @GetDeviceIcon(passkey.DeviceName) me-2 text-primary"></i>
                                @if (editingPasskeyId == passkey.Id)
                                {
                                    <input type="text" class="form-control form-control-sm" style="max-width: 200px;"
                                           @bind="editingName" @bind:event="oninput"
                                           @onkeydown="@(e => HandleKeyDown(e, passkey.Id))" />
                                    <button class="btn btn-sm btn-success ms-2" @onclick="() => SavePasskeyName(passkey.Id)">
                                        <i class="bi bi-check"></i>
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-1" @onclick="CancelEdit">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                                else
                                {
                                    <strong>@passkey.DeviceName</strong>
                                    <button class="btn btn-sm btn-link p-0 ms-2" @onclick="() => StartEdit(passkey)">
                                        <i class="bi bi-pencil small"></i>
                                    </button>
                                }
                            </div>
                            <div class="small text-muted">
                                <span class="me-3">
                                    <i class="bi bi-calendar-plus me-1"></i>
                                    @T.PasskeyManager_CreatedAt @passkey.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                                @if (passkey.LastUsedAt.HasValue)
                                {
                                    <span class="me-3">
                                        <i class="bi bi-clock-history me-1"></i>
                                        @T.PasskeyManager_LastUsed @passkey.LastUsedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </span>
                                }
                                <span>
                                    <i class="bi bi-hash me-1"></i>
                                    @string.Format(T.PasskeyManager_UseCount, passkey.UseCount)
                                </span>
                            </div>
                            @if (passkey.UserVerified)
                            {
                                <span class="badge bg-success mt-1">
                                    <i class="bi bi-shield-check me-1"></i>@T.PasskeyManager_Verified
                                </span>
                            }
                        </div>
                        <div>
                            <button class="btn btn-outline-danger btn-sm"
                                    @onclick="() => ConfirmDeletePasskey(passkey)"
                                    disabled="@isLoading">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Passkey-Name Dialog -->
@if (showNameDialog)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-fingerprint me-2"></i>
                        @T.PasskeyManager_NameDialog_Title
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showNameDialog = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        @T.PasskeyManager_NameDialog_Hint
                    </p>
                    <div class="mb-3">
                        <label class="form-label">@T.PasskeyManager_NameDialog_Label</label>
                        <input type="text" class="form-control" @bind="newPasskeyName"
                               placeholder="z.B. MacBook Pro, iPhone 15" maxlength="100" />
                        <div class="form-text">
                            @T.PasskeyManager_NameDialog_Detected <strong>@detectedDeviceName</strong>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => showNameDialog = false">
                        @T.PasskeyManager_NameDialog_Cancel
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="StartPasskeyRegistration" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-fingerprint me-1"></i>
                        @T.PasskeyManager_NameDialog_Create
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete confirmation -->
@if (showDeleteConfirm && passkeyToDelete != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @T.PasskeyManager_Delete_Title
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p>
                        @T.PasskeyManager_Delete_Confirm <strong>"@passkeyToDelete.DeviceName"</strong>
                    </p>
                     <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @T.PasskeyManager_Delete_Warning
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => showDeleteConfirm = false">
                        @T.PasskeyManager_Delete_Cancel
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="DeletePasskey" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-trash me-1"></i>
                        @T.PasskeyManager_Delete_Confirm_Btn
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public EventCallback OnPasskeyRegistered { get; set; }

    [Parameter]
    public EventCallback OnPasskeyDeleted { get; set; }

    private List<UserPasskey>? passkeys;
    private bool isLoading = false;
    private bool isSupported = false;
    private bool hasPlatformAuthenticator = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    // Dialog State
    private bool showNameDialog = false;
    private string newPasskeyName = string.Empty;
    private string detectedDeviceName = string.Empty;
    private string? currentSessionId;

    // Delete Confirmation
    private bool showDeleteConfirm = false;
    private UserPasskey? passkeyToDelete;

    // Inline Edit
    private int? editingPasskeyId;
    private string editingName = string.Empty;

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadPasskeys();
        await CheckWebAuthnSupport();
    }

    private async Task CheckWebAuthnSupport()
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<WebAuthnSupportInfo>("webAuthnHelper.getAvailableAuthenticators");
            isSupported = result.WebAuthnSupported;
            hasPlatformAuthenticator = result.PlatformAuthenticator;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error checking WebAuthn support");
            isSupported = false;
        }
    }

    private async Task LoadPasskeys()
    {
        try
        {
            passkeys = await WebAuthnService.GetUserPasskeysAsync(UserId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading passkeys for user {UserId}", UserId);
            errorMessage = "Fehler beim Laden der Passkeys.";
        }
    }

    private async Task RegisterNewPasskey()
    {
        try
        {
            // Detect device name
            detectedDeviceName = await JSRuntime.InvokeAsync<string>("webAuthnHelper.detectDeviceName");
            newPasskeyName = detectedDeviceName;
            showNameDialog = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error detecting device name");
            detectedDeviceName = "Unbekanntes Gerät";
            newPasskeyName = detectedDeviceName;
            showNameDialog = true;
        }
    }

    private async Task StartPasskeyRegistration()
    {
        if (string.IsNullOrWhiteSpace(newPasskeyName))
        {
            newPasskeyName = detectedDeviceName;
        }

        isLoading = true;
        errorMessage = string.Empty;
        showNameDialog = false;

        try
        {
            // Generiere Registrierungsoptionen
            var options = await WebAuthnService.GenerateRegistrationOptionsAsync(UserId, newPasskeyName);
            
            if (!options.Success)
            {
                errorMessage = options.Error ?? "Fehler bei der Vorbereitung.";
                return;
            }

            currentSessionId = options.SessionId;

            // Invoke the WebAuthn API
            var jsOptions = new
            {
                challenge = options.Challenge,
                rpId = options.RpId,
                rpName = options.RpName,
                userId = options.UserId,
                userName = options.UserName,
                userDisplayName = options.UserDisplayName,
                excludeCredentials = options.ExcludeCredentials.Select(c => new
                {
                    type = c.Type,
                    id = c.Id,
                    transports = c.Transports
                }),
                authenticatorSelection = new
                {
                    authenticatorAttachment = options.AuthenticatorSelection.AuthenticatorAttachment,
                    residentKey = options.AuthenticatorSelection.ResidentKey,
                    userVerification = options.AuthenticatorSelection.UserVerification
                },
                timeout = options.Timeout,
                attestation = options.Attestation,
                deviceName = newPasskeyName
            };

            var result = await JSRuntime.InvokeAsync<WebAuthnResult>("webAuthnHelper.registerPasskey", jsOptions);

            if (!result.Success)
            {
                errorMessage = result.Error ?? "Passkey-Erstellung fehlgeschlagen.";
                return;
            }

            // Verifiziere auf Server
            var verifyResult = await WebAuthnService.VerifyRegistrationAsync(UserId, result.Credential!, currentSessionId);

            if (verifyResult.Success)
            {
                successMessage = $"Passkey \"{verifyResult.DeviceName}\" wurde erfolgreich erstellt!";
                await LoadPasskeys();
                await OnPasskeyRegistered.InvokeAsync();
            }
            else
            {
                errorMessage = verifyResult.Error ?? "Passkey konnte nicht verifiziert werden.";
            }
        }
        catch (JSException jsEx) when (jsEx.Message.Contains("User cancelled") || jsEx.Message.Contains("NotAllowedError"))
        {
            Logger.LogInformation("User cancelled passkey registration");
            // Don't show an error message when the user cancels
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during passkey registration");
            errorMessage = "Ein unerwarteter Fehler ist aufgetreten.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ConfirmDeletePasskey(UserPasskey passkey)
    {
        passkeyToDelete = passkey;
        showDeleteConfirm = true;
    }

    private async Task DeletePasskey()
    {
        if (passkeyToDelete == null) return;

        isLoading = true;

        try
        {
            var success = await WebAuthnService.DeletePasskeyAsync(UserId, passkeyToDelete.Id);

            if (success)
            {
                successMessage = $"Passkey \"{passkeyToDelete.DeviceName}\" wurde gelöscht.";
                await LoadPasskeys();
                await OnPasskeyDeleted.InvokeAsync();
            }
            else
            {
                errorMessage = T.PasskeyManager_DeleteError ?? "Passkey konnte nicht gelöscht werden.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting passkey");
            errorMessage = T.PasskeyManager_DeleteFail ?? "Fehler beim Löschen des Passkeys.";
        }
        finally
        {
            isLoading = false;
            showDeleteConfirm = false;
            passkeyToDelete = null;
        }
    }

    private void StartEdit(UserPasskey passkey)
    {
        editingPasskeyId = passkey.Id;
        editingName = passkey.DeviceName;
    }

    private void CancelEdit()
    {
        editingPasskeyId = null;
        editingName = string.Empty;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e, int passkeyId)
    {
        if (e.Key == "Enter")
        {
            await SavePasskeyName(passkeyId);
        }
        else if (e.Key == "Escape")
        {
            CancelEdit();
        }
    }

    private async Task SavePasskeyName(int passkeyId)
    {
        if (string.IsNullOrWhiteSpace(editingName)) return;

        try
        {
            var success = await WebAuthnService.RenamePasskeyAsync(UserId, passkeyId, editingName.Trim());
   
            if (success)
            {
                await LoadPasskeys();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error renaming passkey");
        }
        finally
        {
            CancelEdit();
        }
    }

    private string GetDeviceIcon(string deviceName)
    {
        var name = deviceName.ToLowerInvariant();
        
        if (name.Contains("iphone")) return "bi-phone";
        if (name.Contains("ipad")) return "bi-tablet";
        if (name.Contains("mac")) return "bi-laptop";
        if (name.Contains("android")) return "bi-phone";
        if (name.Contains("windows")) return "bi-pc-display";
        if (name.Contains("linux")) return "bi-pc-display";
        if (name.Contains("chromebook")) return "bi-laptop";
        if (name.Contains("yubikey") || name.Contains("security key")) return "bi-key";
        
        return "bi-fingerprint";
    }

    // Helper classes for JS interop
    private class WebAuthnSupportInfo
    {
        public bool WebAuthnSupported { get; set; }
        public bool PlatformAuthenticator { get; set; }
        public bool ConditionalUI { get; set; }
    }

    private class WebAuthnResult
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
        public string? Credential { get; set; }
    }
}
