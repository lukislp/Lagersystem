@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using LagersystemLVHome.Data
@inject LagersystemLVHome.Application.Services.IInventoryService InventoryService
@inject LagersystemLVHome.Application.Services.IAuthService AuthService
@inject LagersystemLVHome.Application.Services.IUserRegistrationService UserRegistrationService
@inject LagersystemLVHome.Application.Services.ISessionManagementService SessionService
@inject IExpiryService ExpiryService
@inject I18nText I18nText
@implements IDisposable

@* SessionBlockingOverlay moved to App.razor (more stable across auth changes) *@

<AuthorizeView>
    <Authorized>
        @* Session Termination Handler - listens for the SessionTerminated event *@
        <SessionTerminationHandler />
        
        @* Thumbmarkjs fingerprint capture - captures precise browser fingerprint after login *@
        <ThumbmarkFingerprintCapture />

        <div class="app-container">
            <!-- Sidebar -->
            <aside class="sidebar">
                <div class="sidebar-header">
                    <a href="/" class="sidebar-brand">
                        <div class="sidebar-brand-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <span class="sidebar-brand-text">LagerSystem</span>
                    </a>
                </div>
     
                <nav class="sidebar-nav">
                    <div class="nav-section">
                        <div class="nav-section-title">@T.Nav_MainMenu</div>
                        <NavLink href="/" class="nav-item" Match="NavLinkMatch.All">
                            <i class="bi bi-house nav-item-icon"></i>
                            <span>@T.Nav_Home</span>
                        </NavLink>
                        <NavLink href="/dashboard" class="nav-item">
                            <i class="bi bi-speedometer2 nav-item-icon"></i>
                            <span>@T.Nav_AnalyticsDashboard</span>
                        </NavLink>
                        <NavLink href="/scanner" class="nav-item">
                            <i class="bi bi-qr-code-scan nav-item-icon"></i>
                            <span>@T.Nav_Scanner</span>
                        </NavLink>
                        <NavLink href="/qr-generator" class="nav-item">
                            <i class="bi bi-qr-code nav-item-icon"></i>
                            <span>@T.Nav_QRGenerator</span>
                        </NavLink>
                        <NavLink href="/products" class="nav-item">
                            <i class="bi bi-box nav-item-icon"></i>
                            <span>@T.Nav_Products</span>
                        </NavLink>
                        <NavLink href="/low-stock" class="nav-item">
                            <i class="bi bi-exclamation-triangle nav-item-icon"></i>
                            <span>@T.Nav_LowStock</span>
                            @if (lowStockCount > 0)
                            {
                                <span class="nav-item-badge">@lowStockCount</span>
                            }
                        </NavLink>
                        <NavLink href="/storage-overview" class="nav-item">
                            <i class="bi bi-grid-3x3-gap nav-item-icon"></i>
                            <span>@T.Nav_StorageOverview</span>
                        </NavLink>
                        <NavLink href="/rooms-overview" class="nav-item">
                            <i class="bi bi-door-open nav-item-icon"></i>
                            <span>@T.Nav_RoomsOverview</span>
                        </NavLink>
                        <NavLink href="/movements" class="nav-item">
                            <i class="bi bi-arrow-left-right nav-item-icon"></i>
                            <span>@T.Nav_Movements</span>
                        </NavLink>
                        <NavLink href="/export-import" class="nav-item">
                            <i class="bi bi-arrow-down-up nav-item-icon"></i>
                            <span>@T.Nav_ExportImport</span>
                        </NavLink>
                        <NavLink href="/expiry-monitoring" class="nav-item">
                            <i class="bi bi-calendar-x nav-item-icon"></i>
                            <span>@T.Nav_ExpiryMonitoring</span>
                            @if (expiringBatchesCount > 0)
                            {
                                <span class="nav-item-badge bg-warning">@expiringBatchesCount</span>
                            }
                        </NavLink>
                        <NavLink href="/ai-assistant" class="nav-item">
                            <i class="bi bi-chat-dots nav-item-icon"></i>
                            <span>@T.Nav_AiAssistant</span>
                        </NavLink>
                        <NavLink href="/gamification" class="nav-item">
                            <i class="bi bi-trophy nav-item-icon"></i>
                            <span>@T.Nav_Gamification</span>
                        </NavLink>
                    </div>
  
                    <div class="nav-section">
                        <div class="nav-section-title">@T.Nav_Categories</div>
                        <NavLink href="/categories" class="nav-item">
                            <i class="bi bi-plus-circle nav-item-icon"></i>
                            <span>@T.Nav_ManageCategories</span>
                        </NavLink>
                    </div>
   
                    <div class="nav-section">
                        <div class="nav-section-title">@T.Nav_Account</div>
                        <NavLink href="/profile" class="nav-item">
                            <i class="bi bi-person nav-item-icon"></i>
                            <span>@T.Nav_Profile</span>
                        </NavLink>
                        @if (currentUser?.Role >= UserRole.Admin)
                        {
                            <NavLink href="/admin/users" class="nav-item">
                                <i class="bi bi-people nav-item-icon"></i>
                                <span>@T.Nav_UserManagement</span>
                                @if (pendingUserCount > 0)
                                {
                                    <span class="nav-item-badge bg-warning">@pendingUserCount</span>
                                }
                            </NavLink>
                            <NavLink href="/admin/warehouses" class="nav-item">
                                <i class="bi bi-building nav-item-icon"></i>
                                @if (currentUser?.Role == UserRole.SuperAdmin)
                                {
                                    <span>@T.Nav_ManageWarehouses</span>
                                }
                                else
                                {
                                    <span>@T.Nav_MyWarehouse</span>
                                }
                            </NavLink>
                            <NavLink href="/admin/rooms" class="nav-item" Match="NavLinkMatch.All">
                                <i class="bi bi-door-open nav-item-icon"></i>
                                <span>@T.Nav_ManageRooms</span>
                            </NavLink>
                            <NavLink href="/security-center" class="nav-item">
                                <i class="bi bi-shield-lock nav-item-icon"></i>
                                <span>@T.Nav_SecurityCenter</span>
                            </NavLink>
                            <NavLink href="/audit-dashboard" class="nav-item">
                                <i class="bi bi-shield-check nav-item-icon"></i>
                                <span>@T.Nav_AuditDashboard</span>
                            </NavLink>
                            <NavLink href="/admin" class="nav-item" Match="NavLinkMatch.All">
                                <i class="bi bi-gear nav-item-icon"></i>
                                <span>@T.Nav_Administration</span>
                            </NavLink>
     
                            @* App insights (SuperAdmin only) *@
                            @if (currentUser?.Role == UserRole.SuperAdmin)
                            {
                                <NavLink href="/admin/insights" class="nav-item">
                                    <i class="bi bi-graph-up-arrow nav-item-icon"></i>
                                    <span>@T.Nav_AppInsights</span>
                                </NavLink>
                            }
  
                            @* Rate limit dashboard (Admin/SuperAdmin) *@
                            @if (currentUser?.Role >= UserRole.Admin)
                            {
                                <NavLink href="/admin/rate-limits" class="nav-item">
                                    <i class="bi bi-speedometer2 nav-item-icon"></i>
                                    <span>@T.Nav_RateLimiting</span>
                                </NavLink>
  
                                @* Session management (Admin/SuperAdmin) *@
                                <NavLink href="/admin/session-management" class="nav-item">
                                    <i class="bi bi-diagram-3 nav-item-icon"></i>
                                    <span>@T.Nav_SessionManagement</span>
                                </NavLink>
     
                                @* Device management (Admin/SuperAdmin) *@
                                <NavLink href="/admin/device-management" class="nav-item">
                                    <i class="bi bi-phone nav-item-icon"></i>
                                    <span>@T.Nav_DeviceManagement</span>
                                </NavLink>
     
                                @* Security threats (SuperAdmin only) *@
                                @if (currentUser?.Role == UserRole.SuperAdmin)
                                {
                                    <NavLink href="/admin/security-threats" class="nav-item">
                                        <i class="bi bi-shield-exclamation nav-item-icon"></i>
                                        <span>@T.Nav_SecurityThreats</span>
                                    </NavLink>
  
                                    @* Cloudflare dashboard (SuperAdmin only) *@
                                    <NavLink href="/admin/cloudflare" class="nav-item">
                                        <i class="bi bi-cloud-fill nav-item-icon"></i>
                                        <span>@T.Nav_Cloudflare</span>
                                    </NavLink>
  
                                    @* Backups (SuperAdmin only) *@
                                    <NavLink href="/admin/backups" class="nav-item">
                                        <i class="bi bi-hdd-stack nav-item-icon"></i>
                                        <span>@T.Nav_Backups</span>
                                    </NavLink>
  
                                    @* Database restore (SuperAdmin only) *@
                                    <NavLink href="/admin/database-restore" class="nav-item">
                                        <i class="bi bi-arrow-clockwise nav-item-icon"></i>
                                        <span>@T.Nav_DatabaseRestore</span>
                                    </NavLink>
  
                                    @* GDPR cleanup (SuperAdmin only) *@
                                    <NavLink href="/admin/gdpr-cleanup" class="nav-item">
                                        <i class="bi bi-shield-check nav-item-icon"></i>
                                        <span>@T.Nav_GdprCleanup</span>
                                    </NavLink>
    
                                    @* Database health (SuperAdmin only) *@
                                    <NavLink href="/admin/database-health" class="nav-item">
                                        <i class="bi bi-database-fill-gear nav-item-icon"></i>
                                        <span>@T.Nav_DatabaseHealth</span>
                                    </NavLink>
                                }
                            }
                        }
    
                        <NavLink href="/settings" class="nav-item">
                            <i class="bi bi-gear nav-item-icon"></i>
                            <span>@T.Nav_Settings</span>
                        </NavLink>
                        <NavLink href="/logout" class="nav-item">
                            <i class="bi bi-box-arrow-right nav-item-icon"></i>
                            <span>@T.Nav_Logout</span>
                        </NavLink>
                    </div>
                </nav>
            </aside>
    
            <!-- Main Content -->
            <main class="main-content">
                <header class="top-header">
                    <!-- Mobile menu button (visible only on mobile) -->
                    <button class="mobile-menu-btn show-mobile" onclick="window.mobileMenu.toggle()">
                        <i class="bi bi-list"></i>
                    </button>
        
                    <div class="header-actions">
                        @if (currentUser != null)
                        {
                            <!-- Make the profile picture and name clickable -->
                            <NavLink href="/profile" class="user-info-link me-3">
                                <div class="user-info d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(currentUser.ProfileImagePath))
                                    {
                                        <img src="@currentUser.ProfileImagePath"
                                             alt="@currentUser.DisplayName"
                                             class="profile-avatar-header" />
                                    }
                                    else
                                    {
                                        <div class="profile-avatar-header-placeholder">
                                            <i class="bi bi-person-circle"></i>
                                        </div>
                                    }
                                    <div class="hide-mobile">
                                        <span class="text-muted d-block">@currentUser.DisplayName</span>
                                        <small class="text-muted d-block">@currentUser.Warehouse?.Name</small>
                                    </div>
                                </div>
                            </NavLink>
                        }
    
                        @* Notification Bell & Team Presence *@
                        <div class="d-flex align-items-center gap-2">
                            <NotificationBell />
                            <TeamPresenceButton />
                        </div>

                        <NavLink href="/low-stock" class="header-btn">
                            <i class="bi bi-bell"></i>
                            @if (lowStockCount > 0)
                            {
                                <span class="badge">@lowStockCount</span>
                            }
                        </NavLink>
                    </div>
                </header>
      
                <div class="page-content">
                    @Body
                </div>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        @* Redirect erfolgt automatisch via OnInitializedAsync *@
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui">
    @T.Error_RequestProcessing
    <a href="" class="reload">@T.Common_Refresh</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private int lowStockCount = 0;
    private int pendingUserCount = 0;
    private int expiringBatchesCount = 0;
    private LagersystemLVHome.Domain.Models.User? currentUser;
    private DotNetObjectReference<MainLayout>? dotNetHelper;
    private string? currentSessionId;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        // Check if session restoration is needed (mobile fix)
        var existingUser = await AuthService.GetCurrentUserAsync();
 
        await LoadDataAsync();
   
        // Redirect unauthenticated users
        if (currentUser == null)
        {
            NavigationManager?.NavigateTo("/login", true);
        }
        else
        {
            // Get the current session id
            currentSessionId = await AuthService.GetCurrentSessionIdAsync();
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && currentUser != null)
        {
            try
            {
                if (string.IsNullOrEmpty(currentSessionId))
                {
                    currentSessionId = await AuthService.GetCurrentSessionIdAsync();
                }

                if (!string.IsNullOrEmpty(currentSessionId))
                {
                    // Create .NET object reference for JS callbacks
                    dotNetHelper = DotNetObjectReference.Create(this);

                    // Start the session monitor
                    await JSRuntime.InvokeVoidAsync("SessionMonitor.start", dotNetHelper, currentSessionId);
                }
            }
            catch
            {
                // Session monitor failed to start; the app remains usable without it
            }
        }
    }
    
    /// <summary>
    /// Called from JavaScript to check session status.
    /// </summary>
    [JSInvokable]
    public async Task<bool> CheckSessionStatus()
    {
        try
        {
            if (string.IsNullOrEmpty(currentSessionId))
                return false;
     
            var session = await SessionService.GetSessionAsync(currentSessionId);
            return session != null && session.IsActive;
        }
        catch
        {
            return true; // Do not log the user out on error
        }
    }
  
    private async Task LoadDataAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser != null)
            {
                var lowStockProducts = await InventoryService.GetLowStockProductsAsync();
                lowStockCount = lowStockProducts.Count();
    
                // Load pending user count for admins
                if (currentUser.Role >= UserRole.Admin)
                {
                    var pendingUsers = await UserRegistrationService.GetPendingUsersAsync(AuthService.GetCurrentWarehouseId());
                    pendingUserCount = pendingUsers.Count();
                }
    
                await LoadExpiringBatchesCount();
            }
        }
        catch
        {
            // Handle gracefully on first run
        }
    }
  
    private async Task LoadExpiringBatchesCount()
    {
        try
        {
            if (currentUser == null) return;

            expiringBatchesCount = await ExpiryService.GetExpiringBatchesCountAsync(
                currentUser.WarehouseId,
                daysThreshold: 7);
        }
        catch
        {
            expiringBatchesCount = 0;
        }
    }
    
    public void Dispose()
    {
        try
        {
            // Stop the session monitor
            JSRuntime?.InvokeVoidAsync("SessionMonitor.stop");
         
            // Dispose .NET Object Reference
            dotNetHelper?.Dispose();
        }
        catch { }
    }
  
    [Inject]
    private NavigationManager? NavigationManager { get; set; }

    [Inject]
    private IServiceProvider ServiceProvider { get; set; } = default!;

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}
