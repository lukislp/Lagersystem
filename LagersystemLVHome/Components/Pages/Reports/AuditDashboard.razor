@page "/audit-dashboard"
@using LagersystemLVHome.Domain.Models
@using LagersystemLVHome.Application.Services
@using ApexCharts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@rendermode InteractiveServer
@inject IAuditService AuditService
@inject IToastService ToastService
@inject ILogger<AuditDashboard> Logger
@inject I18nText I18nText
@implements IDisposable

<PageTitle>@T.AuditDashboard_PageTitle</PageTitle>

<div class="page-header mb-4">
    <div>
        <h1 class="page-title">
            <i class="bi bi-shield-check me-2"></i>
            Audit Dashboard
            <span class="badge bg-success ms-2" title="Auto-refresh every 30 seconds">
                <i class="bi bi-arrow-clockwise @(isRefreshing ? "rotating" : "")"></i>
                @T.AuditDashboard_AutoRefresh
            </span>
        </h1>
        <p class="page-subtitle">@T.AuditDashboard_SecurityMonitoring</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn @(autoRefreshEnabled ? "btn-success" : "btn-outline-secondary")"
                @onclick="ToggleAutoRefresh">
            <i class="bi @(autoRefreshEnabled ? "bi-pause-circle" : "bi-play-circle")"></i>
            @(autoRefreshEnabled ? T.AuditDashboard_Pause : T.AuditDashboard_Resume)
        </button>

        <button class="btn btn-outline-info" @onclick="VerifyIntegrity" disabled="@isVerifying">
            <i class="bi bi-shield-lock @(isVerifying ? "rotating" : "")"></i>
            @(isVerifying ? T.AuditDashboard_Verifying : T.AuditDashboard_VerifyIntegrity)
        </button>

        <button class="btn btn-primary" @onclick="RefreshData" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise @(isLoading ? "rotating" : "")"></i>
            @T.AuditDashboard_Refresh
        </button>
        <a href="/admin-audit-logs" class="btn btn-outline-primary">
            <i class="bi bi-list-ul"></i>
            @T.AuditDashboard_DetailedLogs
        </a>
    </div>
</div>

@if (isLoading && isInitialLoad)
{
    <div class="loading-container">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Lädt...</span>
        </div>
        <p>@T.AuditDashboard_Loading</p>
    </div>
}
else if (recentLogs != null)
{
    @if (verificationResult != null)
    {
        <div class="alert @(verificationResult.IsValid ? "alert-success" : "alert-danger") alert-dismissible fade show mb-4" role="alert">
            <div class="d-flex align-items-start">
                <i class="bi @(verificationResult.IsValid ? "bi-shield-check" : "bi-shield-exclamation") fs-3 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-2">
                        @if (verificationResult.IsValid)
                        {
                            <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Integrität bestätigt</span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i>Integritätsverletzung erkannt!</span>
                        }
                    </h5>
                    <p class="mb-1">
                        <strong>@verificationResult.TotalChecked</strong> Audit-Logs überprüft
                    </p>
                    @if (!verificationResult.IsValid && verificationResult.InvalidLogs.Any())
                    {
                        <hr class="my-2" />
                        <p class="mb-2"><strong>Fehlerhafte Einträge:</strong></p>
                        <ul class="mb-0">
                            @foreach (var invalid in verificationResult.InvalidLogs.Take(5))
                            {
                                <li>
                                    <small>
                                        <strong>Log ID:</strong> @invalid.LogId<br />
                                        <strong>Grund:</strong> @invalid.Reason
                                    </small>
                                </li>
                            }
                            @if (verificationResult.InvalidLogs.Count > 5)
                            {
                                <li><small>... und @(verificationResult.InvalidLogs.Count - 5) weitere</small></li>
                            }
                        </ul>
                    }
                    else if (verificationResult.IsValid)
                    {
                        <p class="mb-0">
                            <small class="text-muted">Alle Audit-Logs sind manipulationssicher und vollständig.</small>
                        </p>
                    }
                </div>
            </div>
            <button type="button" class="btn-close" @onclick="() => verificationResult = null" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-shield-check display-1"></i>
                    <h2 class="mt-3 mb-0">@totalActivities</h2>
                    <p class="mb-0">Gesamtaktivitäten</p>
                    <small>Letzte 24 Stunden</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-success h-100">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle display-1"></i>
                    <h2 class="mt-3 mb-0">@successfulLogins</h2>
                    <p class="mb-0">Erfolgreiche Logins</p>
                    <small>Heute</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-warning h-100">
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle display-1"></i>
                    <h2 class="mt-3 mb-0">@securityEvents</h2>
                    <p class="mb-0">Sicherheitsereignisse</p>
                    <small>Warnungen & Fehler</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-danger h-100">
                <div class="card-body text-center">
                    <i class="bi bi-x-circle display-1"></i>
                    <h2 class="mt-3 mb-0">@failedAttempts</h2>
                    <p class="mb-0">Fehlgeschlagene Versuche</p>
                    <small>Letzte 24h</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up me-2"></i>
                        Aktivitätsverlauf
                    </h5>
                </div>
                <div class="card-body">
                    @if (activityChartData.Any())
                    {
                        <ApexChart TItem="ActivityChartData" Title="Letzte 7 Tage">
                            <ApexPointSeries TItem="ActivityChartData"
                                             Items="@activityChartData"
                                             Name="Aktivitäten"
                                             SeriesType="SeriesType.Line"
                                             XValue="@(e => e.Date.ToString("dd.MM"))"
                                             YValue="@(e => (decimal)e.Count)" />
                        </ApexChart>
                    }
                    else
                    {
                        <div class="no-data">
                            <i class="bi bi-inbox"></i>
                            <p>Keine Daten verfügbar</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-pie-chart me-2"></i>
                        Aktionsverteilung
                    </h5>
                </div>
                <div class="card-body">
                    @if (actionStats.Any())
                    {
                        <ApexChart TItem="ActionStat" Title="Top Aktionen">
                            <ApexPointSeries TItem="ActionStat"
                                             Items="@actionStats.Take(5).ToList()"
                                             SeriesType="SeriesType.Donut"
                                             Name="Anzahl"
                                             XValue="@(e => GetActionDisplayName(e.Action))"
                                             YValue="@(e => e.Count)"
                                             OrderByDescending="@(e => e.Y)" />
                        </ApexChart>
                    }
                    else
                    {
                        <div class="no-data">
                            <i class="bi bi-inbox"></i>
                            <p>Keine Daten verfügbar</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Security Events -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-shield-exclamation me-2"></i>
                        Aktuelle Sicherheitsereignisse
                    </h5>
                </div>
                <div class="card-body">
                    @if (recentSecurityEvents.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Zeitstempel</th>
                                        <th>Benutzer</th>
                                        <th>Aktion</th>
                                        <th>IP-Adresse</th>
                                        <th>Schweregrad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in recentSecurityEvents.Take(10))
                                    {
                                        <tr class="@GetSeverityClass(log.Severity)">
                                            <td data-label="Zeitstempel">
                                                <small>@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</small>
                                            </td>
                                            <td data-label="Benutzer">
                                                <strong>@(log.Username ?? "System")</strong>
                                            </td>
                                            <td data-label="Aktion">
                                                <span class="badge @GetActionBadgeClass(log.Action)">
                                                    @GetActionDisplayName(log.Action)
                                                </span>
                                            </td>
                                            <td data-label="IP-Adresse">
                                                <code>@(log.IpAddress ?? "-")</code>
                                            </td>
                                            <td data-label="Schweregrad">
                                                <span class="badge @GetSeverityBadgeClass(log.Severity)">
                                                    @log.Severity
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="text-center mt-3">
                            <a href="/admin-audit-logs" class="btn btn-sm btn-primary">
                                <i class="bi bi-list-ul me-1"></i>
                                Alle Sicherheitsereignisse anzeigen
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mb-0">
                            <i class="bi bi-shield-check me-2"></i>
                            Keine Sicherheitsereignisse - Alles in Ordnung!
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>
                        Letzte Aktivitäten
                    </h5>
                </div>
                <div class="card-body">
                    @if (recentLogs.Any())
                    {
                        @foreach (var log in recentLogs.Take(20))
                        {
                            <div class="timeline-item @GetTimelineClass(log.Action)">
                                <span class="timeline-badge @GetActionBadgeClass(log.Action)">
                                    <i class="bi @GetActionIcon(log.Action)"></i>
                                </span>
                                <div class="timeline-content">
                                    <div class="timeline-header">
                                        <strong>@(log.Username ?? "System")</strong>
                                        <span class="badge bg-secondary">@GetActionDisplayName(log.Action)</span>
                                    </div>
                                    <div class="timeline-details">
                                        <span>@log.Entity</span>
                                        @if (!string.IsNullOrEmpty(log.Details))
                                        {
                                            <span class="text-muted">→ Details verfügbar</span>
                                        }
                                    </div>
                                    <small class="text-muted">
                                        <i class="bi bi-calendar"></i> @log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
                                        @if (!string.IsNullOrEmpty(log.IpAddress))
                                        {
                                            <span>→ <i class="bi bi-geo-alt"></i> @log.IpAddress</span>
                                        }
                                    </small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-data">
                            <i class="bi bi-inbox"></i>
                            <p>Keine Aktivitäten vorhanden</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private List<AuditLog>? recentLogs;
    private List<AuditLog> recentSecurityEvents = new();
    private List<ActivityChartData> activityChartData = new();
    private List<ActionStat> actionStats = new();

    private bool isLoading = false;
    private bool isInitialLoad = true;
    private bool isRefreshing = false;

    private System.Threading.Timer? _refreshTimer;
    private bool autoRefreshEnabled = true;
    private bool _disposed = false;

    private int _previousTotalActivities = 0;
    private int _previousSuccessfulLogins = 0;
    private int _previousSecurityEvents = 0;
    private int _previousFailedAttempts = 0;
    private int _previousRecentLogsCount = 0;
    private int _previousSecurityEventsCount = 0;

    private int totalActivities = 0;
    private int successfulLogins = 0;
    private int securityEvents = 0;
    private int failedAttempts = 0;

    private bool isVerifying = false;
    private AuditLogVerificationResult? verificationResult = null;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadDashboardData();
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        if (_disposed || _refreshTimer != null) return;

        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            if (autoRefreshEnabled && !isLoading && !_disposed)
            {
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    await LoadDashboardDataSilent();
                });
            }
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));

        Logger.LogInformation("Audit Dashboard: Smart Auto-Refresh aktiviert (30s Intervall)");
    }

    private void ToggleAutoRefresh()
    {
        autoRefreshEnabled = !autoRefreshEnabled;
        Logger.LogInformation("Audit Auto-refresh {Status}", autoRefreshEnabled ? "enabled" : "disabled");
        StateHasChanged();
    }

    private async Task LoadDashboardDataSilent()
    {
        try
        {
            isRefreshing = true;

            var newRecentLogs = await AuditService.GetRecentLogsAsync(100);
            var newSecurityEvents = await AuditService.GetSecurityEventsAsync(50);

            var last24h = DateTime.UtcNow.AddDays(-1);
            var today = DateTime.UtcNow.Date;

            var newTotalActivities = newRecentLogs.Count(l => l.Timestamp >= last24h);
            var newSuccessfulLogins = newRecentLogs.Count(l => l.Action == "LOGIN_SUCCESS" && l.Timestamp >= today);
            var newSecurityEventsCount = newRecentLogs.Count(l => l.Severity >= AuditSeverity.Warning);
            var newFailedAttempts = newRecentLogs.Count(l => l.Action.Contains("FAILED") && l.Timestamp >= last24h);

            bool hasChanges = newTotalActivities != _previousTotalActivities ||
                              newSuccessfulLogins != _previousSuccessfulLogins ||
                              newSecurityEventsCount != _previousSecurityEvents ||
                              newFailedAttempts != _previousFailedAttempts ||
                              newRecentLogs.Count != _previousRecentLogsCount ||
                              newSecurityEvents.Count != _previousSecurityEventsCount;

            if (hasChanges)
            {
                recentLogs = newRecentLogs;
                recentSecurityEvents = newSecurityEvents;

                totalActivities = newTotalActivities;
                successfulLogins = newSuccessfulLogins;
                securityEvents = newSecurityEventsCount;
                failedAttempts = newFailedAttempts;

                var last7Days = DateTime.UtcNow.AddDays(-7);
                activityChartData = newRecentLogs
                    .Where(l => l.Timestamp >= last7Days)
                    .GroupBy(l => l.Timestamp.Date)
                    .Select(g => new ActivityChartData
                    {
                        Date = g.Key,
                        Count = g.Count()
                    })
                    .OrderBy(x => x.Date)
                    .ToList();

                var stats = await AuditService.GetActionStatisticsAsync(DateTime.UtcNow.AddDays(-30));
                actionStats = stats
                    .Select(kvp => new ActionStat { Action = kvp.Key, Count = kvp.Value })
                    .OrderByDescending(x => x.Count)
                    .ToList();

                _previousTotalActivities = newTotalActivities;
                _previousSuccessfulLogins = newSuccessfulLogins;
                _previousSecurityEvents = newSecurityEventsCount;
                _previousFailedAttempts = newFailedAttempts;
                _previousRecentLogsCount = newRecentLogs.Count;
                _previousSecurityEventsCount = newSecurityEvents.Count;

                Logger.LogInformation("Audit Dashboard: Changes detected - Activities: {Activities}, Security: {Security}",
                    totalActivities, securityEvents);

                StateHasChanged();
            }
            else
            {
                Logger.LogDebug("Audit Dashboard: No changes - skipping UI update");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in silent refresh (Audit Dashboard)");
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private async Task LoadDashboardData()
    {
        if (isInitialLoad)
        {
            isLoading = true;
            StateHasChanged();
        }

        try
        {
            await LoadDashboardDataSilent();
        }
        finally
        {
            isLoading = false;
            isInitialLoad = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadDashboardData();
        ToastService.ShowSuccess("Dashboard refreshed");
    }

    private async Task VerifyIntegrity()
    {
        try
        {
            isVerifying = true;
            verificationResult = null;
            StateHasChanged();

            Logger.LogInformation("Starting audit log integrity verification...");

            verificationResult = await AuditService.VerifyIntegrityAsync(limitToLast: 1000);

            if (verificationResult.IsValid)
            {
                ToastService.ShowSuccess($"<i class='bi bi-check-circle-fill me-1'></i> Integrity confirmed: {verificationResult.TotalChecked} logs checked");
                Logger.LogInformation("Audit log integrity verified: {Count} logs checked", verificationResult.TotalChecked);
            }
            else
            {
                ToastService.ShowError($"<i class='bi bi-exclamation-triangle-fill me-1'></i> Integrity violation: {verificationResult.InvalidLogs.Count} corrupted entries found!");
                Logger.LogWarning("Audit log integrity violation: {InvalidCount} invalid entries found",
                    verificationResult.InvalidLogs.Count);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error verifying audit log integrity");
            ToastService.ShowError("Error during integrity check");

            verificationResult = new AuditLogVerificationResult
            {
                IsValid = false,
                InvalidLogs = new List<InvalidLogEntry>
                {
                    new InvalidLogEntry
                    {
                        LogId = 0,
                        Reason = $"Verification error: {ex.Message}"
                    }
                }
            };
            StateHasChanged();
        }
        finally
        {
            isVerifying = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;

        _refreshTimer?.Dispose();
        _refreshTimer = null;

        Logger.LogInformation("Audit Dashboard: Auto-refresh disabled");
    }

    private string GetSeverityClass(AuditSeverity severity)
    {
        return severity switch
        {
            AuditSeverity.Warning => "table-warning",
            AuditSeverity.Error or AuditSeverity.Critical => "table-danger",
            _ => ""
        };
    }

    private string GetSeverityBadgeClass(AuditSeverity severity)
    {
        return severity switch
        {
            AuditSeverity.Info => "bg-success",
            AuditSeverity.Warning => "bg-warning",
            AuditSeverity.Error => "bg-danger",
            AuditSeverity.Critical => "bg-dark",
            _ => "bg-secondary"
        };
    }

    private string GetActionBadgeClass(string action)
    {
        if (action.Contains("SUCCESS") || action.Contains("APPROVED") || action.Contains("CREATED"))
            return "bg-success";
        if (action.Contains("FAILED") || action.Contains("REJECTED") || action.Contains("DELETED"))
            return "bg-danger";
        if (action.Contains("UPDATED") || action.Contains("CHANGED"))
            return "bg-primary";
        if (action.Contains("WARNING") || action.Contains("2FA_DISABLED"))
            return "bg-warning";

        return "bg-secondary";
    }

    private string GetTimelineClass(string action)
    {
        if (action.Contains("FAILED") || action.Contains("REJECTED"))
            return "border-danger";
        return "";
    }

    private string GetActionIcon(string action)
    {
        return action switch
        {
            "LOGIN_SUCCESS" => "bi-box-arrow-in-right",
            "LOGIN_FAILED" => "bi-x-circle",
            "LOGOUT" => "bi-box-arrow-right",
            "PRODUCT_CREATED" => "bi-plus-circle",
            "PRODUCT_UPDATED" => "bi-pencil",
            "PRODUCT_DELETED" => "bi-trash",
            "2FA_ENABLED" => "bi-shield-check",
            "2FA_DISABLED" => "bi-shield-x",
            "PASSWORD_CHANGED" => "bi-key",
            "DATA_EXPORT" => "bi-download",
            "DATA_IMPORT" => "bi-upload",
            _ => "bi-info-circle"
        };
    }

    private string GetActionDisplayName(string action)
    {
        return action switch
        {
            "LOGIN_SUCCESS" => "Login",
            "LOGIN_FAILED" => "Login Fehlgeschlagen",
            "LOGOUT" => "Logout",
            "REGISTER_SUCCESS" => "Registrierung",
            "USER_APPROVED" => "Benutzer Genehmigt",
            "USER_REJECTED" => "Benutzer Abgelehnt",
            "PASSWORD_CHANGED" => "Passwort Geändert",
            "PASSWORD_RESET_REQUEST" => "Passwort-Reset",
            "2FA_ENABLED" => "2FA Aktiviert",
            "2FA_DISABLED" => "2FA Deaktiviert",
            "PRODUCT_CREATED" => "Produkt Erstellt",
            "PRODUCT_UPDATED" => "Produkt Aktualisiert",
            "PRODUCT_DELETED" => "Produkt Gelöscht",
            "CATEGORY_CREATED" => "Kategorie Erstellt",
            "CATEGORY_UPDATED" => "Kategorie Aktualisiert",
            "CATEGORY_DELETED" => "Kategorie Gelöscht",
            "STORAGE_LOCATION_CREATED" => "Lagerplatz Erstellt",
            "STORAGE_LOCATION_UPDATED" => "Lagerplatz Aktualisiert",
            "STORAGE_LOCATION_DELETED" => "Lagerplatz Gelöscht",
            "STOCK_MOVEMENT" => "Lagerbewegung",
            "DATA_EXPORT" => "Daten Export",
            "DATA_IMPORT" => "Daten Import",
            "GDPR_DATA_EXPORT" => "DSGVO Daten-Export",
            "GDPR_ACCOUNT_DELETION" => "DSGVO Kontolöschung",
            "USER_DELETED" => "Benutzer Gelöscht",
            _ => action
        };
    }

    public class ActivityChartData
    {
        public DateTime Date { get; set; }
        public int Count { get; set; }
    }

    public class ActionStat
    {
        public string Action { get; set; } = string.Empty;
        public int Count { get; set; }
    }
}
