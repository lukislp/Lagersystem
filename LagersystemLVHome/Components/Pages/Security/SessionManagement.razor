@page "/admin/session-management"
@rendermode InteractiveServer
@using LagersystemLVHome.Application.Services
@using LagersystemLVHome.Domain.Models
@using LagersystemLVHome.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject ISessionManagementService SessionService
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@inject ILogger<SessionManagement> Logger

<PageTitle>Session Management Dashboard - LagerSystem</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-diagram-3 text-primary me-2"></i>
                Session Management Dashboard
            </h1>
            <p class="text-muted mb-0">
                Active Sessions · VPN Detection · Security Monitoring
                @if (autoRefresh)
                {
                    <span class="badge bg-success ms-2" title="Refreshes every 5 seconds">
                        <i class="bi bi-arrow-clockwise @(isRefreshing ? "rotating" : "")"></i>
                        Live (5s)
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary ms-2">
                        <i class="bi bi-pause-circle"></i> Paused
                    </span>
                }
            </p>
        </div>
        
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="ToggleAutoRefresh">
                <i class="bi bi-@(autoRefresh ? "pause" : "play")-circle"></i>
                @(autoRefresh ? "Pause" : "Resume")
            </button>
            <button class="btn btn-primary" @onclick="ManualRefresh" disabled="@isRefreshing">
                <i class="bi bi-arrow-clockwise @(isRefreshing ? "rotating" : "")"></i>
                Refresh
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Active Sessions</h6>
                                <h3 class="mb-0">@activeSessions.Count</h3>
                                <small class="text-muted">Last 30 minutes</small>
                            </div>
                            <div class="bg-success bg-opacity-10 p-3 rounded">
                                <i class="bi bi-people-fill text-success fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">VPN Detected</h6>
                                <h3 class="mb-0 @(statistics?.VpnSessions > 0 ? "text-warning" : "")">
                                    @(statistics?.VpnSessions ?? 0)
                                </h3>
                                <small class="text-muted">
                                    @((statistics?.VpnSessions > 0 ? (statistics.VpnSessions * 100.0 / Math.Max(1, statistics.TotalSessions)).ToString("F1") : "0"))% of total
                                </small>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded">
                                <i class="bi bi-shield-exclamation text-warning fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Suspicious Sessions</h6>
                                <h3 class="mb-0 @(suspiciousSessions.Count > 0 ? "text-danger" : "")">
                                    @suspiciousSessions.Count
                                </h3>
                                <small class="text-muted">Requires attention</small>
                            </div>
                            <div class="bg-danger bg-opacity-10 p-3 rounded">
                                <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted mb-2">Concurrent Logins</h6>
                                <h3 class="mb-0">@(statistics?.ConcurrentSessions ?? 0)</h3>
                                <small class="text-muted">Multiple devices</small>
                            </div>
                            <div class="bg-info bg-opacity-10 p-3 rounded">
                                <i class="bi bi-diagram-3-fill text-info fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Sessions Table -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-activity text-success me-2"></i>
                    Active Sessions (@activeSessions.Count)
                </h5>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm" placeholder="Search..." @bind="searchQuery" @bind:event="oninput" />
                    <select class="form-select form-select-sm" @bind="filterRiskLevel" @bind:event="onchange">
                        <option value="">All Risk Levels</option>
                        <option value="VeryLow">Very Low</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-0">
                @if (filteredActiveSessions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Location</th>
                                    <th>Device</th>
                                    <th>Fingerprint</th>
                                    <th>Browser</th>
                                    <th>VPN Status</th>
                                    <th>Risk Level</th>
                                    <th>Duration</th>
                                    <th>Activity</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in filteredActiveSessions)
                                {
                                    var duration = DateTime.UtcNow - session.StartTime;
                                    var timeSinceActivity = DateTime.UtcNow - session.LastActivity;
  
                                    <tr class="@(session.IsSuspicious ? "table-danger" : "")">
                                        <td data-label="User">
                                            <div class="d-flex align-items-center gap-2">
                                                @if (session.IsActive)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-circle-fill" style="font-size: 6px;"></i>
                                                    </span>
                                                }
                                                <div>
                                                    <div class="fw-semibold">@session.Username</div>
                                                    <small class="text-muted">@session.Warehouse?.Name</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td data-label="Location">
                                            <div>
                                                @if (!string.IsNullOrEmpty(session.Country))
                                                {
                                                    <div>
                                                        <i class="bi bi-geo-alt me-1"></i>
                                                        @session.City, @session.Country
                                                    </div>
                                                }
                                                <small class="text-muted">@session.IpAddress</small>
                                            </div>
                                        </td>
                                        <td data-label="Device">
                                            <div>
                                                <i class="bi bi-@GetDeviceIcon(session.DeviceType) me-1"></i>
                                                @session.DeviceType
                                            </div>
                                            <small class="text-muted">@session.Browser</small>
                                        </td>
                                        <td data-label="Fingerprint">
                                            @if (!string.IsNullOrEmpty(session.DeviceFingerprint))
                                            {
                                                <code class="small text-muted" title="@session.DeviceFingerprint">
                                                    @session.DeviceFingerprint.Substring(0, Math.Min(12, session.DeviceFingerprint.Length))...
                                                </code>
                                                <div class="small text-muted">
                                                    <i class="bi bi-fingerprint"></i> @(session.DeviceInfo ?? "Unknown")
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td data-label="Browser">
                                            @session.Browser
                                            <div class="small text-muted">@session.OperatingSystem</div>
                                        </td>
                                        <td data-label="VPN Status">
                                            @if (session.IsVpn)
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-shield-exclamation"></i>
                                                    VPN
                                                </span>
                                            }
                                            else if (session.IsProxy)
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-shuffle"></i>
                                                    Proxy
                                                </span>
                                            }
                                            else if (session.IsTor)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-incognito"></i>
                                                    TOR
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-shield-check"></i>
                                                    Direct
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(session.VpnProvider))
                                            {
                                                <div>
                                                    <small class="text-muted">@session.VpnProvider</small>
                                                </div>
                                            }
                                        </td>
                                        <td data-label="Risk Level">
                                            @GetRiskBadge(session.RiskLevel)
                                            @if (session.IsSuspicious)
                                            {
                                                <div class="text-danger small">
                                                    <i class="bi bi-exclamation-triangle"></i>
                                                    Suspicious
                                                </div>
                                            }
                                        </td>
                                        <td data-label="Duration">
                                            <div>@FormatDuration(duration)</div>
                                            <small class="text-muted">
                                                Active @FormatDuration(timeSinceActivity) ago
                                            </small>
                                        </td>
                                        <td data-label="Activity">
                                            @if (session.DeviceType == "API")
                                            {
                                                <div>@session.ApiRequestsCount requests</div>
                                                <small class="text-muted">
                                                    @if (!string.IsNullOrEmpty(session.LastPageUrl) && session.LastPageUrl.StartsWith("/api"))
                                                    {
                                                        <code>@session.LastPageUrl</code>
                                                    }
                                                    else
                                                    {
                                                        <text>API Key: @session.Browser</text>
                                                    }
                                                </small>
                                            }
                                            else
                                            {
                                                <div>@session.PageViewsCount views</div>
                                                <small class="text-muted">@session.LastPageUrl</small>
                                            }
                                        </td>
                                        <td data-label="Actions">
                                            <div class="d-flex gap-1 justify-content-start">
                                                <button class="btn btn-outline-primary btn-sm" @onclick="() => ViewSessionDetails(session)" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </button>

                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => ShowForceLogoutModal(session)" title="Force Logout">
                                                    <i class="bi bi-box-arrow-right"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state p-5">
                        <div class="empty-state-icon">👥</div>
                        <div class="empty-state-title">No Active Sessions</div>
                        <p class="text-muted">There are currently no active user sessions.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Suspicious Sessions Alert -->
        @if (suspiciousSessions.Any())
        {
            <div class="card border-danger shadow-sm mb-4">
                <div class="card-header bg-danger bg-opacity-10 text-danger">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Suspicious Sessions Detected (@suspiciousSessions.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Reason</th>
                                    <th>Risk Score</th>
                                    <th>Last Activity</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in suspiciousSessions.Take(10))
                                {
                                    <tr>
                                        <td data-label="User">
                                            <div class="fw-semibold">@session.Username</div>
                                            <small class="text-muted">@session.IpAddress</small>
                                        </td>
                                        <td data-label="Reason">
                                            <div class="text-danger">@session.SuspiciousReason</div>
                                        </td>
                                        <td data-label="Risk Score">
                                            @GetRiskBadge(session.RiskLevel)
                                        </td>
                                        <td data-label="Last Activity">
                                            @FormatRelativeTime(session.LastActivity)
                                        </td>
                                        <td data-label="Actions">
                                            <button class="btn btn-sm btn-danger" @onclick="() => ShowForceLogoutModal(session)">
                                                <i class="bi bi-x-circle"></i>
                                                Terminate
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Statistics -->
        @if (statistics != null)
        {
            <div class="row g-3 mb-4">
                <!-- Device Types -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent">
                            <h5 class="mb-0">Device Types</h5>
                        </div>
                        <div class="card-body">
                            @if (statistics.DeviceTypes.Any())
                            {
                                <canvas id="deviceChart" style="max-height: 300px;"></canvas>
                            }
                            else
                            {
                                <p class="text-muted text-center">No device data available</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Risk Level Distribution -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent">
                            <h5 class="mb-0">Risk Level Distribution</h5>
                        </div>
                        <div class="card-body">
                            @if (statistics.RiskLevelDistribution.Any())
                            {
                                <canvas id="riskChart" style="max-height: 300px;"></canvas>
                            }
                            else
                            {
                                <p class="text-muted text-center">No risk data available</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top Countries -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0">
                        <i class="bi bi-geo-alt text-primary me-2"></i>
                        Top Countries
                    </h5>
                </div>
                <div class="card-body">
                    @if (statistics.TopCountries.Any())
                    {
                        <div class="row">
                            @foreach (var country in statistics.TopCountries.Take(10))
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>@country.Key</span>
                                        <span class="badge bg-primary">@country.Value sessions</span>
                                    </div>
                                    <div class="progress mt-1" style="height: 6px;">
                                        <div class="progress-bar" role="progressbar"
                                             style="width: @((country.Value * 100.0 / statistics.TopCountries.Max(c => c.Value)).ToString("F0"))%">
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No country data available</p>
                    }
                </div>
            </div>
        }

        <!-- Security Events -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent">
                <h5 class="mb-0">
                    <i class="bi bi-shield-exclamation text-warning me-2"></i>
                    Recent Security Events
                </h5>
            </div>
            <div class="card-body p-0">
                @if (securityEvents.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Event</th>
                                    <th>User</th>
                                    <th>Severity</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var evt in securityEvents.Take(20))
                                {
                                    <tr>
                                        <td data-label="Time">@FormatRelativeTime(evt.Timestamp)</td>
                                        <td data-label="Event">
                                            <code>@evt.EventType</code>
                                        </td>
                                        <td data-label="User">
                                            @if (evt.User != null)
                                            {
                                                <span>@evt.User.Username</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">System</span>
                                            }
                                        </td>
                                        <td data-label="Severity">
                                            @GetSeverityBadge(evt.Severity)
                                        </td>
                                        <td data-label="Details">
                                            <small class="text-muted">@evt.Description</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state p-5">
                        <div class="empty-state-icon">🛡️</div>
                        <div class="empty-state-title">No Security Events</div>
                        <p class="text-muted">All systems are operating normally.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Force Logout Modal -->
@if (showForceLogoutModal && selectedSession != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-box-arrow-right text-danger me-2"></i>
                        Force Logout
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseForceLogoutModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        This will immediately terminate the user's session.
                    </div>
 
                    <div class="mb-3">
                        <strong>User:</strong> @selectedSession.Username<br>
                        <strong>IP:</strong> @selectedSession.IpAddress<br>
                        <strong>Device:</strong> @selectedSession.DeviceType
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reason for logout:</label>
                        <textarea class="form-control" rows="3" @bind="forceLogoutReason"
                                  placeholder="Enter reason..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseForceLogoutModal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmForceLogout">
                        <i class="bi bi-x-circle me-1"></i>
                        Force Logout
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Session details modal -->
@if (showSessionDetailsModal && selectedSession != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Session Details
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseSessionDetailsModal"></button>
                </div>
                <div class="modal-body">
                    <!-- User Info -->
                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-person me-2"></i>User Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Username</label>
                                <div class="fw-semibold">@selectedSession.Username</div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Warehouse</label>
                                <div>@selectedSession.Warehouse?.Name</div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Session ID</label>
                                <div><code class="small">@selectedSession.SessionId</code></div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Status</label>
                                <div>
                                    @if (selectedSession.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Location & Device -->
                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-geo-alt me-2"></i>Location & Device
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small">IP Address</label>
                                <div><code>@selectedSession.IpAddress</code></div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Location</label>
                                <div>
                                    @if (!string.IsNullOrEmpty(selectedSession.Country))
                                    {
                                        <span>@selectedSession.City, @selectedSession.Country</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Device Type</label>
                                <div>
                                    <i class="bi bi-@GetDeviceIcon(selectedSession.DeviceType) me-1"></i>
                                    @selectedSession.DeviceType
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Browser</label>
                                <div>@selectedSession.Browser</div>
                            </div>
                            <div class="col-md-12">
                                <label class="text-muted small">User Agent</label>
                                <div class="small text-break">@selectedSession.UserAgent</div>
                            </div>
                        </div>
                    </div>

                    <!-- Security Info -->
                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-shield me-2"></i>Security Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small">VPN Status</label>
                                <div>
                                    @if (selectedSession.IsVpn)
                                    {
                                        <span class="badge bg-warning">
                                            <i class="bi bi-shield-exclamation"></i> VPN Detected
                                        </span>
                                        @if (!string.IsNullOrEmpty(selectedSession.VpnProvider))
                                        {
                                            <div class="small text-muted mt-1">Provider: @selectedSession.VpnProvider</div>
                                        }
                                    }
                                    else if (selectedSession.IsProxy)
                                    {
                                        <span class="badge bg-warning">
                                            <i class="bi bi-shuffle"></i> Proxy
                                        </span>
                                    }
                                    else if (selectedSession.IsTor)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-incognito"></i> TOR Network
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-shield-check"></i> Direct Connection
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Risk Level</label>
                                <div>@GetRiskBadge(selectedSession.RiskLevel)</div>
                            </div>
                            @if (selectedSession.IsSuspicious)
                            {
                                <div class="col-md-12">
                                    <div class="alert alert-danger mb-0">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        <strong>Suspicious Activity Detected</strong>
                                        <div class="mt-2">@selectedSession.SuspiciousReason</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Activity Stats -->
                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-activity me-2"></i>Activity Statistics
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="text-muted small">Session Duration</label>
                                <div class="fw-semibold">@FormatDuration(DateTime.UtcNow - selectedSession.StartTime)</div>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small">Last Activity</label>
                                <div>@FormatRelativeTime(selectedSession.LastActivity)</div>
                            </div>
                            <div class="col-md-4">
                                @if (selectedSession.DeviceType == "API")
                                {
                                    <label class="text-muted small">API Requests</label>
                                    <div class="fw-semibold">@selectedSession.ApiRequestsCount</div>
                                }
                                else
                                {
                                    <label class="text-muted small">Page Views</label>
                                    <div class="fw-semibold">@selectedSession.PageViewsCount</div>
                                }
                            </div>
                            <div class="col-md-12">
                                @if (selectedSession.DeviceType == "API")
                                {
                                    <label class="text-muted small">API Key</label>
                                    <div><code class="small">@selectedSession.Browser</code></div>
    
                                    @if (!string.IsNullOrEmpty(selectedSession.LastPageUrl) && selectedSession.LastPageUrl.StartsWith("/api"))
                                    {
                                        <label class="text-muted small mt-2">Last API Endpoint</label>
                                        <div><code class="small">@selectedSession.LastPageUrl</code></div>
                                    }
                                }
                                else
                                {
                                    <label class="text-muted small">Last Page</label>
                                    <div><code class="small">@selectedSession.LastPageUrl</code></div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Timestamps -->
                    <div>
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-clock me-2"></i>Timestamps
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Session Start</label>
                                <div>@selectedSession.StartTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Last Activity</label>
                                <div>@selectedSession.LastActivity.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseSessionDetailsModal">
                        Close
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="() => { CloseSessionDetailsModal(); ShowForceLogoutModal(selectedSession); }">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Force Logout
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<Domain.Models.UserSession> activeSessions = new();
    private List<Domain.Models.UserSession> suspiciousSessions = new();
    private List<Domain.Models.SecurityEvent> securityEvents = new();
    private SessionStatistics? statistics;
 
    private string searchQuery = "";
    private string filterRiskLevel = "";
    private bool loading = false; // only true on initial load
    private bool isInitialLoad = true;
    private bool autoRefresh = true;
    private bool isRefreshing = false;
    private bool hasRendered = false;
 
    private bool showForceLogoutModal = false;
    private bool showSessionDetailsModal = false;
    private Domain.Models.UserSession? selectedSession;
    private string forceLogoutReason = "";
    
    private System.Threading.Timer? refreshTimer;
    // Separate timer for live duration updates (UI only)
    private System.Threading.Timer? durationUpdateTimer;
    private bool _disposed = false;
    
    // Previous values for change detection
    private int _previousActiveSessions = 0;
    private int _previousSuspiciousSessions = 0;
    private int _previousVpnSessions = 0;
    private int _previousSecurityEvents = 0;
 
    private IEnumerable<Domain.Models.UserSession> filteredActiveSessions =>
        activeSessions
    .Where(s => string.IsNullOrEmpty(searchQuery) ||
    s.Username.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (s.IpAddress?.Contains(searchQuery) ?? false))
            .Where(s => string.IsNullOrEmpty(filterRiskLevel) ||
s.RiskLevel.ToString() == filterRiskLevel);
    
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        StartAutoRefresh();
        StartDurationUpdateTimer(); // NEU
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            hasRendered = true;
            
            if (statistics != null)
            {
                await RenderChartsAsync();
            }
        }
    }
    
    // Separate timer for duration updates only (no data reload)
    private void StartDurationUpdateTimer()
    {
        if (_disposed || durationUpdateTimer != null) return;
        
        Logger.LogInformation("Session Management: Live Duration Update Timer aktiviert (1s Intervall)");
        
        durationUpdateTimer = new System.Threading.Timer(async _ =>
        {
            if (!_disposed && hasRendered && activeSessions.Any())
            {
                try
                {
                    await InvokeAsync(() =>
    {
        if (_disposed) return;
  
        // IMPORTANT: just call StateHasChanged()
        // No data load, just re-render UI for computed values
        StateHasChanged();
    });
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error during duration update");
                }
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }
  
    // Smart auto-refresh (loads data)
    private void StartAutoRefresh()
    {
        if (_disposed || refreshTimer != null) return;

        Logger.LogInformation("Session Management: Smart Auto-Refresh aktiviert (5s Intervall)");
  
        refreshTimer = new System.Threading.Timer(async _ =>
    {
        if (autoRefresh && !isRefreshing && !_disposed)
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    await LoadDataSilent();
                });
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error during auto-refresh");
            }
        }
    }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }
    
    // Silent load with change detection
    private async Task LoadDataSilent()
    {
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            var warehouseId = currentUser?.Role == UserRole.SuperAdmin ? null : (int?)currentUser?.WarehouseId;
 
            // Load fresh data
            var newActiveSessions = await SessionService.GetActiveSessionsAsync(warehouseId);
            var newSuspiciousSessions = await SessionService.GetSuspiciousSessionsAsync(warehouseId);
            var newSecurityEvents = await SessionService.GetSecurityEventsAsync(warehouseId, 50);
            var newStatistics = await SessionService.GetSessionStatisticsAsync(warehouseId);
    
            // Change detection including LastActivity changes
            bool hasChanges = false;
          
            // 1. Check count changes
            if (newActiveSessions.Count != _previousActiveSessions ||
                newSuspiciousSessions.Count != _previousSuspiciousSessions ||
                        (newStatistics?.VpnSessions ?? 0) != _previousVpnSessions ||
                        newSecurityEvents.Count != _previousSecurityEvents)
            {
                hasChanges = true;
                Logger.LogInformation("Count change detected - Active: {Active}, Suspicious: {Suspicious}, VPN: {VPN}",
                newActiveSessions.Count, newSuspiciousSessions.Count, newStatistics?.VpnSessions ?? 0);
            }
   
            // 2. Check content changes in active sessions
            // (LastActivity, IP, Country, VPN-Status)
            if (!hasChanges && newActiveSessions.Count > 0 && activeSessions.Count > 0)
            {
                // Vergleiche LastActivity der ersten 5 Sessions (Performance)
                var significantSessions = newActiveSessions.Take(5).ToList();
                var oldSignificantSessions = activeSessions.Take(5).ToList();
        
                foreach (var newSession in significantSessions)
                {
                    var oldSession = oldSignificantSessions.FirstOrDefault(s => s.SessionId == newSession.SessionId);
                    if (oldSession != null)
                    {
                        // Check LastActivity (significant change = > 1 second)
                        if ((newSession.LastActivity - oldSession.LastActivity).TotalSeconds > 1)
                        {
                            hasChanges = true;
                            Logger.LogDebug("Activity change detected for session {SessionId}", newSession.SessionId);
                            break;
                        }
          
                        // Check IP change
                        if (newSession.IpAddress != oldSession.IpAddress)
                        {
                            hasChanges = true;
                            Logger.LogInformation("IP change detected: {Old} → {New}", oldSession.IpAddress, newSession.IpAddress);
                            break;
                        }
            
                        // Check country change (VPN switch)
                        if (newSession.Country != oldSession.Country)
                        {
                            hasChanges = true;
                            Logger.LogInformation("Location change detected: {Old} → {New}", oldSession.Country, newSession.Country);
                            break;
                        }
         
                        // Check VPN status change
                        if (newSession.IsVpn != oldSession.IsVpn)
                        {
                            hasChanges = true;
                            Logger.LogInformation("VPN status change detected for session {SessionId}", newSession.SessionId);
                            break;
                        }
                    }
                }
            }
     
            if (hasChanges)
            {
                // Update data
                activeSessions = newActiveSessions;
                suspiciousSessions = newSuspiciousSessions;
                securityEvents = newSecurityEvents;
                statistics = newStatistics;
              
                // Update previous values
                _previousActiveSessions = newActiveSessions.Count;
                _previousSuspiciousSessions = newSuspiciousSessions.Count;
                _previousVpnSessions = newStatistics?.VpnSessions ?? 0;
                _previousSecurityEvents = newSecurityEvents.Count;
    
                // Re-render charts
                if (hasRendered && statistics != null)
                {
                    await RenderChartsAsync();
                }
      
                StateHasChanged();
            }
            else
            {
                // Refresh data WITHOUT StateHasChanged() anyway (prevents flicker)
                activeSessions = newActiveSessions;
                suspiciousSessions = newSuspiciousSessions;
                securityEvents = newSecurityEvents;
                statistics = newStatistics;
            
                Logger.LogDebug("✓ Session Management: Data refreshed silently (no UI changes)");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading session data (silent)");
        }
    }
    
    private void ToggleAutoRefresh()
    {
        autoRefresh = !autoRefresh;
        Logger.LogInformation("Auto-refresh {Status}", autoRefresh ? "enabled" : "disabled");
    }
    
    private async Task ManualRefresh()
    {
        if (isRefreshing) return;
     
        try
        {
            isRefreshing = true;
            StateHasChanged();
   
            Logger.LogInformation("Manual refresh triggered");
            await LoadDataAsync();
        }
        finally
        {
            isRefreshing = false;
            StateHasChanged();
        }
    }
    
    // Manual load (with spinner)
    private async Task LoadDataAsync()
    {
        if (isInitialLoad)
        {
            loading = true;
            StateHasChanged();
        }
        
        try
        {
            await LoadDataSilent();
        }
        finally
        {
            loading = false;
            isInitialLoad = false;
            StateHasChanged();
        }
    }
    
    private async Task RenderChartsAsync()
    {
        if (statistics == null) return;
        
        if (!hasRendered)
        {
            Logger.LogWarning("Charts rendering skipped - component not fully rendered yet");
            return;
        }
   
        try
        {
            var deviceLabels = statistics.DeviceTypes.Keys.ToArray();
            var deviceData = statistics.DeviceTypes.Values.ToArray();

            if (deviceLabels.Length > 0 && deviceData.Length > 0)
            {
                await JSRuntime.InvokeVoidAsync("SessionCharts.renderDeviceChart", deviceLabels, deviceData);
            }
       
            var riskLabels = statistics.RiskLevelDistribution.Keys.ToArray();
            var riskData = statistics.RiskLevelDistribution.Values.ToArray();
      
            if (riskLabels.Length > 0 && riskData.Length > 0)
            {
                await JSRuntime.InvokeVoidAsync("SessionCharts.renderRiskChart", riskLabels, riskData);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rendering charts");
        }
    }
    
    // Open session details modal
    private void ViewSessionDetails(Domain.Models.UserSession session)
    {
        selectedSession = session;
        showSessionDetailsModal = true;
        Logger.LogInformation("Viewing session details: {SessionId}", session.SessionId);
    }
    
    // Close session details modal
    private void CloseSessionDetailsModal()
    {
        showSessionDetailsModal = false;
    }
    
    private void ShowForceLogoutModal(Domain.Models.UserSession session)
    {
        selectedSession = session;
        forceLogoutReason = "";
        showForceLogoutModal = true;
    }
    
    private void CloseForceLogoutModal()
    {
        showForceLogoutModal = false;
        selectedSession = null;
        forceLogoutReason = "";
    }
    
    private async Task ConfirmForceLogout()
    {
        if (selectedSession == null) return;
        
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) return;
            
            await SessionService.ForceLogoutAsync(selectedSession.SessionId, currentUser.Id, forceLogoutReason);
    
            Logger.LogWarning("Admin {AdminId} forced logout of session {SessionId}",
            currentUser.Id, selectedSession.SessionId);
   
            await JSRuntime.InvokeVoidAsync("alert", "Session terminated successfully");
            
            CloseForceLogoutModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error forcing logout");
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }
    
    private string GetDeviceIcon(string? deviceType)
    {
        return deviceType?.ToLower() switch
        {
            "mobile" => "phone",
            "tablet" => "tablet",
            "desktop" => "laptop",
            _ => "device-ssd"
        };
    }
    
    private RenderFragment GetRiskBadge(SessionRiskLevel level)
    {
        var (badgeClass, icon, text) = level switch
        {
            SessionRiskLevel.Critical => ("bg-danger", "x-circle", "Critical"),
            SessionRiskLevel.High => ("bg-warning", "exclamation-triangle", "High"),
            SessionRiskLevel.Medium => ("bg-info", "info-circle", "Medium"),
            SessionRiskLevel.Low => ("bg-secondary", "dash-circle", "Low"),
            _ => ("bg-success", "check-circle", "Very Low")
        };
  
        return @<span class="badge @badgeClass">
            <i class="bi bi-@icon"></i>
            @text
        </span>;
    }

    private RenderFragment GetSeverityBadge(SecurityEventSeverity severity)
    {
        var (badgeClass, text) = severity switch
        {
            SecurityEventSeverity.Critical => ("bg-danger", "Critical"),
            SecurityEventSeverity.High => ("bg-warning", "High"),
            SecurityEventSeverity.Medium => ("bg-info", "Medium"),
            SecurityEventSeverity.Low => ("bg-secondary", "Low"),
            _ => ("bg-light text-dark", "Info")
        };
      
        return @<span class="badge @badgeClass">@text</span>;
    }
  
    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMinutes < 1)
            return $"{(int)duration.TotalSeconds}s";
        if (duration.TotalHours < 1)
            return $"{(int)duration.TotalMinutes}m";
        if (duration.TotalDays < 1)
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        return $"{(int)duration.TotalDays}d {duration.Hours}h";
    }
    
    private string FormatRelativeTime(DateTime dateTime)
    {
        var diff = DateTime.UtcNow - dateTime;
        
        if (diff.TotalMinutes < 1)
            return "Just now";
        if (diff.TotalHours < 1)
            return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1)
            return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }
    
    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        
        Logger.LogInformation("Session Management: Auto-refresh disabled");
        
        // Beide Timer stoppen
        refreshTimer?.Dispose();
        refreshTimer = null;
        
        durationUpdateTimer?.Dispose();
        durationUpdateTimer = null;
    }
}
