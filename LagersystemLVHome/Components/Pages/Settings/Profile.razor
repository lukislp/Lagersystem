        passwordMessage = "Recovery-Codes in Zwischenablage kopiert!";
        passwordSuccess = true;
        StateHasChanged();
    }

    private void Format2FACode(ChangeEventArgs e)
    {
        if (e.Value == null) return;

        var input = e.Value.ToString()!.Replace(" ", "").Replace("-", "");
        if (input.Length <= 6)
        {
            verification2FACode = input;
        }
    }

    // ============================================
