@using LagersystemLVHome.Application.Services
@inject I18nText I18nText

<div class="row g-3">
    <!-- Pfade -->
    <div class="col-12">
        <label class="form-label">
            <i class="bi bi-folder me-1"></i>
            @T.BackupProvider_Label_BackupPaths
        </label>

        @foreach (var (path, index) in Config.Paths.Select((p, i) => (p, i)))
        {
            <div class="input-group mb-2">
                <span class="input-group-text">@(index + 1)</span>
                <input type="text" class="form-control" @bind="Config.Paths[index]" @bind:event="oninput"
                       placeholder="C:\Backups\LagerSystem" />

                <button type="button" class="btn btn-outline-primary" @onclick="() => OnSelectFolder.InvokeAsync(index)"
                        title="@T.BackupProvider_SelectFolder">
                    <i class="bi bi-folder2-open"></i>
                </button>

                <button type="button" class="btn btn-outline-info" @onclick="OnShowPathExamples"
                        title="@T.BackupProvider_ShowPathExamples">
                    <i class="bi bi-question-circle"></i>
                </button>

                <button type="button" class="btn btn-outline-danger" @onclick="() => RemovePath(index)"
                        disabled="@(Config.Paths.Count <= 1)">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        }

        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddPath">
            <i class="bi bi-plus-circle me-1"></i>
            @T.BackupProvider_AddPath
        </button>

        <div class="alert alert-info mt-3 mb-0">
            <div class="d-flex align-items-start">
                <i class="bi bi-info-circle me-2 mt-1"></i>
                <div>
                    <strong><i class="bi bi-shield-check"></i> @T.BackupProvider_BrowserSecurity</strong>
                    <p class="mb-2">@T.BackupProvider_BrowserSecurityText</p>
                    <p class="mb-2"><strong>@T.BackupProvider_HowToFindPath</strong></p>
                    <ol class="mb-2">
                        <li>@(T.BackupProvider_Local_Step1 ?? "Ordner im Windows Explorer öffnen")</li>
                        <li>@(T.BackupProvider_Local_Step2 ?? "Adressleiste anklicken oder Strg+L drücken")</li>
                        <li>@(T.BackupProvider_Local_Step4 ?? "Hier einfügen")</li>
                    </ol>
                    <p class="mb-0">
                        @(T.BackupProvider_Local_Tip ?? "Tipp: Rechtsklick auf Ordner - Als Pfad kopieren")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Max Backups -->
    <div class="col-md-6">
        <label class="form-label">
            <i class="bi bi-file-earmark-zip me-1"></i>
            @T.BackupProvider_Label_MaxBackups
        </label>
        <input type="number" class="form-control" @bind="Config.MaxBackups" min="1" max="100" />
        <small class="text-muted">@T.BackupProvider_MaxBackupsHint</small>
    </div>

    <!-- Ordnerstruktur -->
    <div class="col-12">
        <label class="form-label d-block mb-2">
            <i class="bi bi-folder-plus me-1"></i>
            @T.BackupProvider_Label_FolderStructure
        </label>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" @bind="Config.CreateDateSubfolders" id="dateSubfolders" />
                    <label class="form-check-label" for="dateSubfolders">
                        <i class="bi bi-calendar-month me-1"></i>
                        @T.BackupProvider_CreateDateSubfolders
                    </label>
                </div>
                <small class="text-muted d-block ms-4">@T.BackupProvider_DateSubfoldersHint</small>
            </div>

            <div class="col-md-6">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" @bind="Config.CreateWeekSubfolders"
                           id="weekSubfolders" disabled="@(!Config.CreateDateSubfolders)" />
                    <label class="form-check-label" for="weekSubfolders">
                        <i class="bi bi-calendar-week me-1"></i>
                        @T.BackupProvider_CreateWeekSubfolders
                    </label>
                </div>
                <small class="text-muted d-block ms-4">
                    @if (Config.CreateDateSubfolders)
                    {
                        <text>@(T.BackupProvider_Local_WeekSubfolderHint_Active ?? "Erstellt Unterordner: YYYY-MM/Woche-XX")</text>
                    }
                    else
                    {
                        <text>@(T.BackupProvider_Local_WeekSubfolderHint_Inactive ?? "Benötigt aktivierte Datum-Unterordner")</text>
                    }
                </small>
            </div>
        </div>
    </div>
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    [Parameter] public LocalBackupConfig Config { get; set; } = new();
    [Parameter] public EventCallback<LocalBackupConfig> ConfigChanged { get; set; }
    [Parameter] public EventCallback<int> OnSelectFolder { get; set; }
    [Parameter] public EventCallback OnShowPathExamples { get; set; }

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    private void AddPath()
    {
        Config.Paths.Add("C:\\Backups\\LagerSystem");
        ConfigChanged.InvokeAsync(Config);
    }

    private void RemovePath(int index)
    {
        if (Config.Paths.Count > 1)
        {
            Config.Paths.RemoveAt(index);
            ConfigChanged.InvokeAsync(Config);
        }
    }
}
