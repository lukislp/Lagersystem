    // Revoke Consent Modal
    private bool showRevokeConsentModal = false;
    private string revokeConsentType = "";

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadData();
    }

    private async Task LoadData()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
   
        if (currentUser != null)
        {
            currentUser = await UserProfileService.GetUserWithWarehouseAsync(currentUser.Id);

            if (currentUser != null)
            {
                warehouseUserCount = await UserProfileService.CountActiveUsersInWarehouseAsync(currentUser.WarehouseId);
            }

            // Load current session id
            currentSessionId = await AuthService.GetCurrentSessionIdAsync();

            // Load API keys
            if (currentUser != null)
            {
                apiKeys = await ApiKeyService.GetUserApiKeysAsync(currentUser.Id);
            }
        }
    }

    private async Task HandlePasswordChange()
    {
        isChangingPassword = true;
        passwordMessage = string.Empty;
        passwordSuccess = false;

        try
        {
            if (currentUser == null)
            {
                passwordMessage = "Benutzer nicht gefunden.";
                return;
            }

            if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
            {
                passwordMessage = T.Profile_Password_NoMatch;
                return;
            }

            // Verify password against the Pwned Passwords API
            var pwnedResult = await PwnedPasswordService.CheckPasswordAsync(passwordModel.NewPassword);
 
            if (pwnedResult.IsCompromised)
            {
                // Password was found in a data leak
                passwordMessage = $"{pwnedResult.Message}\n\n" +
            "Aus Sicherheitsgründen empfehlen wir dringend ein anderes Passwort zu wählen. " +
            "Dieses Passwort ist öffentlich bekannt und kann leicht erraten werden.";
                passwordSuccess = false;

                // Show additional warning as alert
                await JSRuntime.InvokeVoidAsync("alert",
        $"SICHERHEITSWARNUNG\n\n{pwnedResult.Message}\n\n" +
            "Dieses Passwort wurde in einem öffentlichen Datenleck gefunden!\n\n" +
            "Bitte wählen Sie ein anderes, sicheres Passwort.");
         
                return;
            }

            var success = await PasswordResetService.ChangePasswordAsync(
            currentUser.Id,
                passwordModel.OldPassword,
                passwordModel.NewPassword
        );

            if (success)
            {
                passwordMessage = T.Profile_Password_Success;
      
                // Show a positive message when the password is safe
                if (!string.IsNullOrEmpty(pwnedResult.Message))
                {
                    passwordMessage += $"\n{pwnedResult.Message}";
                }
      
                passwordSuccess = true;
                passwordModel = new PasswordChangeModel();
            }
            else
            {
                passwordMessage = "Das aktuelle Passwort ist falsch.";
            }
        }
        catch (Exception ex)
        {
            passwordMessage = string.Format(T.Profile_Password_Error, ex.Message);
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    // GDPR methods
    private async Task RevokeMarketingConsent()
    {
        if (currentUser == null) return;

        try
        {
            var success = await UserProfileService.RevokeMarketingConsentAsync(currentUser.Id);
            if (success)
            {
                currentUser.MarketingConsent = false;
                currentUser.MarketingConsentDate = null;
                passwordMessage = "Marketing-Einwilligung wurde widerrufen.";
                passwordSuccess = true;
            }
            else
            {
                passwordMessage = "Fehler beim Widerrufen.";
                passwordSuccess = false;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            passwordMessage = $"Fehler: {ex.Message}";
            passwordSuccess = false;
        }
    }

    private async Task ExportMyData()
    {
        if (currentUser == null) return;

        isExporting = true;
        passwordMessage = string.Empty;

        try
        {
            var export = await GdprService.ExportUserDataAsync(currentUser.Id);
            var json = export.ToJson();
   
            var fileName = $"meine-daten-{DateTime.Now:yyyyMMdd-HHmmss}.json";

            await JSRuntime.InvokeVoidAsync(
                "fileDownload.downloadText",
                json,
                fileName,
                "application/json;charset=utf-8",
                false);

            passwordMessage = "Daten erfolgreich exportiert!";
            passwordSuccess = true;
        }
        catch (Exception ex)
        {
            passwordMessage = $"Fehler beim Exportieren: {ex.Message}";
            passwordSuccess = false;
        }
        finally
        {
            isExporting = false;
        }
    }

    private void ConfirmDeleteAccount()
    {
        showDeleteConfirmation = true;
    }

    private async Task DeleteMyAccount()
    {
        if (currentUser == null) return;

        isDeleting = true;

        try
        {
            await GdprService.DeleteUserAccountAsync(currentUser.Id, "Benutzer-Wunsch", hardDelete: false);
            await AuthService.LogoutAsync();
            NavigationManager.NavigateTo("/logout", forceLoad: true);
        }
        catch (Exception ex)
        {
            passwordMessage = $"Fehler beim Löschen: {ex.Message}";
            passwordSuccess = false;
            showDeleteConfirmation = false;
            isDeleting = false;
        }
    }

    // 2FA methods
    private void StartEnable2FA()
    {
        twoFactorSecret = TwoFactorService.GenerateSecret();
        qrCodeUrl = TwoFactorService.GenerateQrCodeUrl(
        currentUser!.Username,
    twoFactorSecret
            );
        verification2FACode = "";
        twoFactorErrorMessage = "";
        show2FASetup = true;
    }

    private async Task ConfirmEnable2FA()
    {
        if (currentUser == null) return;

        isProcessing2FA = true;
        twoFactorErrorMessage = "";

        try
        {
            var success = await TwoFactorManagementService.Enable2FAAsync(
                            currentUser.Id,
                twoFactorSecret,
                    verification2FACode
                    );

            if (success)
            {
                // Load recovery codes (force reload because Enable2FAAsync saves via a different DbContext)
                var recoveryCodesJson = await UserProfileService.GetTwoFactorRecoveryCodesAsync(currentUser.Id);
                if (!string.IsNullOrEmpty(recoveryCodesJson))
                {
                    recoveryCodes = System.Text.Json.JsonSerializer.Deserialize<List<string>>(recoveryCodesJson);
                }

                currentUser.TwoFactorEnabled = true;
                currentUser.TwoFactorSecret = twoFactorSecret;
                currentUser.TwoFactorRecoveryCodes = recoveryCodesJson;

                show2FASetup = false;
                showRecoveryCodesModal = true;

                passwordMessage = "2FA erfolgreich aktiviert!";
                passwordSuccess = true;
            }
            else
            {
                twoFactorErrorMessage = "Ungültiger Code! Bitte überprüfen Sie den Code in Ihrer Authenticator-App.";
            }
        }
        catch (Exception ex)
        {
            twoFactorErrorMessage = $"Fehler: {ex.Message}";
        }
        finally
        {
            isProcessing2FA = false;
        }
    }

    private void Cancel2FASetup()
    {
        show2FASetup = false;
        verification2FACode = "";
        twoFactorErrorMessage = "";
    }

    private void StartDisable2FA()
    {
        disable2FAPassword = "";
        twoFactorErrorMessage = "";
        show2FADisable = true;
    }

    private async Task ConfirmDisable2FA()
    {
        if (currentUser == null) return;

        isProcessing2FA = true;
        twoFactorErrorMessage = "";

        try
        {
            var success = await TwoFactorManagementService.Disable2FAAsync(
                    currentUser.Id,
                disable2FAPassword
                    );

            if (success)
            {
                currentUser.TwoFactorEnabled = false;
                currentUser.TwoFactorSecret = null;
                currentUser.TwoFactorRecoveryCodes = null;

                show2FADisable = false;

                passwordMessage = "2FA erfolgreich deaktiviert.";
                passwordSuccess = true;
            }
            else
            {
                twoFactorErrorMessage = "Falsches Passwort!";
            }
        }
        catch (Exception ex)
        {
            twoFactorErrorMessage = $"Fehler: {ex.Message}";
        }
        finally
        {
            isProcessing2FA = false;
        }
    }

    private async Task ShowRecoveryCodes()
    {
        if (currentUser == null) return;

        // Force reload from DB (currentUser could be stale)
        var recoveryCodesJson = await UserProfileService.GetTwoFactorRecoveryCodesAsync(currentUser.Id);
        if (!string.IsNullOrEmpty(recoveryCodesJson))
        {
            currentUser.TwoFactorRecoveryCodes = recoveryCodesJson;
