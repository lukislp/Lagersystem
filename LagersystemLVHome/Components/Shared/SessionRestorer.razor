@using LagersystemLVHome.Application.Services
@inject IAuthService AuthService
@inject ILogger<SessionRestorer> Logger

@code {
    /// <summary>
    /// Mobile Session Restoration Component
    /// This component restores the session from the cookie on page load (e.g. after a reload).
    /// Fixes the issue where mobile devices see the login page after a reload.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("SessionRestorer: Checking for session restoration...");
            
            // Check if a session already exists
            var currentUser = await AuthService.GetCurrentUserAsync();
       
            if (currentUser != null)
            {
                Logger.LogInformation("SessionRestorer: Session already active for user {Username}", currentUser.Username);
            }
            else
            {
                Logger.LogInformation("SessionRestorer: No active session found - attempting restoration from cookie");
        
                // GetCurrentUserAsync already attempts restoration internally
                // If successful, returns a user
                var restoredUser = await AuthService.GetCurrentUserAsync();
 
                if (restoredUser != null)
                {
                    Logger.LogInformation("SessionRestorer: Session successfully restored for user {Username}", restoredUser.Username);
                }
                else
                {
                    Logger.LogDebug("SessionRestorer: No session to restore (user not logged in)");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SessionRestorer: Error during session restoration");
        }
    }
}
