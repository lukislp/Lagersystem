    private async Task OpenEditModal(Product product)
    {
        editingProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Barcode = product.Barcode,
            Description = product.Description ?? string.Empty,
            Quantity = product.Quantity,
            MinQuantity = product.MinQuantity,
            Price = product.Price,
            CategoryId = product.CategoryId,
            WarehouseId = product.WarehouseId,
            CreatedAt = product.CreatedAt,
            ExpiryDate = product.ExpiryDate,
            TrackExpiryDate = product.TrackExpiryDate,
            ImageUrl = product.ImageUrl,
            ThumbnailUrl = product.ThumbnailUrl,
            SpecificationPdfPath = product.SpecificationPdfPath
        };

        selectedStorageLocations = new();
        if (product.Id > 0)
        {
            var existingLocations = await InventoryService.GetProductStorageLocationsAsync(product.Id);

            selectedStorageLocations = existingLocations
                .Select(psl => new StorageLocationMultiSelect.ProductStorageLocationItem
                {
                    StorageLocation = psl.StorageLocation,
                    Quantity = psl.Quantity
                })
                .ToList();
        }

        productBatches = (await InventoryService.GetProductBatchesAsync(product.Id)).ToList();

        SaveOriginalState();
        showModal = true;
    }

    private void SaveOriginalState()
    {
        try
        {
            originalProductJson = System.Text.Json.JsonSerializer.Serialize(new
            {
                editingProduct?.Name,
                editingProduct?.Barcode,
                editingProduct?.Description,
                editingProduct?.MinQuantity,
                editingProduct?.Price,
                editingProduct?.CategoryId,
                editingProduct?.ImageUrl,
                editingProduct?.ExpiryDate,
                editingProduct?.SpecificationPdfPath
            });

            originalStorageLocationsJson = System.Text.Json.JsonSerializer.Serialize(
                selectedStorageLocations.OrderBy(sl => sl.StorageLocation.Id)
                    .Select(sl => new { sl.StorageLocation.Id, sl.Quantity })
            );

            originalBatchesJson = System.Text.Json.JsonSerializer.Serialize(
                productBatches.OrderBy(b => b.BatchNumber)
                    .Select(b => new { b.BatchNumber, b.Quantity, b.ExpiryDate, b.ManufactureDate, b.Notes })
            );
        }
        catch
        {
            originalProductJson = string.Empty;
            originalStorageLocationsJson = string.Empty;
            originalBatchesJson = string.Empty;
        }
    }

    private void CloseModal()
    {
        showModal = false;
        editingProduct = null;
    }

    private async Task SaveProduct()
    {
        if (editingProduct == null || string.IsNullOrWhiteSpace(editingProduct.Name)) return;

        editingProduct.Category = null;
        editingProduct.Quantity = GetTotalQuantity();
        editingProduct.TrackExpiryDate = ShouldShowExpiryDate();
        editingProduct.UpdatedAt = DateTime.UtcNow;

        if (editingProduct.Id > 0)
        {
            await InventoryService.UpdateProductAsync(editingProduct);
            await UpdateProductStorageLocations(editingProduct.Id);
            await UpdateProductBatches(editingProduct.Id);
        }
        else
        {
            editingProduct.CreatedAt = DateTime.UtcNow;
            var createdProduct = await InventoryService.CreateProductAsync(editingProduct);

            if (createdProduct != null)
            {
                await UpdateProductStorageLocations(createdProduct.Id);
                await UpdateProductBatches(createdProduct.Id);
            }
        }

        await LoadData();
        await LoadPriceHistoryCounts();
        CloseModal();
    }

    private async Task UpdateProductStorageLocations(int productId)
    {
        var assignments = selectedStorageLocations
            .Where(sl => sl.Quantity > 0)
            .Select(sl => new ProductStorageLocationAssignment(sl.StorageLocation.Id, sl.Quantity));

        await InventoryService.ReplaceProductStorageLocationsAsync(productId, assignments);
    }

    private async Task UpdateProductBatches(int productId)
    {
        try
        {
            var warehouseId = editingProduct?.WarehouseId ?? 0;
            await InventoryService.ReplaceProductBatchesAsync(productId, warehouseId, productBatches);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating product batches");
            imageUploadError = $"Fehler beim Speichern der Chargen: {ex.Message}";
        }
    }

