@page "/logout"
@inherits CancellableComponentBase
@layout EmptyLayout
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject LagersystemLVHome.Application.Services.CircuitUserStore UserStore
@inject IJSRuntime JSRuntime
@inject Toolbelt.Blazor.I18nText.I18nText I18nText

<PageTitle>@T.Logout_PageTitle</PageTitle>

<div class="login-container">
    <div class="login-card text-center">
        <div class="spinner-border text-primary mb-3" role="status">
            <span class="visually-hidden">@T.Logout_VisuallyHidden</span>
        </div>
        <p>@T.Logout_Loading</p>
        @if (!string.IsNullOrEmpty(debugMessage))
        {
            <small class="text-muted d-block mt-2">@debugMessage</small>
        }
    </div>
</div>


@code {
    private string debugMessage = string.Empty;
    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await PerformLogout();
        }
    }

    private async Task PerformLogout()
    {
        try
        {
            // Step 1: Delete session cookie via JS (required for SessionBlockingOverlay)
            await JSRuntime.InvokeVoidAsync("appHelper.cleanupSession");

            // Step 2: Clear session from UserStore
            UserStore.ClearUser();

            // Step 3: Auth service logout (terminates session in DB)
            await AuthService.LogoutAsync();

            // Step 4: JS redirect (avoids circuit issues)
            await JSRuntime.InvokeVoidAsync("appHelper.redirect", "/login");
        }
        catch (Exception ex)
        {
            debugMessage = $"{T.Logout_Error} {ex.Message}";
            StateHasChanged();
        }
    }
}
