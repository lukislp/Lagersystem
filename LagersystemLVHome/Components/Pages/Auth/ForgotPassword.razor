@page "/forgot-password"
@inherits CancellableComponentBase
@using System.ComponentModel.DataAnnotations
@layout EmptyLayout
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject IPasswordResetService PasswordResetService
@inject IEmailService EmailService
@inject NavigationManager NavigationManager
@inject I18nText I18nText

<PageTitle>@T.ForgotPassword_PageTitle</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-key login-logo"></i>
            <h1>@T.ForgotPassword_Title</h1>
            <p>@T.ForgotPassword_Subtitle</p>
        </div>

        @if (!emailSent)
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }

            <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="ForgotPasswordForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="form-label">@T.ForgotPassword_EmailLabel</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <InputText type="email" class="form-control form-control-lg"
                                   @bind-Value="model.Email"
                                   placeholder="ihre-email@example.com"
                                   autocomplete="email" />
                    </div>
                    <ValidationMessage For="() => model.Email" />
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-send me-2"></i>
                    @T.ForgotPassword_Submit
                </button>
            </EditForm>
        }
        else
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-2"></i>
                <strong>@T.ForgotPassword_SentTitle</strong>
                <p class="mb-0 mt-2">
                    @T.ForgotPassword_SentDesc
                </p>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    @T.ForgotPassword_LinkValid
                </p>
            </div>
        }

        <div class="login-footer">
            <p>
                <a href="/login">@T.ForgotPassword_BackToLogin</a>
            </p>
        </div>
    </div>
</div>


@code {
    private ForgotPasswordModel model = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool emailSent = false;
    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var token = await PasswordResetService.RequestPasswordResetAsync(model.Email);
     
            // Always show success for security (do not reveal if email exists)
            if (token != null)
            {
                // Send reset email
                await EmailService.SendPasswordResetEmailAsync(model.Email, model.Email, token);
            }
     
            emailSent = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"{T.ForgotPassword_Error} {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "E-Mail ist erforderlich")]
        [EmailAddress(ErrorMessage = "Ungültige E-Mail-Adresse")]
        public string Email { get; set; } = string.Empty;
    }
}
