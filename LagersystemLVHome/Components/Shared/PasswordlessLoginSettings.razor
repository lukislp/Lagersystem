@using LagersystemLVHome.Domain.Models
@using LagersystemLVHome.Application.Services
@inject IPasswordlessLoginService PasswordlessService
@inject IToastService ToastService
@inject I18nText I18nText

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0">
            <i class="bi bi-magic me-2"></i>
            Passwordless Login (Magic Link)
        </h5>
    </div>
    <div class="card-body">
        <div class="alert alert-info mb-3">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Magic Link Login</strong><br>
            Melden Sie sich ohne Passwort an - ein sicherer Link wird per E-Mail gesendet.
        </div>

        <div class="row align-items-center">
            <div class="col-md-8">
                <h6>@T.PasswordlessSettings_Status</h6>
                @if (User.PasswordlessEnabled)
                {
                    <p class="text-success mb-2">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        <strong>@T.PasswordlessSettings_Enabled</strong>
                    </p>
                }
                else
                {
                    <p class="text-muted mb-2">
                        <i class="bi bi-x-circle me-1"></i>
                        <strong>@T.PasswordlessSettings_Disabled</strong>
                    </p>
                }

                @if (User.PasswordlessEnabled)
                {
                    <h6 class="mt-3">@T.PasswordlessSettings_LoginMethod</h6>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="allowBoth"
                               checked="@isBothMethodsEnabled"
                               @onchange="ToggleBothMethods"
                               disabled="@isProcessing">
                            <label class="form-check-label" for="allowBoth">
                                <strong>@T.PasswordlessSettings_BothMethods</strong>
                                <br><small class="text-muted">@T.PasswordlessSettings_BothMethods_Hint</small>
                            </label>
                        </div>
                    }
                </div>
                <div class="col-md-4 text-end">
                    @if (User.PasswordlessEnabled)
                    {
                        <button class="btn btn-warning" @onclick="DisablePasswordless" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-toggle-off me-1"></i>
                            @T.PasswordlessSettings_Disable
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="EnablePasswordless" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-toggle-on me-1"></i>
                            @T.PasswordlessSettings_Enable
                        </button>
                    }
                </div>
            </div>

            @if (User.PasswordlessEnabled)
            {
                <hr class="my-3">
                <div class="alert alert-light border">
                    <h6><i class="bi bi-lightbulb me-1"></i> So funktioniert's:</h6>
                    <ol class="mb-0 small">
                        <li>Geben Sie auf der Login-Seite Ihre E-Mail-Adresse ein</li>
                        <li>Klicken Sie auf "Magic Link senden"</li>
                        <li>Sie erhalten einen Link per E-Mail (gültig für 15 Minuten)</li>
                        <li>Klicken Sie auf den Link - fertig!</li>
                    </ol>
                </div>
            }
        </div>
    </div>

@code {
    [Parameter]
    public User User { get; set; } = null!;

    [Parameter]
    public EventCallback OnSettingsChanged { get; set; }

    private bool isProcessing = false;
    private bool isBothMethodsEnabled => User.DefaultLoginMethod == "Both";

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    private async Task EnablePasswordless()
    {
        isProcessing = true;
        try
        {
            var success = await PasswordlessService.SetPasswordlessEnabledAsync(User.Id, true);
            if (success)
            {
                User.PasswordlessEnabled = true;
                User.DefaultLoginMethod = "Both";
                ToastService.ShowSuccess("Passwordless Login aktiviert!");
                await OnSettingsChanged.InvokeAsync();
            }
            else
            {
                ToastService.ShowError("Error enabling");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task DisablePasswordless()
    {
        isProcessing = true;
        try
        {
            var success = await PasswordlessService.SetPasswordlessEnabledAsync(User.Id, false);
            if (success)
            {
                User.PasswordlessEnabled = false;
                User.DefaultLoginMethod = "Password";
                ToastService.ShowSuccess("Passwordless Login deaktiviert");
                await OnSettingsChanged.InvokeAsync();
            }
            else
            {
                ToastService.ShowError("Error disabling");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ToggleBothMethods(ChangeEventArgs e)
    {
        var enableBoth = (bool)(e.Value ?? false);
        var newMethod = enableBoth ? "Both" : "Passwordless";
      
        isProcessing = true;
        try
        {
            var success = await PasswordlessService.SetDefaultLoginMethodAsync(User.Id, newMethod);
            if (success)
            {
                User.DefaultLoginMethod = newMethod;
                var methodName = enableBoth ? "Passwort + Magic Link" : "Nur Magic Link";
                ToastService.ShowSuccess($"Login-Methode: {methodName}");
                await OnSettingsChanged.InvokeAsync();
            }
            else
            {
                ToastService.ShowError("Error changing the login method");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
