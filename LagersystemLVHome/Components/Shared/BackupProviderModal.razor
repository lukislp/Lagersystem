@using LagersystemLVHome.Domain.Models
@using System.Text.Json
@using LagersystemLVHome.Application.Services
@using LagersystemLVHome.Components.Shared.BackupProviders
@using LagersystemLVHome.Application.Services.BackupProviders
@inject IJSRuntime JSRuntime
@inject I18nText I18nText

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog @GetModalSizeClass()">
        <div class="modal-content">
            <!-- Header with tabs at the top -->
            <div class="modal-header border-0 pb-2">
                <div class="w-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="modal-title mb-0">
                            <i class="bi bi-@(IsEditMode ? "pencil" : "plus-circle") me-2"></i>
                            @(IsEditMode ? T.BackupProviderModal_EditTitle : T.BackupProviderModal_AddTitle)
                        </h5>
                        <button type="button" class="btn-close" @onclick="OnCancel"></button>
                    </div>

                    <!-- Tabs in a single row -->
                    <ul class="nav nav-pills backup-provider-tabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link @(Provider.Type == BackupProviderType.Local ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchProviderType(BackupProviderType.Local)">
                                <i class="bi bi-folder d-block fs-4 mb-1"></i>
                                <small>@T.BackupProviderModal_Local</small>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(Provider.Type == BackupProviderType.NetworkShare ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchProviderType(BackupProviderType.NetworkShare)">
                                <i class="bi bi-hdd-network d-block fs-4 mb-1"></i>
                                <small>@T.BackupProviderModal_Network</small>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(Provider.Type == BackupProviderType.AzureBlob ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchProviderType(BackupProviderType.AzureBlob)">
                                <i class="bi bi-cloud d-block fs-4 mb-1"></i>
                                <small>@T.BackupProviderModal_Azure</small>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(Provider.Type == BackupProviderType.AWSS3 ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchProviderType(BackupProviderType.AWSS3)">
                                <i class="bi bi-amazon d-block fs-4 mb-1"></i>
                                <small>@T.BackupProviderModal_AWS</small>
                            </button>
                        </li>
                        <!-- Google Drive tab -->
                        <li class="nav-item">
                            <button class="nav-link @(Provider.Type == BackupProviderType.GoogleDrive ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchProviderType(BackupProviderType.GoogleDrive)">
                                <i class="bi bi-google d-block fs-4 mb-1"></i>
                                <small>@T.BackupProviderModal_Google</small>
                            </button>
                        </li>
                        <!-- OneDrive tab -->
                        <li class="nav-item">
                            <button class="nav-link @(Provider.Type == BackupProviderType.OneDrive ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchProviderType(BackupProviderType.OneDrive)">
                                <i class="bi bi-microsoft d-block fs-4 mb-1"></i>
                                <small>@T.BackupProviderModal_OneDrive</small>
                            </button>
                        </li>
                        <!-- Cloudflare R2 tab -->
                        <li class="nav-item">
                            <button class="nav-link @(Provider.Type == BackupProviderType.CloudflareR2 ? "active" : "")"
                                    type="button"
                                    @onclick="() => SwitchProviderType(BackupProviderType.CloudflareR2)">
                                <i class="bi bi-cloud d-block fs-4 mb-1"></i>
                                <small>@T.BackupProviderModal_R2</small>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            <EditForm Model="@Provider" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="modal-body">
                    <!-- Name & status (for all providers) -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label">
                                <i class="bi bi-tag me-1"></i>
                                Name *
                            </label>
                            <InputText class="form-control" @bind-Value="Provider.Name" placeholder="z.B. Azure Backup" />
                            <ValidationMessage For="@(() => Provider.Name)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label d-block">
                                <i class="bi bi-power me-1"></i>
                                @T.BackupProviderModal_Status
                            </label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input" @bind-Value="Provider.Enabled" id="providerEnabled" />
                                <label class="form-check-label" for="providerEnabled">
                                    @(Provider.Enabled ? T.BackupProviderModal_Enabled : T.BackupProviderModal_Disabled)
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Provider-spezifische Komponente -->
                    <div class="provider-content">
                        @if (Provider.Type == BackupProviderType.Local)
                        {
                            <LocalBackupProvider Config="localConfig"
                                                 ConfigChanged="EventCallback.Factory.Create<LocalBackupConfig>(this, c => localConfig = c)"
                                                 OnSelectFolder="SelectFolder"
                                                 OnShowPathExamples="ShowPathExamples" />
                        }
                        else if (Provider.Type == BackupProviderType.NetworkShare)
                        {
                            <NetworkShareProvider Config="networkConfig"
                                                  ConfigChanged="EventCallback.Factory.Create<NetworkShareConfig>(this, c => networkConfig = c)"
                                                  OnSelectFolder="SelectNetworkShare"
                                                  OnShowPathExamples="ShowPathExamples" />
                        }
                        else if (Provider.Type == BackupProviderType.AzureBlob)
                        {
                            <AzureBlobProvider Config="azureConfig"
                                               ConfigChanged="EventCallback.Factory.Create<AzureBlobConfig>(this, c => azureConfig = c)" />
                        }
                        else if (Provider.Type == BackupProviderType.AWSS3)
                        {
                            <AwsS3Provider Config="awsConfig"
                                           ConfigChanged="EventCallback.Factory.Create<AwsS3Config>(this, c => awsConfig = c)" />
                        }
                        else if (Provider.Type == BackupProviderType.GoogleDrive)
                        {
                            <GoogleDriveProvider Config="googleDriveConfig"
                                                 ConfigChanged="EventCallback.Factory.Create<GoogleDriveConfig>(this, c => googleDriveConfig = c)" />
                        }
                        else if (Provider.Type == BackupProviderType.OneDrive)
                        {
                            <OneDriveProvider Config="oneDriveConfig"
                                              ConfigChanged="EventCallback.Factory.Create<OneDriveConfig>(this, c => oneDriveConfig = c)" />
                        }
                        else if (Provider.Type == BackupProviderType.CloudflareR2)
                        {
                            <CloudflareR2Provider Config="cloudflareR2Config"
                                                  ConfigChanged="EventCallback.Factory.Create<CloudflareR2Config>(this, c => cloudflareR2Config = c)" />
                        }
                    </div>

                    <!-- Encryption (for all providers) -->
                    <div class="mt-3">
                        <label class="form-label">
                            <i class="bi bi-shield-lock me-1"></i>
                            @T.BackupProviderModal_Encryption
                        </label>
                        <InputText type="password" class="form-control" @bind-Value="@encryptionPassword"
                                   placeholder="@T.BackupProviderModal_EncryptionPlaceholder" />
                        <small class="text-muted">@T.BackupProviderModal_EncryptionHint</small>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @errorMessage
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                        <i class="bi bi-x-circle me-1"></i>
                        @T.BackupProviderModal_Cancel
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-@(IsEditMode ? "save" : "plus-circle") me-1"></i>
                        }
                        @(IsEditMode ? T.BackupProviderModal_Save : T.BackupProviderModal_Add)
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public BackupProvider Provider { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool isSaving = false;
    private string? errorMessage;
    private string? encryptionPassword;

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    // Config Objects
    private LocalBackupConfig localConfig = new();
    private AzureBlobConfig azureConfig = new();
    private AwsS3Config awsConfig = new();
    private NetworkShareConfig networkConfig = new();
    private GoogleDriveConfig googleDriveConfig = new();  // NEU
    private OneDriveConfig oneDriveConfig = new();  // NEU
    private CloudflareR2Config cloudflareR2Config = new();  // NEU

    protected override void OnParametersSet()
    {
        try
        {
            if (!string.IsNullOrEmpty(Provider.Configuration))
            {
                switch (Provider.Type)
                {
                    case BackupProviderType.Local:
                        localConfig = JsonSerializer.Deserialize<LocalBackupConfig>(Provider.Configuration) ?? new();
                        if (localConfig.Paths == null || !localConfig.Paths.Any())
                        {
                            localConfig.Paths = new List<string> { "C:\\Backups\\LagerSystem" };
                        }
                        break;
                    case BackupProviderType.AzureBlob:
                        azureConfig = JsonSerializer.Deserialize<AzureBlobConfig>(Provider.Configuration) ?? new();
                        break;
                    case BackupProviderType.AWSS3:
                        awsConfig = JsonSerializer.Deserialize<AwsS3Config>(Provider.Configuration) ?? new();
                        break;
                    case BackupProviderType.NetworkShare:
                        networkConfig = JsonSerializer.Deserialize<NetworkShareConfig>(Provider.Configuration) ?? new();
                        if (networkConfig.Paths == null || !networkConfig.Paths.Any())
                        {
                            networkConfig.Paths = new List<NetworkSharePath>
{
new() { UncPath = "\\\\server\\share\\backups", Enabled = true, Description = "Share 1" }
};
                        }
                        break;
                    case BackupProviderType.GoogleDrive:  // NEU
                        googleDriveConfig = JsonSerializer.Deserialize<GoogleDriveConfig>(Provider.Configuration) ?? new();
                        break;
                    case BackupProviderType.OneDrive:  // NEU
                        oneDriveConfig = JsonSerializer.Deserialize<OneDriveConfig>(Provider.Configuration) ?? new();
                        break;
                    case BackupProviderType.CloudflareR2:  // NEU
                        cloudflareR2Config = JsonSerializer.Deserialize<CloudflareR2Config>(Provider.Configuration) ?? new();
                        break;
                }
            }
            else
            {
                InitializeDefaults();
            }
        }
        catch
        {
        }
    }

    private void InitializeDefaults()
    {
        if (Provider.Type == BackupProviderType.Local)
        {
            localConfig.Paths = new List<string> { "C:\\Backups\\LagerSystem" };
            localConfig.MaxBackups = 7;
        }
        else if (Provider.Type == BackupProviderType.NetworkShare)
        {
            networkConfig.Paths = new List<NetworkSharePath>
{
        new() { UncPath = "\\\\server\\share\\backups", Enabled = true, Description = "Share 1" }
        };
        }
    }

    private void SwitchProviderType(BackupProviderType newType)
    {
        if (Provider.Type == newType) return;

        Provider.Type = newType;

        // Reset configs
        localConfig = new();
        azureConfig = new();
        awsConfig = new();
        networkConfig = new();
        googleDriveConfig = new();  // NEU
        oneDriveConfig = new();  // NEU
        cloudflareR2Config = new();  // NEU

        InitializeDefaults();
        StateHasChanged();
    }

    private async Task SelectFolder(int index)
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<FolderBrowserResult>("BackupFolderBrowser.selectFolder");

            if (result.Success && result.NeedsManualInput && !string.IsNullOrEmpty(result.Name))
            {
                localConfig.Paths[index] = $"C:\\Backups\\{result.Name}";
                errorMessage = $"Ordner \"{result.Name}\" ausgewählt. Bitte vollständigen Pfad manuell eingeben.";
                await JSRuntime.InvokeVoidAsync("BackupFolderBrowser.showHelpDialog");
                StateHasChanged();
            }
            else if (result.Success && !string.IsNullOrEmpty(result.Path))
            {
                localConfig.Paths[index] = result.Path;
                errorMessage = null;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler bei Ordnerauswahl: {ex.Message}";
        }
    }

    private async Task SelectNetworkShare(int index)
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<FolderBrowserResult>("BackupFolderBrowser.selectFolder");

            if (result.Success && result.NeedsManualInput && !string.IsNullOrEmpty(result.Name))
            {
                networkConfig.Paths[index].UncPath = $"\\\\server\\share\\{result.Name}";
                errorMessage = $"Ordner \"{result.Name}\" ausgewählt. Bitte vollständigen UNC-Pfad manuell eingeben.";
                await JSRuntime.InvokeVoidAsync("BackupFolderBrowser.showHelpDialog");
                StateHasChanged();
            }
            else if (result.Success && !string.IsNullOrEmpty(result.Path))
            {
                networkConfig.Paths[index].UncPath = result.Path;
                errorMessage = null;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler bei Ordnerauswahl: {ex.Message}";
        }
    }

    private async Task ShowPathExamples()
    {
        await JSRuntime.InvokeVoidAsync("BackupFolderBrowser.showPathExamples");
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            Provider.Configuration = Provider.Type switch
            {
                BackupProviderType.Local => JsonSerializer.Serialize(localConfig),
                BackupProviderType.AzureBlob => JsonSerializer.Serialize(azureConfig),
                BackupProviderType.AWSS3 => JsonSerializer.Serialize(awsConfig),
                BackupProviderType.NetworkShare => JsonSerializer.Serialize(networkConfig),
                BackupProviderType.GoogleDrive => JsonSerializer.Serialize(googleDriveConfig),  // NEU
                BackupProviderType.OneDrive => JsonSerializer.Serialize(oneDriveConfig),  // NEU
                BackupProviderType.CloudflareR2 => JsonSerializer.Serialize(cloudflareR2Config),  // NEU
                _ => "{}"
            };

            if (!string.IsNullOrEmpty(encryptionPassword))
            {
                Provider.EncryptedPassword = encryptionPassword;
            }

            await OnSave.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetModalSizeClass()
    {
        // All providers use modal-xl for more room
        return "modal-xl";
    }

    private class FolderBrowserResult
    {
        public bool Success { get; set; }
        public string? Path { get; set; }
        public string? Name { get; set; }
        public string? Error { get; set; }
        public bool NeedsManualInput { get; set; }
        public string? Message { get; set; }
    }
}
