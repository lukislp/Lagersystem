    private string GetPdfFileName(string pdfPath)
    {
        if (string.IsNullOrEmpty(pdfPath)) return "Unbekannt";
        return Path.GetFileName(pdfPath);
    }

    private string GetPdfFileSize(string pdfPath)
    {
        try
        {
            if (string.IsNullOrEmpty(pdfPath)) return "";
            var physicalPath = ImageService.GetImagePath(pdfPath);
            if (!File.Exists(physicalPath)) return "";

            var fileInfo = new FileInfo(physicalPath);
            var sizeInKb = fileInfo.Length / 1024.0;
            if (sizeInKb < 1024)
                return $"{sizeInKb:F1} KB";
            else
                return $"{sizeInKb / 1024:F1} MB";
        }
        catch
        {
            return "";
        }
    }

    private bool ShouldShowExpiryDate()
    {
        if (editingProduct == null) return false;
        return LagersystemLVHome.Application.Services.ExpiryHelper.ShouldTrackExpiry(
