@using LagersystemLVHome.Domain.Models
@inject I18nText I18nText

<!-- Revocation confirmation modal -->
@if (ShowModal)
{
    <div class="modal-backdrop" style="display: block;"></div>
    <div class="modal" style="display: block;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @string.Format(T.RevokeConsent_Title, ConsentType)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <i class="bi bi-shield-exclamation me-2"></i>
                        <strong>@T.RevokeConsent_Warning</strong>
                    </div>

                    @if (ConsentType == "Analytics & Performance")
                    {
                        <h6 class="mb-3">@(T.RevokeConsent_WhatDoesRevocation_Mean ?? "Was bedeutet der Widerruf?")</h6>
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>@(T.RevokeConsent_LoginBlocked ?? "Login nicht mehr möglich!")</strong><br>
                            @(T.RevokeConsent_Analytics_Required ?? "Analytics & Performance ist erforderlich für die App-Funktion.")
                        </div>

                        <p><strong>@(T.RevokeConsent_Consequences ?? "Folgen des Widerrufs:")</strong></p>
                        <ul>
                            <li><i class="bi bi-x-circle-fill text-danger me-2"></i><strong>@(T.RevokeConsent_LoginBlockedItem ?? "Login blockiert")</strong> - @(T.RevokeConsent_LoginBlockedItem ?? "Sie können sich nicht mehr anmelden")</li>
                            <li><i class="bi bi-x-circle-fill text-danger me-2"></i>@(T.RevokeConsent_NoPageTracking ?? "Keine Seitenaufrufe werden getrackt")</li>
                            <li><i class="bi bi-x-circle-fill text-danger me-2"></i>@(T.RevokeConsent_NoLoadTracking ?? "Keine Ladezeiten werden gemessen")</li>
                            <li><i class="bi bi-x-circle-fill text-danger me-2"></i>@(T.RevokeConsent_NoErrorAnalysis ?? "Fehleranalyse nicht möglich")</li>
                        </ul>

                        <p><strong>@(T.RevokeConsent_WhatHappensData ?? "Was passiert mit Ihren Daten?")</strong></p>
                        <ul>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>@(T.RevokeConsent_AccountRemains ?? "Account bleibt bestehen")</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>@(T.RevokeConsent_DataRemains ?? "Alle Produkte/Kategorien bleiben erhalten")</li>
                            <li><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>@(T.RevokeConsent_GdprModalReappears ?? "Beim nächsten Login-Versuch: GDPR-Modal erscheint erneut")</li>
                        </ul>
                    }
                    else if (ConsentType == "Device Fingerprinting")
                    {
                        <h6 class="mb-3">@(T.RevokeConsent_WhatDoesRevocation_Mean ?? "Was bedeutet der Widerruf?")</h6>
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>@(T.RevokeConsent_LoginBlocked ?? "Login nicht mehr möglich!")</strong><br>
                            @(T.RevokeConsent_Fingerprint_Required ?? "Device Fingerprinting ist erforderlich für Account-Sicherheit.")
                        </div>

                        <p><strong>@(T.RevokeConsent_Consequences ?? "Folgen des Widerrufs:")</strong></p>
                        <ul>
                            <li><i class="bi bi-x-circle-fill text-danger me-2"></i><strong>@(T.RevokeConsent_LoginBlockedItem ?? "Login blockiert")</strong> - @(T.RevokeConsent_LoginBlockedItem ?? "Sie können sich nicht mehr anmelden")</li>
                            <li><i class="bi bi-x-circle-fill text-danger me-2"></i>@(T.RevokeConsent_NoDeviceRecognition ?? "Keine Geräteerkennung mehr")</li>
                            <li><i class="bi bi-x-circle-fill text-danger me-2"></i>@(T.RevokeConsent_NoVpnDetection ?? "Keine VPN-Erkennung mehr")</li>
                            <li><i class="bi bi-x-circle-fill text-danger me-2"></i>@(T.RevokeConsent_NoSessionHijackProtection ?? "Kein Schutz vor Session-Hijacking")</li>
                            <li><i class="bi bi-x-circle-fill text-danger me-2"></i>@(T.RevokeConsent_NoAccountTakeoverProtection ?? "Kein Schutz vor Account-Übernahmen")</li>
                        </ul>

                        <p><strong>@(T.RevokeConsent_WhatHappensData ?? "Was passiert mit Ihren Daten?")</strong></p>
                        <ul>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>@(T.RevokeConsent_AccountRemains ?? "Account bleibt bestehen")</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>@(T.RevokeConsent_DataRemains ?? "Alle Produkte/Kategorien bleiben erhalten")</li>
                            <li><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>@(T.RevokeConsent_GdprModalReappears ?? "Beim nächsten Login-Versuch: GDPR-Modal erscheint erneut")</li>
                        </ul>
                    }

                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>@(T.RevokeConsent_Alternative_Label ?? "Alternative:")</strong> @(T.RevokeConsent_Alternative ?? "Wenn Sie die App nicht mehr nutzen möchten, empfehlen wir die Account-Löschung statt des Widerrufs.")
                    </div>

                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="confirmRevoke" @bind="confirmRevoke">
                            <label class="form-check-label" for="confirmRevoke">
                                @(T.RevokeConsent_ConfirmCheckbox ?? "Ich habe verstanden, dass ich mich nach dem Widerruf nicht mehr einloggen kann")
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="Cancel">
                            <i class="bi bi-x-circle me-1"></i>
                            @T.RevokeConsent_Cancel
                        </button>
                        <button class="btn btn-danger" @onclick="Confirm" disabled="@(!confirmRevoke || isProcessing)">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-shield-x me-1"></i>
                            @T.RevokeConsent_Confirm
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }


@code {
    [Parameter]
    public bool ShowModal { get; set; }

    [Parameter]
    public string ConsentType { get; set; } = "";

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool confirmRevoke = false;
    private bool isProcessing = false;

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    private async Task Confirm()
    {
        if (!confirmRevoke) return;

        isProcessing = true;
        await OnConfirm.InvokeAsync();
        isProcessing = false;
        confirmRevoke = false;
    }

    private async Task Cancel()
    {
        confirmRevoke = false;
        await OnCancel.InvokeAsync();
    }
}
