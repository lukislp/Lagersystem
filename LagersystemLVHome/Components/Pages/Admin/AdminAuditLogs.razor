@page "/admin-audit-logs"
@inherits CancellableComponentBase
@using LagersystemLVHome.Domain.Models
@using LagersystemLVHome.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@rendermode InteractiveServer
@inject IAuditService AuditService
@inject IAuditQueryService AuditQueryService
@inject I18nText I18nText

<PageTitle>@T.AdminAuditLogs_PageTitle</PageTitle>

<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-shield-check me-2"></i>
        @T.AdminAuditLogs_Title
    </h1>
    <p class="page-subtitle">@T.AdminAuditLogs_Subtitle</p>
</div>

<!-- Filter -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">@T.AdminAuditLogs_Filter_User</label>
                <select class="form-select" @bind="filterUserId">
                    <option value="0">@T.AdminAuditLogs_Filter_AllUsers</option>
                    @foreach (var user in users)
                    {
                        <option value="@user.Id">@user.Username</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">@T.AdminAuditLogs_Filter_Action</label>
                <select class="form-select" @bind="filterAction">
                    <option value="">@T.AdminAuditLogs_Filter_AllActions</option>
                    <option value="LOGIN_SUCCESS">Login Erfolg</option>
                    <option value="LOGIN_FAILED">Login Fehlgeschlagen</option>
                    <option value="LOGOUT">Logout</option>
                    <option value="REGISTER_SUCCESS">Registrierung</option>
                    <option value="USER_APPROVED">Benutzer Genehmigt</option>
                    <option value="USER_REJECTED">Benutzer Abgelehnt</option>
                    <option value="PASSWORD_CHANGED">Passwort Geändert</option>
                    <option value="PRODUCT_CREATED">Produkt Erstellt</option>
                    <option value="PRODUCT_UPDATED">Produkt Aktualisiert</option>
                    <option value="PRODUCT_DELETED">Produkt Gelöscht</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">@T.AdminAuditLogs_Filter_Severity</label>
                <select class="form-select" @bind="filterSeverity">
                    <option value="-1">@T.AdminAuditLogs_Filter_All</option>
                    <option value="0">Info</option>
                    <option value="1">Warning</option>
                    <option value="2">Error</option>
                    <option value="3">Critical</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">@T.AdminAuditLogs_Filter_Count</label>
                <select class="form-select" @bind="filterCount">
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                    <option value="500">500</option>
                </select>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <button class="btn btn-primary" @onclick="LoadLogs">
                    <i class="bi bi-funnel me-2"></i>
                    @T.AdminAuditLogs_Filter_Apply
                </button>
                <button class="btn btn-secondary" @onclick="ResetFilter">
                    <i class="bi bi-arrow-counterclockwise me-2"></i>
                    @T.AdminAuditLogs_Filter_Reset
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Statistics -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-shield-check display-4 text-info"></i>
                <h3 class="mt-2">@totalLogs</h3>
                <p class="text-muted mb-0">@T.AdminAuditLogs_Stats_Total</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-check-circle display-4 text-success"></i>
                <h3 class="mt-2">@successCount</h3>
                <p class="text-muted mb-0">@T.AdminAuditLogs_Stats_Success</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-exclamation-triangle display-4 text-warning"></i>
                <h3 class="mt-2">@warningCount</h3>
                <p class="text-muted mb-0">@T.AdminAuditLogs_Stats_Warnings</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-x-circle display-4 text-danger"></i>
                <h3 class="mt-2">@criticalCount</h3>
                <p class="text-muted mb-0">@T.AdminAuditLogs_Stats_Critical</p>
            </div>
        </div>
    </div>
</div>

<!-- Logs table -->
<div class="card">
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@T.AdminAuditLogs_Loading</span>
                </div>
            </div>
        }
        else if (!logs.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-1"></i>
                <p class="mt-3">@T.AdminAuditLogs_Empty</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>@T.AdminAuditLogs_Table_Timestamp</th>
                            <th>@T.AdminAuditLogs_Table_User</th>
                            <th>@T.AdminAuditLogs_Table_Action</th>
                            <th>@T.AdminAuditLogs_Table_Entity</th>
                            <th>@T.AdminAuditLogs_Table_Severity</th>
                            <th>@T.AdminAuditLogs_Table_IP</th>
                            <th>@T.AdminAuditLogs_Table_Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in logs)
                        {
                            <tr class="@GetSeverityClass(log.Severity)">
                                <td>
                                    <small>@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</small>
                                </td>
                                <td>
                                    <strong>@(log.Username ?? "System")</strong>
                                </td>
                                <td>
                                    <span class="badge @GetActionBadgeClass(log.Action)">
                                        @GetActionDisplayName(log.Action)
                                    </span>
                                </td>
                                <td>@log.Entity</td>
                                <td>
                                    <span class="badge @GetSeverityBadgeClass(log.Severity)">
                                        @log.Severity
                                    </span>
                                </td>
                                <td>
                                    <small>@(log.IpAddress ?? "-")</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.Details))
                                    {
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => ShowDetails(log)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Details Modal -->
@if (selectedLog != null)
{
    <div class="modal-backdrop modal-open-inline"></div>
    <div class="modal modal-open-inline">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@T.AdminAuditLogs_Modal_Title</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetails"></button>
                </div>
                <div class="modal-body">
                    <dl class="row">
                        <dt class="col-sm-3">@T.AdminAuditLogs_Modal_Timestamp</dt>
                        <dd class="col-sm-9">@selectedLog.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</dd>

                        <dt class="col-sm-3">@T.AdminAuditLogs_Modal_User</dt>
                        <dd class="col-sm-9">@(selectedLog.Username ?? "System") (@selectedLog.UserId)</dd>

                        <dt class="col-sm-3">@T.AdminAuditLogs_Modal_Action</dt>
                        <dd class="col-sm-9">@selectedLog.Action</dd>

                        <dt class="col-sm-3">@T.AdminAuditLogs_Modal_Entity</dt>
                        <dd class="col-sm-9">@selectedLog.Entity (@selectedLog.EntityId)</dd>

                        <dt class="col-sm-3">@T.AdminAuditLogs_Modal_Severity</dt>
                        <dd class="col-sm-9">
                            <span class="badge @GetSeverityBadgeClass(selectedLog.Severity)">
                                @selectedLog.Severity
                            </span>
                        </dd>

                        <dt class="col-sm-3">@T.AdminAuditLogs_Modal_IP</dt>
                        <dd class="col-sm-9">@(selectedLog.IpAddress ?? "-")</dd>

                        <dt class="col-sm-3">@T.AdminAuditLogs_Modal_UserAgent</dt>
                        <dd class="col-sm-9"><small>@(selectedLog.UserAgent ?? "-")</small></dd>

                        <dt class="col-sm-3">@T.AdminAuditLogs_Modal_Details</dt>
                        <dd class="col-sm-9">
                            <pre class="audit-details-pre">@selectedLog.Details</pre>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private LagersystemLVHome.I18nText.App T = new();
    private List<AuditLog> logs = new();
    private List<User> users = new();
    private bool isLoading = true;
  
    private int filterUserId = 0;
    private string filterAction = "";
    private int filterSeverity = -1;
    private int filterCount = 100;

    private int totalLogs = 0;
    private int successCount = 0;
    private int warningCount = 0;
    private int criticalCount = 0;

    private AuditLog? selectedLog;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadUsers();
        await LoadLogs();
        await LoadStatistics();
    }

    private async Task LoadUsers()
    {
        var activeUsers = await AuditQueryService.GetActiveUsersForFilterAsync();
        users = activeUsers.ToList();
    }

    private async Task LoadLogs()
    {
        isLoading = true;

        try
        {
            var filter = new AuditLogFilter(
                UserId: filterUserId > 0 ? filterUserId : null,
                Action: string.IsNullOrEmpty(filterAction) ? null : filterAction,
                Severity: filterSeverity >= 0 ? (AuditSeverity)filterSeverity : null,
                TakeCount: filterCount);

            var result = await AuditQueryService.GetAuditLogsAsync(filter);
            logs = result.ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadStatistics()
    {
        var stats = await AuditQueryService.GetAuditLogStatsAsync();
        totalLogs = stats.Total;
        successCount = stats.InfoCount;
        warningCount = stats.WarningCount;
        criticalCount = stats.ErrorAndCriticalCount;
    }

    private async Task ResetFilter()
    {
        filterUserId = 0;
        filterAction = "";
        filterSeverity = -1;
        filterCount = 100;
        await LoadLogs();
    }

    private void ShowDetails(AuditLog log)
    {
        selectedLog = log;
    }

    private void CloseDetails()
    {
        selectedLog = null;
    }

    private string GetSeverityClass(AuditSeverity severity)
    {
        return severity switch
        {
            AuditSeverity.Info => "",
            AuditSeverity.Warning => "table-warning",
            AuditSeverity.Error => "table-danger",
            AuditSeverity.Critical => "table-danger",
            _ => ""
        };
    }

    private string GetSeverityBadgeClass(AuditSeverity severity)
    {
        return severity switch
        {
            AuditSeverity.Info => "bg-success",
            AuditSeverity.Warning => "bg-warning",
            AuditSeverity.Error => "bg-danger",
            AuditSeverity.Critical => "bg-dark",
            _ => "bg-secondary"
        };
    }

    private string GetActionBadgeClass(string action)
    {
        if (action.Contains("SUCCESS") || action.Contains("APPROVED"))
            return "bg-success";
        if (action.Contains("FAILED") || action.Contains("REJECTED") || action.Contains("DELETED"))
            return "bg-danger";
        if (action.Contains("CREATED") || action.Contains("UPDATED"))
            return "bg-primary";
   
        return "bg-secondary";
    }

    private string GetActionDisplayName(string action)
    {
        return action switch
        {
            "LOGIN_SUCCESS" => "Login",
            "LOGIN_FAILED" => "Login Fehlgeschlagen",
            "LOGOUT" => "Logout",
            "REGISTER_SUCCESS" => "Registrierung",
            "USER_APPROVED" => "Benutzer Genehmigt",
            "USER_REJECTED" => "Benutzer Abgelehnt",
            "PASSWORD_CHANGED" => "Passwort Geändert",
            "PRODUCT_CREATED" => "Produkt Erstellt",
            "PRODUCT_UPDATED" => "Produkt Aktualisiert",
            "PRODUCT_DELETED" => "Produkt Gelöscht",
            _ => action
        };
    }
}
