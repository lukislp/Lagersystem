                                    </p>
                                    <button class="btn btn-primary" @onclick="ExportMyData" disabled="@isExporting">
                                        @if (isExporting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        <i class="bi bi-download me-1"></i>
                                        Jetzt exportieren
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Delete account -->
                        <div class="col-md-6">
                            <div class="card bg-light border-danger h-100">
                                <div class="card-body">
                                    <h6><i class="bi bi-trash me-2"></i>Account löschen</h6>
                                    <p class="small text-muted">
                                        Löschen Sie Ihr Konto unwiderruflich
                                        (Art. 17 DSGVO - Recht auf Löschung)
                                    </p>
                                    <button class="btn btn-danger" @onclick="ConfirmDeleteAccount">
                                        <i class="bi bi-trash me-1"></i>
                                        Account löschen
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- My devices (GDPR section) -->
                    <h6 class="mb-3">
                        <i class="bi bi-devices me-2"></i>
                        Meine Geräte
                    </h6>
                    <div class="alert alert-info mb-3">
                        <i class="bi bi-info-circle me-2"></i>
                        Hier sehen Sie alle Geräte, mit denen Sie sich angemeldet haben.
                        Sie können Sessions von unbekannten Geräten beenden.
                    </div>
                    <UserDeviceList UserId="@currentUser.Id"
                                    CurrentSessionId="@currentSessionId"
                                    AllowTerminate="true"
                                    ShowFingerprint="true"
                                    OnDeviceTerminated="HandleDeviceTerminated" />
                </div>
            </div>
        </div>
    </div>
}

<!-- Deletion confirmation modal -->
@if (showDeleteConfirmation)
{
