@using LagersystemLVHome.Domain.Models
@inject I18nText I18nText

<InfiniteScroll OnLoadMore="@OnLoadMore"
                IsLoading="@IsLoading"
                HasMore="@HasMore"
                Threshold="200">
    
    @foreach (var movement in Movements)
    {
        <div class="movement-row @GetMovementClass(movement)" @key="movement.Id">
            <div class="movement-icon">
                <i class="bi @GetMovementIcon(movement)"></i>
            </div>
     
            <div class="movement-product">
                <div class="product-info">
                    <div class="product-icon-small">
                        <CategoryIcon IconClass="@(movement.Product?.Category?.Icon ?? "bi-box")" />
                    </div>
                    <div>
                        <div class="product-name">@movement.Product?.Name</div>
                        <div class="product-barcode">@movement.Product?.Barcode</div>
                    </div>
                </div>
            </div>
    
            <div class="movement-quantity @(movement.QuantityChange > 0 ? "positive" : "negative")">
                @(movement.QuantityChange > 0 ? "+" : "")@movement.QuantityChange
            </div>
            
            <div class="movement-type">
                <span class="badge @(movement.QuantityChange > 0 ? "bg-success" : "bg-danger")">
                    @GetMovementTypeText(movement.Type)
                </span>
            </div>
            
            <div class="movement-timestamp">
                <div>@movement.Timestamp.ToLocalTime().ToString("dd.MM.yyyy")</div>
                <small class="text-muted">@movement.Timestamp.ToLocalTime().ToString("HH:mm:ss")</small>
            </div>
            
            <div class="movement-notes">
                @if (!string.IsNullOrEmpty(movement.Notes))
                {
                    <span>@movement.Notes</span>
                }
                @if (!string.IsNullOrEmpty(movement.ScannedBarcode))
                {
                    <br />
                    <small class="text-muted">Barcode: @movement.ScannedBarcode</small>
                }
            </div>
        </div>
    }
</InfiniteScroll>

@code {
    [Parameter, EditorRequired]
    public List<StockMovement> Movements { get; set; } = new();

    [Parameter]
    public EventCallback OnLoadMore { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool HasMore { get; set; } = true;

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    private string GetMovementClass(StockMovement movement) =>
        movement.QuantityChange > 0 ? "movement-in" : "movement-out";

    private string GetMovementIcon(StockMovement movement) =>
    movement.QuantityChange > 0 ? "bi-arrow-down-circle-fill" : "bi-arrow-up-circle-fill";

    private string GetMovementTypeText(MovementType type) =>
        type switch
        {
            MovementType.ManualAdd => T.MovementType_ManualAdd,
            MovementType.ManualRemove => T.MovementType_ManualRemove,
            MovementType.ScanAdd => T.MovementType_ScanAdd,
            MovementType.ScanRemove => T.MovementType_ScanRemove,
            MovementType.Adjustment => T.MovementType_Adjustment,
            MovementType.Initial => T.MovementType_Initial,
            _ => type.ToString()
        };
}
