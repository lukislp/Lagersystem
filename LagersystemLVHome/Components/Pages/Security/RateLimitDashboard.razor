@code {
    private string activeTab = "limits";
    private bool loading = false; // only true on initial load
    private bool isInitialLoad = true;
    private List<RateLimitEntry> activeLimits = new();
    private List<RateLimitViolation> violations = new();
    private List<RequestLog> recentRequests = new();
    private RateLimitStats stats = new();

    // Traffic Filter Properties
    private string trafficStatusFilter = "all";
    private string trafficEndpointFilter = "";
    private string trafficIdentifierFilter = "";

    // Configuration
    private int anonLimit = 100;
    private int authLimit = 1000;
    private int adminLimit = 5000;
    private int superAdminLimit = 50000;

    // Auto-Refresh
    private System.Threading.Timer? _refreshTimer;
    private bool _disposed = false;

    // Previous values for change detection
    private int _previousActiveBuckets = 0;
    private int _previousTotalRequests = 0;
    private int _previousBlockedRequests = 0;
    private int _previousRecentRequestsCount = 0;

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadData();
        StartAutoRefresh();
    }

    private class RateLimitEntry
    {
        public string Identifier { get; set; } = string.Empty;
        public string Endpoint { get; set; } = string.Empty;
        public int RemainingRequests { get; set; }
        public TimeSpan WindowResetsIn { get; set; }
    }

    private class RateLimitViolation
    {
        public DateTime? Timestamp { get; set; }
        public string IpAddress { get; set; } = string.Empty;
        public string Endpoint { get; set; } = string.Empty;
        public int RequestCount { get; set; }
    }

    private class RateLimitStats
    {
        public int ActiveBuckets { get; set; }
        public int TotalRequests { get; set; }
        public int BlockedRequests { get; set; }
    }

    private class RequestLog
    {
        public DateTime Timestamp { get; set; }
        public string Identifier { get; set; } = string.Empty;
        public string Endpoint { get; set; } = string.Empty;
        public bool IsSuccess { get; set; }
        public int RequestCount { get; set; }
    
        // Geo-Location Properties
        public string? Country { get; set; }
        public string? CountryCode { get; set; }
        public string? City { get; set; }
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
    }

    // Smart Auto-Refresh
    private void StartAutoRefresh()
    {
        if (_disposed || _refreshTimer != null) return;
      
        _refreshTimer = new System.Threading.Timer(async _ =>
            {
                if (!_disposed)
                {
                    await InvokeAsync(async () =>
        {
        await LoadDataSilent();
    });
                }
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        
        Logger.LogInformation("Rate Limit Dashboard: Smart Auto-Refresh aktiviert (5s Intervall)");
    }

    // Silent load with change detection
    private async Task LoadDataSilent()
    {
        try
        {
            var globalStats = RateLimitService.GetGlobalStatistics();
            var bucketsCount = RateLimitService.GetActiveBucketsCount();
            
            // Load fresh data
            var newBuckets = RateLimitService.GetAllBuckets();
            var newRequests = RateLimitService.GetRecentRequests(2000);
         
            // CHANGE DETECTION
            bool hasChanges = false;
            
            if (bucketsCount != _previousActiveBuckets ||
                    globalStats.TotalRequests != _previousTotalRequests ||
                    globalStats.BlockedRequests != _previousBlockedRequests ||
                            newRequests.Count != _previousRecentRequestsCount)
            {
                hasChanges = true;
                
                // Update data
                activeLimits.Clear();
                violations.Clear();
            
                foreach (var bucket in newBuckets)
                {
                    activeLimits.Add(new RateLimitEntry
                    {
                        Identifier = bucket.Identifier,
                        Endpoint = bucket.Endpoint,
                        RemainingRequests = bucket.Remaining,
                        WindowResetsIn = bucket.ResetIn
                    });
            
                    if (bucket.Remaining == 0)
                    {
                        violations.Add(new RateLimitViolation
                        {
                            Timestamp = DateTime.UtcNow,
                            IpAddress = bucket.Identifier,
                            Endpoint = bucket.Endpoint,
                            RequestCount = 100
                        });
                    }
                }
   
                recentRequests = newRequests.Select(sr => new RequestLog
                {
                    Timestamp = sr.Timestamp,
                    Identifier = sr.Identifier,
                    Endpoint = sr.Endpoint,
                    IsSuccess = sr.IsSuccess,
                    RequestCount = sr.RequestCount,
                    Country = sr.Country,
                    CountryCode = sr.CountryCode,
                    City = sr.City,
                    Latitude = sr.Latitude,
                    Longitude = sr.Longitude
                }).ToList();
        
                stats.ActiveBuckets = activeLimits.Count;
                stats.TotalRequests = globalStats.TotalRequests;
                stats.BlockedRequests = globalStats.BlockedRequests;
         
                // Update previous values
                _previousActiveBuckets = bucketsCount;
                _previousTotalRequests = globalStats.TotalRequests;
                _previousBlockedRequests = globalStats.BlockedRequests;
                _previousRecentRequestsCount = newRequests.Count;
  
                Logger.LogInformation("Rate Limit: Changes detected - Active: {Active}, Total: {Total}, Blocked: {Blocked}",
            stats.ActiveBuckets, stats.TotalRequests, stats.BlockedRequests);
           
                StateHasChanged();
            }
            else
            {
                Logger.LogDebug("✓ Rate Limit: No changes - skipping UI update");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in silent refresh (Rate Limit)");
        }
    }

    // Manual load (with spinner)
    private async Task LoadData()
    {
        if (isInitialLoad)
        {
            loading = true;
            StateHasChanged();
        }

        try
        {
            await LoadDataSilent();
        }
        finally
        {
            loading = false;
            isInitialLoad = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task ResetLimit(string identifier)
    {
        try
        {
            await RateLimitService.ResetLimitAsync(identifier);
            await LoadData();
            Logger.LogInformation("Rate limit reset for identifier: {Identifier}", identifier);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error resetting rate limit for {Identifier}", identifier);
        }
    }

    private List<RequestLog> GetFilteredRequests()
    {
        var filtered = recentRequests.AsEnumerable();

        if (trafficStatusFilter == "success")
            filtered = filtered.Where(r => r.IsSuccess);
        else if (trafficStatusFilter == "blocked")
            filtered = filtered.Where(r => !r.IsSuccess);

        if (!string.IsNullOrEmpty(trafficEndpointFilter))
            filtered = filtered.Where(r => r.Endpoint == trafficEndpointFilter);

        if (!string.IsNullOrEmpty(trafficIdentifierFilter))
            filtered = filtered.Where(r => r.Identifier == trafficIdentifierFilter);

        return filtered.OrderByDescending(r => r.Timestamp).ToList();
    }

    private List<string> GetUniqueEndpoints()
    {
        return recentRequests.Select(r => r.Endpoint).Distinct().OrderBy(e => e).ToList();
    }

    private List<string> GetUniqueIdentifiers()
    {
        return recentRequests.Select(r => r.Identifier).Distinct().OrderBy(i => i).ToList();
    }

    private int CalculateAverageRequestCount()
    {
        var filtered = GetFilteredRequests();
        return filtered.Any() ? (int)filtered.Average(r => r.RequestCount) : 0;
    }

    private double CalculateBlockRate()
    {
        var filtered = GetFilteredRequests();
        if (!filtered.Any()) return 0;

        var blocked = filtered.Count(r => !r.IsSuccess);
        return Math.Round((double)blocked / filtered.Count * 100, 1);
    }

    private List<(string Identifier, int Count, int BlockedCount)> GetTopIdentifiers(int count)
    {
        return recentRequests
        .GroupBy(r => r.Identifier)
        .Select(g => (
        Identifier: g.Key,
    Count: g.Count(),
    BlockedCount: g.Count(r => !r.IsSuccess)
            ))
            .OrderByDescending(x => x.Count)
            .Take(count)
.ToList();
    }

    private List<(string Endpoint, int Count)> GetTopEndpoints(int count)
    {
        return recentRequests
        .GroupBy(r => r.Endpoint)
        .Select(g => (Endpoint: g.Key, Count: g.Count()))
    .OrderByDescending(x => x.Count)
    .Take(count)
        .ToList();
    }

    // Geo-Location Helper Methods
    private bool TryGetGeoInfo(string identifier, out string? country, out string? city)
    {
        country = null;
        city = null;

        if (!identifier.StartsWith("ip:")) return false;

        var request = recentRequests.FirstOrDefault(r => r.Identifier == identifier);
        if (request == null || string.IsNullOrEmpty(request.Country)) return false;

        country = request.Country;
        city = request.City;
        return true;
    }

    private List<(string Country, string? CountryCode, int Count, int BlockedCount)> GetTopCountries()
    {
        return recentRequests
            .Where(r => !string.IsNullOrEmpty(r.Country))
            .GroupBy(r => new { r.Country, r.CountryCode })
    .Select(g => (
        Country: g.Key.Country!,
            CountryCode: g.Key.CountryCode,
        Count: g.Count(),
            BlockedCount: g.Count(r => !r.IsSuccess)
                ))
                .OrderByDescending(x => x.Count)
        .ToList();
    }

    private List<(string City, string Country, int Count)> GetTopCities()
    {
        return recentRequests
    .Where(r => !string.IsNullOrEmpty(r.City) && !string.IsNullOrEmpty(r.Country))
        .GroupBy(r => new { r.City, r.Country })
        .Select(g => (
        City: g.Key.City!,
        Country: g.Key.Country!,
    Count: g.Count()
        ))
            .OrderByDescending(x => x.Count)
    .ToList();
    }

    private string GetCountryFlag(string? countryCode)
    {
        if (string.IsNullOrEmpty(countryCode)) return "🌍";
 
        try
        {
            var code = countryCode.ToUpper();
            if (code.Length != 2) return "🌍";

            // Convert ISO code to flag emoji
            // Regional Indicator Symbols: 🇦-🇿 (U+1F1E6 - U+1F1FF)
            int firstChar = char.ToUpper(code[0]) - 'A';
            int secondChar = char.ToUpper(code[1]) - 'A';
            
            // Ensure both characters are valid (A-Z)
            if (firstChar < 0 || firstChar > 25 || secondChar < 0 || secondChar > 25)
                return "🌍";
            
            var flag = char.ConvertFromUtf32(0x1F1E6 + firstChar) +
    char.ConvertFromUtf32(0x1F1E6 + secondChar);
     
            return flag;
        }
        catch
        {
            return "🌍";
        }
    }

    private async Task ExportTrafficData()
    {
        try
        {
            var filtered = GetFilteredRequests();
            var csv = new System.Text.StringBuilder();
       
            csv.AppendLine("Timestamp,Identifier,Endpoint,Status,RequestCount,Country,City");
 
            foreach (var request in filtered)
            {
                var country = request.Country ?? "";
                var city = request.City ?? "";
                csv.AppendLine($"{request.Timestamp:yyyy-MM-dd HH:mm:ss},{GetDisplayIdentifier(request.Identifier)},{request.Endpoint},{(request.IsSuccess ? "Success" : "Blocked")},{request.RequestCount},{country},{city}");
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"traffic-log-{DateTime.Now:yyyyMMdd-HHmmss}.csv";

            await JSRuntime.InvokeVoidAsync("downloadBase64File", base64, fileName, "text/csv");

            Logger.LogInformation("Traffic data exported: {Count} entries", filtered.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting traffic data");
        }
    }

    private string GetTimeAgo(DateTime timestamp)
    {
        var timeSpan = DateTime.UtcNow - timestamp;
        
        if (timeSpan.TotalSeconds < 60)
            return $"vor {(int)timeSpan.TotalSeconds}s";
        if (timeSpan.TotalMinutes < 60)
            return $"vor {(int)timeSpan.TotalMinutes}m";
        return $"vor {(int)timeSpan.TotalHours}h";
    }

    private string GetRequestCountBadgeClass(int count)
    {
        if (count > 80) return "bg-danger";
        if (count > 50) return "bg-warning";
        if (count > 20) return "bg-info";
        return "bg-secondary";
    }

    private string GetActivityBarClass(int count)
    {
        if (count > 80) return "bg-danger";
        if (count > 50) return "bg-warning";
        if (count > 20) return "bg-info";
        return "bg-success";
    }

    private int GetActivityPercentage(int count)
    {
        var limit = 100;
        return Math.Min((int)((double)count / limit * 100), 100);
    }

    private string GetDisplayIdentifier(string identifier)
    {
        if (identifier.StartsWith("ip:"))
        {
            var ip = identifier.Substring(3);
    
            if (ip == "localhost-ipv6")
                return "localhost (IPv6: ::1)";
        
            if (ip == "localhost-ipv4")
                return "localhost (IPv4: 127.0.0.1)";
       
            if (ip == "::1")
                return "localhost (::1)";
    
            if (ip == "127.0.0.1")
                return "localhost (127.0.0.1)";
     
            return ip;
        }
    
        if (identifier.StartsWith("user:"))
            return $"User #{identifier.Substring(5)}";
        
        if (identifier.StartsWith("apikey:"))
            return $"API Key: {identifier.Substring(7, Math.Min(10, identifier.Length - 7))}...";

        if (identifier.StartsWith("token:"))
            return $"Token: {identifier.Substring(6, Math.Min(10, identifier.Length - 6))}...";
  
        return identifier;
    }

    private string GetRemainingClass(int remaining)
    {
        if (remaining > 50) return "bg-success";
        if (remaining > 10) return "bg-warning";
        return "bg-danger";
    }

    private string FormatTimeSpan(TimeSpan timeSpan)
    {
        if (timeSpan.TotalMinutes >= 1)
            return $"{(int)timeSpan.TotalMinutes}m {timeSpan.Seconds}s";
        return $"{timeSpan.Seconds}s";
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
      
        _refreshTimer?.Dispose();
        _refreshTimer = null;
      
        Logger.LogInformation("Rate Limit Dashboard: Auto-refresh disabled");
    }
}
