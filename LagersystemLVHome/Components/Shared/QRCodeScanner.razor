@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="qrcode-scanner-container">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        </div>
    }

    @if (!isScanning)
    {
        <div class="text-center mb-3">
            <button class="btn btn-success btn-lg" @onclick="StartScanning">
                <i class="bi bi-qr-code-scan me-2"></i>QR-Scanner starten
            </button>
        </div>
    }

    @if (isScanning)
    {
        <div class="scanner-active mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-success">
                    <i class="bi bi-record-circle-fill blink me-2"></i>QR-Scanner aktiv
                </span>
                <button class="btn btn-danger btn-sm" @onclick="StopScanning">
                    <i class="bi bi-stop-circle me-1"></i>Stop
                </button>
            </div>

            <div class="qr-scanner-viewport">
                <div id="@readerId" class="qr-reader"></div>
            
                <div class="qr-scan-overlay">
                    <div class="qr-corner qr-top-left"></div>
                    <div class="qr-corner qr-top-right"></div>
                    <div class="qr-corner qr-bottom-left"></div>
                    <div class="qr-corner qr-bottom-right"></div>
                    <div class="qr-scan-text">QR-Code scannen</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(lastQRCode))
            {
                <div class="alert alert-success mt-3 scan-result">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>Letzter Scan:</strong>
                    <div class="mt-1">
                        <code class="fs-5">@lastQRCode</code>
                        <span class="ms-2 text-muted">(@lastScanTime.ToString("HH:mm:ss"))</span>
                    </div>
                </div>
            }
        </div>
    }
</div>


@code {
    [Parameter]
    public EventCallback<string> OnScanned { get; set; }

    [Parameter]
    public string ScannerLabel { get; set; } = "QR-Code";

    private IJSObjectReference? module;
    private DotNetObjectReference<QRCodeScanner>? dotNetRef;
    private bool isScanning = false;
    private string? errorMessage;
    private string lastQRCode = string.Empty;
    private DateTime lastScanTime = DateTime.Now;
    private string readerId = $"qr-reader-{Guid.NewGuid():N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/qr-code-scanner.js");
                dotNetRef = DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("init", dotNetRef);
            }
            catch (Exception ex)
            {
                errorMessage = $"QR-Scanner konnte nicht initialisiert werden: {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private async Task StartScanning()
    {
        if (module == null) return;

        errorMessage = null;
        isScanning = true;
        StateHasChanged();

        await Task.Delay(200);

        try
        {
            await module.InvokeVoidAsync("startQRScanner", readerId);
        }
        catch (Exception ex)
        {
            errorMessage = $"QR-Scanner konnte nicht gestartet werden: {ex.Message}";
            isScanning = false;
            StateHasChanged();
        }
    }

    private async Task StopScanning()
    {
        if (module != null)
        {
            await module.InvokeVoidAsync("stopQRScanner");
        }
        isScanning = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnQRCodeDetected(string qrCode)
    {
        if (string.IsNullOrWhiteSpace(qrCode))
            return;

        lastQRCode = qrCode;
        lastScanTime = DateTime.Now;

        await InvokeAsync(StateHasChanged);

        if (OnScanned.HasDelegate)
        {
            try
            {
                await OnScanned.InvokeAsync(qrCode);
            }
            catch
            {
            }
        }
    }

    [JSInvokable]
    public async Task OnError(string error)
    {
        errorMessage = error;
        isScanning = false;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module != null)
            {
                await module.InvokeVoidAsync("stopQRScanner");
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
        }
        catch
        {
            // Ignore disposal errors
        }

        dotNetRef?.Dispose();
    }
}
