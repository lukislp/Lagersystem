@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject I18nText I18nText

<div class="infinite-scroll" @ref="scrollContainer">
    @ChildContent

    @if (IsLoading)
    {
        <div class="infinite-scroll-loading">
            @if (LoadingTemplate != null)
            {
                @LoadingTemplate
            }
            else
            {
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@(T.InfiniteScroll_Loading ?? "Lade mehr...")</span>
                </div>
                <p class="mt-2 text-muted">@(T.InfiniteScroll_Loading ?? "Lade mehr Einträge...")</p>
            }
        </div>
    }

    @if (HasMore && !IsLoading)
    {
        <div class="infinite-scroll-trigger" @ref="triggerElement"></div>
    }

    @if (!HasMore && ShowEndMessage)
    {
        <div class="infinite-scroll-end">
            @if (EndTemplate != null)
            {
                @EndTemplate
            }
            else
            {
                <p class="text-muted">
                    <i class="bi bi-check-circle"></i> Alle Einträge geladen
                </p>
            }
        </div>
    }
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    private ElementReference scrollContainer;
    private ElementReference triggerElement;
    private DotNetObjectReference<InfiniteScroll>? dotNetRef;
    private IJSObjectReference? jsModule;

    /// <summary>
    /// Child content (the items to display)
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Callback fired when more data should be loaded
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback OnLoadMore { get; set; }

    /// <summary>
    /// Indicates whether a load is currently in progress
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Indicates whether more data is available
    /// </summary>
    [Parameter]
    public bool HasMore { get; set; } = true;

    /// <summary>
    /// Template for the loading state
    /// </summary>
    [Parameter]
    public RenderFragment? LoadingTemplate { get; set; }

    /// <summary>
    /// Template for the "all loaded" message
    /// </summary>
    [Parameter]
    public RenderFragment? EndTemplate { get; set; }

    /// <summary>
    /// Show the "all loaded" message
    /// </summary>
    [Parameter]
    public bool ShowEndMessage { get; set; } = true;

    /// <summary>
    /// Threshold in pixels when loading should trigger (default: 200px before the end)
    /// </summary>
    [Parameter]
    public int Threshold { get; set; } = 200;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);

            try
            {
                jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./js/infiniteScroll.js");

                await jsModule.InvokeVoidAsync("initialize", triggerElement, dotNetRef, Threshold);
            }
            catch
            {
            }
        }
    }

    [JSInvokable]
    public async Task LoadMoreItems()
    {
        if (!IsLoading && HasMore)
        {
            await OnLoadMore.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule != null)
        {
            try
            {
                await jsModule.InvokeVoidAsync("dispose");
                await jsModule.DisposeAsync();
            }
            catch { }
        }

        dotNetRef?.Dispose();
    }
}
