@page "/"
@inherits CancellableComponentBase
@using Microsoft.EntityFrameworkCore
@using LagersystemLVHome.Domain.Models
@rendermode InteractiveServer
@inject LagersystemLVHome.Application.Services.IInventoryService InventoryService
@inject I18nText I18nText

<PageTitle>@T.Home_PageTitle</PageTitle>

<div class="page-header">
    <h1 class="page-title">@T.Home_Title</h1>
    <p class="page-subtitle">@T.Home_Subtitle</p>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner"></div>
    </div>
}
else
{
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="stat-content">
                <h3>@T.Home_TotalProducts</h3>
                <p class="stat-value">@stats.TotalProducts</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon success">
                <i class="bi bi-tags"></i>
            </div>
            <div class="stat-content">
                <h3>@T.Home_Categories</h3>
                <p class="stat-value">@stats.TotalCategories</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="stat-content">
                <h3>@T.Home_LowStock</h3>
                <p class="stat-value">@stats.LowStockCount</p>
                @if (stats.LowStockCount > 0)
                {
                    <p class="stat-change negative">@T.Home_ActionRequired</p>
                }
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <div class="stat-content">
                <h3>@T.Home_MovementsToday</h3>
                <p class="stat-value">@stats.TodayMovements</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title"><i class="bi bi-qr-code me-2"></i>@T.Home_StorageScan_Title</h3>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm @(storageScanMode == StorageScanMode.Manual ? "btn-light" : "btn-outline-light")"
                                @onclick="() => storageScanMode = StorageScanMode.Manual">
                            <i class="bi bi-keyboard"></i> @T.Home_StorageScan_Manual
                        </button>
                        <button class="btn btn-sm @(storageScanMode == StorageScanMode.Camera ? "btn-light" : "btn-outline-light")"
                                @onclick="() => storageScanMode = StorageScanMode.Camera">
                            <i class="bi bi-camera"></i> @T.Home_StorageScan_Camera
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (storageScanMode == StorageScanMode.Manual)
                    {
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                    <input type="text" class="form-control"
                                           @bind="storageCodeInput"
                                           @bind:event="oninput"
                                           @onkeydown="HandleStorageCodeKeyDown"
                                           placeholder="@T.Home_StorageScan_Placeholder" />
                                </div>
                            </div>
                            <div class="col-md-4 mt-3 mt-md-0">
                                <button class="btn btn-success btn-lg w-100" @onclick="SearchStorageLocation">
                                    <i class="bi bi-search"></i> @T.Home_StorageScan_Search
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <QRCodeScanner OnScanned="HandleStorageQRScan" ScannerLabel="@T.StorageOverview_QR_Scanner_Label" />
                            </div>
                            <div class="col-md-6">
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <strong>@T.Home_StorageScan_Hint_Strong</strong> @T.Home_StorageScan_Hint
                                </div>
                                @if (lastScannedStorage != null)
                                {
                                    <div class="alert alert-success">
                                        <strong>@T.Home_StorageScan_LastScanned:</strong> @lastScannedStorage.Code
                                        <br /><small>@lastScannedStorage.Name</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(storageMessage))
                    {
                        <div class="alert @(storageSuccess ? "alert-success" : "alert-warning") mt-3 mb-0">
                            @storageMessage
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@T.Home_Categories_Title</h3>
                    <a href="/categories" class="btn btn-secondary btn-sm">@T.Home_Categories_ShowAll</a>
                </div>
                <div class="card-body">
                    @if (stats.CategoryStats.Any())
                    {
                        <div class="category-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
                            @foreach (var cat in stats.CategoryStats.Take(3))
                            {
                                <div class="category-card"
                                     @onclick="() => NavigateToCategory(cat.Name)"
                                     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                                            border-radius: 16px; padding: 1.5rem;
                                            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                                            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                                            cursor: pointer; position: relative; overflow: hidden;
                                            min-height: 180px; display: flex; flex-direction: column;
                                            justify-content: space-between;"
                                     @onmouseover="@((MouseEventArgs e) => { })"
                                     onmouseenter="this.style.transform='translateY(-8px) scale(1.02)'; this.style.boxShadow='0 8px 25px rgba(0, 0, 0, 0.2)';"
                                     onmouseleave="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 15px rgba(0, 0, 0, 0.1)';">

                                    <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px;
                                                background: rgba(255, 255, 255, 0.1); border-radius: 50%; pointer-events: none;"></div>

                                    <div style="display: flex; align-items: center; justify-content: center;
                                                width: 64px; height: 64px; background: rgba(255, 255, 255, 0.25);
                                                border-radius: 16px; margin-bottom: 1rem; backdrop-filter: blur(10px);
                                                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); font-size: 2rem; color: white;">
                                        <CategoryIcon IconClass="@cat.Icon" />
                                    </div>

                                    <div>
                                        <div style="font-size: 1.25rem; font-weight: 700; color: white;
                                                    margin-bottom: 0.75rem; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">
                                            @cat.Name
                                        </div>
                                        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                                            <div style="display: flex; align-items: center; gap: 0.5rem;
                                                        background: rgba(255, 255, 255, 0.2); padding: 0.375rem 0.75rem;
                                                        border-radius: 8px; backdrop-filter: blur(5px);">
                                                <i class="bi bi-box" style="color: white; font-size: 1rem;"></i>
                                                <span style="color: white; font-weight: 600; font-size: 0.875rem;">
                                                    @(T.Home_CategoryProducts != null ? string.Format(T.Home_CategoryProducts, cat.ProductCount) : "")
                                                </span>
                                            </div>
                                            <div style="display: flex; align-items: center; gap: 0.5rem;
                                                        background: rgba(255, 255, 255, 0.2); padding: 0.375rem 0.75rem;
                                                        border-radius: 8px; backdrop-filter: blur(5px);">
                                                <i class="bi bi-stack" style="color: white; font-size: 1rem;"></i>
                                                <span style="color: white; font-weight: 600; font-size: 0.875rem;">
                                                    @cat.TotalQuantity @T.Home_Qty_Unit
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div style="position: absolute; bottom: 1rem; right: 1rem;
                                                color: white; font-size: 1.5rem; opacity: 0.7;
                                                transition: all 0.3s ease;">
                                        <i class="bi bi-arrow-right-circle"></i>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (stats.CategoryStats.Count > 3)
                        {
                            <div class="text-center mt-3">
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @(T.Home_MoreCategories != null ? string.Format(T.Home_MoreCategories, stats.CategoryStats.Count - 3) : "")
                                </p>
                                <a href="/categories" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-grid-3x3-gap me-1"></i>
                                    @(T.Home_ShowAllCategories != null ? string.Format(T.Home_ShowAllCategories, stats.CategoryStats.Count) : "")
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-state-icon">📦</div>
                            <div class="empty-state-title">@T.Home_NoCategories_Title</div>
                            <p>@T.Home_NoCategories_Desc</p>
                            <a href="/categories" class="btn btn-primary">@T.Home_CreateCategory</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card" style="height: 100%">
                <div class="card-header">
                    <h3 class="card-title">@T.Home_LastMovements</h3>
                    <a href="/movements" class="btn btn-secondary btn-sm">@T.Home_AllMovements</a>
                </div>
                <div class="card-body" style="max-height: none; overflow-y: auto;">
                    @if (recentMovements.Any())
                    {
                        @foreach (var movement in recentMovements.Take(10))
                        {
                            <div class="movement-item">
                                <div class="movement-icon @(movement.QuantityChange > 0 ? "in" : "out")">
                                    <i class="bi @(movement.QuantityChange > 0 ? "bi-arrow-down" : "bi-arrow-up")"></i>
                                </div>
                                <div class="movement-details">
                                    <div class="movement-product">@movement.Product?.Name</div>
                                    <div class="movement-time">@movement.Timestamp.ToLocalTime().ToString("dd.MM.yy HH:mm")</div>
                                </div>
                                <div class="movement-quantity @(movement.QuantityChange > 0 ? "positive" : "negative")">
                                    @(movement.QuantityChange > 0 ? "+" : "")@movement.QuantityChange
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-state-icon">📋</div>
                            <p>@T.Home_NoMovements</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (roomStats.Any())
        {
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="bi bi-door-open me-2"></i>
                            @T.Home_RoomsOverview_Title
                        </h3>
                        <a href="/admin/rooms" class="btn btn-secondary btn-sm">@T.Home_RoomsOverview_Manage</a>
                    </div>
                    <div class="card-body">
                        <div class="room-grid">
                            @foreach (var room in roomStats.Take(6))
                            {
                                <div class="room-card" @onclick="() => NavigateToRoom(room.RoomId)">
                                    <div class="room-header">
                                        <i class="bi bi-door-open text-primary"></i>
                                        <strong>@room.RoomName</strong>
                                    </div>
                                    <div class="room-stats">
                                        <div class="room-stat">
                                            <i class="bi bi-geo-alt text-info"></i>
                                            <span>@room.StorageLocationCount @T.Home_Room_StorageLocations</span>
                                        </div>
                                        <div class="room-stat">
                                            <i class="bi bi-box text-success"></i>
                                            <span>@room.ProductCount @T.Home_Room_Products</span>
                                        </div>
                                        <div class="room-stat">
                                            <i class="bi bi-stack text-warning"></i>
                                            <span>@room.TotalQuantity @T.Home_Room_TotalQty</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (topStorageLocations.Any())
        {
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="bi bi-geo-alt me-2"></i>
                            @T.Home_TopStorage_Title
                        </h3>
                        <a href="/storage-overview" class="btn btn-secondary btn-sm">@T.Home_TopStorage_ShowAll</a>
                    </div>
                    <div class="card-body">
                        <div class="storage-list">
                            @foreach (var storage in topStorageLocations.Take(8))
                            {
                                <div class="storage-item" @onclick="() => NavigateToStorage(storage.Id)">
                                    <div class="storage-info">
                                        <code class="storage-code">@storage.Code</code>
                                        <small class="text-muted">@storage.Name</small>
                                        @if (!string.IsNullOrEmpty(storage.Room))
                                        {
                                            <span class="badge bg-info ms-2">@storage.Room</span>
                                        }
                                    </div>
                                    <div class="storage-count">
                                        <span class="badge bg-primary">@storage.ProductCount @T.Home_Storage_Products</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (lowStockProducts.Any())
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-header" style="background: rgba(239, 68, 68, 0.1);">
                        <h3 class="card-title" style="color: var(--danger-color);">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @T.Home_LowStock_Title
                        </h3>
                        <a href="/low-stock" class="btn btn-danger btn-sm">@T.Home_LowStock_ShowAll</a>
                    </div>
                    <div class="card-body">
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>@T.Home_LowStock_Col_Product</th>
                                        <th>@T.Home_LowStock_Col_Category</th>
                                        <th>@T.Home_LowStock_Col_CurrentStock</th>
                                        <th>@T.Home_LowStock_Col_MinStock</th>
                                        <th>@T.Home_LowStock_Col_Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in lowStockProducts.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <div class="product-info">
                                                    <div class="product-icon">
                                                        <CategoryIcon IconClass="@(product.Category?.Icon ?? "bi-box")" />
                                                    </div>
                                                    <div>
                                                        <div class="product-name">@product.Name</div>
                                                        <div class="product-barcode">@product.Barcode</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@product.Category?.Name</td>
                                            <td>
                                                <span class="stock-badge @(product.Quantity == 0 ? "critical" : "low")">
                                                        @product.Quantity @T.Home_Qty_Unit
                                                    </span>
                                            </td>
                                            <td>@product.MinQuantity</td>
                                            <td>
                                                <button class="btn btn-success btn-sm" @onclick="() => QuickAddStock(product)">
                                                    <i class="bi bi-plus"></i> @T.Home_LowStock_Refill
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (showDistributionModal && distributionProduct != null)
{
    <div class="modal-backdrop" @onclick="CloseDistributionModal">
        <div class="modal-content" style="max-width: 800px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="bi bi-grid-3x3-gap me-2"></i>
                    @T.Home_Distribution_Title @distributionProduct.Name
                </h3>
                <button class="modal-close" @onclick="CloseDistributionModal">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">@T.Home_Distribution_Qty</label>
                    <div class="d-flex gap-2 align-items-center">
                        <button class="btn btn-secondary" @onclick="() => distributionQuantity = Math.Max(1, distributionQuantity - 1)">−</button>
                        <input type="number" @bind="distributionQuantity" min="1" style="width: 100px; text-align: center;" class="form-control form-control-lg" />
                        <button class="btn btn-secondary" @onclick="() => distributionQuantity++">+</button>
                    </div>
                </div>

                    <StorageDistributionPanel ProductId="@distributionProduct.Id"
                                              TotalQuantity="@distributionQuantity"
                                              @bind-DistributionItems="dashboardDistributionItems" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDistributionModal">@T.Home_Distribution_Cancel</button>
                    <button class="btn btn-success"
                            @onclick="() => ConfirmDistribution(true)"
                            disabled="@(!IsDistributionValid())">
                        <i class="bi bi-plus-lg"></i> @T.Home_Distribution_In
                    </button>
                    <button class="btn btn-danger"
                            @onclick="() => ConfirmDistribution(false)"
                            disabled="@(!IsDistributionValid())">
                        <i class="bi bi-dash-lg"></i> @T.Home_Distribution_Out
                    </button>
                </div>
            </div>
        </div>
    }

    @code {
        private bool isLoading = true;
        private LagersystemLVHome.Application.Services.DashboardStats stats = new();
        private List<LagersystemLVHome.Domain.Models.StockMovement> recentMovements = new();
        private List<LagersystemLVHome.Domain.Models.Product> lowStockProducts = new();
        private List<RoomStatistic> roomStats = new();
        private List<StorageLocationWithCount> topStorageLocations = new();

        private string scannerInput = string.Empty;
        private string scanMessage = string.Empty;
        private bool scanSuccess = false;
        private LagersystemLVHome.Domain.Models.Product? lastScannedProduct;

        private QuickScanMode quickScanMode = QuickScanMode.Manual;
        private QuickCameraAction quickCameraAction = QuickCameraAction.Add;

        private StorageScanMode storageScanMode = StorageScanMode.Manual;
        private string storageCodeInput = string.Empty;
        private string storageMessage = string.Empty;
        private bool storageSuccess = false;
        private StorageLocation? lastScannedStorage = null;

        private bool showDistributionModal = false;
        private Product? distributionProduct = null;
        private int distributionQuantity = 1;
        private List<StorageDistributionPanel.StorageDistributionItem> dashboardDistributionItems = new();

        [Inject] private NavigationManager? NavigationManager { get; set; }
        [Inject] private LagersystemLVHome.Application.Services.ILocationQueryService? LocationQueryService { get; set; }
        [Inject] private LagersystemLVHome.Application.Services.IAuthService? AuthService { get; set; }
        [Inject] private LagersystemLVHome.Application.Services.IAuditService? AuditService { get; set; }
        [Inject] private I18nText? _i18nText { get; set; }
        private LagersystemLVHome.I18nText.App T = new();

        protected override async Task OnInitializedAsync()
        {
            if (_i18nText != null)
                T = await _i18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
            await LoadDashboardData();
        }

        private async Task LoadDashboardData()
        {
            isLoading = true;
            try
            {
                stats = await InventoryService.GetDashboardStatsAsync();
                recentMovements = (await InventoryService.GetRecentMovementsAsync(10)).ToList();
                lowStockProducts = (await InventoryService.GetLowStockProductsAsync()).ToList();
                await LoadRoomStatistics();
                await LoadTopStorageLocations();
            }
            catch (Exception)
            {
                stats = new LagersystemLVHome.Application.Services.DashboardStats();
            }
            finally
            {
                isLoading = false;
            }
        }

        private async Task LoadRoomStatistics()
        {
            if (LocationQueryService == null || AuthService == null) return;

            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) return;

            var rooms = await LocationQueryService.GetRoomsWithStatsAsync(currentUser.WarehouseId);

            roomStats = rooms
                .Select(r => new RoomStatistic
                {
                    RoomId = r.Room.Id,
                    RoomName = r.Room.Name,
                    RoomCode = r.Room.Code,
                    StorageLocationCount = r.StorageLocationCount,
                    ProductCount = r.DistinctProductCount,
                    TotalQuantity = r.TotalQuantity
                })
                .OrderByDescending(r => r.ProductCount)
                .ToList();
        }

        private async Task LoadTopStorageLocations()
        {
            if (LocationQueryService == null || AuthService == null) return;

            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) return;

            var overview = await LocationQueryService.GetStorageOverviewAsync(currentUser.WarehouseId);

            topStorageLocations = overview.Locations
                .Select(l => new StorageLocationWithCount
                {
                    Id = l.Location.Id,
                    Code = l.Location.Code,
                    Name = l.Location.Name,
                    Room = l.Location.Room,
                    ProductCount = l.DistinctProductCount
                })
                .OrderByDescending(sl => sl.ProductCount)
                .Take(8)
                .ToList();
                }

                private async Task HandleScannerKeyDown(KeyboardEventArgs e)
                {
                    if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(scannerInput))
                    {
                        await ProcessScan(true);
                    }
                }

                private async Task HandleQuickCameraScan(string barcode)
                {
                    if (string.IsNullOrEmpty(barcode)) return;

                    scannerInput = barcode;
                    await ProcessScan(quickCameraAction == QuickCameraAction.Add);
                }

                private async Task ProcessScan(bool isAdd)
                {
                    if (string.IsNullOrWhiteSpace(scannerInput))
                    {
                        scanMessage = T.Home_Scan_EnterBarcode;
                        scanSuccess = false;
                        return;
                    }

                    LagersystemLVHome.Domain.Models.Product? result;
                    if (isAdd)
                    {
                        result = await InventoryService.AddStockByScanAsync(scannerInput);
                        if (result != null)
                        {
                            scanMessage = string.Format(T.Home_Scan_StockIncreased, result.Name, result.Quantity);
                            scanSuccess = true;
                            lastScannedProduct = result;
                        }
                    }
                    else
                    {
                        result = await InventoryService.RemoveStockByScanAsync(scannerInput);
                        if (result != null)
                        {
                            scanMessage = string.Format(T.Home_Scan_StockDecreased, result.Name, result.Quantity);
                            scanSuccess = true;
                            lastScannedProduct = result;
                        }
                    }

                    if (result == null)
                    {
                        scanMessage = string.Format(T.Home_Scan_NotFound, scannerInput);
                        scanSuccess = false;
                    }
                    else
                    {
                        scannerInput = string.Empty;
                        await LoadDashboardData();
                    }
                }

                private async Task QuickAddStock(LagersystemLVHome.Domain.Models.Product product)
                {
                    var quantity = product.MinQuantity - product.Quantity + 10;
                    await InventoryService.AdjustStockAsync(product.Id, product.Quantity + quantity, T.Home_QuickRefill_Note);
                    await LoadDashboardData();
                }

                private async Task OpenDistributionModal()
                {
                    if (string.IsNullOrWhiteSpace(scannerInput))
                    {
                        scanMessage = T.Home_Scan_EnterBarcode;
                        scanSuccess = false;
                        return;
                    }

                    distributionProduct = await InventoryService.GetProductByBarcodeAsync(scannerInput);

                    if (distributionProduct == null)
                    {
                        scanMessage = string.Format(T.Home_Scan_NotFoundDist, scannerInput);
                        scanSuccess = false;
                        return;
                    }

                    distributionQuantity = 1;
                    dashboardDistributionItems = new();
                    showDistributionModal = true;
                }

                private void CloseDistributionModal()
                {
                    showDistributionModal = false;
                    distributionProduct = null;
                    dashboardDistributionItems.Clear();
                }

                private bool IsDistributionValid()
                {
                    return dashboardDistributionItems.Sum(x => x.Quantity) == distributionQuantity;
                }

                private async Task ConfirmDistribution(bool isAdd)
                {
                    if (distributionProduct == null || AuthService == null) return;

                    try
                    {
                        var command = new LagersystemLVHome.Application.Services.ScannerMovementCommand(
                            ProductId: distributionProduct.Id,
                            IsAdd: isAdd,
                            Quantity: distributionQuantity,
                            Barcode: scannerInput,
                            WarehouseId: AuthService.GetCurrentWarehouseId(),
                            Distribution: dashboardDistributionItems
                                .Where(x => x.Quantity > 0)
                                .Select(x => new LagersystemLVHome.Application.Services.ProductStorageLocationAssignment(x.StorageLocation.Id, x.Quantity))
                                .ToList(),
                            ProcessBatch: false,
                            SelectedBatchId: null,
                            BatchNumber: null,
                            BatchExpiryDate: null,
                            BatchManufactureDate: null,
                            BatchNotes: null,
                            MovementNotes: T.Home_Distribution_MovementNote);

                        var result = await InventoryService.ProcessScannerMovementAsync(command);

                        if (result.IsFailure)
                        {
                            scanMessage = string.Format(T.Home_Scan_Error, result.ErrorMessage);
                            scanSuccess = false;
                            return;
                        }

                        distributionProduct.Quantity = isAdd
                            ? distributionProduct.Quantity + distributionQuantity
                            : Math.Max(0, distributionProduct.Quantity - distributionQuantity);

                        if (AuditService != null)
                        {
                            await AuditService.LogStockMovementAsync(
                                distributionProduct.Id,
                                distributionProduct.Name,
                                isAdd ? distributionQuantity : -distributionQuantity,
                                isAdd ? nameof(MovementType.ScanAdd) : nameof(MovementType.ScanRemove));
                        }

            scanMessage = string.Format(T.Home_Distribution_Success, isAdd ? T.MovementType_ScanAdd : T.MovementType_ScanRemove, distributionProduct.Name, distributionQuantity);
            scanSuccess = true;
            lastScannedProduct = distributionProduct;
            scannerInput = string.Empty;

            CloseDistributionModal();
            await LoadDashboardData();
        }
        catch (Exception ex)
        {
            scanMessage = $"Fehler: {ex.Message}";
            scanSuccess = false;
        }
    }

    private void NavigateToCategory(string categoryName)
    {
        var category = stats.CategoryStats.FirstOrDefault(c => c.Name == categoryName);
        if (category != null)
        {
            NavigationManager?.NavigateTo($"/products?category={Uri.EscapeDataString(categoryName)}");
        }
    }

    private void NavigateToRoom(int roomId)
    {
        NavigationManager?.NavigateTo($"/rooms/{roomId}/products");
    }

    private void NavigateToStorage(int storageId)
    {
        NavigationManager?.NavigateTo($"/storage/{storageId}");
    }

    private async Task HandleStorageCodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(storageCodeInput))
        {
            await SearchStorageLocation();
        }
    }

    private async Task HandleStorageQRScan(string code)
    {
        if (string.IsNullOrWhiteSpace(code)) return;

        storageCodeInput = code;
        await SearchStorageLocation();
    }

    private async Task SearchStorageLocation()
    {
        if (string.IsNullOrWhiteSpace(storageCodeInput))
        {
            storageMessage = T.Home_Storage_EnterCode;
            storageSuccess = false;
            return;
        }

        if (LocationQueryService == null)
        {
            storageMessage = T.Home_Storage_NoContext;
            storageSuccess = false;
            return;
        }

        if (AuthService == null)
        {
            storageMessage = T.Home_Storage_NoAuth;
            storageSuccess = false;
            return;
        }

        if (NavigationManager == null)
        {
            storageMessage = T.Home_Storage_NoNav;
            storageSuccess = false;
            return;
        }

        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null)
            {
                storageMessage = T.Home_Storage_NotAuthenticated;
                storageSuccess = false;
                return;
            }

            var searchCode = storageCodeInput;
            var storage = LocationQueryService == null
                ? null
                : await LocationQueryService.FindActiveStorageLocationByCodeAsync(currentUser.WarehouseId, searchCode);

            if (storage != null)
            {
                lastScannedStorage = storage;
                storageMessage = string.Format(T.Home_Storage_Found, storage.Code);
                storageSuccess = true;
                StateHasChanged();

                await Task.Delay(1000);
                NavigationManager.NavigateTo($"/storage/{storage.Id}", forceLoad: false);
            }
            else
            {
                storageMessage = string.Format(T.Home_Storage_NotFound, storageCodeInput);
                storageSuccess = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            storageMessage = $"Fehler: {ex.Message}";
            storageSuccess = false;
            StateHasChanged();
        }
    }

