@using LagersystemLVHome.Application.Services
@inject I18nText I18nText

<div class="row g-3">
    <div class="col-12">
        <label class="form-label">
            <i class="bi bi-cloud me-1"></i>
            AWS S3 Bucket Name *
        </label>
        <input type="text" class="form-control" @bind="Config.BucketName"
               placeholder="my-lagersystem-backups" />
        <small class="text-muted">@(T.BackupProvider_S3_BucketLabel ?? "Name des S3 Buckets")</small>
    </div>

    <div class="col-md-6">
        <label class="form-label">
            <i class="bi bi-geo me-1"></i>
            AWS Region *
        </label>
        <select class="form-select" @bind="Config.Region">
            <option value="eu-central-1">EU (Frankfurt) - eu-central-1</option>
            <option value="eu-west-1">EU (Ireland) - eu-west-1</option>
            <option value="us-east-1">US East (N. Virginia) - us-east-1</option>
            <option value="us-west-2">US West (Oregon) - us-west-2</option>
            <option value="ap-southeast-1">Asia Pacific (Singapore)</option>
            <option value="ap-northeast-1">Asia Pacific (Tokyo)</option>
        </select>
    </div>

    <div class="col-md-6">
        <label class="form-label">
            <i class="bi bi-key me-1"></i>
            Access Key ID *
        </label>
        <input type="text" class="form-control" @bind="Config.AccessKey"
               placeholder="AKIAIOSFODNN7EXAMPLE" />
    </div>

    <div class="col-12">
        <label class="form-label">
            <i class="bi bi-shield-lock me-1"></i>
            Secret Access Key *
        </label>
        <input type="password" class="form-control" @bind="Config.SecretKey"
               placeholder="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY" />
        <small class="text-muted">@(T.BackupProvider_S3_Encrypted ?? "Wird verschl\u00fcsselt gespeichert")</small>
    </div>

    <!-- Max Backups -->
    <div class="col-md-6">
        <label class="form-label">
            <i class="bi bi-clock-history me-1"></i>
            Maximale Anzahl Backups
        </label>
        <InputNumber class="form-control" @bind-Value="Config.MaxBackups"
                     min="1" max="365" />
        <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            @(T.BackupProvider_S3_MaxBackupsHint ?? "Älteste Backups werden automatisch gelöscht (Standard: 30)")
        </small>
    </div>

    <div class="col-12">
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-2"></i>
            <strong>@(T.BackupProvider_S3_SetupTitle ?? "AWS S3 Setup:")</strong>
            <ol class="mb-0 mt-2">
                <li>@(T.BackupProvider_S3_Step1 ?? "Erstelle einen S3 Bucket in der AWS Console")</li>
                <li>@(T.BackupProvider_S3_Step2 ?? "Erstelle einen IAM User mit folgenden Rechten:"):</li>
                <ul>
                    <li><code>s3:PutObject</code></li>
                    <li><code>s3:GetObject</code></li>
                    <li><code>s3:ListBucket</code></li>
                    <li><code>s3:DeleteObject</code> (für automatischen Cleanup)</li>
                </ul>
                <li>@(T.BackupProvider_S3_Step3 ?? "Generiere Access Keys für den IAM User")</li>
                <li>@(T.BackupProvider_S3_Step4 ?? "Trage Bucket-Name, Region und Keys hier ein")</li>
            </ol>
        </div>
    </div>
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    [Parameter] public AwsS3Config Config { get; set; } = new();
    [Parameter] public EventCallback<AwsS3Config> ConfigChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }
}
