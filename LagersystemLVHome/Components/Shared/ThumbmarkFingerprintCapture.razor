@* Thumbmarkjs Device Fingerprint Capture Component *@
@* This component captures the precise browser fingerprint via Thumbmarkjs after login *@
@* and updates the active session with the fingerprint *@

@rendermode InteractiveServer

@using Soenneker.Blazor.Thumbmarkjs
@using Soenneker.Blazor.Thumbmarkjs.Abstract
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using LagersystemLVHome.Data
@using LagersystemLVHome.Application.Services
@inject IAuthService AuthService
@inject ISessionManagementService SessionService
@inject ILogger<ThumbmarkFingerprintCapture> Logger
@inject IJSRuntime JSRuntime

@* Thumbmarkjs Komponente (hidden) - generiert automatisch Fingerprint *@
<Thumbmarkjs @ref="_thumbmarkjs" OnGenerated="OnFingerprintGenerated" style="display:none;" />

@code {
    private Thumbmarkjs? _thumbmarkjs;
    private bool _fingerprintCaptured = false;
    private string? _lastCapturedFingerprint;
    private string _instanceId = Guid.NewGuid().ToString("N")[..8];

    protected override void OnInitialized()
    {
        Logger.LogInformation("ThumbmarkFingerprintCapture: OnInitialized, InstanceId: {InstanceId}", _instanceId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Logger.LogInformation("ThumbmarkFingerprintCapture: OnAfterRenderAsync (firstRender=true), InstanceId: {InstanceId}", _instanceId);
       
            // Wait briefly, then fetch the fingerprint manually in case OnGenerated did not fire
            await Task.Delay(2000);
     
            if (!_fingerprintCaptured && _thumbmarkjs != null)
            {
                Logger.LogInformation("ThumbmarkFingerprintCapture: Manually calling Get() after timeout...");
                try
                {
                    var fingerprint = await _thumbmarkjs.Get();
                    if (!string.IsNullOrEmpty(fingerprint))
                    {
                        await SaveFingerprintAsync(fingerprint);
                    }
                    else
                    {
                        Logger.LogWarning("ThumbmarkFingerprintCapture: Manual Get() returned empty");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "ThumbmarkFingerprintCapture: Error calling manual Get()");
                }
            }
        }
    }

    /// <summary>
    /// Callback invoked when Thumbmarkjs has generated the fingerprint
    /// </summary>
    private async Task OnFingerprintGenerated(string fingerprint)
    {
        Logger.LogInformation("ThumbmarkFingerprintCapture: OnFingerprintGenerated callback fired! FP: {Fingerprint}",
                string.IsNullOrEmpty(fingerprint) ? "EMPTY" : fingerprint[..Math.Min(20, fingerprint.Length)] + "...");

        if (!string.IsNullOrEmpty(fingerprint))
        {
            await SaveFingerprintAsync(fingerprint);
        }
    }

    private async Task SaveFingerprintAsync(string fingerprint)
    {
        if (_fingerprintCaptured)
        {
            Logger.LogDebug("ThumbmarkFingerprintCapture: Already captured, skipping save");
            return;
        }

        if (string.IsNullOrEmpty(fingerprint))
        {
            Logger.LogWarning("ThumbmarkFingerprintCapture: Cannot save empty fingerprint");
            return;
        }

        // Prevent saving the same fingerprint twice
        if (_lastCapturedFingerprint == fingerprint)
        {
            Logger.LogDebug("ThumbmarkFingerprintCapture: Fingerprint unchanged, skipping");
            return;
        }

        try
        {
            // Check whether the user is logged in
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null)
            {
                Logger.LogWarning("ThumbmarkFingerprintCapture: No user logged in, cannot save fingerprint");
                return;
            }

            // Get the current session id
            var sessionId = await AuthService.GetCurrentSessionIdAsync();
            if (string.IsNullOrEmpty(sessionId))
            {
                Logger.LogWarning("ThumbmarkFingerprintCapture: No active session found for user {UserId}", user.Id);
                return;
            }

            // Update the session in the database via the session service
            var updated = await SessionService.UpdateSessionFingerprintAsync(sessionId, fingerprint);

            if (updated)
            {
                // Also store the fingerprint in a cookie for middleware access
                try
                {
                    await JSRuntime.InvokeVoidAsync("cookieHelper.setCookie", "DeviceFingerprint", fingerprint, 30, "Strict");
                    Logger.LogDebug("Fingerprint cookie set: {Fingerprint}", fingerprint[..Math.Min(16, fingerprint.Length)] + "...");
                }
                catch (Exception cookieEx)
                {
                    Logger.LogWarning(cookieEx, "Could not set fingerprint cookie via JS");
                }

                _lastCapturedFingerprint = fingerprint;
                _fingerprintCaptured = true;

                Logger.LogInformation(
                    "ThumbmarkFingerprintCapture: SUCCESS! Saved Thumbmarkjs fingerprint for session {SessionId}, user {UserId}. NewFP: {NewFP}",
                    sessionId[..Math.Min(8, sessionId.Length)] + "...",
                    user.Id,
                    fingerprint[..Math.Min(16, fingerprint.Length)] + "...");
            }
            else
            {
                Logger.LogWarning("ThumbmarkFingerprintCapture: Session {SessionId} not found in database", sessionId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ThumbmarkFingerprintCapture: Error saving fingerprint - {Message}", ex.Message);
        }
    }

    public async Task RefreshFingerprintAsync()
    {
        Logger.LogInformation("ThumbmarkFingerprintCapture: RefreshFingerprintAsync called");
        _fingerprintCaptured = false;
        _lastCapturedFingerprint = null;
     
        if (_thumbmarkjs != null)
        {
            var fingerprint = await _thumbmarkjs.Get();
            if (!string.IsNullOrEmpty(fingerprint))
            {
                await SaveFingerprintAsync(fingerprint);
            }
        }
    }
}
