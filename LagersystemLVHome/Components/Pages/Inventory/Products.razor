    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        imageUploadError = null;

        try
        {
            if (editingProduct == null) return;

            var file = e.File;

            if (!string.IsNullOrEmpty(editingProduct.ImageUrl))
            {
                await ImageService.DeleteProductImageAsync(editingProduct.ImageUrl, editingProduct.ThumbnailUrl);
            }

            var (imageUrl, thumbnailUrl) = await ImageService.UploadProductImageAsync(file, editingProduct.Id);
            editingProduct.ImageUrl = imageUrl;
            editingProduct.ThumbnailUrl = thumbnailUrl;
        }
        catch (Exception ex)
        {
            imageUploadError = ex.Message;
        }
    }

    private async Task RemoveImage()
