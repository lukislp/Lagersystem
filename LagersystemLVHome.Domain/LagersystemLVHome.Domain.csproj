<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LagersystemLVHome</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!--
    Pure POCO / value-type layer: Domain models, enums and Result<T>.
    Must not depend on EF Core, ASP.NET Core or any external I/O library.
    System.ComponentModel.DataAnnotations is part of the framework and
    allowed for attribute-driven validation.
  -->

</Project>
