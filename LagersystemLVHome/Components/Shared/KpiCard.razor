<div class="kpi-card border-@Color @(Clickable ? "clickable" : "")" @onclick="HandleClick">
    <div class="kpi-icon text-@Color">
        <i class="bi @Icon"></i>
    </div>
    <div class="kpi-content">
        <h3 class="kpi-value">@Value</h3>
        <p class="kpi-title text-muted">@Title</p>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <small class="kpi-subtitle text-muted d-block">@Subtitle</small>
        }
        @if (!string.IsNullOrEmpty(Trend))
        {
            <span class="kpi-trend @(TrendUp ? "text-success" : "text-danger")">
                <i class="bi @(TrendUp ? "bi-arrow-up" : "bi-arrow-down")"></i>
                @Trend
            </span>
        }
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "bi-graph-up";
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Trend { get; set; }
    [Parameter] public bool TrendUp { get; set; } = true;
    [Parameter] public bool Clickable { get; set; } = false;
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task HandleClick()
    {
        if (Clickable && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}
