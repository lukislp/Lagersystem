@page "/register"
@inherits CancellableComponentBase
@using System.ComponentModel.DataAnnotations
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using LagersystemLVHome.Application.Services
@using Microsoft.EntityFrameworkCore
@layout EmptyLayout
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject IUserProfileService UserProfileService
@inject IUserRegistrationService UserRegistrationService
@inject IPasswordValidationService PasswordValidator
@inject NavigationManager NavigationManager
@inject IWarehouseService WarehouseService
@inject IGdprService GdprService
@inject IImageService ImageService
@inject IWebAuthnService WebAuthnService
@inject IJSRuntime JSRuntime
@inject ILogger<Register> Logger
@inject I18nText I18nText

<PageTitle>@T.Register_PageTitle</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-person-plus login-logo"></i>
            <h1>LagerSystem</h1>
            <p>@T.Register_Subtitle_Full</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-2"></i>
                @successMessage
            </div>
        }

        <EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="RegisterForm">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label">@T.Register_Username</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <InputText class="form-control form-control-lg" @bind-Value="registerModel.Username"
                               placeholder="mustermann" autocomplete="username" />
                </div>
                <ValidationMessage For="() => registerModel.Username" />
            </div>

            <div class="form-group">
                <label class="form-label">@T.Register_Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <InputText type="email" class="form-control form-control-lg" @bind-Value="registerModel.Email"
                               placeholder="max.mustermann@example.com" autocomplete="email" />
                </div>
                <ValidationMessage For="() => registerModel.Email" />
            </div>

            <div class="form-group">
                <label class="form-label">@T.Register_DisplayName</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                    <InputText class="form-control form-control-lg" @bind-Value="registerModel.DisplayName"
                               placeholder="Max Mustermann" autocomplete="name" />
                </div>
                <ValidationMessage For="() => registerModel.DisplayName" />
            </div>

            <!-- Profile image (optional) -->
            <div class="form-group">
                <label class="form-label">@T.Register_ProfileImage</label>
                <ProfileImageUpload CurrentImagePath="@profileImagePath"
                                    OnImageUploaded="HandleProfileImageUploaded" />
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    @T.Register_ProfileImage_Hint
                </small>
            </div>

            <div class="form-group">
                <label class="form-label">@T.Register_WarehouseOption</label>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="warehouseOption" id="existingWarehouse"
                           checked="@(!createNewWarehouse)"
                           @onchange="() => createNewWarehouse = false" />
                    <label class="form-check-label" for="existingWarehouse">
                        <i class="bi bi-building me-1"></i> @T.Register_JoinExisting
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="warehouseOption" id="newWarehouse"
                           checked="@createNewWarehouse"
                           @onchange="() => createNewWarehouse = true" />
                    <label class="form-check-label" for="newWarehouse">
                        <i class="bi bi-plus-circle me-1"></i> @T.Register_CreateNew
                    </label>
                </div>
            </div>

            @if (!createNewWarehouse)
            {
                <div class="form-group">
                    <label class="form-label">@T.Register_SelectWarehouse</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-building"></i></span>
                        <InputSelect class="form-select form-select-lg" @bind-Value="registerModel.WarehouseId" @bind-Value:after="OnWarehouseChanged">
                            <option value="0">@T.Register_SelectWarehousePlaceholder</option>
                            @foreach (var warehouse in warehouses)
                            {
                                <option value="@warehouse.Id">@warehouse.Name (@warehouse.Code)</option>
                            }
                        </InputSelect>
                    </div>
                    <ValidationMessage For="() => registerModel.WarehouseId" />
                    @if (selectedWarehouseInfo != null)
                    {
                        <small class="text-muted mt-1 d-block">
                            @T.Register_ApprovedUsers @selectedWarehouseInfo.CurrentUsers / @selectedWarehouseInfo.MaxUsers
                        </small>
                    }
                </div>
            }
            else
            {
                <div class="card bg-light p-3 mb-3">
                    <h6 class="mb-3"><i class="bi bi-building me-2"></i>@T.Register_NewWarehouse</h6>
     
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label class="form-label">@T.Register_WarehouseName *</label>
                                <InputText class="form-control" @bind-Value="newWarehouseModel.Name"
                                           placeholder="z.B. Hauptlager Mönchen" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label">@T.Register_WarehouseCode *</label>
                                <InputText class="form-control" @bind-Value="newWarehouseModel.Code"
                                           placeholder="z.B. MUC001" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">@T.Register_WarehouseAddress</label>
                        <InputText class="form-control" @bind-Value="newWarehouseModel.Address"
                                   placeholder="Straße, PLZ Stadt" />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-0">
                                <label class="form-label">@T.Register_MaxUsers</label>
                                <InputNumber class="form-control" @bind-Value="newWarehouseModel.MaxUsers" min="1" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="form-label">@T.Register_Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <InputText type="password" class="form-control form-control-lg"
                               @bind-Value="registerModel.Password"
                               @oninput="@(e => { registerModel.Password = e.Value?.ToString() ?? string.Empty; })"
                               placeholder="••••••••" autocomplete="new-password" />
                </div>
                <ValidationMessage For="() => registerModel.Password" />
                <PasswordStrengthIndicator Password="@registerModel.Password" />
            </div>

            <div class="form-group">
                <label class="form-label">@T.Register_ConfirmPasswordLabel</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <InputText type="password" class="form-control form-control-lg" @bind-Value="registerModel.ConfirmPassword"
                               placeholder="••••••••" autocomplete="new-password" />
                </div>
                <ValidationMessage For="() => registerModel.ConfirmPassword" />
            </div>

            <!-- GDPR consent -->
            <div class="form-check mb-2 mt-4">
                <input class="form-check-input" type="checkbox" id="gdprConsent"
                       @bind="gdprConsent" required>
                    <label class="form-check-label" for="gdprConsent">
                        <strong><i class="bi bi-shield-check me-1"></i>@T.Register_Gdpr_Privacy_Strong</strong> -
                        @T.Register_Gdpr_Privacy_Consent
                        <span class="text-danger">*</span>
                    </label>
                </div>
            
                <!-- Required: Analytics consent -->
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="analyticsConsent"
                           @bind="analyticsConsent" required>
                        <label class="form-check-label" for="analyticsConsent">
                            <strong><i class="bi bi-graph-up me-1"></i>@T.Register_Gdpr_Analytics_Label</strong> -
                            @T.Register_Gdpr_Analytics_Desc <span class="text-danger">*</span>
                        </label>
                        <small class="text-muted d-block ms-4">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>@T.Common_Required:</strong> @T.Register_Gdpr_Analytics_Required
                        </small>
                    </div>
            
                    <!-- Required: Device fingerprint consent -->
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="fingerprintConsent"
                               @bind="fingerprintConsent" required>
                            <label class="form-check-label" for="fingerprintConsent">
                                <strong><i class="bi bi-phone me-1"></i>@T.Register_Gdpr_Security_Label</strong> -
                                @T.Register_Gdpr_Security_Desc <span class="text-danger">*</span>
                            </label>
                            <small class="text-muted d-block ms-4">
                                <i class="bi bi-info-circle me-1"></i>
                                <strong>@T.Common_Required:</strong> @T.Register_Gdpr_Security_Required
                            </small>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="marketingConsent"
                                   @bind="marketingConsent">
                                <label class="form-check-label" for="marketingConsent">
                                    <i class="bi bi-envelope me-1"></i>
                                    @T.Register_Gdpr_Marketing
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-person-check me-2"></i>
                                @T.Register_Submit
                            </button>
                        </EditForm>

                        <div class="login-footer">
                            <p>@T.Register_AlreadyHaveAccount <a href="/login">@T.Register_Login</a></p>
                        </div>
                    </div>
                </div>

                <!-- Passkey registration prompt after successful signup -->
                @if (showPasskeyPrompt && registeredUser != null)
                {
                    <div class="modal-backdrop modal-backdrop--active"></div>
                    <div class="modal modal--active">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-success text-white">
                                    <h5 class="modal-title">
                                        <i class="bi bi-check-circle me-2"></i>
                                        @T.Login_PasskeySetup_Title
                                    </h5>
                                </div>
                                <div class="modal-body">
                                    <div class="text-center mb-3">
                                        <i class="bi bi-fingerprint display-1 text-primary"></i>
                                    </div>
          
                                    <h6 class="text-center mb-3">@T.Register_Passkey_Subtitle</h6>
             
                                    <div class="alert alert-light">
                                        <p class="mb-2"><strong>@T.Register_Passkey_BenefitsTitle</strong></p>
                                        <ul class="mb-0 small">
                                            <li><i class="bi bi-check-circle text-success me-1"></i> @T.Login_PasskeySetup_Benefit1</li>
                                            <li><i class="bi bi-check-circle text-success me-1"></i> @T.Login_PasskeySetup_Benefit2</li>
                                            <li><i class="bi bi-check-circle text-success me-1"></i> @T.Login_PasskeySetup_Benefit3</li>
                                        </ul>
                                    </div>
         
                                    <div class="form-group mt-3">
                                        <label class="form-label">@T.Login_PasskeySetup_DeviceLabel</label>
                                        <input type="text" class="form-control" @bind="passkeyDeviceName"
                                               placeholder="@detectedDeviceName" />
                                        <small class="text-muted">@T.Login_PasskeySetup_DeviceDetected: @detectedDeviceName</small>
                                    </div>

                                    @if (!string.IsNullOrEmpty(passkeyError))
                                    {
                                        <div class="alert alert-danger mt-3 mb-0">
                                            <small>@passkeyError</small>
                                        </div>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button class="btn btn-secondary" @onclick="SkipPasskeySetup">
                                        <i class="bi bi-x-lg me-1"></i>
                                        @T.Register_Passkey_Later
                                    </button>
                                    <button class="btn btn-primary" @onclick="CreatePasskeyAfterRegister" disabled="@isPasskeyLoading">
                                        @if (isPasskeyLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        <i class="bi bi-fingerprint me-1"></i>
                                        @T.Login_PasskeySetup_Create
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }


@code {
    private LagersystemLVHome.I18nText.App T = new();
    private RegisterModel registerModel = new();
    private NewWarehouseModel newWarehouseModel = new();
    private List<LagersystemLVHome.Domain.Models.Warehouse> warehouses = new();
    private WarehouseInfo? selectedWarehouseInfo;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = false;
    private bool createNewWarehouse = false;
    
    // GDPR consent flags
    private bool gdprConsent = false;
    private bool marketingConsent = false;
    private bool analyticsConsent = false;
    private bool fingerprintConsent = false;

    // Profile image
    private string? profileImagePath;

    // Post-registration passkey state
    private bool webAuthnSupported = false;
    private bool showPasskeyPrompt = false;
    private bool isPasskeyLoading = false;
    private User? registeredUser = null;
    private string passkeyDeviceName = string.Empty;
    private string detectedDeviceName = "Unbekanntes Gerät";
    private string passkeyError = string.Empty;
    private string? currentPasskeySessionId;
    private bool isFirstUserInWarehouse = false;

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        if (AuthService.IsAuthenticated())
        {
            NavigationManager.NavigateTo("/");
        }

        warehouses = await WarehouseService.GetActiveWarehousesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var supportInfo = await JSRuntime.InvokeAsync<WebAuthnSupportInfo>("webAuthnHelper.getAvailableAuthenticators");
                webAuthnSupported = supportInfo.WebAuthnSupported;
        
                if (webAuthnSupported)
                {
                    detectedDeviceName = await JSRuntime.InvokeAsync<string>("webAuthnHelper.detectDeviceName");
                }
      
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error checking WebAuthn support");
                webAuthnSupported = false;
            }
        }
    }

    private async Task OnWarehouseChanged()
    {
        if (registerModel.WarehouseId > 0)
        {
            var warehouse = warehouses.FirstOrDefault(w => w.Id == registerModel.WarehouseId);
            if (warehouse != null)
            {
                var userCount = await UserProfileService.CountApprovedActiveUsersInWarehouseAsync(warehouse.Id);

                selectedWarehouseInfo = new WarehouseInfo
                {
                    CurrentUsers = userCount,
                    MaxUsers = warehouse.MaxUsers
                };
            }
        }
        else
        {
            selectedWarehouseInfo = null;
        }
    }

    private void HandleProfileImageUploaded(string imagePath)
    {
        profileImagePath = imagePath;
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            // Validate consent flags
            if (!gdprConsent)
            {
                errorMessage = T.Register_GdprNotAccepted ?? "Bitte akzeptieren Sie die Datenschutzerklärung.";
                return;
            }
         
            if (!analyticsConsent)
            {
                errorMessage = "Bitte akzeptieren Sie das Analytics & Performance Tracking.";
                return;
            }
 
            if (!fingerprintConsent)
            {
                errorMessage = "Bitte akzeptieren Sie das Device Fingerprinting.";
                return;
            }

            if (registerModel.Password != registerModel.ConfirmPassword)
            {
                errorMessage = T.Register_PasswordMismatch ?? "Passwörter stimmen nicht überein.";
                return;
            }

            var passwordValidation = PasswordValidator.ValidatePassword(registerModel.Password);
            if (!passwordValidation.IsValid)
            {
                errorMessage = string.Format(T.Register_PasswordWeak ?? "Passwort erfüllt nicht die Anforderungen:\n{0}",
        string.Join("\n", passwordValidation.Errors));
                return;
            }

            int warehouseId;

            if (createNewWarehouse)
            {
                if (string.IsNullOrWhiteSpace(newWarehouseModel.Name) ||
            string.IsNullOrWhiteSpace(newWarehouseModel.Code))
                {
                    errorMessage = "Lager-Name und Code sind erforderlich.";
                    return;
                }

                var newWarehouse = new LagersystemLVHome.Domain.Models.Warehouse
                {
                    Name = newWarehouseModel.Name,
                    Code = newWarehouseModel.Code,
                    Address = newWarehouseModel.Address ?? string.Empty,
                    MaxUsers = newWarehouseModel.MaxUsers,
                    IsActive = true,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };

                var createResult = await WarehouseService.CreateWarehouseAsync(newWarehouse);
                if (createResult.IsFailure)
                {
                    errorMessage = createResult.ErrorCode == "warehouse.codeexists"
                        ? $"Ein Lager mit dem Code '{newWarehouseModel.Code}' existiert bereits."
                        : createResult.ErrorMessage ?? "Fehler beim Erstellen des Lagers.";
                    return;
                }

                warehouseId = createResult.Value!.Id;
                isFirstUserInWarehouse = true;
            }
            else
            {
                warehouseId = registerModel.WarehouseId;

                if (warehouseId == 0)
                {
                    errorMessage = T.Register_SelectWarehouseMsg ?? "Bitte wählen Sie ein Lager aus.";
                    return;
                }

                await OnWarehouseChanged();
                if (selectedWarehouseInfo != null && selectedWarehouseInfo.CurrentUsers >= selectedWarehouseInfo.MaxUsers)
                {
                    errorMessage = T.Register_WarehouseFull ?? "Das ausgewählte Lager hat die maximale Benutzeranzahl erreicht.";
                    return;
                }
            }

            var user = await UserRegistrationService.RegisterAsync(
                registerModel.Username,
            registerModel.Email,
        registerModel.Password,
                        registerModel.DisplayName,
                    warehouseId
                    );

            if (user != null)
            {
                // Save GDPR consent
                await GdprService.GiveConsentAsync(user.Id, marketingConsent);

                // Save granular consent preferences
                await UserProfileService.UpdateConsentPreferencesAsync(user.Id, analyticsConsent, fingerprintConsent);

                // Assign profile image if uploaded
                if (!string.IsNullOrEmpty(profileImagePath))
                {
                    try
                    {
                        if (await UserProfileService.SetProfileImagePathAsync(user.Id, profileImagePath))
                        {
                            user.ProfileImagePath = profileImagePath;
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to assign profile image");
                    }
                }

                if (createNewWarehouse || isFirstUserInWarehouse)
                {
                    // First user in warehouse is auto-approved as admin
                    await UserProfileService.ApproveAsAdminAsync(user.Id);
                    user.ApprovalStatus = UserApprovalStatus.Approved;
                    user.Role = UserRole.Admin;

                    registeredUser = user;

                    // Show passkey prompt for auto-approved users
                    if (webAuthnSupported)
                    {
                        showPasskeyPrompt = true;
                        successMessage = $"Neues Lager '{newWarehouseModel.Name}' erstellt! Sie wurden als Administrator freigeschaltet.";
                        return;
                    }
                    else
                    {
                        successMessage = $"Neues Lager erstellt! Als erster Benutzer wurden Sie automatisch als Administrator genehmigt.";
                        await Task.Delay(3000);
                        NavigationManager.NavigateTo("/login");
                    }
                }
                else
                {
                    successMessage = "Registrierung erfolgreich! Ihr Account muss noch von einem Administrator genehmigt werden.";
                    await Task.Delay(5000);
                    NavigationManager.NavigateTo("/login");
                }
            }
            else
            {
                errorMessage = "Registrierung fehlgeschlagen. Benutzername oder E-Mail existiert bereits.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler bei der Registrierung: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Create passkey after successful registration
    private async Task CreatePasskeyAfterRegister()
    {
        if (registeredUser == null) return;

        isPasskeyLoading = true;
        passkeyError = string.Empty;

        try
        {
            var deviceName = string.IsNullOrWhiteSpace(passkeyDeviceName) ? detectedDeviceName : passkeyDeviceName;
            
            var options = await WebAuthnService.GenerateRegistrationOptionsAsync(registeredUser.Id, deviceName);
     
            if (!options.Success)
            {
                passkeyError = options.Error ?? "Fehler bei der Vorbereitung.";
                return;
            }

            currentPasskeySessionId = options.SessionId;

            var jsOptions = new
            {
                challenge = options.Challenge,
                rpId = options.RpId,
                rpName = options.RpName,
                userId = options.UserId,
                userName = options.UserName,
                userDisplayName = options.UserDisplayName,
                excludeCredentials = options.ExcludeCredentials.Select(c => new
                {
                    type = c.Type,
                    id = c.Id,
                    transports = c.Transports
                }),
                authenticatorSelection = new
                {
                    authenticatorAttachment = options.AuthenticatorSelection.AuthenticatorAttachment,
                    residentKey = options.AuthenticatorSelection.ResidentKey,
                    userVerification = options.AuthenticatorSelection.UserVerification
                },
                timeout = options.Timeout,
                attestation = options.Attestation,
                deviceName = deviceName
            };

            var result = await JSRuntime.InvokeAsync<WebAuthnResult>("webAuthnHelper.registerPasskey", jsOptions);

            if (!result.Success)
            {
                passkeyError = result.Error ?? "Passkey-Erstellung fehlgeschlagen.";
                return;
            }

            var verifyResult = await WebAuthnService.VerifyRegistrationAsync(registeredUser.Id, result.Credential!, currentPasskeySessionId);

            if (verifyResult.Success)
            {
                Logger.LogInformation("Passkey registered for new user {UserId}", registeredUser.Id);
                showPasskeyPrompt = false;
                successMessage = T.Register_PasskeySuccess ?? "Passkey erfolgreich erstellt! Sie können sich jetzt anmelden.";
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                passkeyError = verifyResult.Error ?? "Passkey konnte nicht verifiziert werden.";
            }
        }
        catch (JSException jsEx) when (jsEx.Message.Contains("cancelled") || jsEx.Message.Contains("NotAllowedError"))
        {
            Logger.LogInformation("User cancelled passkey registration during signup");
            showPasskeyPrompt = false;
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during passkey registration");
            passkeyError = "Ein Fehler ist aufgetreten.";
        }
        finally
        {
            isPasskeyLoading = false;
        }
    }

    private void SkipPasskeySetup()
    {
        showPasskeyPrompt = false;
        NavigationManager.NavigateTo("/login");
    }

    // JS interop DTOs
    private class WebAuthnSupportInfo
    {
        public bool WebAuthnSupported { get; set; }
        public bool PlatformAuthenticator { get; set; }
        public bool ConditionalUI { get; set; }
    }

    private class WebAuthnResult
    {
        // JsonPropertyName required for case-insensitive JS interop deserialization
        [System.Text.Json.Serialization.JsonPropertyName("success")]
        public bool Success { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("error")]
        public string? Error { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("credential")]
        public string? Credential { get; set; }
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Benutzername ist erforderlich")]
        [MinLength(3, ErrorMessage = "Benutzername muss mindestens 3 Zeichen lang sein")]
        [MaxLength(100, ErrorMessage = "Benutzername darf maximal 100 Zeichen lang sein")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "E-Mail ist erforderlich")]
        [EmailAddress(ErrorMessage = "Ungültige E-Mail-Adresse")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Anzeigename ist erforderlich")]
        [MaxLength(200, ErrorMessage = "Anzeigename darf maximal 200 Zeichen lang sein")]
        public string DisplayName { get; set; } = string.Empty;

        public int WarehouseId { get; set; }

        [Required(ErrorMessage = "Passwort ist erforderlich")]
        [MinLength(8, ErrorMessage = "Passwort muss mindestens 8 Zeichen lang sein")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Passwortbestätigung ist erforderlich")]
