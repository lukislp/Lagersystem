@using LagersystemLVHome.Application.Services
@inject I18nText I18nText

<div class="row g-3">
    <div class="col-12">
        <label class="form-label">
            <i class="bi bi-google me-1"></i>
            Client ID *
        </label>
        <input type="text" class="form-control" @bind="Config.ClientId"
               placeholder="123456789-abc.apps.googleusercontent.com" />
        <small class="text-muted">@(T.BackupProvider_GDrive_ClientIdHint ?? "Google Cloud Console Client ID")</small>
    </div>

    <div class="col-12">
        <label class="form-label">
            <i class="bi bi-key me-1"></i>
            Client Secret *
        </label>
        <input type="password" class="form-control" @bind="Config.ClientSecret"
               placeholder="GOCSPX-..." />
        <small class="text-muted">@(T.BackupProvider_GDrive_ClientSecretHint ?? "Google Cloud Console Client Secret")</small>
    </div>

    <div class="col-12">
        <label class="form-label">
            <i class="bi bi-shield-lock me-1"></i>
            Refresh Token *
        </label>
        <input type="password" class="form-control" @bind="Config.RefreshToken"
               placeholder="1//..." />
        <small class="text-muted">OAuth2 Refresh Token (wird automatisch erneuert)</small>
    </div>

    <div class="col-md-8">
        <label class="form-label">
            <i class="bi bi-folder me-1"></i>
            @(T.BackupProvider_GDrive_FolderLabel ?? "Ordnername")
        </label>
        <input type="text" class="form-control" @bind="Config.FolderName"
               placeholder="LagerSystem Backups" />
        <small class="text-muted">@(T.BackupProvider_GDrive_FolderHint ?? "Name des Ordners in Google Drive")</small>
    </div>

    <div class="col-md-4">
        <label class="form-label">
            <i class="bi bi-link me-1"></i>
            Folder ID (optional)
        </label>
        <input type="text" class="form-control" @bind="Config.FolderId"
               placeholder="1a2b3c..." />
        <small class="text-muted">@(T.BackupProvider_GDrive_FolderIdHint ?? "Leer lassen für Root")</small>
    </div>

    <!-- Max Backups -->
    <div class="col-md-6">
        <label class="form-label">
            <i class="bi bi-clock-history me-1"></i>
            Maximale Anzahl Backups
        </label>
        <InputNumber class="form-control" @bind-Value="Config.MaxBackups"
                     min="1" max="365" />
        <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            @(T.BackupProvider_GDrive_MaxBackupsHint ?? "Älteste Backups werden automatisch gelöscht (Standard: 30)")
        </small>
    </div>

    <div class="col-12">
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle me-2"></i>
            <strong>@(T.BackupProvider_GDrive_SetupTitle ?? "Google Drive Setup:")</strong>
            <ol class="mb-0 mt-2">
                <li>@(T.BackupProvider_GDrive_SetupStep1 ?? "Erstelle ein Google Cloud Project")</li>
                <li>@(T.BackupProvider_GDrive_SetupStep2 ?? "Aktiviere die Google Drive API")</li>
                <li>@(T.BackupProvider_GDrive_SetupStep3 ?? "Erstelle OAuth 2.0 Client ID (Desktop App)")</li>
                <li>
                    @(T.BackupProvider_GDrive_SetupStep4 ?? "Generiere Refresh Token mit OAuth2 Flow:")
                    <ul class="mt-1">
                        <li><code>https://accounts.google.com/o/oauth2/auth?client_id=YOUR_CLIENT_ID&amp;redirect_uri=urn:ietf:wg:oauth:2.0:oob&amp;scope=https://www.googleapis.com/auth/drive.file&amp;response_type=code</code></li>
                        <li>@(T.BackupProvider_GDrive_SetupStep4b ?? "Tausche Code gegen Refresh Token:") <code>POST https://oauth2.googleapis.com/token</code></li>
                    </ul>
                </li>
                <li>@(T.BackupProvider_GDrive_SetupStep5 ?? "Trage Client ID, Secret und Refresh Token hier ein")</li>
            </ol>
        </div>
    </div>
</div>

@code {
    private LagersystemLVHome.I18nText.App T = new();
    [Parameter] public GoogleDriveConfig Config { get; set; } = new();
    [Parameter] public EventCallback<GoogleDriveConfig> ConfigChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }
}
