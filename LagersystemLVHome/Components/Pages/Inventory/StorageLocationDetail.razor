@page "/storage/{LocationId:int}"
@inherits CancellableComponentBase
@using LagersystemLVHome.Data
@using LagersystemLVHome.Domain.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject LagersystemLVHome.Application.Services.StorageLocationService StorageService
@inject ILocationQueryService LocationQueryService
@inject NavigationManager NavigationManager
@inject I18nText I18nText

<PageTitle>@T.StorageLocationDetail_PageTitle @location?.Code - LagerSystem</PageTitle>

@if (location == null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner"></div>
    </div>
}
else
{
    <div class="page-header">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/storage-overview">@T.StorageLocationDetail_Breadcrumb</a></li>
                <li class="breadcrumb-item active">@location.Code</li>
            </ol>
        </nav>
        <h1 class="page-title">@location.Code</h1>
        <p class="page-subtitle">@location.Name</p>
    </div>

    <div class="row g-4">
        <!-- Location Info -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@T.StorageLocationDetail_Info_Title</h3>
                </div>
                <div class="card-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">@T.StorageLocationDetail_Info_Code</span>
                            <span class="info-value"><code>@location.Code</code></span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@T.StorageLocationDetail_Info_Name</span>
                            <span class="info-value">@location.Name</span>
                        </div>
                        @if (!string.IsNullOrEmpty(location.Description))
                        {
                            <div class="info-item">
                                <span class="info-label">@T.StorageLocationDetail_Info_Desc</span>
                                <span class="info-value">@location.Description</span>
                            </div>
                        }
                    </div>

                    <hr />

                    <h4 class="mt-3 mb-2">@T.StorageLocationDetail_Position</h4>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">@T.StorageLocationDetail_Aisle</span>
                            <span class="info-value">@location.Aisle</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@T.StorageLocationDetail_Rack</span>
                            <span class="info-value">@location.Rack</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">@T.StorageLocationDetail_Shelf</span>
                            <span class="info-value">@location.Shelf</span>
                        </div>
                        @if (!string.IsNullOrEmpty(location.Bin))
                        {
                            <div class="info-item">
                                <span class="info-label">@T.StorageLocationDetail_Bin</span>
                                <span class="info-value">@location.Bin</span>
                            </div>
                        }
                    </div>

                    @if (location.MaxCapacity.HasValue || location.Width.HasValue)
                    {
                        <hr />
                        <h4 class="mt-3 mb-2">Kapazität & Maße</h4>
                        <div class="info-grid">
                            @if (location.MaxCapacity.HasValue)
                            {
                                <div class="info-item">
                                    <span class="info-label">Max. Kapazität:</span>
                                    <span class="info-value">@location.MaxCapacity Stück</span>
                                </div>
                                var usage = productQuantities.Values.Sum();
                                <div class="info-item">
                                    <span class="info-label">Aktuelle Belegung:</span>
                                    <span class="info-value">@usage Stück (@string.Format("{0:F1}%", (double)usage / location.MaxCapacity.Value * 100))</span>
                                </div>
                            }
                            @if (location.Width.HasValue || location.Height.HasValue || location.Depth.HasValue)
                            {
                                <div class="info-item">
                                    <span class="info-label">Abmessungen:</span>
                                    <span class="info-value">
                                        @(location.Width?.ToString() ?? "?") × @(location.Height?.ToString() ?? "?") × @(location.Depth?.ToString() ?? "?") cm
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Products in Location -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="card-title mb-0">Produkte in diesem Lagerplatz</h3>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="badge bg-primary">@products.Count Produkte</span>
                        @{
                            var totalQuantity = productQuantities.Values.Sum();
                            var totalValue = products.Sum(p =>
                    (productQuantities.ContainsKey(p.Id) ? productQuantities[p.Id] : 0) * p.Price);
                        }
                        <span class="badge bg-info">@totalQuantity Stück gesamt</span>
                        <span class="badge bg-success">@totalValue.ToString("C") Gesamtwert</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (products.Any())
                    {
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Produkt</th>
                                        <th>Kategorie</th>
                                        <th>Barcode</th>
                                        <th>Bestand</th>
                                        <th>Preis (Stk.)</th>
                                        <th>Gesamtwert</th>
                                        <th>Aktionen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in products)
                                    {
                                        var quantityHere = productQuantities.ContainsKey(product.Id) ? productQuantities[product.Id] : 0;
                                        var productTotalValue = product.Price * quantityHere;
    
                                        <tr>
                                            <td data-label="Produkt">
                                                <div class="product-info">
                                                    <div class="product-icon">
                                                        <CategoryIcon IconClass="@(product.Category?.Icon ?? "bi-box")" />
                                                    </div>
                                                    <div>
                                                        <div class="product-name">@product.Name</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td data-label="Kategorie">@product.Category?.Name</td>
                                            <td data-label="Barcode"><code>@product.Barcode</code></td>
                                            <td data-label="Bestand">
                                                <span class="badge @(quantityHere < product.MinQuantity ? "bg-danger" : quantityHere == 0 ? "bg-secondary" : "bg-success")">
                                                    @quantityHere Stk.
                                                </span>
                                                @if (quantityHere < product.MinQuantity && quantityHere > 0)
                                                {
                                                    <span class="text-danger ms-2">
                                                        <i class="bi bi-exclamation-triangle"></i>
                                                        Niedrig!
                                                    </span>
                                                }
                                            </td>
                                            <td data-label="Preis (Stk.)">@product.Price.ToString("C")</td>
                                            <td data-label="Gesamtwert">
                                                <strong>@productTotalValue.ToString("C")</strong>
                                            </td>
                                            <td data-label="Aktionen">
                                                <a href="/products?search=@Uri.EscapeDataString(product.Name)" class="btn btn-sm btn-secondary">
                                                    <i class="bi bi-eye"></i> Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-state-icon">📦</div>
                            <div class="empty-state-title">Keine Produkte</div>
                            <p>Dieser Lagerplatz ist noch leer.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}


@code {
    private LagersystemLVHome.I18nText.App T = new();
    [Parameter]
    public int LocationId { get; set; }

    private LagersystemLVHome.Domain.Models.StorageLocation? location;
    private List<LagersystemLVHome.Domain.Models.Product> products = new();
    private Dictionary<int, int> productQuantities = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        location = await StorageService.GetByIdAsync(LocationId);
        if (location != null)
        {
            var contents = await LocationQueryService.GetProductsAtLocationAsync(LocationId);
            products = contents.Products.ToList();
            productQuantities = new Dictionary<int, int>(contents.QuantityByProductId);
        }
    }

    private string GetStockClass(LagersystemLVHome.Domain.Models.Product product)
    {
        if (product.Quantity == 0) return "critical";
        if (product.Quantity <= product.MinQuantity) return "low";
        return "ok";
    }
}
