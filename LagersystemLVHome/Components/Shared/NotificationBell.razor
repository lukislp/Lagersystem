@inject INotificationService NotificationService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject INotificationEventService EventService
@inject I18nText I18nText
@rendermode InteractiveServer
@implements IDisposable

<div class="notification-bell-container">
    <div class="notification-bell" @onclick="ToggleDropdown">
        <i class="bi bi-bell"></i>
        @if (unreadCount > 0)
        {
            <span class="badge">@unreadCount</span>
        }
    </div>

    @if (showDropdown)
    {
        <div class="notification-dropdown" @onclick:stopPropagation="true">
            <div class="notification-header">
                <h6>@T.NotificationBell_Title</h6>
                <div class="d-flex align-items-center gap-2">
                    @if (unreadCount > 0)
                    {
                        <button class="btn btn-sm btn-link" @onclick="MarkAllAsRead">
                            @T.NotificationBell_MarkAllRead
                        </button>
                    }
                    <button class="notification-close-btn" @onclick="CloseDropdown" title="@T.NotificationBell_Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div class="notification-list">
                @if (notifications == null || !notifications.Any())
                {
                    <div class="empty-notifications">
                        <i class="bi bi-inbox"></i>
                            <p>@T.NotificationBell_Empty</p>
                    </div>
                }
                else
                {
                    @foreach (var notification in notifications)
                    {
                        <div class="notification-item @(notification.IsRead ? "read" : "unread")"
                             @onclick="() => OnNotificationClick(notification)">
                            <div class="notification-icon notification-@notification.Type.ToString().ToLower()">
                                <i class="bi @GetIcon(notification.Type)"></i>
                            </div>
                            <div class="notification-content">
                                <strong>@notification.Title</strong>
                                <p>@notification.Message</p>
                                <small>@FormatTime(notification.CreatedAt)</small>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="notification-footer">
                <a href="/notifications" @onclick="CloseDropdown">@T.NotificationBell_ShowAll</a>
            </div>
        </div>
    }
</div>

@code {
    private List<Notification>? notifications;
    private int unreadCount;
    private bool showDropdown;
    private System.Threading.Timer? _timer;
  
    // Previous values for change detection
    private int _previousUnreadCount = 0;
    private int _previousNotificationCount = 0;

    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
        await LoadNotifications();

        // Subscribe to notification change events
        EventService.OnNotificationsChanged += OnNotificationsChanged;
        
        // Use the silent load path inside the timer
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
    {
        await LoadNotificationsSilent();
    });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    // Event handler
    private async void OnNotificationsChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadNotifications();
            StateHasChanged();
        });
    }
    
    // Silent load without StateHasChanged when nothing changed
    private async Task LoadNotificationsSilent()
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user != null)
            {
                var newNotifications = await NotificationService.GetUserNotificationsAsync(user.Id, unreadOnly: false, limit: 10);
                var newUnreadCount = await NotificationService.GetUnreadCountAsync(user.Id);

                // CHANGE DETECTION
                bool hasChanges = false;
    
                if (newUnreadCount != _previousUnreadCount ||
                (newNotifications?.Count ?? 0) != _previousNotificationCount)
                {
                    hasChanges = true;
       
                    // Update data
                    notifications = newNotifications;
                    unreadCount = newUnreadCount;
       
                    // Update previous values
                    _previousUnreadCount = newUnreadCount;
                    _previousNotificationCount = newNotifications?.Count ?? 0;
           
                    // StateHasChanged WITHOUT scroll reset
                    StateHasChanged();
                }
            }
        }
        catch
        {
        }
    }

    // Manual load (initial)
    private async Task LoadNotifications()
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user != null)
            {
                notifications = await NotificationService.GetUserNotificationsAsync(user.Id, unreadOnly: false, limit: 10);
                unreadCount = await NotificationService.GetUnreadCountAsync(user.Id);
       
                // Initialize previous values
                _previousUnreadCount = unreadCount;
                _previousNotificationCount = notifications?.Count ?? 0;
            }
        }
        catch
        {
        }
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown()
    {
        showDropdown = false;
    }

    private async Task MarkAllAsRead()
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user != null)
            {
                await NotificationService.MarkAllAsReadAsync(user.Id);
                await LoadNotifications();
            }
        }
        catch
        {
        }
    }

    private async Task OnNotificationClick(Notification notification)
    {
        try
        {
            if (!notification.IsRead)
            {
                await NotificationService.MarkAsReadAsync(notification.Id);
                await LoadNotifications();
            }

            if (!string.IsNullOrEmpty(notification.ActionUrl))
            {
                NavigationManager.NavigateTo(notification.ActionUrl);
            }

            showDropdown = false;
        }
        catch
        {
        }
    }

    private string GetIcon(NotificationType type)
    {
        return type switch
        {
            NotificationType.LowStock => "bi-box-seam",
            NotificationType.CriticalStock => "bi-exclamation-triangle-fill",
            NotificationType.NewUser => "bi-person-plus-fill",
            NotificationType.SecurityAlert => "bi-shield-exclamation",
            NotificationType.Success => "bi-check-circle-fill",
            NotificationType.Error => "bi-x-circle-fill",
            NotificationType.Warning => "bi-exclamation-triangle-fill",
            NotificationType.Info => "bi-info-circle-fill",
            NotificationType.SystemUpdate => "bi-arrow-repeat",
            _ => "bi-bell-fill"
        };
    }

    private string FormatTime(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;
   
        if (timeSpan.TotalMinutes < 1)
            return "Gerade eben";

        if (timeSpan.TotalMinutes < 60)
            return $"vor {(int)timeSpan.TotalMinutes} Min.";
        
        if (timeSpan.TotalHours < 24)
            return $"vor {(int)timeSpan.TotalHours} Std.";
      
        if (timeSpan.TotalDays < 7)
            return $"vor {(int)timeSpan.TotalDays} Tag(en)";
   
        return dateTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm");
    }

    public void Dispose()
    {
        _timer?.Dispose();
        
        // Unsubscribe from events
        EventService.OnNotificationsChanged -= OnNotificationsChanged;
    }
}
