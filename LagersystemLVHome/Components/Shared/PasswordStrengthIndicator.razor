@inject IPasswordValidationService PasswordValidator
@inject I18nText I18nText

<div class="password-strength-container">
    @if (!string.IsNullOrEmpty(Password))
    {
        var result = PasswordValidator.ValidatePassword(Password);
        
        <div class="password-strength-bar">
            <div class="password-strength-fill password-strength-@GetStrengthClass(result.StrengthLevel)"
                 style="width: @(result.Strength)%"></div>
        </div>
        
        <div class="password-strength-label">
            <span class="badge bg-@GetBadgeClass(result.StrengthLevel)">
                @GetStrengthText(result.StrengthLevel)
            </span>
            <small class="text-muted ms-2">@result.Strength%</small>
        </div>

        @if (result.Errors.Any())
        {
            <div class="password-requirements mt-2">
                <small class="text-muted">@(T.PasswordStrengthIndicator_Requirements ?? "Anforderungen:")</small>
                <ul class="small mb-0 mt-1">
                    @foreach (var error in result.Errors)
                    {
                        <li class="text-danger">@error</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="password-requirements mt-2">
                <small class="text-success">
                    <i class="bi bi-check-circle me-1"></i>
                    @(T.PasswordStrengthIndicator_AllMet ?? "Alle Anforderungen erfüllt")
                </small>
            </div>
        }
    }
</div>


@code {
    private LagersystemLVHome.I18nText.App T = new();

    protected override async Task OnInitializedAsync()
    {
        T = await I18nText.GetTextTableAsync<LagersystemLVHome.I18nText.App>(this);
    }

    [Parameter]
    public string Password { get; set; } = string.Empty;

    private string GetStrengthClass(PasswordStrengthLevel level)
    {
        return level.ToString().ToLower().Replace("_", "-");
    }

    private string GetBadgeClass(PasswordStrengthLevel level)
    {
        return level switch
        {
            PasswordStrengthLevel.VeryWeak => "danger",
            PasswordStrengthLevel.Weak => "warning",
            PasswordStrengthLevel.Fair => "info",
            PasswordStrengthLevel.Strong => "success",
            PasswordStrengthLevel.VeryStrong => "success",
            _ => "secondary"
        };
    }

    private string GetStrengthText(PasswordStrengthLevel level)
    {
        return level switch
        {
            PasswordStrengthLevel.VeryWeak => "Sehr schwach",
            PasswordStrengthLevel.Weak => "Schwach",
            PasswordStrengthLevel.Fair => "Mittel",
            PasswordStrengthLevel.Strong => "Stark",
            PasswordStrengthLevel.VeryStrong => "Sehr stark",
            _ => "Unbekannt"
        };
    }
}
