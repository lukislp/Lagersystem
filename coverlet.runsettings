<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverlet configuration for: dotnet test /p:settings=coverlet.runsettings

  Stufen 11..17 ratchet:
    Stufe 11 baseline 20 %, Stufen 12..17 added more tests; threshold 40 %.
    See docs/coverage-roadmap.md for the path to 80 %.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[xunit.*]*,[*]*.Migrations.*,[LagersystemLVHome]*Components.*,[LagersystemLVHome]*API.Controllers.*,[LagersystemLVHome.Infrastructure]*</Exclude>
          <ExcludeByFile>**/Migrations/**/*.cs,**/*.Log.cs,**/Program.cs,**/obj/**/*.cs,**/wwwroot/**,**/*.razor.g.cs,**/*.razor.cs,**/Components/**/*.cs,**/BackupProviders/**/*.cs,**/*HostedService.cs,**/Hubs/**/*.cs,**/GlobalUsings.cs,**/Configuration/*Extensions.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <UseSourceLink>true</UseSourceLink>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>true</DeterministicReport>
          <Threshold>40</Threshold>
          <ThresholdType>line</ThresholdType>
          <ThresholdStat>total</ThresholdStat>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
